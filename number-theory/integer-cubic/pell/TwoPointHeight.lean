/-- The recorded residue excludes all rational numbers of height at most 10^209. -/
theorem coefficient_height_exclusion (a b : ℤ) (hb₀ : b ≠ 0)
    (ha : |a| ≤ 10^209) (hb : |b| ≤ 10^209) : ¬ (7^500 : ℤ) ∣ a-b*residue := by
  intro h
  exact hb₀ (lattice_exclusion (u := u) (v := v) (s := s) (t := t) h ha hb (by decide +kernel))

/-! The values below give a complete polynomial solution modulo 7^500.
Coefficients are stored in ascending order in the original t coordinate,
where L=1−3t². At t=1/3 the marked triple is (−2,3,1). For W=2Z+Y²,
the numerator equation is W²=Y⁴−4X³+8L¹². -/

namespace HeightCertificate

def modulus : ℤ := 7^500

def coeff (f : List ℤ) (i : ℕ) := f[i]?.getD 0

private def add : List ℤ → List ℤ → List ℤ
  | [], b => b
  | a, [] => a
  | a :: as, b :: bs => (a+b) :: add as bs

private def mul : List ℤ → List ℤ → List ℤ
  | [], _ => []
  | a :: as, b => add (b.map (a*·)) (0 :: mul as b)

private def powers (f : List ℤ) : ℕ → List ℤ
  | 0 => [1]
  | k+1 => mul (powers f k) f

def rhs (x y : List ℤ) : List ℤ :=
  add (powers y 4) (add ((powers x 3).map ((-4)*·)) ((powers [1,0,-3] 12).map (8*·)))

/-- The degree-d homogeneous evaluation at [1:3], equal to 3^d f(1/3). -/
def atMark (f : List ℤ) (d : ℕ) : ℤ :=
  ((List.range (d+1)).map (fun i => coeff f i * 3^(d-i))).sum

private def wFrom (f : List ℤ) : List ℤ :=
  let inverseSix := (5*modulus+1)/6
  (List.range 12).foldl (fun w i => w ++
    [((coeff f (i+1) - coeff (mul w w) (i+1))*inverseSix) % modulus]) [3]

/-- Coefficientwise congruence for the identity, including both marked values. -/
def validModel (x y w : List ℤ) : Bool :=
  let f := rhs x y
  let square := mul w w
  (x.length == 9 && y.length == 7 && w.length == 13) &&
    (coeff x 0 == 0 && coeff y 0 == 1 && coeff w 0 == 3) &&
    ((atMark x 8 + 2*6^4) % modulus == 0) &&
    ((atMark y 6 - 3*6^3) % modulus == 0) &&
    ((atMark w 12 - 11*6^6) % modulus == 0) &&
    (List.range 25).all (fun i => (coeff square i - coeff f i) % modulus == 0)

private def xData : List ℤ := [0, residue,
  ,
  ,
  ,
  ,
  ,
  ,
  ]

private def yData : List ℤ := [1,
  ,
  ,
  ,
  ,
  ,
  ]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem model_data : validModel xData yData (wFrom (rhs xData yData)) = true := by
  decide +kernel

/-- A two-mark solution modulo 7^500 with the same linear coefficient as in the height theorem. -/
theorem model_exists : ∃ x y w : List ℤ, coeff x 1 = residue ∧ validModel x y w = true :=
  ⟨xData, yData, wFrom (rhs xData yData), rfl, model_data⟩

end HeightCertificate
