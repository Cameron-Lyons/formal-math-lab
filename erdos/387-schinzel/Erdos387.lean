/-! ## 1. Reduction to a covering problem -/

/-- Lucas's congruence when the last base `p` digits `k % p` of `k` and `c` of `p * M + c` add up
without a carry: the last digits can be removed. -/
lemma dvd_choose_div {p k M c : ℕ} (hp : p.Prime) (hc : c + k % p < p)
    (hd : p ∣ (p * M + c + k).choose k) : p ∣ (M + k / p).choose (k / p) := by
  have := Fact.mk hp
  have hn : p * M + c + k = p * (M + k / p) + (c + k % p) := by
    have := Nat.div_add_mod k p
    linarith
  have h := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := p * M + c + k) (k := k) (p := p)
  rw [hn, Nat.mul_add_mod, Nat.mod_eq_of_lt hc, Nat.mul_add_div hp.pos, Nat.div_eq_of_lt hc,
    add_zero, ← hn] at h
  refine (hp.dvd_mul.1 ((h.dvd_iff dvd_rfl).1 hd)).resolve_left fun h1 => ?_
  have h2 : p ∣ (c + k % p).factorial := by
    rw [← Nat.add_choose_mul_factorial_mul_factorial]
    exact (h1.mul_right _).mul_right _
  exact absurd (hp.dvd_factorial.1 h2) (by omega)

/-- If `k < p ^ e` and `p ^ e ∣ M`, then `p ∤ C(M + k, k)`. -/
lemma not_dvd_choose {p : ℕ} (hp : p.Prime) (e : ℕ) : ∀ k M : ℕ, k < p ^ e → p ^ e ∣ M →
    ¬ p ∣ (M + k).choose k := by
  induction e with
  | zero =>
    intro k M hk _
    rw [pow_zero, Nat.lt_one_iff] at hk
    simp [hk, hp.one_lt.ne']
  | succ e ih =>
    rintro k _ hk ⟨M, rfl⟩ hd
    rw [pow_succ'] at hk hd
    rw [mul_assoc] at hd
    exact ih (k / p) (p ^ e * M) (Nat.div_lt_of_lt_mul hk) (Dvd.intro _ rfl)
      (dvd_choose_div hp (c := 0) (by simpa using Nat.mod_lt k hp.pos) hd)

/-- **Lemma 1** (Schinzel). Suppose that `a p ∈ (k % p, p]` for every prime `p ≤ k`, and that the
classes `a p` modulo `p` cover `1, ..., k`. Then some `n` has `n - i ∤ C(n, k)` for all `i < k`. -/
theorem reduction {k : ℕ} (a : ℕ → ℕ) (ha : ∀ p, p.Prime → p ≤ k → k % p < a p ∧ a p ≤ p)
    (hcov : ∀ j, 1 ≤ j → j ≤ k → ∃ p, p.Prime ∧ p ≤ k ∧ j ≡ a p [MOD p]) :
    ∃ n : ℕ, ∀ i < k, ¬ n - i ∣ n.choose k := by
  obtain ⟨m, hm⟩ := Nat.chineseRemainderOfFinset (fun p => a p - 1 - k % p) (fun p => p ^ (k + 1))
    (Nat.primesLE k) (fun p hp => pow_ne_zero _ (Nat.prime_of_mem_primesLE hp).ne_zero)
    (fun p hp r hr hne => Nat.Coprime.pow _ _ ((Nat.coprime_primes
      (Nat.prime_of_mem_primesLE hp) (Nat.prime_of_mem_primesLE hr)).2 hne))
  refine ⟨m + k, fun i hi hdvd => ?_⟩
  obtain ⟨p, hp, hpk, hj⟩ := hcov (i + 1) (by omega) (by omega)
  obtain ⟨h1, h2⟩ := ha p hp hpk
  set c := a p - 1 - k % p with hc
  have hmp : m ≡ c [MOD p ^ (k + 1)] := hm p (Nat.mem_primesLE.2 ⟨hpk, hp⟩)
  -- `p ∣ n - i`
  have hdiv : p ∣ m + k - i := by
    have h3 := ((hmp.of_dvd (dvd_pow_self p k.succ_ne_zero)).add
      (Nat.mod_modEq k p).symm).add_right 1
    rw [show c + k % p + 1 = a p by omega] at h3
    exact (Nat.modEq_iff_dvd' (by omega)).1 (Nat.ModEq.add_right_cancel' 1 (hj.trans h3.symm))
  -- `p ∤ C(n, k)`
  have hlt : k < p ^ k := Nat.lt_pow_self hp.one_lt
  have hcm : c ≤ m := by
    have h3 : c % p ^ (k + 1) = c := Nat.mod_eq_of_lt (by
      calc c < p := by omega
        _ ≤ p ^ (k + 1) := Nat.le_self_pow k.succ_ne_zero p)
    rw [← h3, ← hmp]
    exact Nat.mod_le _ _
  obtain ⟨M, hM⟩ := (Nat.modEq_iff_dvd' hcm).1 hmp.symm
  rw [pow_succ', mul_assoc] at hM
  refine not_dvd_choose hp k (k / p) (p ^ k * M) ((Nat.div_le_self _ _).trans_lt hlt)
    (Dvd.intro _ rfl) (dvd_choose_div hp (c := c) (by omega) ?_)
  rw [← hM, Nat.sub_add_cancel hcm]
  exact hdiv.trans hdvd

/-! ## 2. Størmer's theorem -/

/-- The sequences `x n`, `e n` with `(x + y √D) ^ n = x n + y * e n * √D`, where
`x ^ 2 - D y ^ 2 = 1`. They depend only on `x`. -/
def pellSeq (x : ℤ) : ℕ → ℤ × ℤ
  | 0 => (1, 0)
  | n + 1 => (x * (pellSeq x n).1 + (x ^ 2 - 1) * (pellSeq x n).2,
      (pellSeq x n).1 + x * (pellSeq x n).2)

/-- `pellSeq` describes the powers of a solution of Pell's equation. -/
lemma y_pow_eq {D : ℤ} (b : Pell.Solution₁ D) (n : ℕ) :
    (b ^ n).x = (pellSeq b.x n).1 ∧ (b ^ n).y = b.y * (pellSeq b.x n).2 := by
  induction n with
  | zero => simp [pellSeq]
  | succ n ih =>
    rw [pow_succ, Pell.Solution₁.x_mul, Pell.Solution₁.y_mul, ih.1, ih.2, pellSeq, ← b.prop_y]
    constructor <;> ring

/-- `x n ≡ x ^ n` and `x * e n ≡ n * x ^ n` modulo `x ^ 2 - 1`. -/
lemma pellSeq_congr (x : ℤ) (n : ℕ) : x ^ 2 - 1 ∣ (pellSeq x n).1 - x ^ n ∧
    x ^ 2 - 1 ∣ x * (pellSeq x n).2 - n * x ^ n := by
  induction n with
  | zero => simp [pellSeq]
  | succ n ih =>
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := ih
    simp only [pellSeq]
    push_cast
    exact ⟨⟨x * a + (pellSeq x n).2, by linear_combination x * ha⟩,
      ⟨x * a + x * b, by linear_combination x * ha + x * hb⟩⟩

/-- `e n > n` for `n ≥ 2`. -/
lemma lt_pellSeq {x : ℤ} (hx : 2 ≤ x) (n : ℕ) :
    1 ≤ (pellSeq x n).1 ∧ 0 ≤ (pellSeq x n).2 ∧ (2 ≤ n → (n : ℤ) < (pellSeq x n).2) := by
  induction n with
  | zero => simp [pellSeq]
  | succ n ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    simp only [pellSeq]
    have h4 : 0 ≤ (x ^ 2 - 1) * (pellSeq x n).2 := mul_nonneg (by nlinarith) h2
    refine ⟨by nlinarith, by nlinarith, fun hn => ?_⟩
    obtain rfl | h : n = 1 ∨ 2 ≤ n := by omega
    · simp [pellSeq]; linarith
    · push_cast; nlinarith [h3 h]

/-- Integers larger than 1 have prime divisors. -/
lemma exists_prime_dvd_int {z : ℤ} (hz : 1 < z) : ∃ p : ℕ, p.Prime ∧ (p : ℤ) ∣ z := by
  obtain ⟨p, hp, hpz⟩ := Nat.exists_prime_and_dvd (n := z.natAbs) (by omega)
  exact ⟨p, hp, Int.natCast_dvd.2 hpz⟩

/-- If every prime `p ∣ y` has `p ^ 2 ∣ D`, then the solution `(x, y)` is not a power with prime
exponent `r` of another solution `b`. -/
lemma no_prime_pow {D : ℤ} (b : Pell.Solution₁ D) (hbx : 1 < b.x) {r : ℕ} (hr : r.Prime)
    (hy : ∀ p : ℕ, p.Prime → (p : ℤ) ∣ (b ^ r).y → (p : ℤ) ^ 2 ∣ D) : False := by
  set x := b.x with hx
  set e := (pellSeq x r).2 with he
  have hre : (r : ℤ) < e := (lt_pellSeq (by linarith) r).2.2 hr.two_le
  -- a prime divisor `p` of `e` has `p ^ 2 ∣ x ^ 2 - 1` and `p ∤ x`
  have hp2 : ∀ p : ℕ, p.Prime → (p : ℤ) ∣ e → (p : ℤ) ^ 2 ∣ x ^ 2 - 1 ∧ ¬ (p : ℤ) ∣ x := by
    intro p hp hpe
    have h1 : (p : ℤ) ^ 2 ∣ x ^ 2 - 1 :=
      (hy p hp (by rw [(y_pow_eq b r).2]; exact hpe.mul_left _)).trans ⟨b.y ^ 2, by rw [← b.prop_y]⟩
    refine ⟨h1, fun h2 => hp.one_lt.ne' ?_⟩
    have h3 := dvd_sub (h2.pow two_ne_zero) ((dvd_pow_self (p : ℤ) two_ne_zero).trans h1)
    rw [sub_sub_cancel] at h3
    exact_mod_cast Int.eq_one_of_dvd_one (by positivity) h3
  -- hence `p = r`, and `r ^ 2 ∤ e`
  have hdvd : ∀ m : ℤ, m ∣ x ^ 2 - 1 → m ∣ e → m ∣ r * x ^ r := fun m h1 h2 =>
    (dvd_sub_right (h2.mul_left x)).1 (h1.trans (pellSeq_congr x r).2)
  have honly : ∀ p : ℕ, p.Prime → (p : ℤ) ∣ e → p = r := by
    intro p hp hpe
    obtain ⟨h1, h2⟩ := hp2 p hp hpe
    have hpp : Prime (p : ℤ) := Nat.prime_iff_prime_int.1 hp
    rcases hpp.dvd_or_dvd (hdvd p ((dvd_pow_self _ two_ne_zero).trans h1) hpe) with h | h
    · exact (Nat.prime_dvd_prime_iff_eq hp hr).1 (by exact_mod_cast h)
    · exact absurd (hpp.dvd_of_dvd_pow h) h2
  obtain ⟨p, hp, hpe⟩ := exists_prime_dvd_int (by have := hr.one_lt; omega : 1 < e)
  obtain rfl := honly p hp hpe
  obtain ⟨h1, h2⟩ := hp2 p hp hpe
  obtain ⟨v, hv⟩ := hpe
  have hp0 : (0 : ℤ) < p := by exact_mod_cast hp.pos
  obtain ⟨p', hp', hpv⟩ := exists_prime_dvd_int (by nlinarith : 1 < v)
  obtain rfl := honly p' hp' (by rw [hv]; exact hpv.mul_left _)
  have h3 := hdvd (p' ^ 2) h1 (by rw [hv, pow_two]; exact mul_dvd_mul_left _ hpv)
  rw [pow_two] at h3
  exact h2 ((Nat.prime_iff_prime_int.1 hr).dvd_of_dvd_pow (Int.dvd_of_mul_dvd_mul_left hp0.ne' h3))

/-- If every prime `p ∣ y` has `p ^ 2 ∣ D`, then the solution `(x, y)` is the fundamental one. -/
lemma eq_fundamental {D : ℤ} {f a : Pell.Solution₁ D} (hf : Pell.IsFundamental f)
    (hax : 1 < a.x) (hay : 0 < a.y)
    (hy : ∀ p : ℕ, p.Prime → (p : ℤ) ∣ a.y → (p : ℤ) ^ 2 ∣ D) : a = f := by
  obtain ⟨n, hn⟩ := hf.eq_pow_of_nonneg (a := a) (by linarith) hay.le
  by_contra hne
  obtain ⟨r, hr, m, rfl⟩ := Nat.exists_prime_and_dvd (n := n) (by rintro rfl; simp [hn] at hne)
  rw [mul_comm, pow_mul] at hn
  refine no_prime_pow (f ^ m) ?_ hr (by rwa [← hn])
  have hx : 0 < (f ^ m).x := Pell.Solution₁.x_pow_pos hf.x_pos m
  by_contra h1
  have h2 : (f ^ m).x = 1 := by omega
  have h3 : f ^ m = 1 := by
    have := (f ^ m).prop
    rw [h2, one_pow, sub_eq_self, mul_eq_zero] at this
    have hD := hf.d_pos
    refine Pell.Solution₁.ext h2 ?_
    simpa using this.resolve_left hD.ne'
  rw [hn, h3, one_pow] at hax
  simp at hax

/-- A number `N` with all prime factors at most `J` is `D * y ^ 2`, where `D` divides a number that
depends only on `J`, and `p ^ 2 ∣ D` for every prime `p ∣ y`. -/
lemma exists_decomp {J N : ℕ} (hN : N ≠ 0) (hJ : ∀ p, p.Prime → p ∣ N → p ≤ J) :
    ∃ D y : ℕ, N = D * y ^ 2 ∧ D ∣ primorial J ^ 3 ∧ ∀ p : ℕ, p.Prime → p ∣ y → p ^ 2 ∣ D := by
  obtain ⟨s, t, rfl, hs⟩ := Nat.sq_mul_squarefree N
  have ht : t ≠ 0 := by rintro rfl; simp at hN
  have hP : ∀ m, m ≠ 0 → m ∣ t ^ 2 * s → ∏ p ∈ m.primeFactors, p ∣ primorial J := fun m hm hd =>
    prod_dvd_prod_of_subset _ _ _ fun p hp => by
      obtain ⟨h1, h2, -⟩ := Nat.mem_primeFactors.1 hp
      rw [mem_filter, mem_range]
      exact ⟨by have := hJ p h1 (h2.trans hd); omega, h1⟩
  set r := ∏ p ∈ t.primeFactors, p with hr
  obtain ⟨y, hy⟩ : r ∣ t := Nat.prod_primeFactors_dvd t
  refine ⟨s * r ^ 2, y, by rw [hy]; ring, ?_, fun p hp hpy => ?_⟩
  · rw [pow_succ' (primorial J) 2, ← Nat.prod_primeFactors_of_squarefree hs]
    exact mul_dvd_mul (hP s hs.ne_zero (Dvd.intro_left _ rfl))
      (pow_dvd_pow_of_dvd (hP t ht (dvd_mul_of_dvd_left (dvd_pow_self t two_ne_zero) s)) 2)
  · have h1 : p ∈ t.primeFactors :=
      Nat.mem_primeFactors.2 ⟨hp, by rw [hy]; exact hpy.mul_left r, ht⟩
    exact (pow_dvd_pow_of_dvd (dvd_prod_of_mem _ h1) 2).mul_left s

/-- **Lemma 2** (Størmer). For large `m`, the number `m * (m + 1)` has a prime factor larger than
`J`. -/
theorem stormer (J : ℕ) : ∃ m0 : ℕ, ∀ m, m0 ≤ m → ∃ p, p.Prime ∧ J < p ∧ p ∣ m * (m + 1) := by
  classical
  -- `F D` is the `x` of the fundamental solution
  set F : ℕ → ℕ := fun D => if h : ∃ f : Pell.Solution₁ (D : ℤ), Pell.IsFundamental f
    then h.choose.x.natAbs else 0 with hF
  refine ⟨(∑ D ∈ (primorial J ^ 3).divisors, F D) + 1, fun m hm => ?_⟩
  by_contra hcon
  push Not at hcon
  have h2 : 2 ≤ J := by
    by_contra h
    exact hcon 2 Nat.prime_two (by omega) (Nat.even_mul_succ_self m).two_dvd
  have hJ : ∀ p, p.Prime → p ∣ 4 * (m * (m + 1)) → p ≤ J := by
    intro p hp hd
    by_contra hlt
    rcases (Nat.Prime.dvd_mul hp).1 hd with h | h
    · have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 (hp.dvd_of_dvd_pow (n := 2) h)
      omega
    · exact hcon p hp (by omega) h
  have hm1 : 1 ≤ m := by omega
  obtain ⟨D, y, hDy, hDd, hyD⟩ := exists_decomp (by positivity) hJ
  have hy0 : 0 < y := Nat.pos_of_ne_zero (by rintro rfl; simp at hDy; omega)
  have hprop : ((2 * m + 1 : ℕ) : ℤ) ^ 2 - (D : ℤ) * (y : ℤ) ^ 2 = 1 := by
    have : ((4 * (m * (m + 1)) : ℕ) : ℤ) = D * y ^ 2 := by exact_mod_cast hDy
    rw [← this]; push_cast; ring
  set a : Pell.Solution₁ (D : ℤ) := Pell.Solution₁.mk _ _ hprop with ha
  have hax : 1 < a.x := by rw [ha, Pell.Solution₁.x_mk]; push_cast; omega
  have hex := Pell.IsFundamental.exists_of_not_isSquare (Pell.Solution₁.d_pos_of_one_lt_x hax)
    (Pell.Solution₁.d_nonsquare_of_one_lt_x hax)
  have heq := eq_fundamental hex.choose_spec hax
    (by rw [ha, Pell.Solution₁.y_mk]; exact_mod_cast hy0) (fun p hp hpy => by
      rw [ha, Pell.Solution₁.y_mk] at hpy
      exact_mod_cast hyD p hp (by exact_mod_cast hpy))
  have hFD : F D = 2 * m + 1 := by
    simp only [hF, hex, dif_pos]
    rw [← heq, ha, Pell.Solution₁.x_mk, Int.natAbs_natCast]
  have hle : F D ≤ ∑ D ∈ (primorial J ^ 3).divisors, F D :=
    single_le_sum (f := F) (fun _ _ => Nat.zero_le _)
      (Nat.mem_divisors.2 ⟨hDd, pow_ne_zero 3 (primorial_pos J).ne'⟩)
  omega

/-! ## 3. Chebyshev's bounds -/

section Chebyshev
open ArithmeticFunction hiding log id
open Real (log)

/-- `log n!` as a sum over prime powers (Legendre's formula). -/
lemma log_factorial_eq (n : ℕ) : log n.factorial = ∑ d ∈ Ioc 0 n, Λ d * ((n / d : ℕ) : ℝ) := by
  rw [← sum_Ioc_mul_zeta_eq_sum (R := ℝ) Λ n, vonMangoldt_mul_zeta]
  induction n with
  | zero => simp
  | succ n ih =>
    rw [← insert_Ioc_right_eq_Ioc_add_one (by omega), sum_insert (by simp), ← ih,
      Nat.factorial_succ, Nat.cast_mul, Real.log_mul (by positivity) (by positivity)]
    simp [ArithmeticFunction.log_apply]

/-- An upper bound for `log n!`. -/
lemma log_factorial_le {n : ℕ} (hn : 1 ≤ n) : log n.factorial ≤ n * log n - n + log n + 1 := by
  induction n, hn using Nat.le_induction with
  | base => simp
  | succ n hn ih =>
    have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
    rw [Nat.factorial_succ]
    push_cast
    rw [Real.log_mul (by positivity) (by positivity)]
    have h1 := Real.one_sub_inv_le_log_of_pos (x := (n + 1 : ℝ) / n) (by positivity)
    rw [Real.log_div (by positivity) (by positivity)] at h1
    have h2 : 1 - ((n + 1 : ℝ) / n)⁻¹ = 1 / (n + 1) := by field_simp; ring
    rw [h2, div_le_iff₀ (by positivity)] at h1
    nlinarith

/-- `log (c m)!` up to an error `O(log m)`, for `c ≤ 30`. -/
lemma log_factorial_mul {c m : ℕ} (hc1 : 1 ≤ c) (hc2 : c ≤ 30) (hm : 1 ≤ m) :
    |log (c * m).factorial - (c * m * (log c + log m) - c * m)| ≤ log m + 5 := by
  have hc0 : (0 : ℝ) < c := by exact_mod_cast hc1
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have h1 := log_factorial_le (n := c * m) (Nat.mul_pos hc1 hm)
  have h2 := Stirling.le_log_factorial_stirling (n := c * m) (Nat.mul_pos hc1 hm).ne'
  push_cast at h1 h2
  rw [Real.log_mul hc0.ne' hm0.ne'] at h1 h2
  have h3 : 0 ≤ log m := Real.log_natCast_nonneg m
  have h4 : 0 ≤ log c := Real.log_natCast_nonneg c
  have h5 : 0 ≤ log (2 * Real.pi) := Real.log_nonneg (by linarith [Real.pi_gt_three])
  have h6 : log c ≤ 4 := by
    rw [Real.log_le_iff_le_exp hc0]
    calc (c : ℝ) ≤ 30 := by exact_mod_cast hc2
      _ ≤ 2.7 ^ 4 := by norm_num
      _ ≤ Real.exp 1 ^ 4 := pow_le_pow_left₀ (by norm_num) (by linarith [Real.exp_one_gt_d9]) 4
      _ = Real.exp 4 := by rw [← Real.exp_nat_mul]; norm_num
  rw [abs_le]
  constructor <;> linarith

/-- Chebyshev's combination of factorials. -/
noncomputable def chebL (m : ℕ) : ℝ := log (30 * m).factorial - log (15 * m).factorial
  - log (10 * m).factorial - log (6 * m).factorial + log m.factorial

/-- Chebyshev's constant (multiplied by 30). -/
noncomputable def chebA : ℝ := 30 * log 30 - 15 * log 15 - 10 * log 10 - 6 * log 6

/-- Numerical bounds for Chebyshev's constant. -/
lemma chebA_bounds : 27.6 < chebA ∧ chebA < 27.65 := by
  have h1 : chebA = 40 * log 2 + log (30 ^ 30 / (15 ^ 15 * 10 ^ 10 * 6 ^ 6) / 2 ^ 40) := by
    rw [chebA, Real.log_div (by positivity) (by positivity),
      Real.log_div (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity)]
    simp only [Real.log_pow]
    push_cast; ring
  have h2 := Real.log_le_sub_one_of_pos
    (x := (30 ^ 30 / (15 ^ 15 * 10 ^ 10 * 6 ^ 6) / 2 ^ 40 : ℝ)) (by positivity)
  have h3 := Real.one_sub_inv_le_log_of_pos
    (x := (30 ^ 30 / (15 ^ 15 * 10 ^ 10 * 6 ^ 6) / 2 ^ 40 : ℝ)) (by positivity)
  have h4 := Real.log_two_gt_d9
  have h5 := Real.log_two_lt_d9
  norm_num at h1 h2 h3
  rw [h1]
  constructor <;> linarith

/-- `chebL m = chebA * m + O(log m)`. -/
lemma chebL_bounds {m : ℕ} (hm : 1 ≤ m) : |chebL m - chebA * m| ≤ 5 * log m + 25 := by
  have h30 := log_factorial_mul (c := 30) (by norm_num) (by norm_num) hm
  have h15 := log_factorial_mul (c := 15) (by norm_num) (by norm_num) hm
  have h10 := log_factorial_mul (c := 10) (by norm_num) (by norm_num) hm
  have h6 := log_factorial_mul (c := 6) (by norm_num) (by norm_num) hm
  have h1 := log_factorial_mul (c := 1) le_rfl (by norm_num) hm
  rw [one_mul] at h1
  push_cast at h30 h15 h10 h6 h1
  rw [Real.log_one] at h1
  rw [chebL, chebA]
  rw [abs_le] at *
  constructor <;> linarith [h30.1, h30.2, h15.1, h15.2, h10.1, h10.2, h6.1, h6.2, h1.1, h1.2]

/-- `chebL` as a sum over prime powers. -/
lemma chebL_eq (m : ℕ) : chebL m = ∑ d ∈ Ioc 0 (30 * m), Λ d *
    (((30 * m / d : ℕ) : ℝ) - (30 * m / d / 2 : ℕ) - (30 * m / d / 3 : ℕ) - (30 * m / d / 5 : ℕ)
      + (30 * m / d / 30 : ℕ)) := by
  have key : ∀ c a : ℕ, 1 ≤ c → 30 * m / c = a → log a.factorial =
      ∑ d ∈ Ioc 0 (30 * m), Λ d * ((30 * m / d / c : ℕ) : ℝ) := by
    rintro c _ hc rfl
    rw [log_factorial_eq, sum_subset (Ioc_subset_Ioc_right (Nat.div_le_self _ c))]
    · exact sum_congr rfl fun d _ => by rw [Nat.div_right_comm]
    · intro d hd hd'
      rw [mem_Ioc] at hd hd'
      rw [Nat.div_eq_of_lt (by omega), Nat.cast_zero, mul_zero]
  have h1 := key 1 (30 * m) le_rfl (Nat.div_one _)
  simp only [Nat.div_one] at h1
  rw [chebL, h1, key 2 (15 * m) (by omega) (by omega), key 3 (10 * m) (by omega) (by omega),
    key 5 (6 * m) (by omega) (by omega), key 30 m (by omega) (by omega), ← sum_sub_distrib,
    ← sum_sub_distrib, ← sum_sub_distrib, ← sum_add_distrib]
  exact sum_congr rfl fun d _ => by ring

/-- Chebyshev's inequalities for `ψ`. -/
lemma chebL_le_psi (m : ℕ) : chebL m ≤ Chebyshev.psi (30 * m : ℕ) ∧
    Chebyshev.psi (30 * m : ℕ) ≤ Chebyshev.psi (5 * m : ℕ) + chebL m := by
  simp only [chebL_eq, Chebyshev.psi, Nat.floor_natCast]
  constructor
  · refine sum_le_sum fun d _ => ?_
    have h : ((30 * m / d + 30 * m / d / 30 : ℕ) : ℝ) ≤
        ((1 + 30 * m / d / 2 + 30 * m / d / 3 + 30 * m / d / 5 : ℕ) : ℝ) :=
      Nat.cast_le.2 (by omega)
    push_cast at h
    nlinarith [vonMangoldt_nonneg (n := d)]
  · have hsub : Ioc 0 (5 * m) ⊆ Ioc 0 (30 * m) := Ioc_subset_Ioc_right (by omega)
    rw [← inter_eq_right.2 hsub, ← sum_ite_mem, ← sum_add_distrib]
    refine sum_le_sum fun d hd => ?_
    rw [mem_Ioc] at hd
    have hΛ := vonMangoldt_nonneg (n := d)
    set t := 30 * m / d with ht
    have h1 : 1 ≤ t := Nat.div_pos hd.2 hd.1
    split_ifs with h
    · have h2 : ((t / 2 + t / 3 + t / 5 : ℕ) : ℝ) ≤ ((t + t / 30 : ℕ) : ℝ) :=
        Nat.cast_le.2 (by omega)
      push_cast at h2
      nlinarith
    · have h6 : t < 6 := by
        rw [mem_Ioc, not_and, not_le] at h
        rw [ht, Nat.div_lt_iff_lt_mul hd.1]
        linarith [h hd.1]
      have h2 : ((t / 2 + t / 3 + t / 5 + 1 : ℕ) : ℝ) ≤ ((t + t / 30 : ℕ) : ℝ) :=
        Nat.cast_le.2 (by omega)
      push_cast at h2
      nlinarith

/-- Logarithms are small. -/
lemma eventually_log_le {ε : ℝ} (hε : 0 < ε) (a b : ℝ) :
    ∀ᶠ x : ℝ in atTop, a * log x + b ≤ ε * x := by
  have h := (Real.isLittleO_log_id_atTop.const_mul_left a).add
    (Asymptotics.isLittleO_const_id_atTop b)
  filter_upwards [h.bound hε, eventually_ge_atTop 0] with x hx h0
  rw [id, Real.norm_of_nonneg h0] at hx
  exact (le_abs_self _).trans hx

/-- Powers are small against the exponential function. -/
lemma eventually_pow_le_exp (c : ℝ) (n : ℕ) : ∀ᶠ x : ℝ in atTop, c * x ^ n ≤ Real.exp x := by
  have h := (Real.isLittleO_pow_exp_atTop (n := n)).const_mul_left c
  filter_upwards [h.bound one_pos] with x hx
  rw [one_mul, Real.norm_of_nonneg (Real.exp_pos x).le] at hx
  exact (le_abs_self _).trans hx

/-- `log k → ∞` for natural numbers `k → ∞`. -/
lemma tendsto_log_nat : Tendsto (fun k : ℕ => log (k : ℝ)) atTop atTop :=
  Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop

/-- `ψ(n) ≤ 1.107 n + O(1)`. -/
lemma psi_upper : ∃ C : ℝ, ∀ n : ℕ, Chebyshev.psi n ≤ 1.107 * n + C := by
  obtain ⟨N, hN⟩ := eventually_atTop.1
    ((eventually_log_le (ε := 0.01) (by norm_num) 5 60).natCast_atTop)
  refine ⟨Chebyshev.psi (30 * N + 30 : ℕ), fun n => ?_⟩
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n (30 * N + 30) with h | h
    · have h2 : Chebyshev.psi n ≤ Chebyshev.psi (30 * N + 30 : ℕ) :=
        Chebyshev.psi_mono (by exact_mod_cast h.le)
      have : (0 : ℝ) ≤ n := by positivity
      linarith
    · obtain ⟨m, hm1, hm2⟩ : ∃ m, n ≤ 30 * m ∧ 30 * m ≤ n + 29 :=
        ⟨(n + 29) / 30, by omega, by omega⟩
      have h1 : Chebyshev.psi n ≤ Chebyshev.psi (30 * m : ℕ) :=
        Chebyshev.psi_mono (by exact_mod_cast hm1)
      have h2 := (chebL_le_psi m).2
      have h3 := (abs_le.1 (chebL_bounds (m := m) (by omega))).2
      have h4 := hN m (by omega)
      have h5 := ih (5 * m) (by omega)
      have h6 : (30 * m : ℝ) ≤ n + 29 := by exact_mod_cast hm2
      have h7 := mul_le_mul_of_nonneg_right chebA_bounds.2.le (Nat.cast_nonneg (α := ℝ) m)
      push_cast at h1 h2 h5 ⊢
      linarith

/-- **Lemma 3** (Chebyshev). `0.91 x ≤ θ(x) ≤ 1.11 x` for large `x`. -/
theorem theta_bounds : ∀ᶠ x : ℝ in atTop, 0.91 * x ≤ Chebyshev.theta x ∧
    Chebyshev.theta x ≤ 1.11 * x := by
  obtain ⟨C, hC⟩ := psi_upper
  have hsq : ∀ᶠ x : ℝ in atTop, log x ≤ 0.001 * √x := by
    filter_upwards [(isLittleO_log_rpow_atTop (r := 1 / 2) (by norm_num)).bound
      (c := 0.001) (by norm_num)] with x hx
    rw [← Real.sqrt_eq_rpow, Real.norm_of_nonneg (Real.sqrt_nonneg x)] at hx
    exact (le_abs_self _).trans hx
  filter_upwards [hsq, eventually_log_le (ε := 0.001) (by norm_num) 5 (|C| + 100),
    eventually_ge_atTop 30] with x h1 h2 h3
  have hlog : 0 ≤ log x := Real.log_nonneg (by linarith)
  constructor
  · obtain ⟨m, hm⟩ : ∃ m : ℕ, m = ⌊x⌋₊ / 30 := ⟨_, rfl⟩
    have hx30 : 30 ≤ ⌊x⌋₊ := Nat.le_floor (by exact_mod_cast h3)
    have h5 : (30 * m : ℝ) ≤ x :=
      le_trans (by exact_mod_cast (by omega : 30 * m ≤ ⌊x⌋₊)) (Nat.floor_le (by linarith))
    have h6 : x ≤ 30 * m + 30 :=
      (Nat.lt_floor_add_one x).le.trans (by exact_mod_cast (by omega : ⌊x⌋₊ + 1 ≤ 30 * m + 30))
    have h7 : Chebyshev.psi (30 * m : ℕ) ≤ Chebyshev.psi x :=
      Chebyshev.psi_mono (by push_cast; exact h5)
    have h8 := (abs_le.1 (chebL_bounds (m := m) (by omega))).1
    have h9 := (chebL_le_psi m).1
    have h10 := mul_le_mul_of_nonneg_right chebA_bounds.1.le (Nat.cast_nonneg (α := ℝ) m)
    have h11 := Chebyshev.psi_sub_theta_le (x := x) (by linarith)
    have hm0 : (1 : ℝ) ≤ m := by exact_mod_cast (by omega : 1 ≤ m)
    have h12 : log m ≤ log x := Real.log_le_log (by linarith) (by linarith)
    have h13 : √x * log x ≤ 0.001 * x := by
      have := mul_le_mul_of_nonneg_left h1 (Real.sqrt_nonneg x)
      rwa [mul_left_comm, Real.mul_self_sqrt (by linarith)] at this
    linarith [abs_nonneg C]
  · rw [Chebyshev.theta_eq_theta_coe_floor]
    have h4 := (Chebyshev.theta_le_psi _).trans (hC ⌊x⌋₊)
    have h5 := Nat.floor_le (by linarith : 0 ≤ x)
    linarith [le_abs_self C]

/-- **Lemma 3**, last part: `π(x) ≤ 1.12 x / log x` for large `x`. -/
lemma primeCounting_le : ∀ᶠ x : ℝ in atTop, (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ 1.12 * x / log x := by
  obtain ⟨C, hC⟩ := Chebyshev.primeCounting_sub_theta_div_log_isBigO.bound
  filter_upwards [hC, theta_bounds, Real.tendsto_log_atTop.eventually_ge_atTop (max 1 (100 * |C|)),
    eventually_gt_atTop 0] with x h1 h2 h3 hx
  have hl1 : 1 ≤ log x := (le_max_left _ _).trans h3
  have hl2 : 100 * |C| ≤ log x := (le_max_right _ _).trans h3
  rw [Real.norm_eq_abs, Real.norm_of_nonneg (by positivity)] at h1
  have h4 : C * (x / log x ^ 2) ≤ 0.01 * x / log x := by
    calc C * (x / log x ^ 2) ≤ log x / 100 * (x / log x ^ 2) := by
          gcongr; linarith [le_abs_self C]
      _ = 0.01 * x / log x := by field_simp; norm_num
  have h5 : Chebyshev.theta x / log x ≤ 1.11 * x / log x := by gcongr; exact h2.2
  have h6 : 1.12 * x / log x = 1.11 * x / log x + 0.01 * x / log x := by ring
  linarith [(abs_le.1 h1).2]

end Chebyshev

open Real (log)

/-! ## 4. The auxiliary prime -/

/-- The proportion of residues modulo `r` that are larger than `k % r`. -/
noncomputable def dens (k r : ℕ) : ℝ := #{a ∈ range r | k % r < a % r} / r

/-- The indicator function of `k % r < n % r`, minus its mean value. -/
noncomputable def dev (k r n : ℕ) : ℝ := (if k % r < n % r then 1 else 0) - dens k r

/-- `dens k r` is a proportion. -/
lemma dens_bounds {k r : ℕ} (hr : 0 < r) : 0 ≤ dens k r ∧ dens k r ≤ 1 := by
  refine ⟨by rw [dens]; positivity, ?_⟩
  rw [dens, div_le_one (by exact_mod_cast hr), Nat.cast_le]
  simpa using card_filter_le (range r) (fun a => k % r < a % r)

/-- The values of `dev` lie in `[-1, 1]`. -/
lemma abs_dev_le {k r : ℕ} (hr : 0 < r) (n : ℕ) : |dev k r n| ≤ 1 := by
  obtain ⟨h1, h2⟩ := dens_bounds (k := k) hr
  rw [dev, abs_le]
  split_ifs <;> constructor <;> linarith

/-- `dev` has mean value zero. -/
lemma sum_dev {k r : ℕ} (hr : 0 < r) : ∑ a ∈ range r, dev k r a = 0 := by
  have hr' : (r : ℝ) ≠ 0 := by exact_mod_cast hr.ne'
  simp only [dev, dens, sum_sub_distrib, sum_boole, sum_const, card_range, nsmul_eq_mul]
  rw [mul_div_cancel₀ _ hr', sub_self]

/-- By the Chinese remainder theorem, `dev k p * dev k r` has mean value zero. -/
lemma sum_dev_mul {k p r : ℕ} (hp : 0 < p) (hr : 0 < r) (h : Nat.Coprime p r) :
    ∑ n ∈ range (p * r), dev k p n * dev k r n = 0 := by
  have key : ∑ n ∈ range (p * r), dev k p n * dev k r n =
      ∑ c ∈ range p ×ˢ range r, dev k p c.1 * dev k r c.2 := by
    refine sum_nbij (fun n => (n % p, n % r)) ?_ ?_ ?_ ?_
    · intro n _
      simp [Nat.mod_lt, hp, hr]
    · intro a ha b hb hab
      simp only [Prod.mk.injEq] at hab
      simp only [coe_range, Set.mem_Iio] at ha hb
      exact Nat.ModEq.eq_of_lt_of_lt ((Nat.modEq_and_modEq_iff_modEq_mul h).1 hab) ha hb
    · intro ⟨a, b⟩ hab
      simp only [coe_product, coe_range, Set.mem_prod, Set.mem_Iio] at hab
      obtain ⟨n, hn1, hn2⟩ := Nat.chineseRemainder h a b
      refine ⟨n % (p * r), by simpa using Nat.mod_lt _ (Nat.mul_pos hp hr), ?_⟩
      simp only [Nat.mod_mul_right_mod, Nat.mod_mul_left_mod]
      rw [hn1, hn2, Nat.mod_eq_of_lt hab.1, Nat.mod_eq_of_lt hab.2]
    · intro n _
      simp [dev]
  rw [key, sum_product, ← sum_mul_sum, sum_dev hp, zero_mul]

/-- A periodic function with mean value zero and values in `[-1, 1]` has bounded partial sums. -/
lemma abs_sum_le_period {m : ℕ} (hm : 0 < m) {f : ℕ → ℝ} (hper : ∀ n, f (m + n) = f n)
    (hz : ∑ n ∈ range m, f n = 0) (hb : ∀ n, |f n| ≤ 1) (N : ℕ) : |∑ n ∈ range N, f n| ≤ m := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    rcases Nat.lt_or_ge N m with h | h
    · calc |∑ n ∈ range N, f n| ≤ ∑ n ∈ range N, |f n| := abs_sum_le_sum_abs _ _
        _ ≤ ∑ n ∈ range N, (1 : ℝ) := sum_le_sum fun n _ => hb n
        _ = N := by simp
        _ ≤ m := by exact_mod_cast h.le
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
      rw [sum_range_add, hz, zero_add, sum_congr rfl fun n _ => hper n]
      exact ih j (by omega)

/-- The covariances of the functions `dev k r`. -/
lemma sum_dev_dev_le {k p r Q : ℕ} (hp : p.Prime) (hr : r.Prime) (hpQ : p ≤ Q) (hrQ : r ≤ Q)
    (N : ℕ) : ∑ n ∈ range N, dev k p n * dev k r n ≤
      (if p = r then N * dens k p else 0) + (Q : ℝ) ^ 2 := by
  have hpQ' : (p : ℝ) ≤ Q := by exact_mod_cast hpQ
  have hQ1 : (1 : ℝ) ≤ Q := by exact_mod_cast hp.one_le.trans hpQ
  split_ifs with h
  · subst h
    obtain ⟨e1, e2⟩ := dens_bounds (k := k) hp.pos
    have hz := abs_sum_le_period hp.pos (f := dev k p) (fun n => by simp [dev]) (sum_dev hp.pos)
      (abs_dev_le hp.pos) N
    have hid : ∀ n, dev k p n * dev k p n ≤ dens k p + (1 - 2 * dens k p) * dev k p n := by
      intro n; unfold dev; split_ifs <;> nlinarith
    have h1 : |1 - 2 * dens k p| * |∑ n ∈ range N, dev k p n| ≤ 1 * p :=
      mul_le_mul (abs_le.2 ⟨by linarith, by linarith⟩) hz (abs_nonneg _) zero_le_one
    rw [← abs_mul] at h1
    calc _ ≤ ∑ n ∈ range N, (dens k p + (1 - 2 * dens k p) * dev k p n) :=
          sum_le_sum fun n _ => hid n
      _ = N * dens k p + (1 - 2 * dens k p) * ∑ n ∈ range N, dev k p n := by
          rw [sum_add_distrib, sum_const, card_range, nsmul_eq_mul, mul_sum]
      _ ≤ _ := by nlinarith [le_abs_self ((1 - 2 * dens k p) * ∑ n ∈ range N, dev k p n)]
  · have hz := abs_sum_le_period (Nat.mul_pos hp.pos hr.pos)
      (f := fun n => dev k p n * dev k r n) (fun n => by simp [dev])
      (sum_dev_mul hp.pos hr.pos ((Nat.coprime_primes hp hr).2 h))
      (fun n => by
        rw [abs_mul]
        exact mul_le_one₀ (abs_dev_le hp.pos n) (abs_nonneg _) (abs_dev_le hr.pos n)) N
    have hrQ' : (r : ℝ) ≤ Q := by exact_mod_cast hrQ
    push_cast at hz
    nlinarith [(abs_le.1 hz).2, Nat.cast_nonneg (α := ℝ) p, Nat.cast_nonneg (α := ℝ) r]

/-- **Lemma 4** (Turán's second moment argument). Few `n < N` have `n % r ≤ k % r` for all
`r ∈ R`. -/
lemma second_moment (k N Q : ℕ) (R : Finset ℕ) (hR : ∀ r ∈ R, r.Prime ∧ r ≤ Q) :
    (∑ r ∈ R, dens k r) ^ 2 * #{n ∈ range N | ∀ r ∈ R, n % r ≤ k % r} ≤
      N * ∑ r ∈ R, dens k r + (Q : ℝ) ^ 4 := by
  have hcard : (#R : ℝ) ≤ Q := by
    have : R ⊆ Icc 1 Q := fun r hr => mem_Icc.2 ⟨(hR r hr).1.one_le, (hR r hr).2⟩
    simpa using card_le_card this
  calc (∑ r ∈ R, dens k r) ^ 2 * #{n ∈ range N | ∀ r ∈ R, n % r ≤ k % r}
      = ∑ n ∈ range N with ∀ r ∈ R, n % r ≤ k % r, (∑ r ∈ R, dev k r n) ^ 2 := by
        rw [mul_comm, ← nsmul_eq_mul, ← sum_const]
        refine sum_congr rfl fun n hn => ?_
        rw [← neg_sq, ← sum_neg_distrib]
        congr 1
        refine sum_congr rfl fun r hr => ?_
        rw [dev, if_neg (by have := (mem_filter.1 hn).2 r hr; omega), zero_sub]
    _ ≤ ∑ n ∈ range N, (∑ r ∈ R, dev k r n) ^ 2 :=
        sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _ => sq_nonneg _
    _ = ∑ p ∈ R, ∑ r ∈ R, ∑ n ∈ range N, dev k p n * dev k r n := by
        simp_rw [sq, sum_mul_sum]
        rw [sum_comm]
        exact sum_congr rfl fun p _ => sum_comm
    _ ≤ ∑ p ∈ R, ∑ r ∈ R, ((if p = r then N * dens k p else 0) + (Q : ℝ) ^ 2) :=
        sum_le_sum fun p hp => sum_le_sum fun r hr =>
          sum_dev_dev_le (hR p hp).1 (hR r hr).1 (hR p hp).2 (hR r hr).2 N
    _ = N * ∑ r ∈ R, dens k r + (#R * #R) * (Q : ℝ) ^ 2 := by
        simp only [sum_add_distrib, sum_ite_eq, sum_const, nsmul_eq_mul,
          mul_sum]
        rw [sum_ite_mem, inter_self]
        ring
    _ ≤ N * ∑ r ∈ R, dens k r + (Q * Q) * (Q : ℝ) ^ 2 := by gcongr
    _ = _ := by ring

/-- There are at least `t ^ 5` primes up to `t ^ 6`, for large `t`. -/
lemma pow_five_le_primeCounting : ∀ᶠ t : ℕ in atTop, (t : ℝ) ^ 5 ≤ Nat.primeCounting (t ^ 6) := by
  have h6 : Tendsto (fun t : ℕ => (t : ℝ) ^ 6) atTop atTop :=
    (tendsto_pow_atTop (by norm_num)).comp tendsto_natCast_atTop_atTop
  filter_upwards [(eventually_log_le (ε := 0.91) (by norm_num) 6 0).natCast_atTop,
    h6.eventually theta_bounds, eventually_ge_atTop 1] with t h1 h2 h3
  have ht : (0 : ℝ) < t := by exact_mod_cast h3
  have h4 := Chebyshev.theta_le_pi_mul_log (t ^ 6)
  push_cast at h4
  rw [Real.log_pow] at h4
  push_cast at h4
  have h5 := mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg (α := ℝ) (Nat.primeCounting (t ^ 6)))
  have h7 : (t : ℝ) ^ 5 * (0.91 * t) ≤ Nat.primeCounting (t ^ 6) * (0.91 * t) := by
    have : (t : ℝ) ^ 6 = t ^ 5 * t := by ring
    linarith [h2.1]
  exact le_of_mul_le_mul_right h7 (by positivity)

/-- Primes `r` for which `k % r` is close to `0` or to `r` are rare: they divide the product of the
`2 s` numbers closest to `k`. -/
lemma card_exceptional_le {k s : ℕ} (hk : 3 ≤ log k) (hs : s ≤ k) (B : Finset ℕ)
    (hB : ∀ r ∈ B, r.Prime ∧ (k % r < s ∨ r ≤ k % r + s)) : (#B : ℝ) ≤ 4 * s * log k := by
  set N := (k + s).descFactorial (2 * s) with hN
  have hN0 : 0 < N := Nat.descFactorial_pos.2 (by omega)
  have hdvd : ∀ r ∈ B, r ∣ N := by
    intro r hr
    obtain ⟨hp, h⟩ := hB r hr
    have h0 := Nat.mod_lt k hp.pos
    have h1 := Nat.mod_add_div k r
    have key : ∀ i < 2 * s, r ∣ k + s - i → r ∣ N := fun i hi hd => by
      rw [hN, Nat.descFactorial_eq_prod_range]
      exact hd.trans (dvd_prod_of_mem _ (mem_range.2 hi))
    rcases h with h | h
    · exact key (s + k % r) (by omega) ⟨k / r, by omega⟩
    · exact key (s - (r - k % r)) (by omega) ⟨k / r + 1, by rw [mul_add]; omega⟩
  have h1 : 2 ^ #B ≤ (2 * k) ^ (2 * s) :=
    calc 2 ^ #B ≤ ∏ r ∈ B, r := pow_card_le_prod _ _ _ fun r hr => (hB r hr).1.two_le
      _ ≤ N := Nat.le_of_dvd hN0 (prod_primes_dvd _ (fun r hr => (hB r hr).1.prime) hdvd)
      _ ≤ (k + s) ^ (2 * s) := Nat.descFactorial_le_pow _ _
      _ ≤ (2 * k) ^ (2 * s) := Nat.pow_le_pow_left (by omega) _
  have h2 : (2 : ℝ) ^ #B ≤ (2 * k) ^ (2 * s) := by exact_mod_cast h1
  have hk0 : (k : ℝ) ≠ 0 := by rintro h; rw [h, Real.log_zero] at hk; linarith
  have h3 := Real.log_le_log (by positivity) h2
  rw [Real.log_pow, Real.log_pow, Real.log_mul (by norm_num) hk0] at h3
  push_cast at h3
  nlinarith [Real.log_two_gt_d9, Real.log_two_lt_d9, Nat.cast_nonneg (α := ℝ) #B,
    mul_nonneg (Nat.cast_nonneg (α := ℝ) s) (by linarith : 0 ≤ log k - 3)]

/-- For large `k` there are many primes `r ≤ (log k) ^ 6` for which `k % r` is not close to `0` or
to `r`. -/
lemma exists_primes : ∀ᶠ k : ℕ in atTop, ∃ R : Finset ℕ,
    (∀ r ∈ R, r.Prime ∧ r ≤ ⌊log k⌋₊ ^ 6 ∧ log k ^ 2 ≤ (k % r : ℕ)) ∧
    log k ^ 2 / 4 ≤ ∑ r ∈ R, dens k r := by
  filter_upwards [(tendsto_nat_floor_atTop.comp tendsto_log_nat).eventually
    pow_five_le_primeCounting, tendsto_log_nat.eventually (eventually_pow_le_exp 1 3),
    tendsto_log_nat.eventually_ge_atTop 100, eventually_ge_atTop 1] with k h1 hk3 hL hk
  simp only [Function.comp] at h1
  rw [one_mul, Real.exp_log (by positivity)] at hk3
  set L := log (k : ℝ) with hLdef
  set t := ⌊L⌋₊ with ht
  have ht1 : (t : ℝ) ≤ L := Nat.floor_le (by linarith)
  have ht2 : L < t + 1 := Nat.lt_floor_add_one L
  have ht0 : (99 : ℝ) ≤ t := by linarith
  have hsk : t ^ 3 ≤ k := by exact_mod_cast (pow_le_pow_left₀ (by linarith) ht1 3).trans hk3
  set R := {r ∈ Nat.primesLE (t ^ 6) | t ^ 3 ≤ k % r ∧ k % r + t ^ 3 < r} with hR
  have hRmem : ∀ r ∈ R, (r.Prime ∧ r ≤ t ^ 6) ∧ t ^ 3 ≤ k % r ∧ k % r + t ^ 3 < r := fun r hr => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hr
    exact ⟨(Nat.mem_primesLE.1 h1).symm, h2⟩
  have hcard : (t : ℝ) ^ 5 / 2 ≤ #R := by
    have e1 := card_exceptional_le (by linarith) hsk {r ∈ Nat.primesLE (t ^ 6) |
      ¬ (t ^ 3 ≤ k % r ∧ k % r + t ^ 3 < r)} fun r hr => by
        obtain ⟨h1, h2⟩ := mem_filter.1 hr
        exact ⟨Nat.prime_of_mem_primesLE h1, by omega⟩
    have e2 : (Nat.primeCounting (t ^ 6) : ℝ) = #R + #{r ∈ Nat.primesLE (t ^ 6) |
        ¬ (t ^ 3 ≤ k % r ∧ k % r + t ^ 3 < r)} := by
      rw [← Nat.primesLE_card_eq_primeCounting, ← Nat.cast_add, hR,
        card_filter_add_card_filter_not]
    have e3 : 4 * (t : ℝ) ^ 3 * L ≤ 4 * t ^ 3 * (2 * t) := by gcongr; linarith
    have e4 : 4 * (t : ℝ) ^ 3 * (2 * t) ≤ t ^ 5 / 2 := by
      have : (0 : ℝ) < t ^ 4 := by positivity
      nlinarith
    push_cast at e1
    linarith
  have hdens : ∀ r ∈ R, 1 / (t : ℝ) ^ 3 ≤ dens k r := fun r hr => by
    obtain ⟨⟨h1, h2⟩, -, h3⟩ := hRmem r hr
    have e1 : t ^ 3 ≤ #{a ∈ range r | k % r < a % r} := by
      calc t ^ 3 ≤ #(Ico (k % r + 1) r) := by rw [Nat.card_Ico]; omega
        _ ≤ _ := card_le_card fun a ha => by
          rw [mem_Ico] at ha
          rw [mem_filter, mem_range, Nat.mod_eq_of_lt ha.2]
          omega
    have e2 : (t : ℝ) ^ 3 ≤ #{a ∈ range r | k % r < a % r} := by exact_mod_cast e1
    have e3 : (r : ℝ) ≤ t ^ 6 := by exact_mod_cast h2
    have hr0 : (0 : ℝ) < r := by exact_mod_cast h1.pos
    rw [dens, div_le_div_iff₀ (by positivity) hr0]
    nlinarith [pow_pos (by linarith : (0 : ℝ) < t) 3]
  refine ⟨R, fun r hr => ⟨(hRmem r hr).1.1, (hRmem r hr).1.2, ?_⟩, ?_⟩
  · have h3 : ((t ^ 3 : ℕ) : ℝ) ≤ (k % r : ℕ) := Nat.cast_le.2 (hRmem r hr).2.1
    have h4 : L ^ 2 ≤ (2 * t) ^ 2 := pow_le_pow_left₀ (by linarith) (by linarith) 2
    push_cast at h3
    nlinarith
  · calc L ^ 2 / 4 ≤ (t : ℝ) ^ 5 / 2 * (1 / t ^ 3) := by field_simp; nlinarith
      _ ≤ #R * (1 / (t : ℝ) ^ 3) := by gcongr
      _ = ∑ r ∈ R, 1 / (t : ℝ) ^ 3 := by rw [sum_const, nsmul_eq_mul]
      _ ≤ _ := sum_le_sum hdens

/-- There are at least `0.02 k / log k` primes in `(k - ⌊k/5⌋, k]`, for large `k`. -/
lemma card_primes_ge : ∀ᶠ k : ℕ in atTop,
    0.02 * k / log k ≤ #{P ∈ Ioc (k - k / 5) k | P.Prime} := by
  have hsub : Tendsto (fun k : ℕ => ((k - k / 5 : ℕ) : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp (tendsto_atTop_mono (fun k => (by omega : k / 2 ≤ k - k / 5))
      (Nat.tendsto_div_const_atTop two_ne_zero))
  filter_upwards [theta_bounds.natCast_atTop, hsub.eventually theta_bounds,
    eventually_ge_atTop 1000] with k h1 h2 hk
  have hk0 : (1000 : ℝ) ≤ k := by exact_mod_cast hk
  rw [div_le_iff₀ (Real.log_pos (by linarith))]
  have h3 : ((k - k / 5 : ℕ) : ℝ) ≤ 0.8 * k + 0.8 := by
    have : ((5 * (k - k / 5) : ℕ) : ℝ) ≤ ((4 * k + 4 : ℕ) : ℝ) := Nat.cast_le.2 (by omega)
    push_cast at this
    linarith
  have h4 : Chebyshev.theta k = Chebyshev.theta (k - k / 5 : ℕ) +
      ∑ P ∈ Ioc (k - k / 5) k with P.Prime, log P := by
    simp only [Chebyshev.theta, Nat.floor_natCast, sum_filter]
    rw [sum_Ioc_consecutive _ (Nat.zero_le _) (Nat.sub_le _ _)]
  have h5 : ∑ P ∈ Ioc (k - k / 5) k with P.Prime, log P ≤
      #{P ∈ Ioc (k - k / 5) k | P.Prime} * log k := by
    rw [← nsmul_eq_mul]
    refine sum_le_card_nsmul _ _ _ fun P hP => ?_
    rw [mem_filter, mem_Ioc] at hP
    exact Real.log_le_log (by exact_mod_cast hP.2.pos) (by exact_mod_cast hP.1.2)
  linarith [h1.1, h2.2]

/-- For large `k`, at least half of these primes `P` have `P % r > k % r` for some prime `r ∈ R`. -/
lemma card_good_primes_ge : ∀ᶠ k : ℕ in atTop, ∃ R : Finset ℕ,
    (∀ r ∈ R, r.Prime ∧ r ≤ ⌊log k⌋₊ ^ 6 ∧ log k ^ 2 ≤ (k % r : ℕ)) ∧
    0.01 * k / log k ≤ #{P ∈ Ioc (k - k / 5) k | P.Prime ∧ ∃ r ∈ R, k % r < P % r} := by
  filter_upwards [exists_primes, card_primes_ge,
    tendsto_log_nat.eventually (eventually_pow_le_exp 1 24),
    tendsto_log_nat.eventually_ge_atTop 1200, eventually_ge_atTop 1] with k ⟨R, hR, hV⟩ h1 h2 hL hk
  refine ⟨R, hR, ?_⟩
  rw [one_mul, Real.exp_log (by positivity)] at h2
  set L := log (k : ℝ) with hLdef
  set V := ∑ r ∈ R, dens k r with hVdef
  set Z := {n ∈ range (k + 1) | ∀ r ∈ R, n % r ≤ k % r} with hZ
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hV1 : 1 ≤ V := by nlinarith
  have hZcard : (#Z : ℝ) ≤ 12 * k / L ^ 2 := by
    have h3 := second_moment k (k + 1) (⌊L⌋₊ ^ 6) R fun r hr => ⟨(hR r hr).1, (hR r hr).2.1⟩
    have h4 : ((⌊L⌋₊ ^ 6 : ℕ) : ℝ) ^ 4 ≤ k := by
      push_cast
      rw [← pow_mul]
      exact (pow_le_pow_left₀ (by positivity) (Nat.floor_le (by linarith)) 24).trans h2
    push_cast at h3 h4
    have h5 : V * (V * #Z) ≤ V * (3 * k) := by nlinarith
    have h6 := le_of_mul_le_mul_left h5 (by linarith)
    rw [le_div_iff₀ (by positivity)]
    nlinarith [Nat.cast_nonneg (α := ℝ) #Z]
  have h3 : #{P ∈ Ioc (k - k / 5) k | P.Prime} ≤
      #{P ∈ Ioc (k - k / 5) k | P.Prime ∧ ∃ r ∈ R, k % r < P % r} + #Z := by
    refine (card_le_card fun P hP => ?_).trans (card_union_le _ _)
    simp only [hZ, mem_union, mem_filter, mem_Ioc, mem_range] at hP ⊢
    by_cases h : ∃ r ∈ R, k % r < P % r
    · exact Or.inl ⟨hP.1, hP.2, h⟩
    · push Not at h
      exact Or.inr ⟨by omega, h⟩
  have h4 : 12 * k / L ^ 2 ≤ 0.01 * k / L := by
    rw [div_le_div_iff₀ (by positivity) (by linarith)]
    nlinarith [mul_pos (by linarith : (0 : ℝ) < k) (by linarith : 0 < L)]
  have h5 : 0.02 * k / L = 0.01 * k / L + 0.01 * k / L := by ring
  have h6 : (#{P ∈ Ioc (k - k / 5) k | P.Prime} : ℝ) ≤
      #{P ∈ Ioc (k - k / 5) k | P.Prime ∧ ∃ r ∈ R, k % r < P % r} + #Z := by exact_mod_cast h3
  linarith

/-- **Lemma 5** (auxiliary prime). For large `k` some class `c0` modulo a prime `p0`, where
`k % p0 < c0`, contains many primes of `(k - ⌊k/5⌋, k]`. -/
theorem exists_aux : ∀ᶠ k : ℕ in atTop, ∃ p0 c0 : ℕ, p0.Prime ∧ p0 ≤ k ∧
    log k ^ 2 ≤ (k % p0 : ℕ) ∧ k % p0 < c0 ∧ c0 < p0 ∧
    k / log k ^ 14 ≤ #{P ∈ Ioc (k - k / 5) k | P.Prime ∧ P % p0 = c0} := by
  filter_upwards [card_good_primes_ge, tendsto_log_nat.eventually (eventually_pow_le_exp 1 6),
    tendsto_log_nat.eventually_ge_atTop 200, eventually_ge_atTop 1] with k ⟨R, hR, hS⟩ h1 hL hk
  rw [one_mul, Real.exp_log (by positivity)] at h1
  set L := log (k : ℝ) with hLdef
  set S := {P ∈ Ioc (k - k / 5) k | P.Prime ∧ ∃ r ∈ R, k % r < P % r} with hSdef
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hQ : ((⌊L⌋₊ ^ 6 : ℕ) : ℝ) ≤ L ^ 6 := by
    push_cast
    exact pow_le_pow_left₀ (by positivity) (Nat.floor_le (by linarith)) 6
  have hRQ : ∀ r ∈ R, (r : ℝ) ≤ L ^ 6 := fun r hr => (Nat.cast_le.2 (hR r hr).2.1).trans hQ
  have hcard : (#R : ℝ) ≤ L ^ 6 := by
    have : R ⊆ Icc 1 (⌊L⌋₊ ^ 6) := fun r hr => mem_Icc.2 ⟨(hR r hr).1.one_le, (hR r hr).2.1⟩
    exact le_trans (Nat.cast_le.2 (by simpa using card_le_card this)) hQ
  -- otherwise there are too few primes in `S`
  by_contra hcon
  push Not at hcon
  have hsub : S ⊆ R.biUnion fun r => (Ioo (k % r) r).biUnion fun c =>
      {P ∈ Ioc (k - k / 5) k | P.Prime ∧ P % r = c} := fun P hP => by
    obtain ⟨h2, h3, r, hr, h4⟩ := mem_filter.1 hP
    refine mem_biUnion.2 ⟨r, hr, mem_biUnion.2 ⟨P % r, ?_, ?_⟩⟩
    · exact mem_Ioo.2 ⟨h4, Nat.mod_lt P (hR r hr).1.pos⟩
    · exact mem_filter.2 ⟨h2, h3, rfl⟩
  have h5 : (#S : ℝ) ≤ L ^ 12 * (k / L ^ 14) := by
    calc (#S : ℝ) ≤ ∑ r ∈ R, ∑ c ∈ Ioo (k % r) r,
          (#{P ∈ Ioc (k - k / 5) k | P.Prime ∧ P % r = c} : ℝ) := by
          exact_mod_cast (card_le_card hsub).trans
            (card_biUnion_le.trans (sum_le_sum fun r _ => card_biUnion_le))
      _ ≤ ∑ r ∈ R, ∑ c ∈ Ioo (k % r) r, k / L ^ 14 := by
          refine sum_le_sum fun r hr => sum_le_sum fun c hc => ?_
          obtain ⟨h2, h3⟩ := mem_Ioo.1 hc
          obtain ⟨h4, -, h5⟩ := hR r hr
          exact (hcon r c h4 (by exact_mod_cast (hRQ r hr).trans h1) h5 h2 h3).le
      _ ≤ ∑ r ∈ R, L ^ 6 * (k / L ^ 14) := by
          refine sum_le_sum fun r hr => ?_
          rw [sum_const, nsmul_eq_mul]
          gcongr
          refine le_trans (Nat.cast_le.2 ?_) (hRQ r hr)
          rw [Nat.card_Ioo]; omega
      _ = #R * (L ^ 6 * (k / L ^ 14)) := by rw [sum_const, nsmul_eq_mul]
      _ ≤ L ^ 6 * (L ^ 6 * (k / L ^ 14)) := by gcongr
      _ = L ^ 12 * (k / L ^ 14) := by ring
  have h6 : L ^ 12 * (k / L ^ 14) = k / L ^ 2 := by field_simp
  have h7 : k / L ^ 2 < 0.01 * k / L := by
    rw [div_lt_div_iff₀ (by positivity) (by linarith)]
    nlinarith [mul_pos (by linarith : (0 : ℝ) < k) (by linarith : 0 < L)]
  linarith

/-! ## 5. The weight -/

/-- The exponent in the weight `phi`. Irreducible, so that tactics do not unfold `10 ^ 6`. -/
@[irreducible] def b : ℕ := 10 ^ 6

/-- The value of `b`. -/
lemma b_eq : b = 10 ^ 6 := by rw [b]

/-- The weight of a number of level `x`; here `A = 1 + log k`. -/
noncomputable def phi (A x : ℝ) : ℝ := ((A - log x) / log x) ^ b * (A / (x * log x ^ 2))

/-- An antiderivative of `-phi`. -/
noncomputable def Phi (A x : ℝ) : ℝ := ((A - log x) / log x) ^ (b + 1) / (b + 1)

/-- The threshold of `l`: the smallest size of a prime that may cover a number of level `l`. -/
noncomputable def thr (A : ℝ) (l : ℕ) : ℝ := l * max 1.01 (log l * (A - log l) / (20 * A))

/-- The derivative of `Phi`. -/
lemma hasDerivAt_Phi {A x : ℝ} (hx : 1 < x) :
    HasDerivAt (Phi A) (-phi A x) x := by
  have hx0 : x ≠ 0 := by linarith
  have hl : log x ≠ 0 := (Real.log_pos hx).ne'
  have h1 := Real.hasDerivAt_log hx0
  have h2 : HasDerivAt (Phi A) _ x :=
    (((h1.const_sub A).div h1 hl).pow (b + 1)).div_const ((b : ℝ) + 1)
  refine h2.congr_deriv ?_
  have hb : (b : ℝ) + 1 ≠ 0 := by positivity
  simp only [phi, Pi.div_apply, Nat.add_sub_cancel]
  push_cast
  field_simp
  ring

section
variable {A x y : ℝ}

/-- The base `(A - log x) / log x` of the power in `phi` is nonnegative and decreasing. -/
lemma ratio_anti (hx : 1 < x) (hxy : x ≤ y) (hy : log y ≤ A) :
    0 ≤ (A - log y) / log y ∧ (A - log y) / log y ≤ (A - log x) / log x := by
  have hlx : 0 < log x := Real.log_pos hx
  have hly : log x ≤ log y := Real.log_le_log (by linarith) hxy
  exact ⟨div_nonneg (by linarith) (by linarith),
    div_le_div₀ (by linarith) (by linarith) hlx hly⟩

/-- `phi` is nonnegative. -/
lemma phi_nonneg (hx : 1 < x) (hA : log x ≤ A) : 0 ≤ phi A x := by
  have hlx : 0 < log x := Real.log_pos hx
  have := (ratio_anti hx le_rfl hA).1
  have : 0 ≤ A := by linarith
  rw [phi]
  positivity

/-- Comparison of `phi` at two places. -/
lemma phi_le {c t : ℝ} (hx : 1 < x) (hc : 1 ≤ c) (hxy : x * c ≤ y) (hy : log y ≤ A)
    (ht : (A - log y) / log y ≤ (A - log x) / log x * t) : phi A y ≤ phi A x * t ^ b / c := by
  have hxy' : x ≤ y := by nlinarith
  have hlx : 0 < log x := Real.log_pos hx
  have hly : log x ≤ log y := Real.log_le_log (by linarith) hxy'
  have h1 := (ratio_anti hx hxy' hy).1
  have hA : 0 ≤ A := by linarith
  have hx0 : 0 < x := by linarith
  have hy0 : 0 < y := by linarith
  calc phi A y ≤ ((A - log x) / log x * t) ^ b * (A / (x * c * log x ^ 2)) := by
        rw [phi]
        have := pow_nonneg (h1.trans ht) b
        gcongr
    _ = phi A x * t ^ b / c := by rw [phi, mul_pow]; field_simp

/-- `phi` is decreasing. -/
lemma phi_anti (hx : 1 < x) (hxy : x ≤ y) (hy : log y ≤ A) : phi A y ≤ phi A x := by
  simpa using phi_le (t := 1) hx le_rfl (by simpa using hxy) hy
    (by simpa using (ratio_anti hx hxy hy).2)

/-- Comparison of `phi` with the decrease of `Phi`. -/
lemma mul_phi_le (hx : 1 < x) (hxy : x < y) (hy : log y ≤ A) :
    (y - x) * phi A y ≤ Phi A x - Phi A y := by
  obtain ⟨z, hz, hz2⟩ := exists_hasDerivAt_eq_slope (Phi A) (fun t => -phi A t) hxy
    (fun t ht => (hasDerivAt_Phi (by linarith [ht.1])).continuousAt.continuousWithinAt)
    (fun t ht => hasDerivAt_Phi (by linarith [ht.1]))
  have h := phi_anti (by linarith [hz.1] : 1 < z) hz.2.le hy
  rw [eq_div_iff (by linarith)] at hz2
  nlinarith [hz.1]

end

/-- Summation over multiples of `p`. -/
lemma sum_phi_le {A : ℝ} {p M : ℕ} (hp : 2 ≤ p) (hM0 : 1 ≤ M)
    (hM : log ((M * p : ℕ) : ℝ) ≤ A) :
    ∑ m ∈ Icc 1 M, phi A (m * p : ℕ) ≤ phi A p + Phi A p / p := by
  have hp0 : (1 : ℝ) < p := by exact_mod_cast hp
  have key : ∀ M : ℕ, 1 ≤ M → log ((M * p : ℕ) : ℝ) ≤ A →
      p * ∑ m ∈ Icc 1 M, phi A (m * p : ℕ) ≤ p * phi A p + Phi A p - Phi A (M * p : ℕ) := by
    intro M hM
    induction M, hM using Nat.le_induction with
    | base => intro _; simp
    | succ M hM ih =>
      intro hA
      have h1 : (1 : ℝ) < (M * p : ℕ) := by exact_mod_cast (by nlinarith : 1 < M * p)
      have h2 : ((M * p : ℕ) : ℝ) < ((M + 1) * p : ℕ) :=
        Nat.cast_lt.2 (by nlinarith : M * p < (M + 1) * p)
      have h3 := mul_phi_le h1 h2 hA
      have h4 := ih ((Real.log_le_log (by linarith) h2.le).trans hA)
      rw [sum_Icc_succ_top (by omega), mul_add]
      have h5 : (((M + 1) * p : ℕ) : ℝ) - ((M * p : ℕ) : ℝ) = p := by push_cast; ring
      rw [h5] at h3
      linarith
  have h1 := key M hM0 hM
  have h2 : 0 ≤ Phi A (M * p : ℕ) := by
    have h3 : (1 : ℝ) < (M * p : ℕ) := by exact_mod_cast (by nlinarith : 1 < M * p)
    have := (ratio_anti h3 le_rfl hM).1
    rw [Phi]; positivity
  rw [← mul_le_mul_iff_right₀ (by linarith : (0 : ℝ) < p), mul_add, mul_div_cancel₀ _ (by linarith)]
  linarith

/-- The weight drops by a factor 8 between `l` and the threshold of `l`. -/
lemma phi_le_eighth {A l p : ℝ} (hl1 : 1 < l) (hl : 320 ≤ log l)
    (hp1 : l * 1.01 ≤ p) (hp2 : l * (log l * (A - log l) / (20 * A)) ≤ p) (hpA : log p ≤ A)
    (hlA : log l + 1 ≤ A) : phi A p ≤ phi A l / 8 := by
  set v := log l with hv
  have hlp : l ≤ p := by linarith
  have hA : 0 < A := by linarith
  have hw := ratio_anti hl1 hlp hpA
  rcases le_or_gt (160 * A) (v * (A - v)) with h | h
  · have h8 : l * 8 ≤ p := by
      refine le_trans (mul_le_mul_of_nonneg_left ?_ (by linarith)) hp2
      rw [le_div_iff₀ (by positivity)]
      linarith
    simpa using phi_le (t := 1) hl1 (by norm_num) h8 hpA (by simpa using hw.2)
  · -- now `A - v < 320`
    have e1 : A - v < 320 := by
      by_contra hcon
      nlinarith
    have e2 : v + 1 / 101 ≤ log p := by
      have h1 := Real.one_sub_inv_le_log_of_pos (x := (1.01 : ℝ)) (by norm_num)
      have h2 := Real.log_le_log (by positivity) hp1
      rw [Real.log_mul (by positivity) (by norm_num)] at h2
      norm_num at h1
      linarith
    have e3 : (A - log p) / log p ≤ (A - v) / v * (1 - 1 / 33000) := by
      rw [div_mul_eq_mul_div, div_le_div_iff₀ (by linarith) (by linarith)]
      have : A - log p ≤ (A - v) * (1 - 1 / 33000) := by linarith
      exact mul_le_mul this (by linarith) (by linarith) (mul_nonneg (by linarith) (by norm_num))
    have e4 : (1 - 1 / 33000 : ℝ) ^ b ≤ 1 / 8 := by
      have hb : (b : ℝ) = 10 ^ 6 := by rw [b_eq]; norm_num
      calc (1 - 1 / 33000 : ℝ) ^ b ≤ Real.exp (-(1 / 33000)) ^ b :=
            pow_le_pow_left₀ (by norm_num) (by linarith [Real.add_one_le_exp (-(1 / 33000 : ℝ))]) b
        _ = Real.exp (-(b / 33000)) := by rw [← Real.exp_nat_mul]; congr 1; ring
        _ ≤ 1 / 8 := by
          rw [Real.exp_neg, one_div]
          exact inv_anti₀ (by norm_num) (by linarith [Real.add_one_le_exp ((b : ℝ) / 33000)])
    have e5 := phi_le (c := 1) hl1 le_rfl (by linarith) hpA e3
    have e6 := phi_nonneg hl1 (by linarith : log l ≤ A)
    nlinarith

/-- Numbers with positive logarithm exceed 1. -/
lemma one_lt_of_log {l : ℕ} (h : 1 ≤ log l) : (1 : ℝ) < l :=
  (Real.log_pos_iff (Nat.cast_nonneg l)).1 (by linarith)

/-- **Lemma 6** (weight). If `p` is at least the threshold of `l`, the weights of the multiples of
`p` are together at most a quarter of the weight of `l`. -/
theorem weight {k l p : ℕ} (hl : 320 ≤ log l) (hlk : l ≤ k)
    (hpl : thr (1 + log k) l ≤ p) (hpk : p ≤ k) :
    4 * ∑ m ∈ Icc 1 (k / p), phi (1 + log k) (m * p : ℕ) ≤ phi (1 + log k) l := by
  set A := 1 + log (k : ℝ) with hA
  set v := log (l : ℝ) with hv
  have hl1 : (1 : ℝ) < l := one_lt_of_log (by linarith)
  have hl0 : (0 : ℝ) < l := by linarith
  have hvA : v + 1 ≤ A := by
    have := Real.log_le_log hl0 (Nat.cast_le.2 hlk)
    linarith
  have hp1 : l * 1.01 ≤ (p : ℝ) := le_trans (mul_le_mul_of_nonneg_left (le_max_left _ _) hl0.le) hpl
  have hp2 : l * (v * (A - v) / (20 * A)) ≤ p :=
    le_trans (mul_le_mul_of_nonneg_left (le_max_right _ _) hl0.le) hpl
  have hp0 : (0 : ℝ) < p := by linarith
  have hp2' : 2 ≤ p := by
    have : (1 : ℝ) < p := by linarith
    exact_mod_cast this
  have hpA : log p ≤ A - 1 := by
    have := Real.log_le_log hp0 (Nat.cast_le.2 hpk)
    linarith
  have hsum := sum_phi_le (A := A) hp2' (Nat.div_pos hpk (by omega)) (by
    have h1 : (((k / p) * p : ℕ) : ℝ) ≤ k := Nat.cast_le.2 (Nat.div_mul_le_self k p)
    have h2 : 0 < k / p * p := Nat.mul_pos (Nat.div_pos hpk (by omega)) (by omega)
    have := Real.log_le_log (by exact_mod_cast h2) h1
    linarith)
  have hphi : 0 ≤ phi A l := phi_nonneg hl1 (by linarith)
  -- the integral term
  have h1 : Phi A p / p ≤ phi A l / 8 := by
    have e1 : Phi A p ≤ Phi A l := by
      obtain ⟨h1, h2⟩ := ratio_anti (A := A) hl1 (by linarith : (l : ℝ) ≤ p) (by linarith)
      rw [Phi, Phi]; gcongr
    have e2 : Phi A l = phi A l * (l * (v * (A - v) / A)) / (b + 1) := by
      have : A ≠ 0 := by linarith
      have : v ≠ 0 := by linarith
      rw [Phi, phi, pow_succ, ← hv]
      field_simp
    have hb : (b : ℝ) = 10 ^ 6 := by rw [b_eq]; norm_num
    have e3 : l * (v * (A - v) / A) ≤ 20 * p := by
      have : l * (v * (A - v) / (20 * A)) = l * (v * (A - v) / A) / 20 := by field_simp
      linarith
    rw [div_le_iff₀ hp0]
    refine e1.trans ?_
    rw [e2, div_le_iff₀ (by positivity)]
    have e4 := mul_le_mul_of_nonneg_left e3 hphi
    have e5 : 0 ≤ phi A l * p := by positivity
    nlinarith
  -- the first term
  have h2 : phi A p ≤ phi A l / 8 := phi_le_eighth hl1 hl hp1 hp2 (by linarith) hvA
  linarith

/-! ## 6. Supply of fresh primes -/

/-- The primes `p ≥ y` that divide some even `k - i` with `i = k % p < l`. -/
noncomputable def supply (k l : ℕ) (y : ℝ) : Finset ℕ :=
  {p ∈ range (k + 1) | p.Prime ∧ y ≤ p ∧ k % p < l ∧ 2 ∣ k - k % p}

/-- The number of `i < l` for which `k - i` is even. -/
def half (k l : ℕ) : ℕ := (l + 1 - k % 2) / 2

/-- Large prime divisors of `⌊k/2⌋ - i`, `i < half k l`, belong to the supply. -/
lemma mem_supply {k l p i : ℕ} {y : ℝ} (hp : p.Prime) (hy : y ≤ p) (hl : l ≤ p) (hi : i < half k l)
    (hlk : l ≤ k) (hd : p ∣ k / 2 - i) : p ∈ supply k l y := by
  rw [half] at hi
  have hle : p ≤ k / 2 - i := Nat.le_of_dvd (by omega) hd
  obtain ⟨c, hc⟩ := hd
  have hk : k = p * (2 * c) + (2 * i + k % 2) := by rw [mul_left_comm, ← hc]; omega
  have hmod : k % p = 2 * i + k % 2 := by
    conv_lhs => rw [hk, Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (by omega)
  rw [supply, mem_filter, mem_range, hmod]
  exact ⟨by omega, hp, hy, by omega, ⟨k / 2 - i, by omega⟩⟩

/-- A lower bound for binomial coefficients. -/
lemma log_choose_ge {K h : ℕ} (hK : h ≤ K) (hh : 1 ≤ h) :
    h * (log ((K + 1 - h : ℕ) / h) + 1) - log h - 1 ≤ log (K.choose h) := by
  have h1 := Nat.pow_sub_le_descFactorial K h
  rw [Nat.descFactorial_eq_factorial_mul_choose] at h1
  have h0 : 0 < K.choose h := Nat.choose_pos hK
  have hpos : 0 < K + 1 - h := by omega
  have h2 : (((K + 1 - h : ℕ) : ℝ)) ^ h ≤ (h.factorial : ℝ) * (K.choose h : ℝ) := by
    exact_mod_cast h1
  have h3 := Real.log_le_log (by positivity) h2
  rw [Real.log_pow, Real.log_mul (by positivity) (by positivity)] at h3
  have h4 := log_factorial_le hh
  rw [Real.log_div (by positivity) (by positivity)]
  linarith

/-- The prime powers in `C(K, h)` are at most `K`, so it has many prime factors. -/
lemma log_choose_le {K h : ℕ} (hK : h ≤ K) (hK0 : 0 < K) :
    log (K.choose h) ≤ #(K.choose h).primeFactors * log K := by
  have h0 : K.choose h ≠ 0 := (Nat.choose_pos hK).ne'
  rw [← Real.log_pow]
  refine Real.log_le_log (by positivity) ?_
  have h1 : K.choose h ≤ K ^ #(K.choose h).primeFactors := by
    conv_lhs => rw [← Nat.prod_factorization_pow_eq_self h0]
    exact prod_le_pow_card _ _ _ fun p _ => Nat.pow_factorization_choose_le hK0
  exact_mod_cast h1

/-- The supply is bounded below by a binomial coefficient. -/
lemma log_choose_le_supply {k l : ℕ} {y : ℝ} (hly : l ≤ y) (hlk : l ≤ k) (hk : 2 ≤ k) :
    log ((k / 2).choose (half k l)) ≤ (#(supply k l y) + Nat.primeCounting ⌊y⌋₊) * log k := by
  have hle : half k l ≤ k / 2 := by rw [half]; omega
  refine (log_choose_le hle (by omega)).trans ?_
  have h1 : #((k / 2).choose (half k l)).primeFactors ≤
      #(supply k l y) + Nat.primeCounting ⌊y⌋₊ := by
    rw [← Nat.primesLE_card_eq_primeCounting]
    refine (card_le_card fun p hp => ?_).trans (card_union_le _ _)
    obtain ⟨hp1, hp2, -⟩ := Nat.mem_primeFactors.1 hp
    rw [mem_union, Nat.mem_primesLE]
    rcases le_or_gt y p with h | h
    · left
      have h2 : p ∣ (k / 2).descFactorial (half k l) := by
        rw [Nat.descFactorial_eq_factorial_mul_choose]; exact hp2.mul_left _
      rw [Nat.descFactorial_eq_prod_range, Prime.dvd_finsetProd_iff hp1.prime] at h2
      obtain ⟨i, hi, hd⟩ := h2
      exact mem_supply hp1 h (by exact_mod_cast hly.trans h) (mem_range.1 hi) hlk hd
    · exact Or.inr ⟨Nat.le_floor h.le, hp1⟩
  have h3 : log (k / 2 : ℕ) ≤ log k := Real.log_le_log (by exact_mod_cast (by omega : 0 < k / 2))
    (by exact_mod_cast Nat.div_le_self k 2)
  exact mul_le_mul (by exact_mod_cast h1) h3 (Real.log_natCast_nonneg _) (by positivity)

/-- `log (k / l) ≥ 1.6` if `k ≥ 5 l`. -/
lemma log_sub_log_ge {k l : ℕ} (hl : 0 < l) (hlk : 5 * l ≤ k) : 1.6 ≤ log k - log l := by
  have hl0 : (0 : ℝ) < l := by exact_mod_cast hl
  have hk0 : 5 * (l : ℝ) ≤ k := by exact_mod_cast hlk
  have h1 : 3 * log 5 = log (5 ^ 3 / 2 ^ 7) + 7 * log 2 := by
    rw [Real.log_div (by norm_num) (by norm_num), Real.log_pow, Real.log_pow]; push_cast; ring
  have h2 := Real.one_sub_inv_le_log_of_pos (x := (5 ^ 3 / 2 ^ 7 : ℝ)) (by norm_num)
  have h3 := Real.log_two_gt_d9
  have h4 : log 5 ≤ log k - log l := by
    rw [← Real.log_div (by linarith) hl0.ne']
    refine Real.log_le_log (by norm_num) ?_
    rwa [le_div_iff₀ hl0]
  norm_num at h1 h2 ⊢
  linarith

/-- A lower bound for the binomial coefficient in `log_choose_le_supply`. -/
lemma log_choose_half_ge {k l : ℕ} (hl : 100 ≤ l) (hlog : log l + 1 ≤ 0.01 * l) (hlk : 5 * l ≤ k) :
    0.49 * l * (1 + log k - log l - 0.24) ≤ log ((k / 2).choose (half k l)) := by
  set K := k / 2 with hK
  set h := half k l with hh
  have hl0 : (100 : ℝ) ≤ l := by exact_mod_cast hl
  have hh1 : l ≤ 2 * h + 1 := by rw [hh, half]; omega
  have hh2 : 2 * h ≤ l + 1 := by rw [hh, half]; omega
  have hh1' : (l : ℝ) ≤ 2 * h + 1 := by exact_mod_cast hh1
  have hh2' : 2 * (h : ℝ) ≤ l + 1 := by exact_mod_cast hh2
  have hh0 : (0 : ℝ) < h := by linarith
  have hlpos : (0 : ℝ) < l := by linarith
  have hk0 : 5 * (l : ℝ) ≤ k := by exact_mod_cast hlk
  have hkpos : (0 : ℝ) < k := by linarith
  have h1 := log_choose_ge (K := K) (h := h) (by omega) (by omega)
  have h2 : log k - log l - 0.24 ≤ log ((K + 1 - h : ℕ) / h) := by
    have e1 : (k : ℝ) / l * 0.79 ≤ (K + 1 - h : ℕ) / h := by
      have e2 : (k : ℝ) ≤ 2 * (K + 1 - h : ℕ) + l := by
        exact_mod_cast (by omega : k ≤ 2 * (K + 1 - h) + l)
      rw [div_mul_eq_mul_div, div_le_div_iff₀ hlpos hh0]
      nlinarith
    have e3 := Real.log_le_log (by positivity) e1
    rw [Real.log_mul (by positivity) (by norm_num), Real.log_div hkpos.ne' hlpos.ne'] at e3
    have e4 : 3 * log 0.79 = log (0.79 ^ 3 * 2) - log 2 := by
      rw [Real.log_mul (by norm_num) (by norm_num), Real.log_pow]; push_cast; ring
    have e5 := Real.one_sub_inv_le_log_of_pos (x := (0.79 ^ 3 * 2 : ℝ)) (by norm_num)
    have e6 := Real.log_two_lt_d9
    norm_num at e3 e4 e5 ⊢
    linarith
  have h3 : log h ≤ log l := Real.log_le_log hh0 (by exact_mod_cast (by omega : h ≤ l))
  have h4 := log_sub_log_ge (by omega) hlk
  set δ := 1 + log k - log l - 0.24 with hδ
  have h5 : h * δ ≤ h * (log ((K + 1 - h : ℕ) / h) + 1) := by gcongr; linarith
  nlinarith

/-- The lower bound of Lemma 7 for the size of the supply; `1 + log k` is called `A` in the text. -/
noncomputable def beta (k l : ℕ) : ℝ := l * (1 + log k - log l) / (10 ^ 4 * (1 + log k))

/-- The inequality behind Lemma 7: `s` is the size of the supply and `q` the number of primes below
the threshold. -/
lemma supply_arith {A v l s q : ℝ} (hl : 0 < l) (hv : 10 ^ 4 ≤ v) (hA : v + 2.6 ≤ A) (hs : 0 ≤ s)
    (hq : q * v ≤ 1.12 * (l * max 1.01 (v * (A - v) / (20 * A))))
    (h : 0.49 * l * (A - v - 0.24) ≤ (s + q) * (A - 1)) : l * (A - v) ≤ s * (10 ^ 4 * A) := by
  have hA0 : 0 < A := by linarith
  have h0 : 0 ≤ l * (A - v - 2.6) := mul_nonneg hl.le (by linarith)
  rcases le_total (v * (A - v) / (20 * A)) 1.01 with h1 | h1
  · -- close to `k`, where the threshold is `1.01 l`
    rw [max_eq_left h1] at hq
    rw [div_le_iff₀ (by linarith)] at h1
    have h2 : A - v ≤ 20.3 := by nlinarith
    have h3 : q * (A - 1) ≤ 1.135 * l := by nlinarith
    nlinarith
  · rw [max_eq_right h1] at hq
    have h2 : q * A ≤ 0.056 * l * (A - v) := by
      have e : 1.12 * (l * (v * (A - v) / (20 * A))) * A = 0.056 * l * (A - v) * v := by
        field_simp; ring
      have := mul_le_mul_of_nonneg_right hq hA0.le
      rw [e] at this
      nlinarith
    nlinarith

/-- **Lemma 7** (supply of fresh primes). -/
theorem supply_ge : ∃ L0 : ℕ, ∀ k l : ℕ, L0 ≤ l → 5 * l ≤ k →
    beta k l ≤ #(supply k l (thr (1 + log k) l)) := by
  obtain ⟨x0, hx0⟩ := eventually_atTop.1 primeCounting_le
  obtain ⟨L0, hL0⟩ := eventually_atTop.1
    (((eventually_ge_atTop (max x0 100)).natCast_atTop.and
      (eventually_log_le (ε := 0.01) (by norm_num) 1 1).natCast_atTop).and
      (tendsto_log_nat.eventually_ge_atTop (10 ^ 4)))
  refine ⟨L0, fun k l hl hlk => ?_⟩
  obtain ⟨⟨hl1, hl2⟩, hv⟩ := hL0 l hl
  have hl0 : (100 : ℝ) ≤ l := (le_max_right _ _).trans hl1
  have hl100 : 100 ≤ l := by exact_mod_cast hl0
  have hlpos : (0 : ℝ) < l := by linarith
  rw [one_mul] at hl2
  have h5 := log_sub_log_ge (by omega) hlk
  set y := thr (1 + log k) l with hy
  have hly : (l : ℝ) ≤ y := by
    rw [hy, thr]
    nlinarith [le_max_left 1.01 (log l * (1 + log k - log l) / (20 * (1 + log k)))]
  have h1 := (log_choose_half_ge hl100 hl2 hlk).trans
    (log_choose_le_supply hly (by omega) (by omega))
  have h2 : (Nat.primeCounting ⌊y⌋₊ : ℝ) * log l ≤ 1.12 * y := by
    rw [← le_div_iff₀ (by linarith)]
    refine (hx0 y (((le_max_left _ _).trans hl1).trans hly)).trans ?_
    have := Real.log_le_log hlpos hly
    gcongr
    linarith
  rw [beta, div_le_iff₀ (by linarith)]
  exact supply_arith hlpos hv (by linarith) (Nat.cast_nonneg _) h2 (by linarith)

/-- **Lemma 8** (supply at bounded levels). From Størmer's theorem: one of two neighbouring numbers
`⌊k/2⌋ - i` has a prime factor larger than `J`. -/
theorem supply_bounded (J : ℕ) : ∃ k0 : ℕ, ∀ k l : ℕ, k0 ≤ k → l ≤ J →
    half k l / 2 ≤ #(supply k l J) := by
  obtain ⟨m0, hm0⟩ := stormer J
  refine ⟨2 * (m0 + J) + 10, fun k l hk hl => ?_⟩
  have hex : ∀ i ∈ range (half k l / 2), ∃ p e, p.Prime ∧ J < p ∧ e < 2 ∧
      p ∣ k / 2 - (2 * i + e) := by
    intro i hi
    rw [mem_range, half] at hi
    obtain ⟨p, hp, hJ, h⟩ := hm0 (k / 2 - (2 * i + 1)) (by omega)
    rcases (Nat.Prime.dvd_mul hp).1 h with h | h
    · exact ⟨p, 1, hp, hJ, by norm_num, h⟩
    · refine ⟨p, 0, hp, hJ, by norm_num, ?_⟩
      rwa [show k / 2 - (2 * i + 0) = k / 2 - (2 * i + 1) + 1 by omega]
  choose! f e hf using hex
  have hlt : ∀ i ∈ range (half k l / 2), 2 * i + e i < half k l := by
    intro i hi
    have := (hf i hi).2.2.1
    rw [mem_range] at hi
    omega
  have hinj : Set.InjOn f (range (half k l / 2) : Set ℕ) := by
    intro i hi j hj hij
    obtain ⟨-, hJ, he, hd⟩ := hf i hi
    obtain ⟨-, -, he', hd'⟩ := hf j hj
    have h1 := hlt i hi
    have h2 := hlt j hj
    rw [half] at h1 h2
    rw [← hij] at hd'
    have h3 : (2 * i + e i : ℕ) ≡ 2 * j + e j [MOD f i] := by
      have h4 := (Nat.modEq_zero_iff_dvd.2 hd).trans (Nat.modEq_zero_iff_dvd.2 hd').symm
      have h5 := (h4.add_right (2 * i + e i)).add_right (2 * j + e j)
      rw [Nat.sub_add_cancel (by omega), add_right_comm, Nat.sub_add_cancel (by omega)] at h5
      exact (Nat.ModEq.add_left_cancel' _ h5).symm
    have := Nat.ModEq.eq_of_lt_of_lt h3 (by omega) (by omega)
    omega
  rw [← card_range (half k l / 2), ← card_image_of_injOn hinj]
  refine card_le_card fun p hp => ?_
  obtain ⟨i, hi, rfl⟩ := mem_image.1 hp
  obtain ⟨hp, hJ, he, hd⟩ := hf i hi
  have := hlt i hi
  exact mem_supply hp (by exact_mod_cast hJ.le) (by omega) this (by rw [half] at this; omega) hd

/-! ## 7. Standing assumptions and states -/

/-- Levels below `X = u ^ M`, where `log k = u ^ 8`, are called small. Irreducible, as `b`. -/
@[irreducible] def M : ℕ := 16 * b + 150

/-- The value of `M`. -/
lemma M_eq : M = 16 * b + 150 := by rw [M]

/-- The exponent in the Rankin sums; `X ^ σ = u`. -/
noncomputable def σ : ℝ := (M : ℝ)⁻¹

/-- The bound for the Rankin sums. -/
noncomputable def S : ℝ := 2 / (1 - 3 ^ (-σ)) + 3

/-- `M` is positive. -/
lemma M_pos : 0 < M := by rw [M_eq]; omega

/-- `σ` is positive. -/
lemma σ_pos : 0 < σ := inv_pos.2 (by exact_mod_cast M_pos)

/-- `σ` inverts the exponent `M`. -/
lemma pow_rpow_σ {x : ℝ} (hx : 0 ≤ x) : (x ^ M) ^ σ = x := Real.pow_rpow_inv_natCast hx M_pos.ne'

/-- The denominator in `S` is positive. -/
lemma three_rpow_lt : (3 : ℝ) ^ (-σ) < 1 :=
  Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith [σ_pos])

/-- `S` is at least 3. -/
lemma three_le_S : 3 ≤ S := by
  have : 0 ≤ 1 - (3 : ℝ) ^ (-σ) := by linarith [three_rpow_lt]
  rw [S]
  linarith [div_nonneg zero_le_two this]

/-- `S` is positive. -/
lemma S_pos : 0 < S := by linarith [three_le_S]

/-- The constant `L0`. -/
lemma exists_L0 : ∃ L0 : ℕ, 10 ≤ L0 ∧ 40 * (4 * S) ^ M ≤ log L0 ∧
    (∀ l : ℕ, L0 ≤ l → S * l ^ σ + 1 < l / (2 * 10 ^ 4)) ∧ ∀ k l : ℕ, L0 ≤ l → 5 * l ≤ k →
    beta k l ≤ #(supply k l (thr (1 + log k) l)) := by
  obtain ⟨L1, hL1⟩ := supply_ge
  have hσ : σ < 1 :=
    inv_lt_one_of_one_lt₀ (by rw [M_eq]; exact_mod_cast (by omega : 1 < 16 * b + 150))
  have h1 : ∀ᶠ x : ℝ in atTop, S * x ^ σ + 1 < x / (2 * 10 ^ 4) := by
    filter_upwards [(tendsto_rpow_atTop (by linarith : 0 < 1 - σ)).eventually_ge_atTop
      (4 * 10 ^ 4 * (S + 1)), eventually_ge_atTop 1] with x hx h0
    have h2 : 1 ≤ x ^ σ := Real.one_le_rpow h0 σ_pos.le
    have h3 : x = x ^ σ * x ^ (1 - σ) := by rw [← Real.rpow_add (by linarith)]; simp
    have h4 : x ^ σ * (4 * 10 ^ 4 * (S + 1)) ≤ x := by
      conv_rhs => rw [h3]
      gcongr
    rw [lt_div_iff₀ (by norm_num)]
    nlinarith [S_pos]
  obtain ⟨L2, hL2⟩ := eventually_atTop.1 (h1.natCast_atTop.and
    (tendsto_log_nat.eventually_ge_atTop (40 * (4 * S) ^ M)))
  refine ⟨max (max L1 L2) 10, le_max_right _ _, (hL2 _ ?_).2, fun l hl => (hL2 l ?_).1,
    fun k l hl => hL1 k l ?_⟩ <;> omega

/-- The prime factors `q` and `q'` of a number that is not a prime power. -/
lemma exists_prime_factors {k : ℕ} (hk : 2 ≤ k) (hpp : ¬ IsPrimePow k) : ∃ q q' : ℕ,
    q.Prime ∧ q'.Prime ∧ q ∣ k ∧ q' ∣ k ∧ q' < q ∧ (2 ∣ k → q' = 2) ∧
    ∀ r, r.Prime → r ∣ k → r ≤ q := by
  have hne : k.primeFactors.Nonempty := Nat.nonempty_primeFactors.2 (by omega)
  set q := k.primeFactors.max' hne with hq
  have hqm := k.primeFactors.max'_mem hne
  have hmax : ∀ r, r.Prime → r ∣ k → r ≤ q := fun r hr hrk =>
    le_max' _ _ (Nat.mem_primeFactors.2 ⟨hr, hrk, by omega⟩)
  obtain ⟨q', hq'm, hne'⟩ : ∃ q' ∈ k.primeFactors, q' ≠ q := by
    by_contra hcon
    push Not at hcon
    refine hpp (isPrimePow_iff_card_primeFactors_eq_one.2 (card_eq_one.2 ⟨q, ?_⟩))
    exact eq_singleton_iff_unique_mem.2 ⟨hqm, hcon⟩
  rw [← hq, Nat.mem_primeFactors] at hqm
  obtain ⟨hq'p, hq'k, -⟩ := Nat.mem_primeFactors.1 hq'm
  have hlt : q' < q := lt_of_le_of_ne (hmax q' hq'p hq'k) hne'
  by_cases h2 : 2 ∣ k
  · exact ⟨q, 2, hqm.1, Nat.prime_two, hqm.2.1, h2, hq'p.two_le.trans_lt hlt, fun _ => rfl, hmax⟩
  · exact ⟨q, q', hqm.1, hq'p, hqm.2.1, hq'k, hlt, fun h => absurd h h2, hmax⟩

/-- The standing assumptions and notation, for one large `k` that is not a prime power. -/
structure Setting where
  /-- `q' < q` are prime factors of `k`, and `c0` is a class modulo the auxiliary prime `p0` -/
  (k q q' p0 c0 : ℕ)
  /-- levels below `L0` are called bounded; they are covered by primes of size at least `J` -/
  (L0 J : ℕ)
  /-- `log k = u ^ 8` -/
  u : ℝ
  /-- the prime factors `q` and `q'` of `k` -/
  q_prime : q.Prime
  q'_prime : q'.Prime
  q_dvd : q ∣ k
  q'_dvd : q' ∣ k
  q'_lt : q' < q
  q'_two : 2 ∣ k → q' = 2
  q_max : ∀ r, r.Prime → r ∣ k → r ≤ q
  /-- the auxiliary prime (Lemma 5) -/
  p0_prime : p0.Prime
  p0_le : p0 ≤ k
  lt_c0 : k % p0 < c0
  c0_lt : c0 < p0
  u_le : u ≤ (k % p0 : ℕ)
  freed : k / u ^ 112 ≤ #{P ∈ Ioc (k - k / 5) k | P.Prime ∧ P % p0 = c0}
  /-- the absolute constants `L0` and `J` -/
  ten_le : 10 ≤ L0
  log_L0 : 40 * (4 * S) ^ M ≤ log L0
  count_lt : ∀ l : ℕ, L0 ≤ l → S * l ^ σ + 1 < l / (2 * 10 ^ 4)
  J_ge : (4 * S) ^ M * L0 ≤ J
  /-- supply of fresh primes (Lemmas 7 and 8) and Størmer's theorem (Lemma 2) -/
  supply_big : ∀ l, L0 ≤ l → 5 * l ≤ k → beta k l ≤ #(supply k l (thr (1 + log k) l))
  supply_small : ∀ l, l ≤ J → half k l / 2 ≤ #(supply k l J)
  stormer : ∀ m, k ≤ L0 * (m + 1) → ∃ p, p.Prime ∧ J < p ∧ p ∣ m * (m + 1)
  /-- `u` is large -/
  log_k : log k = u ^ 8
  L0_le_u : L0 ≤ u
  S_le : S + 2 ≤ u
  four_pow_le : 4 ^ M ≤ u
  two_pow_le : 2 ^ (2 * b + 4) ≤ u
  le_exp : 2 * u ^ 8 + 1 ≤ Real.exp u
  pow_le_exp : u ^ M ≤ Real.exp u

/-- For every large `k` that is not a prime power the standing assumptions can be satisfied. -/
theorem exists_setting : ∀ᶠ k : ℕ in atTop, ¬ IsPrimePow k → ∃ D : Setting, D.k = k := by
  obtain ⟨L0, hL0, hlog, hcount, hbig⟩ := exists_L0
  set J := ⌈(4 * S) ^ M * L0⌉₊ with hJ
  obtain ⟨m0, hm0⟩ := stormer J
  obtain ⟨k0, hk0⟩ := supply_bounded J
  set f : ℕ → ℝ := fun k => log k ^ ((8 : ℕ) : ℝ)⁻¹ with hf
  have hu : Tendsto f atTop atTop :=
    (tendsto_rpow_atTop (by norm_num)).comp tendsto_log_nat
  have hu8 : ∀ k : ℕ, f k ^ 8 = log k := fun k =>
    Real.rpow_inv_natCast_pow (Real.log_natCast_nonneg k) (by norm_num)
  filter_upwards [exists_aux, hu.eventually_ge_atTop (2 ^ (2 * b + 4)),
    hu.eventually_ge_atTop (S + 2), hu.eventually_ge_atTop L0,
    hu.eventually (eventually_pow_le_exp 3 8), hu.eventually (eventually_pow_le_exp 1 M),
    hu.eventually_ge_atTop (4 ^ M), eventually_ge_atTop (k0 + L0 * (m0 + 1) + 2)] with
    k ⟨p0, c0, h1, h2, h3, h4, h5, h6⟩ a1 a2 a3 a4 a5 a6 a7 hpp
  obtain ⟨q, q', b1, b2, b3, b4, b5, b6, b7⟩ := exists_prime_factors (by omega) hpp
  have hu1 : 1 ≤ f k := by linarith [S_pos]
  refine ⟨{ k := k, q := q, q' := q', p0 := p0, c0 := c0, L0 := L0, J := J, u := f k
            q_prime := b1, q'_prime := b2, q_dvd := b3, q'_dvd := b4, q'_lt := b5, q'_two := b6
            q_max := b7, p0_prime := h1, p0_le := h2, lt_c0 := h4, c0_lt := h5
            u_le := ?_
            freed := ?_
            ten_le := hL0, log_L0 := hlog, count_lt := hcount
            J_ge := Nat.le_ceil _
            supply_big := hbig k
            supply_small := fun l hl => hk0 k l (by omega) hl
            stormer := fun m hm => hm0 m ?_
            log_k := (hu8 k).symm, L0_le_u := a3, S_le := a2, four_pow_le := a6, two_pow_le := a1
            le_exp := ?_
            pow_le_exp := by simpa using a5 }, rfl⟩
  · refine le_trans ?_ h3
    rw [← hu8 k, ← pow_mul]
    exact le_self_pow₀ hu1 (by norm_num)
  · rwa [← hu8 k, ← pow_mul] at h6
  · by_contra hlt
    have : L0 * (m + 1) ≤ L0 * (m0 + 1) := Nat.mul_le_mul_left _ (by omega)
    omega
  · linarith [one_le_pow₀ (n := 8) hu1]

/-- The level of `n`, where `1 ≤ n < k`. -/
def lv (k n : ℕ) : ℕ := min n (k - n)

/-- **Lemma 9 (b)**, general form: if `p` divides the odd number `n` and the number `k - k % p` is
even, then the level of `n` is at least `p`. -/
lemma le_lv {k p n : ℕ} (hk : 2 ∣ k - k % p) (hn0 : 0 < n) (hnk : n < k) (hn : ¬ 2 ∣ n)
    (hd : p ∣ n) : p ≤ lv k n := by
  refine le_min (Nat.le_of_dvd hn0 hd) ?_
  by_contra hlt
  have h1 : k % p = k - n := by
    obtain ⟨c, rfl⟩ := hd
    conv_lhs => rw [show k = p * c + (k - p * c) by omega, Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (by omega)
  rw [h1, Nat.sub_sub_self hnk.le] at hk
  exact hn hk

/-- **Lemma 9 (c)**: the residue of `n` modulo `p` is admissible if `k % p < lv k n < p`. -/
lemma mod_lt_mod {k p n : ℕ} (hnk : n ≤ k) (h1 : k % p < lv k n) (h2 : lv k n < p) :
    k % p < n % p := by
  rw [lv] at h1 h2
  rcases le_total n (k - n) with h | h
  · rw [min_eq_left h] at h1 h2
    rwa [Nat.mod_eq_of_lt h2]
  · rw [min_eq_right h] at h1 h2
    have h3 : (n % p + (k - n)) % p = k % p := by rw [Nat.mod_add_mod, Nat.add_sub_cancel' hnk]
    have h4 := Nat.mod_lt n (by omega : 0 < p)
    rcases lt_or_ge (n % p + (k - n)) p with h5 | h5
    · rw [Nat.mod_eq_of_lt h5] at h3
      omega
    · rw [Nat.mod_eq_sub_mod h5, Nat.mod_eq_of_lt (by omega)] at h3
      omega

namespace Setting
variable (D : Setting)

/-- `A = 1 + log k`. -/
noncomputable def A : ℝ := 1 + log D.k

/-- Levels below `X` are small levels. -/
noncomputable def X : ℝ := D.u ^ M

/-- A number of level `l` may be covered by primes of size at least `gam l`. -/
noncomputable def gam (l : ℕ) : ℝ := if l < D.L0 then D.J else thr D.A l

/-- The set of all moved primes. -/
def moved (T : Finset ℕ) : Finset ℕ := insert D.q (insert D.p0 T)

/-- The smooth numbers: those in `[2, k)` composed of moved primes. -/
def smooth (T : Finset ℕ) : Finset ℕ := {n ∈ Ico 2 D.k | n.primeFactors ⊆ D.moved T}

/-- The smooth numbers that are not in the classes `1` modulo `q`, `c0` modulo `p0` and `d p`
modulo `p`, where `p ∈ T`. -/
def uncovered (T : Finset ℕ) (d : ℕ → ℕ) : Finset ℕ :=
  {n ∈ D.smooth T | n % D.q ≠ 1 ∧ n % D.p0 ≠ D.c0 ∧ ∀ p ∈ T, n % p ≠ d p % p}

/-- A state: a set `T` of primes, where `p ∈ T` has been moved in order to cover `d p`. The fields
are the conditions (S1), (S1), (S2), (S3), (S4) of the text. -/
structure State (T : Finset ℕ) (d : ℕ → ℕ) : Prop where
  smooth : ∀ p ∈ T, d p ∈ D.smooth T
  inj : Set.InjOn d T
  fresh : ∀ p ∈ T, p ∈ supply D.k (lv D.k (d p)) (D.gam (lv D.k (d p))) ∧ p ≠ D.q ∧ p ≠ D.p0
  order : ∀ n ∈ D.uncovered T d, ∀ p ∈ T, lv D.k (d p) ≤ lv D.k n
  sum : ∑ p ∈ T with lv D.k (d p) < D.X, (lv D.k (d p) : ℝ) ^ (-σ) ≤ S

variable {D} {T : Finset ℕ} {d : ℕ → ℕ}

/-- Membership in the set of moved primes. -/
lemma mem_moved {r : ℕ} : r ∈ D.moved T ↔ r = D.q ∨ r = D.p0 ∨ r ∈ T := by
  simp [moved]

/-- The set of moved primes grows with `T`. -/
lemma moved_mono {T' : Finset ℕ} (h : T ⊆ T') : D.moved T ⊆ D.moved T' :=
  insert_subset_insert _ (insert_subset_insert _ h)

/-- Membership in the set of smooth numbers. -/
lemma mem_smooth {n : ℕ} : n ∈ D.smooth T ↔ (2 ≤ n ∧ n < D.k) ∧ n.primeFactors ⊆ D.moved T := by
  simp [Setting.smooth]

/-- Prime factors of smooth numbers are moved primes. -/
lemma mem_moved_of_dvd {n r : ℕ} (hn : n ∈ D.smooth T) (hr : r.Prime) (h : r ∣ n) :
    r ∈ D.moved T := by
  obtain ⟨⟨h1, -⟩, h2⟩ := mem_smooth.1 hn
  exact h2 (Nat.mem_primeFactors.2 ⟨hr, h, by omega⟩)

/-- The levels of smooth numbers are positive. -/
lemma lv_pos {n : ℕ} (hn : n ∈ D.smooth T) : 1 ≤ lv D.k n := by
  obtain ⟨⟨h1, h2⟩, -⟩ := mem_smooth.1 hn
  rw [lv]; omega

/-- Levels are at most `k`. -/
lemma lv_le (n : ℕ) : lv D.k n ≤ D.k := (min_le_right _ _).trans (Nat.sub_le _ _)

/-- `k` is positive. -/
lemma k_pos : 0 < D.k := D.p0_prime.pos.trans_le D.p0_le

/-- `k % p0` is at least `L0`. -/
lemma L0_le : D.L0 ≤ D.k % D.p0 := by exact_mod_cast D.L0_le_u.trans D.u_le

/-- `J` is at least `L0`. -/
lemma L0_le_J : D.L0 ≤ D.J := by
  have h1 : 1 ≤ (4 * S) ^ M := one_le_pow₀ (by linarith [three_le_S])
  exact_mod_cast (le_mul_of_one_le_left (Nat.cast_nonneg _) h1).trans D.J_ge

/-- `p0` does not divide `k`, so it differs from `q`. -/
lemma q_ne_p0 : D.q ≠ D.p0 := fun h => by
  have h1 := D.L0_le
  have h2 := D.ten_le
  rw [← h, Nat.mod_eq_zero_of_dvd D.q_dvd] at h1
  omega

/-- Assertion (3): the thresholds exceed the levels, and they are at least `L0`. -/
lemma lt_gam {l : ℕ} (hl : 1 ≤ l) : (l : ℝ) < D.gam l ∧ (D.L0 : ℝ) ≤ D.gam l := by
  have hl0 : (1 : ℝ) ≤ l := by exact_mod_cast hl
  rw [gam]
  split_ifs with h
  · exact ⟨by exact_mod_cast h.trans_le D.L0_le_J, by exact_mod_cast D.L0_le_J⟩
  · have h1 : (l : ℝ) < thr D.A l := by
      rw [thr]
      nlinarith [le_max_left 1.01 (log l * (D.A - log l) / (20 * D.A))]
    exact ⟨h1, (Nat.cast_le.2 (not_lt.1 h)).trans h1.le⟩

/-- A crude lower bound for `u`. -/
lemma ten_le_u : 10 ≤ D.u := (by exact_mod_cast D.ten_le : (10 : ℝ) ≤ D.L0).trans D.L0_le_u

/-- `X` is positive. -/
lemma X_pos : 0 < D.X := pow_pos (by linarith [D.ten_le_u]) _

/-- Assertion (3), last part: at large levels `gam` is the threshold. -/
lemma gam_eq {l : ℕ} (hl : D.X ≤ l) : D.gam l = thr D.A l := by
  have h1 : (D.L0 : ℝ) ≤ l :=
    D.L0_le_u.trans ((le_self_pow₀ (by linarith [D.ten_le_u]) M_pos.ne').trans hl)
  rw [gam, if_neg (not_lt.2 (by exact_mod_cast h1))]

/-- `X ^ σ = u`. -/
lemma X_rpow : D.X ^ σ = D.u := pow_rpow_σ (by linarith [D.ten_le_u])

/-- Bounds for `A = 1 + u ^ 8`. -/
lemma A_bounds : 1 ≤ D.A ∧ D.A ≤ 2 * D.u ^ 8 := by
  have : 1 ≤ D.u ^ 8 := one_le_pow₀ (by linarith [D.ten_le_u])
  rw [A, D.log_k]
  constructor <;> linarith

/-- `A` is positive. -/
lemma A_pos : 0 < D.A := by linarith [D.A_bounds.1]

/-- Small levels are much smaller than `k`. -/
lemma log_le_of_lt_X {l : ℕ} (hl : 1 ≤ l) (hlX : l < D.X) : 2 * log l ≤ D.A := by
  have h1 : log l ≤ D.u := by
    rw [Real.log_le_iff_le_exp (by positivity)]
    exact hlX.le.trans D.pow_le_exp
  have h2 : D.u ^ 2 ≤ D.u ^ 8 := pow_le_pow_right₀ (by linarith [D.ten_le_u]) (by norm_num)
  rw [A, D.log_k]
  nlinarith [D.ten_le_u]

/-- Assertion (4): primes that cover a number of small level `l` are much larger than `l`. -/
lemma gam_ge {l : ℕ} (hl : 1 ≤ l) (hlX : l < D.X) : (4 * S) ^ M * l ≤ D.gam l := by
  have hS := S_pos
  rw [gam]
  split_ifs with h
  · exact (mul_le_mul_of_nonneg_left (Nat.cast_le.2 h.le) (by positivity)).trans D.J_ge
  · have hl0 : (1 : ℝ) ≤ l := by exact_mod_cast hl
    have h1 := log_le_of_lt_X hl hlX
    have h2 : log D.L0 ≤ log l := Real.log_le_log
      (by exact_mod_cast (by have := D.ten_le; omega : 0 < D.L0)) (Nat.cast_le.2 (not_lt.1 h))
    have h3 : 0 ≤ log l := Real.log_natCast_nonneg l
    have h4 := D.A_pos
    have h5 : log l / 40 ≤ log l * (D.A - log l) / (20 * D.A) := by
      rw [div_le_div_iff₀ (by norm_num) (by positivity)]
      nlinarith
    rw [thr, mul_comm]
    refine mul_le_mul_of_nonneg_left (le_trans ?_ (h5.trans (le_max_right _ _))) (by positivity)
    linarith [D.log_L0]

/-- If the primes in `T` are odd, then all moved primes are odd. -/
lemma two_lt_of_mem_moved (hT : ∀ p ∈ T, 2 < p) {p : ℕ} (hp : p ∈ D.moved T) : 2 < p := by
  rcases mem_moved.1 hp with rfl | rfl | h
  · exact D.q'_prime.two_le.trans_lt D.q'_lt
  · have h1 := D.ten_le
    have h2 := D.L0_le
    have h3 := Nat.mod_lt D.k D.p0_prime.pos
    omega
  · exact hT p h

/-- **Lemma 9 (a)**: if the primes in `T` are odd, then smooth numbers are odd. -/
lemma odd_of_smooth (hT : ∀ p ∈ T, 2 < p) {n : ℕ} (hn : n ∈ D.smooth T) : ¬ 2 ∣ n := fun h =>
  absurd (two_lt_of_mem_moved hT (mem_moved_of_dvd hn Nat.prime_two h)) (by norm_num)

/-- Assertion (5): an uncovered number differs from all numbers `d p`. -/
lemma ne_of_uncovered {n p : ℕ} (hn : n ∈ D.uncovered T d) (hp : p ∈ T) : n ≠ d p := by
  rintro rfl
  exact (mem_filter.1 hn).2.2.2 p hp rfl

namespace State

/-- The properties of the primes in a state. -/
lemma prime (hT : D.State T d) {p : ℕ} (hp : p ∈ T) : p.Prime ∧ D.gam (lv D.k (d p)) ≤ p ∧
    D.k % p < lv D.k (d p) ∧ 2 ∣ D.k - D.k % p :=
  (mem_filter.1 (hT.fresh p hp).1).2

/-- The primes in a state exceed the levels, and they are at least `L0`. -/
lemma lv_lt (hT : D.State T d) {p : ℕ} (hp : p ∈ T) : lv D.k (d p) < p ∧ D.L0 ≤ p := by
  obtain ⟨h1, h2⟩ := lt_gam (D := D) (lv_pos (hT.smooth p hp))
  have h3 := (hT.prime hp).2.1
  exact ⟨by exact_mod_cast h1.trans_le h3, by exact_mod_cast h2.trans h3⟩

/-- The primes in a state are odd. -/
lemma two_lt (hT : D.State T d) : ∀ p ∈ T, 2 < p := fun p hp => by
  have := (hT.lv_lt hp).2
  have := D.ten_le
  omega

/-- **Lemma 9 (a)**: all moved primes are odd primes. -/
lemma prime_of_mem_moved (hT : D.State T d) {p : ℕ} (hp : p ∈ D.moved T) : p.Prime ∧ 2 < p := by
  refine ⟨?_, two_lt_of_mem_moved hT.two_lt hp⟩
  rcases mem_moved.1 hp with rfl | rfl | h
  exacts [D.q_prime, D.p0_prime, (hT.prime h).1]

/-- **Lemma 9 (a)**: the prime `q'` is not moved. -/
lemma q'_notMem (hT : D.State T d) : D.q' ∉ D.moved T := by
  intro h
  have h0 := Nat.mod_eq_zero_of_dvd D.q'_dvd
  rcases mem_moved.1 h with h | h | h
  · exact D.q'_lt.ne h
  · have h1 := D.L0_le
    have h2 := D.ten_le
    rw [← h] at h1
    omega
  · obtain ⟨-, -, -, h2⟩ := hT.prime h
    rw [h0, Nat.sub_zero] at h2
    have := hT.two_lt _ h
    have := D.q'_two h2
    omega

/-- **Lemma 9 (b)** (lifting). If `p ∈ T` divides a smooth number `n`, then the level of `n` is at
least `p`. -/
lemma le_lv (hT : D.State T d) {n p : ℕ} (hn : n ∈ D.smooth T) (hp : p ∈ T) (h : p ∣ n) :
    p ≤ lv D.k n := by
  obtain ⟨⟨h1, h2⟩, -⟩ := mem_smooth.1 hn
  exact E387.le_lv (hT.prime hp).2.2.2 (by omega) h2 (odd_of_smooth hT.two_lt hn) h

end State

end Setting

/-! ## 8. Two tools -/

/-- **Lemma 10** (Rankin's bound, from the Euler product). -/
lemma rankin {R B : Finset ℕ} (hR : ∀ p ∈ R, p.Prime) (hB : ∀ n ∈ B, n ≠ 0 ∧ n.primeFactors ⊆ R)
    {s : ℝ} (hs : 0 < s) : ∑ n ∈ B, (n : ℝ) ^ (-s) ≤ ∏ p ∈ R, (1 - (p : ℝ) ^ (-s))⁻¹ := by
  let f : ℕ →* ℝ :=
    { toFun := fun n => (n : ℝ) ^ (-s)
      map_one' := by simp
      map_mul' := fun m n => by
        rw [Nat.cast_mul, Real.mul_rpow (Nat.cast_nonneg m) (Nat.cast_nonneg n)] }
  have hf0 : ∀ n, 0 ≤ f n := fun n => Real.rpow_nonneg (Nat.cast_nonneg n) _
  obtain ⟨-, h⟩ := EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_geometric
    (f := f) (fun {p} hp => by
      rw [Real.norm_of_nonneg (hf0 p)]
      exact Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast hp.one_lt) (by linarith)) R
  rw [filter_true_of_mem hR] at h
  have hmem : ∀ n ∈ B, n ∈ Nat.factoredNumbers R := fun n hn =>
    Nat.mem_factoredNumbers_iff_primeFactors_subset.2 (hB n hn)
  have h1 := sum_le_hasSum (B.subtype (· ∈ Nat.factoredNumbers R)) (fun n _ => hf0 n) h
  rw [sum_subtype_eq_sum_filter, filter_true_of_mem hmem] at h1
  exact h1

/-- `∏ (1 - x p) ≥ 1 - ∑ x p`. -/
lemma one_sub_sum_le_prod {R : Finset ℕ} {x : ℕ → ℝ} (hx : ∀ p ∈ R, 0 ≤ x p ∧ x p ≤ 1) :
    1 - ∑ p ∈ R, x p ≤ ∏ p ∈ R, (1 - x p) := by
  induction R using Finset.induction_on with
  | empty => simp
  | insert a R ha ih =>
    rw [sum_insert ha, prod_insert ha]
    obtain ⟨h1, h2⟩ := hx a (mem_insert_self a R)
    have h3 := ih fun p hp => hx p (mem_insert_of_mem hp)
    have h4 : 0 ≤ ∑ p ∈ R, x p := sum_nonneg fun p hp => (hx p (mem_insert_of_mem hp)).1
    nlinarith

/-- **Lemma 11** (window). Numbers close to `k` that are composed of a few primes have a large prime
power as a factor, and different numbers have different such primes. -/
lemma window {k : ℕ} {Y : ℝ} {R B : Finset ℕ} (hY : 1 ≤ Y) (hk : Y ^ #R < k - Y)
    (hB : ∀ n ∈ B, (k : ℝ) - Y < n ∧ n < k ∧ n.primeFactors ⊆ R) :
    ∃ f : ℕ → ℕ, Set.InjOn f B ∧ ∀ n ∈ B, f n ∈ R ∧ f n ∣ n := by
  have hYk : 0 < (k : ℝ) - Y := (pow_nonneg (by linarith) _).trans_lt hk
  have h1 : ∀ n ∈ B, ∃ p ∈ R, Y < (p : ℝ) ^ n.factorization p := by
    intro n hn
    by_contra hcon
    push Not at hcon
    obtain ⟨a, b, c⟩ := hB n hn
    have hn0 : n ≠ 0 := by rintro rfl; norm_num at a; linarith
    have e : (n : ℝ) = ∏ p ∈ R, (p : ℝ) ^ n.factorization p := by
      have e1 : n = ∏ p ∈ R, p ^ n.factorization p := by
        conv_lhs => rw [← Nat.prod_factorization_pow_eq_self hn0]
        exact Finsupp.prod_of_support_subset _ (by rwa [Nat.support_factorization]) _ (by simp)
      conv_lhs => rw [e1]
      push_cast; rfl
    have : (n : ℝ) ≤ Y ^ #R := by
      rw [e, ← prod_const]
      exact prod_le_prod (fun p _ => by positivity) hcon
    linarith
  choose! f hf1 hf2 using h1
  refine ⟨f, fun n hn m hm he => ?_, fun n hn => ⟨hf1 n hn, ?_⟩⟩
  · by_contra hne
    wlog hlt : n < m generalizing n m
    · exact this m hm n hn he.symm (Ne.symm hne) (by omega)
    have g1 := hf2 n hn
    have g2 := hf2 m hm
    rw [← he] at g2
    set p := f n
    set e := min (n.factorization p) (m.factorization p) with hedef
    have d1 : p ^ e ∣ m - n := Nat.dvd_sub
      ((pow_dvd_pow p (min_le_right _ _)).trans (Nat.ordProj_dvd m p))
      ((pow_dvd_pow p (min_le_left _ _)).trans (Nat.ordProj_dvd n p))
    have d2 : ((p ^ e : ℕ) : ℝ) ≤ ((m - n : ℕ) : ℝ) := Nat.cast_le.2 (Nat.le_of_dvd (by omega) d1)
    have d3 : Y < (p : ℝ) ^ e := by
      rcases min_choice (n.factorization p) (m.factorization p) with h | h
      · rwa [hedef, h]
      · rwa [hedef, h]
    rw [Nat.cast_sub hlt.le, Nat.cast_pow] at d2
    have h5 : (m : ℝ) < k := by exact_mod_cast (hB m hm).2.1
    linarith [(hB n hn).1]
  · have h2 := hf2 n hn
    by_contra hnd
    rw [Nat.factorization_eq_zero_of_not_dvd hnd, pow_zero] at h2
    linarith

/-- Sums along an injection. -/
lemma sum_le_sum_of_injOn {B C : Finset ℕ} {F G : ℕ → ℝ} (e : ℕ → ℕ) (he : ∀ n ∈ B, e n ∈ C)
    (hinj : Set.InjOn e B) (h : ∀ n ∈ B, F n ≤ G (e n)) (hG : ∀ m ∈ C, 0 ≤ G m) :
    ∑ n ∈ B, F n ≤ ∑ m ∈ C, G m := by
  refine (sum_le_sum h).trans ?_
  rw [← sum_image hinj]
  exact sum_le_sum_of_subset_of_nonneg (image_subset_iff.2 he) fun m hm _ => hG m hm

/-- There are few numbers below `k` that are composed of a few primes. -/
lemma card_smooth_le {k : ℕ} {R B : Finset ℕ} (hB : ∀ n ∈ B, n ≠ 0 ∧ n < k ∧ n.primeFactors ⊆ R) :
    (#B : ℝ) ≤ (2 * log k + 1) ^ #R := by
  set N := Nat.log 2 k with hN
  have h1 : #B ≤ (N + 1) ^ #R := by
    have hc : #(Fintype.piFinset fun _ : R => range (N + 1)) = (N + 1) ^ #R := by simp
    rw [← hc]
    refine card_le_card_of_injOn (fun n (p : R) => n.factorization p) (fun n hn => ?_)
      fun n hn m hm h => ?_
    · rw [mem_coe, Fintype.mem_piFinset]
      intro p
      rw [mem_range, Nat.lt_succ_iff]
      obtain ⟨h0, h1, -⟩ := hB n hn
      by_cases hp : p.1.Prime
      · refine Nat.le_log_of_pow_le (by norm_num) ((Nat.pow_le_pow_left hp.two_le _).trans ?_)
        exact (Nat.ordProj_le p h0).trans h1.le
      · simp [hp]
    · refine Nat.eq_of_factorization_eq (hB n hn).1 (hB m hm).1 fun p => ?_
      by_cases hp : p ∈ R
      · exact congr_fun h ⟨p, hp⟩
      · rw [Finsupp.notMem_support_iff.1 fun h' => hp ((hB n hn).2.2 h'),
          Finsupp.notMem_support_iff.1 fun h' => hp ((hB m hm).2.2 h')]
  rcases B.eq_empty_or_nonempty with rfl | ⟨n, hn⟩
  · simp only [card_empty, Nat.cast_zero]
    exact pow_nonneg (by linarith [Real.log_natCast_nonneg k]) _
  have h2 : (N : ℝ) ≤ 2 * log k := by
    have hk : k ≠ 0 := by have := (hB n hn).2.1; omega
    have h3 : ((2 ^ N : ℕ) : ℝ) ≤ k := Nat.cast_le.2 (Nat.pow_log_le_self 2 hk)
    have h4 := Real.log_le_log (by positivity) h3
    rw [Nat.cast_pow, Real.log_pow, Nat.cast_ofNat] at h4
    nlinarith [Real.log_two_gt_d9, Nat.cast_nonneg (α := ℝ) N]
  calc (#B : ℝ) ≤ ((N : ℝ) + 1) ^ #R := by exact_mod_cast h1
    _ ≤ _ := by gcongr

/-! ## 9. Small levels -/

namespace Setting
variable {D : Setting} {T : Finset ℕ} {d : ℕ → ℕ}

/-- The moved primes that cover numbers of small level. -/
noncomputable def low (D : Setting) (T : Finset ℕ) (d : ℕ → ℕ) : Finset ℕ :=
  {p ∈ T | lv D.k (d p) < D.X}

namespace State
variable (hT : D.State T d)
include hT

/-- **Lemma 12 (a)**: the primes in `low` have a small sum of weights. -/
lemma sum_low_le : ∑ p ∈ D.low T d, (p : ℝ) ^ (-σ) ≤ 1 / 4 := by
  have hS := S_pos
  have hG : ((4 * S) ^ M) ^ (-σ) = (4 * S)⁻¹ := by
    rw [Real.rpow_neg (by positivity), pow_rpow_σ (by linarith)]
  calc ∑ p ∈ D.low T d, (p : ℝ) ^ (-σ)
      ≤ ∑ p ∈ D.low T d, (4 * S)⁻¹ * (lv D.k (d p) : ℝ) ^ (-σ) := sum_le_sum fun p hp => by
        obtain ⟨hpT, hpX⟩ := mem_filter.1 hp
        have hl := lv_pos (hT.smooth p hpT)
        have hl' : (0 : ℝ) < lv D.k (d p) := by exact_mod_cast hl
        rw [← hG, ← Real.mul_rpow (by positivity) hl'.le]
        exact Real.rpow_le_rpow_of_nonpos (by positivity)
          ((gam_ge hl hpX).trans (hT.prime hpT).2.1) (by linarith [σ_pos])
    _ ≤ (4 * S)⁻¹ * S := by
        rw [← mul_sum]; exact mul_le_mul_of_nonneg_left hT.sum (by positivity)
    _ = 1 / 4 := by field_simp

/-- **Lemma 12 (a)**: there are few primes in `low`. -/
lemma card_low_le : (#(D.moved (D.low T d)) : ℝ) ≤ D.u ^ 2 := by
  have hu := D.ten_le_u
  have h1 : (#(D.low T d) : ℝ) * D.u⁻¹ ≤ S := by
    rw [← nsmul_eq_mul]
    refine (card_nsmul_le_sum _ _ _ fun p hp => ?_).trans hT.sum
    obtain ⟨hpT, hpX⟩ := mem_filter.1 hp
    have hl' : (0 : ℝ) < lv D.k (d p) := by exact_mod_cast lv_pos (hT.smooth p hpT)
    rw [← D.X_rpow, ← Real.rpow_neg D.X_pos.le]
    exact Real.rpow_le_rpow_of_nonpos hl' hpX.le (by linarith [σ_pos])
  have h2 : #(D.moved (D.low T d)) ≤ #(D.low T d) + 2 :=
    (card_insert_le _ _).trans (Nat.succ_le_succ (card_insert_le _ _))
  have h3 : (#(D.moved (D.low T d)) : ℝ) ≤ #(D.low T d) + 2 := by exact_mod_cast h2
  rw [← div_eq_mul_inv, div_le_iff₀ (by linarith)] at h1
  nlinarith [D.S_le]

/-- `q` and `p0` do not belong to `low`. -/
lemma notMem_low : D.q ∉ D.low T d ∧ D.p0 ∉ D.low T d :=
  ⟨fun h => (hT.fresh _ (mem_filter.1 h).1).2.1 rfl,
    fun h => (hT.fresh _ (mem_filter.1 h).1).2.2 rfl⟩

/-- The elements of `low`, and `q` and `p0`, are odd primes. -/
lemma prime_moved_low {p : ℕ} (hp : p ∈ D.moved (D.low T d)) : p.Prime ∧ 2 < p :=
  hT.prime_of_mem_moved ((mem_moved.1 hp).elim (fun h => mem_moved.2 (Or.inl h)) fun h =>
    mem_moved.2 (Or.inr (h.imp_right fun h => (mem_filter.1 h).1)))

/-- **Lemma 12 (b)** (Rankin sum over numbers composed of `q`, `p0` and the primes in `low`). -/
lemma rankin_low {B : Finset ℕ} (hB : ∀ n ∈ B, n ≠ 0 ∧ n.primeFactors ⊆ D.moved (D.low T d)) :
    ∑ n ∈ B, (n : ℝ) ^ (-σ) ≤ S - 3 := by
  set R := D.moved (D.low T d) with hR
  have hσ := σ_pos
  have hx : ∀ p ∈ R, 0 ≤ (p : ℝ) ^ (-σ) ∧ (p : ℝ) ^ (-σ) ≤ 1 := fun p hp =>
    ⟨by positivity, Real.rpow_le_one_of_one_le_of_nonpos
      (by exact_mod_cast (hT.prime_moved_low hp).1.one_le) (by linarith)⟩
  refine (rankin (fun p hp => (hT.prime_moved_low hp).1) hB hσ).trans ?_
  have hqR : D.q ∈ R := mem_insert_self _ _
  have h1 : 1 - (3 : ℝ) ^ (-σ) ≤ 1 - (D.q : ℝ) ^ (-σ) := by
    have : (3 : ℝ) ≤ D.q := by exact_mod_cast (hT.prime_moved_low hqR).2
    linarith [Real.rpow_le_rpow_of_nonpos (by norm_num) this (by linarith : -σ ≤ 0)]
  have h2 : 1 / 2 ≤ ∏ p ∈ R.erase D.q, (1 - (p : ℝ) ^ (-σ)) := by
    refine le_trans ?_ (one_sub_sum_le_prod fun p hp => hx p (mem_of_mem_erase hp))
    have h3 : (D.p0 : ℝ) ^ (-σ) ≤ 1 / 4 := by
      have e1 : ((4 : ℝ) ^ M) ^ (-σ) = 1 / 4 := by
        rw [Real.rpow_neg (by positivity), pow_rpow_σ (by norm_num), one_div]
      rw [← e1]
      refine Real.rpow_le_rpow_of_nonpos (by positivity) ?_ (by linarith)
      exact (D.four_pow_le.trans D.u_le).trans
        (Nat.cast_le.2 (Nat.mod_lt D.k D.p0_prime.pos).le)
    have h4 : ∑ p ∈ R.erase D.q, (p : ℝ) ^ (-σ) ≤ ∑ p ∈ insert D.p0 (D.low T d), (p : ℝ) ^ (-σ) :=
      sum_le_sum_of_subset_of_nonneg (erase_insert_subset _ _)
        fun p _ _ => by positivity
    rw [sum_insert hT.notMem_low.2] at h4
    linarith [hT.sum_low_le]
  have h3 := three_rpow_lt
  rw [prod_inv_distrib, ← mul_prod_erase R _ hqR, S, add_sub_cancel_right,
    inv_le_comm₀ (by nlinarith) (by apply div_pos <;> linarith), inv_div]
  nlinarith

/-- Smooth numbers of small level are composed of `q`, `p0` and primes in `low`. -/
lemma primeFactors_subset_low {n : ℕ} (hn : n ∈ D.smooth T) (hnX : lv D.k n < D.X) :
    n.primeFactors ⊆ D.moved (D.low T d) := by
  intro p hp
  have hpT := mem_moved.1 ((mem_smooth.1 hn).2 hp)
  refine mem_moved.2 (hpT.imp_right (Or.imp_right fun h => mem_filter.2 ⟨h, ?_⟩))
  have h1 : (lv D.k (d p) : ℝ) < p := by exact_mod_cast (hT.lv_lt h).1
  have h2 : (p : ℝ) ≤ lv D.k n := by exact_mod_cast hT.le_lv hn h (Nat.dvd_of_mem_primeFactors hp)
  linarith

/-- **Lemma 12 (c)**: the window lemma for the primes in `low`. -/
lemma window_low {B : Finset ℕ} (hB : ∀ n ∈ B, (D.k : ℝ) - Real.exp (D.u ^ 4) < n ∧ n < D.k ∧
    n.primeFactors ⊆ D.moved (D.low T d)) :
    ∃ f : ℕ → ℕ, Set.InjOn f B ∧ ∀ n ∈ B, f n ∈ D.moved (D.low T d) ∧ f n ∣ n := by
  have hu := D.ten_le_u
  refine window (Real.one_le_exp (by positivity)) ?_ hB
  have hk : (D.k : ℝ) = Real.exp (D.u ^ 8) := by
    rw [← D.log_k, Real.exp_log]
    exact_mod_cast D.p0_prime.pos.trans_le D.p0_le
  have h4 : (1 : ℝ) ≤ D.u ^ 4 := one_le_pow₀ (by linarith)
  have h1 : Real.exp (D.u ^ 4) ^ #(D.moved (D.low T d)) ≤ Real.exp (D.u ^ 6) := by
    rw [← Real.exp_nat_mul]
    refine Real.exp_le_exp.2 ?_
    calc (#(D.moved (D.low T d)) : ℝ) * D.u ^ 4 ≤ D.u ^ 2 * D.u ^ 4 := by
          gcongr; exact hT.card_low_le
      _ = D.u ^ 6 := by ring
  have h2 : Real.exp (D.u ^ 4) ≤ Real.exp (D.u ^ 6) :=
    Real.exp_le_exp.2 (pow_le_pow_right₀ (by linarith) (by norm_num))
  have h3 : 2 * Real.exp (D.u ^ 6) < Real.exp (D.u ^ 8) := by
    calc 2 * Real.exp (D.u ^ 6) < Real.exp 1 * Real.exp (D.u ^ 6) := by
          gcongr; linarith [Real.exp_one_gt_d9]
      _ = Real.exp (1 + D.u ^ 6) := (Real.exp_add _ _).symm
      _ ≤ Real.exp (D.u ^ 8) := Real.exp_le_exp.2 (by
          have e1 : (1 : ℝ) ≤ D.u ^ 6 := one_le_pow₀ (by linarith)
          have e2 : 2 ≤ D.u ^ 2 := by nlinarith
          rw [show D.u ^ 8 = D.u ^ 6 * D.u ^ 2 by ring]
          nlinarith)
  rw [hk]
  linarith

/-- **Lemma 12 (d)** (small levels). The sum of the weights of the smooth numbers of small level is
bounded. -/
lemma sum_small : ∑ n ∈ D.smooth T with lv D.k n < D.X, (lv D.k n : ℝ) ^ (-σ) ≤ S := by
  have hσ := σ_pos
  rw [← sum_filter_add_sum_filter_not _ (fun n => n ≤ D.k - n)]
  -- bottoms
  have hbot : ∑ n ∈ {n ∈ D.smooth T | lv D.k n < D.X} with n ≤ D.k - n,
      (lv D.k n : ℝ) ^ (-σ) ≤ S - 3 := by
    refine le_trans (le_of_eq (sum_congr rfl fun n hn => ?_)) (hT.rankin_low fun n hn => ?_)
    · rw [lv, min_eq_left (mem_filter.1 hn).2]
    · obtain ⟨hn, hnX⟩ := mem_filter.1 (mem_filter.1 hn).1
      have := (mem_smooth.1 hn).1.1
      exact ⟨by omega, hT.primeFactors_subset_low hn hnX⟩
  -- tops
  set B := {n ∈ {n ∈ D.smooth T | lv D.k n < D.X} | ¬ n ≤ D.k - n} with hB
  have hBmem : ∀ n ∈ B, n ∈ D.smooth T ∧ (lv D.k n : ℝ) < D.X ∧ lv D.k n = D.k - n ∧ n < D.k := by
    intro n hn
    obtain ⟨hn1, hn2⟩ := mem_filter.1 hn
    obtain ⟨hn1, hnX⟩ := mem_filter.1 hn1
    exact ⟨hn1, hnX, min_eq_right (by omega), (mem_smooth.1 hn1).1.2⟩
  obtain ⟨f, hf1, hf2⟩ := hT.window_low (B := B) fun n hn => by
    obtain ⟨h1, h2, h3, h4⟩ := hBmem n hn
    refine ⟨?_, h4, hT.primeFactors_subset_low h1 h2⟩
    have h5 : Real.exp D.u ≤ Real.exp (D.u ^ 4) :=
      Real.exp_le_exp.2 (le_self_pow₀ (by linarith [D.ten_le_u]) (by norm_num))
    rw [h3, Nat.cast_sub h4.le] at h2
    linarith [D.pow_le_exp, show D.X = D.u ^ M from rfl]
  set g : ℕ → ℝ := fun r => if r ∈ D.low T d then (r : ℝ) ^ (-σ) else 1 with hg
  have htop : ∑ n ∈ B, (lv D.k n : ℝ) ^ (-σ) ≤ ∑ r ∈ D.moved (D.low T d), g r := by
    refine sum_le_sum_of_injOn f (fun n hn => (hf2 n hn).1) hf1 (fun n hn => ?_)
      fun r _ => by simp only [hg]; split_ifs <;> positivity
    have h1 := (hBmem n hn).1
    simp only [hg]
    split_ifs with h
    · have h2 := (mem_filter.1 h).1
      have h3 := hT.le_lv h1 h2 (hf2 n hn).2
      exact Real.rpow_le_rpow_of_nonpos (by exact_mod_cast (hT.prime h2).1.pos)
        (by exact_mod_cast h3) (by linarith)
    · exact Real.rpow_le_one_of_one_le_of_nonpos (by exact_mod_cast lv_pos h1) (by linarith)
  have hsum : ∑ r ∈ D.moved (D.low T d), g r = 1 + (1 + ∑ r ∈ D.low T d, (r : ℝ) ^ (-σ)) := by
    obtain ⟨hq, hp0⟩ := hT.notMem_low
    rw [moved, sum_insert (by simp [hq, D.q_ne_p0]), sum_insert hp0]
    simp only [hg, if_neg hq, if_neg hp0]
    rw [sum_congr rfl fun r hr => if_pos hr]
  linarith [hT.sum_low_le]

/-- **Lemma 12 (e)**: the number of smooth numbers of small level at most `x`. -/
lemma card_small {x : ℝ} (hx : 1 ≤ x) :
    (#{n ∈ D.smooth T | (lv D.k n : ℝ) < D.X ∧ lv D.k n ≤ x} : ℝ) ≤ S * x ^ σ := by
  have hσ := σ_pos
  have h1 : (#{n ∈ D.smooth T | (lv D.k n : ℝ) < D.X ∧ lv D.k n ≤ x} : ℝ) * x ^ (-σ) ≤ S := by
    rw [← nsmul_eq_mul]
    refine (card_nsmul_le_sum _ _ _ fun n hn => ?_).trans
      ((sum_le_sum_of_subset_of_nonneg (fun n hn => ?_) fun n _ _ => by positivity).trans
        hT.sum_small)
    · obtain ⟨hn, -, hnx⟩ := mem_filter.1 hn
      exact Real.rpow_le_rpow_of_nonpos (by exact_mod_cast lv_pos hn) hnx (by linarith)
    · rw [mem_filter] at hn ⊢
      exact ⟨hn.1, hn.2.1⟩
  rw [Real.rpow_neg (by linarith), ← div_eq_mul_inv, div_le_iff₀ (by positivity)] at h1
  exact h1

end State

end Setting

/-! ## 10. Large levels -/

/-- Assertion (6): bounds for the weight. -/
lemma phi_bounds {A : ℝ} {l : ℕ} (h1 : 1 ≤ log l) (h2 : log l + 1 ≤ A) :
    1 / (l * A ^ (b + 1)) ≤ phi A l ∧ phi A l ≤ A ^ (b + 1) * (1 / l) := by
  have hl := one_lt_of_log h1
  have hA : 0 < A := by linarith
  have h3 : 0 ≤ (A - log l) / log l := div_nonneg (by linarith) (by linarith)
  constructor
  · calc 1 / (l * A ^ (b + 1)) = (1 / A) ^ b * (A / (l * A ^ 2)) := by
          rw [one_div_pow, pow_succ]; field_simp
      _ ≤ phi A l := by
        have h4 : 1 / A ≤ (A - log l) / log l :=
          div_le_div₀ (by linarith) (by linarith) (by linarith) (by linarith)
        rw [phi]
        gcongr
        linarith
  · calc phi A l ≤ (A / 1) ^ b * (A / (l * 1 ^ 2)) := by
          have h4 : (A - log l) / log l ≤ A / 1 := div_le_div₀ hA.le (by linarith) one_pos h1
          rw [phi]
          gcongr
      _ = A ^ (b + 1) * (1 / l) := by rw [div_one, one_pow, mul_one, pow_succ]; ring

namespace Setting
variable {D : Setting} {T : Finset ℕ} {d : ℕ → ℕ}

/-- Large levels: their logarithms are between `320` and `A - 1`. -/
lemma log_bounds {l : ℕ} (hl : D.X ≤ l) (hlk : l ≤ D.k) : 320 ≤ log l ∧ log l + 1 ≤ D.A := by
  have hu := D.ten_le_u
  have hl0 : (0 : ℝ) < l := D.X_pos.trans_le hl
  constructor
  · have h1 := Real.log_le_log D.X_pos hl
    rw [X, Real.log_pow] at h1
    have h2 : (320 : ℝ) ≤ M := by rw [M_eq, b_eq]; norm_num
    have h3 : 1 ≤ log D.u := by
      rw [Real.le_log_iff_exp_le (by linarith)]
      linarith [Real.exp_one_lt_d9]
    nlinarith
  · rw [A, add_comm]
    linarith [Real.log_le_log hl0 (Nat.cast_le.2 hlk)]

/-- `phi` is nonnegative at large levels. -/
lemma phi_nonneg' {l : ℕ} (hl : D.X ≤ l) (hlk : l ≤ D.k) : 0 ≤ phi D.A l := by
  obtain ⟨h1, h2⟩ := log_bounds hl hlk
  exact phi_nonneg (one_lt_of_log (by linarith)) (by linarith)

/-- `phi` is decreasing at large levels. -/
lemma phi_anti' {l m : ℕ} (hl : D.X ≤ l) (hlm : l ≤ m) (hm : m ≤ D.k) : phi D.A m ≤ phi D.A l := by
  have hm' : D.X ≤ m := hl.trans (Nat.cast_le.2 hlm)
  obtain ⟨h1, h2⟩ := log_bounds hl (hlm.trans hm)
  obtain ⟨-, h4⟩ := log_bounds hm' hm
  exact phi_anti (one_lt_of_log (by linarith)) (Nat.cast_le.2 hlm) (by linarith)

/-- The smooth numbers of large level. -/
noncomputable def large (D : Setting) (T : Finset ℕ) : Finset ℕ := {n ∈ D.smooth T | D.X ≤ lv D.k n}

/-- The total weight of the smooth numbers of large level. -/
noncomputable def W (D : Setting) (T : Finset ℕ) : ℝ := ∑ n ∈ D.large T, phi D.A (lv D.k n)

/-- The numbers of large level composed of `q`, `p0` and primes in `low`. -/
noncomputable def rest (D : Setting) (T : Finset ℕ) (d : ℕ → ℕ) : Finset ℕ :=
  {n ∈ D.large T | n.primeFactors ⊆ D.moved (D.low T d)}

/-- Properties of the numbers in `rest`. -/
lemma mem_rest {n : ℕ} (hn : n ∈ D.rest T d) :
    (n ≠ 0 ∧ n < D.k ∧ n.primeFactors ⊆ D.moved (D.low T d)) ∧ D.X ≤ lv D.k n := by
  obtain ⟨h1, h2⟩ := mem_filter.1 hn
  obtain ⟨h3, h4⟩ := mem_filter.1 h1
  have h5 := (mem_smooth.1 h3).1
  exact ⟨⟨by omega, h5.2, h2⟩, h4⟩

namespace State
variable (hT : D.State T d)
include hT

/-- The weight of the multiples of a prime that covers a number of large level. -/
lemma sum_multiples_le {p : ℕ} (hp : p ∈ T) (hpX : D.X ≤ lv D.k (d p)) :
    ∑ n ∈ D.large T with p ∣ n, phi D.A (lv D.k n) ≤ phi D.A (lv D.k (d p)) / 2 := by
  set l := lv D.k (d p) with hl
  set B := {n ∈ D.large T | p ∣ n} with hB
  obtain ⟨hpp, hgam, -, -⟩ := hT.prime hp
  have hpX' : D.X ≤ p := hpX.trans (Nat.cast_le.2 (hT.lv_lt hp).1.le)
  have hlk : l ≤ D.k := lv_le _
  have hpk : p ≤ D.k := Nat.lt_succ_iff.1 (mem_range.1 (mem_filter.1 (hT.fresh p hp).1).1)
  rw [gam_eq hpX] at hgam
  have hw : 4 * ∑ m ∈ Icc 1 (D.k / p), phi D.A (m * p : ℕ) ≤ phi D.A l :=
    weight (log_bounds hpX hlk).1 hlk hgam hpk
  have hmem : ∀ n ∈ B, p ∣ n ∧ n < D.k ∧ lv D.k n / p ∈ Icc 1 (D.k / p) := fun n hn => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hn
    have h3 := (mem_filter.1 h1).1
    have h4 := hT.le_lv h3 hp h2
    exact ⟨h2, (mem_smooth.1 h3).1.2,
      mem_Icc.2 ⟨Nat.div_pos h4 hpp.pos, Nat.div_le_div_right (lv_le n)⟩⟩
  have hXm : ∀ m ∈ Icc 1 (D.k / p), D.X ≤ (m * p : ℕ) ∧ m * p ≤ D.k := fun m hm => by
    obtain ⟨h1, h2⟩ := mem_Icc.1 hm
    exact ⟨hpX'.trans (Nat.cast_le.2 (Nat.le_mul_of_pos_left p h1)),
      (Nat.mul_le_mul_right p h2).trans (Nat.div_mul_le_self D.k p)⟩
  -- at most two numbers in `B` have the same value of `lv n / p`
  have hfib : ∀ m, #{n ∈ B | lv D.k n / p = m} ≤ 2 := fun m => by
    refine (card_le_card fun n hn => ?_).trans
      (card_le_two (a := p * m) (b := D.k - (p * m + D.k % p)))
    obtain ⟨hnB, hnm⟩ := mem_filter.1 hn
    obtain ⟨⟨c, hc⟩, hnk, -⟩ := hmem n hnB
    rw [mem_insert, mem_singleton, ← hnm, lv]
    rcases le_total n (D.k - n) with h | h
    · rw [min_eq_left h]
      exact Or.inl (by rw [hc, Nat.mul_div_cancel_left c hpp.pos])
    · have h1 : D.k % p = (D.k - n) % p := by rw [hc, Nat.sub_mul_mod (hc ▸ hnk.le)]
      rw [min_eq_right h, h1, Nat.div_add_mod, Nat.sub_sub_self hnk.le]
      exact Or.inr rfl
  calc ∑ n ∈ B, phi D.A (lv D.k n) ≤ ∑ n ∈ B, phi D.A (lv D.k n / p * p : ℕ) :=
        sum_le_sum fun n hn =>
          phi_anti' (hXm _ (hmem n hn).2.2).1 (Nat.div_mul_le_self _ p) (lv_le n)
    _ = ∑ m ∈ Icc 1 (D.k / p), ∑ n ∈ B with lv D.k n / p = m, phi D.A (lv D.k n / p * p : ℕ) :=
        (sum_fiberwise_of_maps_to (fun n hn => (hmem n hn).2.2) _).symm
    _ ≤ ∑ m ∈ Icc 1 (D.k / p), 2 * phi D.A (m * p : ℕ) := sum_le_sum fun m hm => by
        rw [sum_congr rfl fun n hn => by rw [(mem_filter.1 hn).2], sum_const,
          nsmul_eq_mul]
        refine mul_le_mul_of_nonneg_right (by exact_mod_cast hfib m) ?_
        exact phi_nonneg' (hXm m hm).1 (hXm m hm).2
    _ ≤ phi D.A l / 2 := by rw [← mul_sum]; linarith

/-- The numbers up to `k / 2` in `rest`. -/
lemma sum_rest_bot : ∑ n ∈ D.rest T d with n ≤ D.k - n, 1 / (lv D.k n : ℝ) ≤ D.u * S / D.X := by
  have hX := D.X_pos
  have hu := D.ten_le_u
  calc ∑ n ∈ D.rest T d with n ≤ D.k - n, 1 / (lv D.k n : ℝ)
      ≤ ∑ n ∈ D.rest T d with n ≤ D.k - n, D.u / D.X * (n : ℝ) ^ (-σ) := by
        refine sum_le_sum fun n hn => ?_
        obtain ⟨hn, hbot⟩ := mem_filter.1 hn
        have h2 := (mem_rest hn).2
        rw [lv, min_eq_left hbot] at h2 ⊢
        have hn0 : (0 : ℝ) < n := hX.trans_le h2
        have h3 : 1 / (n : ℝ) = (n : ℝ) ^ (σ - 1) * (n : ℝ) ^ (-σ) := by
          rw [← Real.rpow_add hn0, one_div, ← Real.rpow_neg_one]; congr 1; ring
        have h4 : D.u / D.X = D.X ^ (σ - 1) := by rw [Real.rpow_sub_one hX.ne', D.X_rpow]
        have h5 : σ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast M_pos)
        rw [h3, h4]
        exact mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_nonpos hX h2 (by linarith))
          (by positivity)
    _ ≤ D.u / D.X * S := by
        rw [← mul_sum]
        have := hT.rankin_low (B := {n ∈ D.rest T d | n ≤ D.k - n}) fun n hn => by
          have h1 := (mem_rest (mem_filter.1 hn).1).1
          exact ⟨h1.1, h1.2.2⟩
        gcongr
        linarith
    _ = _ := by ring

/-- The numbers close to `k` in `rest`. -/
lemma sum_rest_mid :
    ∑ n ∈ {n ∈ D.rest T d | ¬ n ≤ D.k - n} with (lv D.k n : ℝ) < Real.exp (D.u ^ 4),
    1 / (lv D.k n : ℝ) ≤ D.u ^ 2 / D.X := by
  have hX := D.X_pos
  set C := {n ∈ {n ∈ D.rest T d | ¬ n ≤ D.k - n} | (lv D.k n : ℝ) < Real.exp (D.u ^ 4)} with hC
  have hCmem : ∀ n ∈ C, n ∈ D.rest T d ∧ lv D.k n = D.k - n ∧
      (lv D.k n : ℝ) < Real.exp (D.u ^ 4) := by
    intro n hn
    obtain ⟨h1, h2⟩ := mem_filter.1 hn
    obtain ⟨h3, h4⟩ := mem_filter.1 h1
    exact ⟨h3, min_eq_right (by omega), h2⟩
  obtain ⟨f, hf1, hf2⟩ := hT.window_low (B := C) fun n hn => by
    obtain ⟨h1, h2, h3⟩ := hCmem n hn
    have h4 := (mem_rest h1).1
    rw [h2, Nat.cast_sub h4.2.1.le] at h3
    exact ⟨by linarith, h4.2.1, h4.2.2⟩
  have hcard : #C ≤ #(D.moved (D.low T d)) :=
    card_le_card_of_injOn f (fun n hn => (hf2 n hn).1) hf1
  refine (sum_le_card_nsmul _ _ (1 / D.X) fun n hn => ?_).trans ?_
  · exact one_div_le_one_div_of_le hX (mem_rest (hCmem n hn).1).2
  · rw [nsmul_eq_mul, mul_one_div]
    gcongr
    exact (Nat.cast_le.2 hcard).trans hT.card_low_le

/-- The other numbers in `rest`. -/
lemma sum_rest_top :
    ∑ n ∈ {n ∈ D.rest T d | ¬ n ≤ D.k - n} with ¬ (lv D.k n : ℝ) < Real.exp (D.u ^ 4),
    1 / (lv D.k n : ℝ) ≤ 1 / D.X := by
  have hu := D.ten_le_u
  set C := {n ∈ {n ∈ D.rest T d | ¬ n ≤ D.k - n} | ¬ (lv D.k n : ℝ) < Real.exp (D.u ^ 4)} with hC
  have hCmem : ∀ n ∈ C, n ∈ D.rest T d ∧ Real.exp (D.u ^ 4) ≤ lv D.k n := fun n hn => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hn
    exact ⟨(mem_filter.1 h1).1, not_lt.1 h2⟩
  have hcard : (#C : ℝ) ≤ Real.exp (D.u ^ 3) := by
    refine (card_smooth_le fun n hn => (mem_rest (hCmem n hn).1).1).trans ?_
    rw [D.log_k]
    calc (2 * D.u ^ 8 + 1) ^ #(D.moved (D.low T d)) ≤ Real.exp D.u ^ #(D.moved (D.low T d)) := by
          gcongr; exact D.le_exp
      _ = Real.exp (#(D.moved (D.low T d)) * D.u) := (Real.exp_nat_mul _ _).symm
      _ ≤ Real.exp (D.u ^ 3) := Real.exp_le_exp.2 (by nlinarith [hT.card_low_le])
  refine (sum_le_card_nsmul _ _ (1 / Real.exp (D.u ^ 4)) fun n hn =>
    one_div_le_one_div_of_le (Real.exp_pos _) (hCmem n hn).2).trans ?_
  rw [nsmul_eq_mul, mul_one_div, div_le_div_iff₀ (Real.exp_pos _) D.X_pos, one_mul]
  calc (#C : ℝ) * D.X ≤ Real.exp (D.u ^ 3) * Real.exp D.u := by
        gcongr
        · exact D.X_pos.le
        · exact D.pow_le_exp
    _ = Real.exp (D.u ^ 3 + D.u) := (Real.exp_add _ _).symm
    _ ≤ Real.exp (D.u ^ 4) := Real.exp_le_exp.2 (by
        have e1 : D.u ≤ D.u ^ 3 := le_self_pow₀ (by linarith) (by norm_num)
        rw [show D.u ^ 4 = D.u * D.u ^ 3 by ring]
        nlinarith)

/-- The weight of `rest`. -/
lemma sum_rest : ∑ n ∈ D.rest T d, phi D.A (lv D.k n) ≤ 3 * D.A ^ (b + 1) * D.u ^ 2 / D.X := by
  have hX := D.X_pos
  have hA : 0 < D.A := D.A_pos
  calc ∑ n ∈ D.rest T d, phi D.A (lv D.k n)
      ≤ ∑ n ∈ D.rest T d, D.A ^ (b + 1) * (1 / (lv D.k n : ℝ)) := sum_le_sum fun n hn => by
        obtain ⟨h1, h2⟩ := log_bounds (mem_rest hn).2 (lv_le n)
        exact (phi_bounds (by linarith) h2).2
    _ = D.A ^ (b + 1) * ∑ n ∈ D.rest T d, 1 / (lv D.k n : ℝ) := (mul_sum _ _ _).symm
    _ ≤ D.A ^ (b + 1) * (D.u * S / D.X + (D.u ^ 2 / D.X + 1 / D.X)) := by
        rw [← sum_filter_add_sum_filter_not (D.rest T d) (fun n => n ≤ D.k - n),
          ← sum_filter_add_sum_filter_not {n ∈ D.rest T d | ¬ n ≤ D.k - n}
            (fun n => (lv D.k n : ℝ) < Real.exp (D.u ^ 4))]
        gcongr
        exacts [hT.sum_rest_bot, hT.sum_rest_mid, hT.sum_rest_top]
    _ = D.A ^ (b + 1) * (D.u * S + D.u ^ 2 + 1) / D.X := by ring
    _ ≤ D.A ^ (b + 1) * (3 * D.u ^ 2) / D.X := by
        gcongr
        nlinarith [D.S_le, D.ten_le_u]
    _ = _ := by ring

/-- **Lemma 13** (large levels). The total weight of the smooth numbers of large level is small. -/
lemma W_le : D.W T ≤ 6 * D.A ^ (b + 1) * D.u ^ 2 / D.X := by
  have hphi : ∀ n ∈ D.large T, 0 ≤ phi D.A (lv D.k n) := fun n hn =>
    phi_nonneg' (mem_filter.1 hn).2 (lv_le n)
  set high := {p ∈ T | D.X ≤ lv D.k (d p)} with hhigh
  -- each number is in `rest` or a multiple of a prime in `high`
  have h1 : D.W T ≤ ∑ p ∈ high, ∑ n ∈ D.large T with p ∣ n, phi D.A (lv D.k n) +
      ∑ n ∈ D.rest T d, phi D.A (lv D.k n) := by
    simp only [W, rest, sum_filter]
    rw [sum_comm, ← sum_add_distrib]
    refine sum_le_sum fun n hn => ?_
    have h0 : ∀ p ∈ high, 0 ≤ if p ∣ n then phi D.A (lv D.k n) else 0 := fun p _ => by
      split_ifs
      exacts [hphi n hn, le_rfl]
    by_cases h : n.primeFactors ⊆ D.moved (D.low T d)
    · rw [if_pos h]
      linarith [sum_nonneg h0]
    · obtain ⟨p, hp, hp'⟩ := not_subset.1 h
      have hpT := mem_moved.1 ((mem_smooth.1 (mem_filter.1 hn).1).2 hp)
      rw [mem_moved, not_or, not_or] at hp'
      have hpT' := (hpT.resolve_left hp'.1).resolve_left hp'.2.1
      have hph : p ∈ high := mem_filter.2 ⟨hpT', not_lt.1 fun hlt =>
        hp'.2.2 (mem_filter.2 ⟨hpT', hlt⟩)⟩
      have h1 := single_le_sum h0 hph
      rw [if_pos (Nat.dvd_of_mem_primeFactors hp)] at h1
      rw [if_neg h]
      linarith
  have h2 : ∑ p ∈ high, ∑ n ∈ D.large T with p ∣ n, phi D.A (lv D.k n) ≤ D.W T / 2 := by
    calc _ ≤ ∑ p ∈ high, phi D.A (lv D.k (d p)) / 2 := sum_le_sum fun p hp =>
          hT.sum_multiples_le (mem_filter.1 hp).1 (mem_filter.1 hp).2
      _ = (∑ n ∈ high.image d, phi D.A (lv D.k n)) / 2 := by
          rw [sum_image (hT.inj.mono (by exact_mod_cast filter_subset _ _)), sum_div]
      _ ≤ D.W T / 2 := by
          refine div_le_div_of_nonneg_right (sum_le_sum_of_subset_of_nonneg
            (image_subset_iff.2 fun p hp => ?_) fun n hn _ => hphi n hn) (by norm_num)
          obtain ⟨hp1, hp2⟩ := mem_filter.1 hp
          exact mem_filter.2 ⟨hT.smooth p hp1, hp2⟩
  have h3 := hT.sum_rest
  have h4 : 6 * D.A ^ (b + 1) * D.u ^ 2 / D.X = 2 * (3 * D.A ^ (b + 1) * D.u ^ 2 / D.X) := by ring
  linarith

/-- **Lemma 13**, second part: the number of smooth numbers of large level at most `l`. -/
lemma card_large {l : ℕ} (hl : D.X ≤ l) (hlk : l ≤ D.k) :
    (#{n ∈ D.large T | lv D.k n ≤ l} : ℝ) ≤ l / D.u ^ 120 := by
  have hu := D.ten_le_u
  have hl0 : (0 : ℝ) < l := D.X_pos.trans_le hl
  have hA := D.A_pos
  obtain ⟨h1, h2⟩ := log_bounds hl hlk
  have h3 := (phi_bounds (by linarith) h2).1
  have h4 : #{n ∈ D.large T | lv D.k n ≤ l} * phi D.A l ≤ D.W T := by
    rw [← nsmul_eq_mul]
    refine (card_nsmul_le_sum _ _ _ fun n hn => ?_).trans
      (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun n hn _ =>
        phi_nonneg' (mem_filter.1 hn).2 (lv_le n))
    obtain ⟨hn, hnl⟩ := mem_filter.1 hn
    exact phi_anti' (mem_filter.1 hn).2 hnl hlk
  have h5 : (#{n ∈ D.large T | lv D.k n ≤ l} : ℝ) * (1 / (l * D.A ^ (b + 1))) ≤
      6 * D.A ^ (b + 1) * D.u ^ 2 / D.X :=
    (mul_le_mul_of_nonneg_left h3 (Nat.cast_nonneg _)).trans (h4.trans hT.W_le)
  have h6 : D.A ^ (b + 1) * D.A ^ (b + 1) ≤ 2 ^ (2 * b + 2) * D.u ^ (16 * b + 16) := by
    have e1 := D.A_bounds.2
    calc D.A ^ (b + 1) * D.A ^ (b + 1) ≤ (2 * D.u ^ 8) ^ (b + 1) * (2 * D.u ^ 8) ^ (b + 1) := by
          gcongr
      _ = _ := by rw [← pow_add, mul_pow, ← pow_mul]; congr 2 <;> ring
  have h7 : 6 * 2 ^ (2 * b + 2) ≤ D.u ^ 2 := by
    have e1 := D.two_pow_le
    rw [show 2 * b + 4 = 2 * b + 2 + 2 by ring, pow_add] at e1
    nlinarith
  rw [mul_one_div, div_le_div_iff₀ (by positivity) D.X_pos] at h5
  rw [le_div_iff₀ (by positivity)]
  have h8 : D.X = D.u ^ 120 * (D.u ^ (16 * b + 16) * D.u ^ 14) := by
    rw [X, M_eq, ← pow_add, ← pow_add]; congr 1; ring
  have h9 : 6 * D.A ^ (b + 1) * D.u ^ 2 * (l * D.A ^ (b + 1)) ≤
      l * (D.u ^ (16 * b + 16) * D.u ^ 14) := by
    calc 6 * D.A ^ (b + 1) * D.u ^ 2 * (l * D.A ^ (b + 1))
        = 6 * l * D.u ^ 2 * (D.A ^ (b + 1) * D.A ^ (b + 1)) := by ring
      _ ≤ 6 * l * D.u ^ 2 * (2 ^ (2 * b + 2) * D.u ^ (16 * b + 16)) := by gcongr
      _ = l * D.u ^ (16 * b + 16) * D.u ^ 2 * (6 * 2 ^ (2 * b + 2)) := by ring
      _ ≤ l * D.u ^ (16 * b + 16) * D.u ^ 2 * D.u ^ 2 := by gcongr
      _ ≤ l * D.u ^ (16 * b + 16) * D.u ^ 2 * D.u ^ 12 := by gcongr <;> linarith
      _ = _ := by ring
  rw [h8, ← mul_assoc] at h5
  exact le_of_mul_le_mul_right (h5.trans h9) (by positivity)

end State
end Setting

/-! ## 11. There are enough fresh primes -/

namespace Setting
variable {D : Setting} {T : Finset ℕ} {d : ℕ → ℕ}

namespace State
variable (hT : D.State T d)
include hT

/-- At bounded levels the smooth numbers are powers of `q`. -/
lemma prime_dvd_eq {n r : ℕ} (hn : n ∈ D.smooth T) (hl : lv D.k n < D.L0) (hr : r.Prime)
    (hrn : r ∣ n) : r = D.q := by
  rcases mem_moved.1 (mem_moved_of_dvd hn hr hrn) with h | rfl | h
  · exact h
  · exfalso
    obtain ⟨⟨h1, h2⟩, -⟩ := mem_smooth.1 hn
    have h3 := D.L0_le
    have h4 : D.k % D.p0 ≤ lv D.k n := by
      refine le_min ((Nat.mod_lt _ hr.pos).le.trans (Nat.le_of_dvd (by omega) hrn)) ?_
      obtain ⟨c, rfl⟩ := hrn
      rw [← Nat.sub_mul_mod h2.le]
      exact Nat.mod_le _ _
    omega
  · have := (hT.lv_lt h).2
    have := hT.le_lv hn h hrn
    omega

/-- `q` divides the level of a smooth number of bounded level. -/
lemma q_dvd_lv {n : ℕ} (hn : n ∈ D.smooth T) (hl : lv D.k n < D.L0) : D.q ∣ n ∧ D.q ∣ lv D.k n := by
  have h1 : D.q ∣ n := by
    obtain ⟨r, hr, hrn⟩ := Nat.exists_prime_and_dvd (n := n)
      (by have := (mem_smooth.1 hn).1.1; omega)
    rwa [← hT.prime_dvd_eq hn hl hr hrn]
  refine ⟨h1, ?_⟩
  rw [lv]
  rcases min_choice n (D.k - n) with h | h <;> rw [h]
  · exact h1
  · exact Nat.dvd_sub D.q_dvd h1

/-- Two smooth numbers of the same bounded level are equal, by Størmer's theorem. -/
lemma lv_inj {m n : ℕ} (hm : m ∈ D.smooth T) (hn : n ∈ D.smooth T) (hl : lv D.k n < D.L0)
    (h : lv D.k m = lv D.k n) : m = n := by
  by_contra hne
  wlog hlt : m < n generalizing m n
  · exact this hn hm (by omega) h.symm (Ne.symm hne) (by omega)
  have hmk := (mem_smooth.1 hm).1
  have hnk := (mem_smooth.1 hn).1
  have hsum : m + n = D.k := by rw [lv, lv] at h; omega
  have hlm : lv D.k m = m := by rw [lv]; omega
  have hpow : ∀ x ∈ D.smooth T, lv D.k x < D.L0 → ∃ e, x = D.q ^ e := fun x hx hxl =>
    ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd (by have := (mem_smooth.1 hx).1.1; omega)
      fun hr hrx => hT.prime_dvd_eq hx hxl hr hrx⟩
  obtain ⟨e, he⟩ := hpow m hm (by omega)
  obtain ⟨f, hf⟩ := hpow n hn hl
  have hef : e < f := (Nat.pow_lt_pow_iff_right D.q_prime.one_lt).1 (by rwa [← he, ← hf])
  have hk : D.k = D.q ^ e * (D.q ^ (f - e) + 1) := by
    rw [mul_add, mul_one, ← pow_add, Nat.add_sub_cancel' hef.le, ← he, ← hf]; omega
  obtain ⟨p, hp, hpJ, hpd⟩ := D.stormer (D.q ^ (f - e)) (by
    conv_lhs => rw [hk]
    exact Nat.mul_le_mul_right _ (by rw [← he]; omega))
  have hpq : p ≤ D.q := by
    rcases (Nat.Prime.dvd_mul hp).1 hpd with h1 | h1
    · exact ((Nat.prime_dvd_prime_iff_eq hp D.q_prime).1 (hp.dvd_of_dvd_pow h1)).le
    · exact D.q_max p hp (by rw [hk]; exact h1.mul_left _)
  have h1 := Nat.le_of_dvd (by omega) (hT.q_dvd_lv hm (by omega)).2
  have h2 := D.L0_le_J
  omega

/-- **Lemma 14.** The number of smooth numbers of bounded level at most `l`. -/
lemma card_bounded {l : ℕ} (hl : l < D.L0) : #{n ∈ D.smooth T | lv D.k n ≤ l} ≤ half D.k l / 2 := by
  set B := {n ∈ D.smooth T | lv D.k n ≤ l} with hB
  rcases B.eq_empty_or_nonempty with h | ⟨n0, hn0⟩
  · rw [h]; exact Nat.zero_le _
  have hmem : ∀ n ∈ B, n ∈ D.smooth T ∧ lv D.k n < D.L0 ∧ D.q * (lv D.k n / D.q) = lv D.k n ∧
      1 ≤ lv D.k n / D.q ∧ lv D.k n / D.q ≤ l / D.q := by
    intro n hn
    obtain ⟨h1, h2⟩ := mem_filter.1 hn
    have h3 := (hT.q_dvd_lv h1 (by omega)).2
    exact ⟨h1, by omega, Nat.mul_div_cancel' h3, Nat.div_pos (Nat.le_of_dvd (lv_pos h1) h3)
      D.q_prime.pos, Nat.div_le_div_right h2⟩
  have hinj : ∀ m ∈ B, ∀ n ∈ B, lv D.k m / D.q = lv D.k n / D.q → m = n := fun m hm n hn h => by
    obtain ⟨h1, h2, h3, -⟩ := hmem m hm
    obtain ⟨h4, h5, h6, -⟩ := hmem n hn
    exact hT.lv_inj h1 h4 h5 (by rw [← h3, ← h6, h])
  have hq := D.q'_lt
  have hq' := D.q'_prime.two_le
  obtain ⟨-, -, -, hn1, hn2⟩ := hmem n0 hn0
  have hdiv : ∀ c, 0 < c → c ≤ D.q → l / D.q ≤ l / c := fun c hc h => Nat.div_le_div_left h hc
  rcases Nat.even_or_odd D.k with ⟨t, ht⟩ | ⟨t, ht⟩
  · have hodd : ∀ n ∈ B, lv D.k n / D.q % 2 = 1 := fun n hn => by
      obtain ⟨h1, -, h3, -⟩ := hmem n hn
      have h4 := odd_of_smooth hT.two_lt h1
      have h5 := (mem_smooth.1 h1).1
      have h6 : ¬ 2 ∣ lv D.k n := by rw [lv]; omega
      rw [← h3] at h6
      by_contra h7
      exact h6 (Dvd.dvd.mul_left (by omega) _)
    have hcard : #B ≤ #(range ((l / D.q + 1) / 2)) :=
      card_le_card_of_injOn (fun n => lv D.k n / D.q / 2)
        (fun n hn => by
          have := hodd n hn
          have := (hmem n hn).2.2.2.2
          simp only [coe_range, Set.mem_Iio]
          omega)
        (fun m hm n hn h => hinj m hm n hn (by
          have := hodd m hm
          have := hodd n hn
          have h' : lv D.k m / D.q / 2 = lv D.k n / D.q / 2 := h
          omega))
    rw [card_range] at hcard
    have h3 := hdiv 3 (by norm_num) (by omega)
    rw [half]
    omega
  · have hq3 : D.q' ≠ 2 := fun h => by
      have := D.q'_dvd
      rw [h] at this
      omega
    have hcard : #B ≤ #(Icc 1 (l / D.q)) :=
      card_le_card_of_injOn (fun n => lv D.k n / D.q)
        (fun n hn => mem_coe.2 (mem_Icc.2 (hmem n hn).2.2.2))
        (fun m hm n hn h => hinj m hm n hn h)
    rw [Nat.card_Icc] at hcard
    have h4 := hdiv 4 (by norm_num) (by omega)
    rw [half]
    omega

/-- The number of smooth numbers of level at most `l`, if `l` is small but not bounded. -/
lemma card_le_of_small {l : ℕ} (hl : D.L0 ≤ l) (hlX : l < D.X) :
    (#{n ∈ D.smooth T | lv D.k n ≤ l} : ℝ) + 1 < beta D.k l := by
  have hl1 : 1 ≤ l := by have := D.ten_le; omega
  have hA := D.A_pos
  have h1 : (#{n ∈ D.smooth T | lv D.k n ≤ l} : ℝ) ≤ S * l ^ σ := by
    refine le_trans (Nat.cast_le.2 (card_le_card fun n hn => ?_))
      (hT.card_small (by exact_mod_cast hl1))
    obtain ⟨h1, h2⟩ := mem_filter.1 hn
    have h3 : (lv D.k n : ℝ) ≤ l := Nat.cast_le.2 h2
    exact mem_filter.2 ⟨h1, by linarith, h3⟩
  refine lt_of_le_of_lt (add_le_add_left h1 1) ((D.count_lt l hl).trans_le ?_)
  change _ ≤ l * (D.A - log l) / (10 ^ 4 * D.A)
  rw [div_le_div_iff₀ (by norm_num) (by positivity)]
  nlinarith [log_le_of_lt_X hl1 hlX, Nat.cast_nonneg (α := ℝ) l]

/-- The number of smooth numbers of level at most `l`, if `l` is large. -/
lemma card_le_of_large {l : ℕ} (hl : D.X ≤ l) (hlk : l ≤ D.k) :
    (#{n ∈ D.smooth T | lv D.k n ≤ l} : ℝ) + 1 < beta D.k l := by
  have hu := D.ten_le_u
  have hA := D.A_pos
  have hl0 : (0 : ℝ) < l := D.X_pos.trans_le hl
  have h1 : (#{n ∈ D.smooth T | lv D.k n ≤ l} : ℝ) ≤ S * D.u + l / D.u ^ 120 := by
    have e1 : #{n ∈ D.smooth T | lv D.k n ≤ l} ≤
        #{n ∈ D.smooth T | (lv D.k n : ℝ) < D.X ∧ lv D.k n ≤ D.X} +
        #{n ∈ D.large T | lv D.k n ≤ l} := by
      refine (card_le_card fun n hn => ?_).trans (card_union_le _ _)
      obtain ⟨h1, h2⟩ := mem_filter.1 hn
      rw [mem_union]
      rcases lt_or_ge (lv D.k n : ℝ) D.X with h' | h'
      · exact Or.inl (mem_filter.2 ⟨h1, h', h'.le⟩)
      · exact Or.inr (mem_filter.2 ⟨mem_filter.2 ⟨h1, h'⟩, h2⟩)
    have e2 := hT.card_small (x := D.X) (one_le_pow₀ (by linarith))
    rw [D.X_rpow] at e2
    have e3 := hT.card_large hl hlk
    have e4 : (#{n ∈ D.smooth T | lv D.k n ≤ l} : ℝ) ≤
        #{n ∈ D.smooth T | (lv D.k n : ℝ) < D.X ∧ lv D.k n ≤ D.X} +
        #{n ∈ D.large T | lv D.k n ≤ l} := by exact_mod_cast e1
    linarith
  have h2 : S * D.u + 1 ≤ l / D.u ^ 118 := by
    rw [le_div_iff₀ (by positivity)]
    calc (S * D.u + 1) * D.u ^ 118 ≤ D.u ^ 2 * D.u ^ 118 := by
          gcongr; nlinarith [D.S_le]
      _ = D.u ^ 120 := by ring
      _ ≤ D.X := pow_le_pow_right₀ (by linarith) (by rw [M_eq]; omega)
      _ ≤ l := hl
  have h3 : l / D.u ^ 120 ≤ l / D.u ^ 118 := by
    gcongr <;> linarith
  have h4 : l / D.u ^ 118 + l / D.u ^ 118 < beta D.k l := by
    change _ < l * (D.A - log l) / (10 ^ 4 * D.A)
    have e2 : (4 * 10 ^ 4 : ℝ) < D.u ^ 110 := by
      calc (4 * 10 ^ 4 : ℝ) < 10 ^ 110 := by norm_num
        _ ≤ D.u ^ 110 := by gcongr
    rw [← two_mul, ← mul_div_assoc, div_lt_div_iff₀ (by positivity) (by positivity)]
    calc 2 * (l : ℝ) * (10 ^ 4 * D.A) ≤ 2 * l * (10 ^ 4 * (2 * D.u ^ 8)) := by
          gcongr; exact D.A_bounds.2
      _ = l * D.u ^ 8 * (4 * 10 ^ 4) := by ring
      _ < l * D.u ^ 8 * D.u ^ 110 := by gcongr
      _ = l * 1 * D.u ^ 118 := by ring
      _ ≤ l * (D.A - log l) * D.u ^ 118 := by
          gcongr; linarith [(log_bounds hl hlk).2]
  linarith

/-- **Lemma 15** (fresh primes). Every uncovered number of level `< k / 5` has a fresh prime. -/
lemma exists_fresh {n : ℕ} (hn : n ∈ D.uncovered T d) (hlev : 5 * lv D.k n < D.k) :
    ∃ p ∈ supply D.k (lv D.k n) (D.gam (lv D.k n)), p ∉ D.moved T := by
  set l := lv D.k n with hl
  have hnT := (mem_filter.1 hn).1
  have hcard : #T + 1 ≤ #{m ∈ D.smooth T | lv D.k m ≤ l} := by
    rw [← card_image_of_injOn hT.inj, ← card_insert_of_notMem (a := n)]
    · refine card_le_card (insert_subset_iff.2 ⟨mem_filter.2 ⟨hnT, le_rfl⟩,
        image_subset_iff.2 fun p hp => mem_filter.2 ⟨hT.smooth p hp, hT.order n hn p hp⟩⟩)
    · rw [mem_image]
      rintro ⟨r, hr, h⟩
      exact ne_of_uncovered hn hr h.symm
  -- it is enough that the supply has many elements different from `q` and `p0`
  suffices h : #{m ∈ D.smooth T | lv D.k m ≤ l} ≤ #(supply D.k l (D.gam l) \ {D.q, D.p0}) by
    obtain ⟨p, hp, hpT⟩ := exists_mem_notMem_of_card_lt_card (hcard.trans h)
    simp only [Finset.mem_sdiff, mem_insert, mem_singleton, not_or] at hp
    exact ⟨p, hp.1, fun h => (mem_moved.1 h).elim hp.2.1 fun h => h.elim hp.2.2 hpT⟩
  rcases Nat.lt_or_ge l D.L0 with h | h
  · have hlJ := h.le.trans D.L0_le_J
    refine ((hT.card_bounded h).trans (D.supply_small l hlJ)).trans (card_le_card fun p hp => ?_)
    obtain ⟨-, hJ, hmod, -⟩ := (mem_filter.1 hp).2
    rw [Finset.mem_sdiff, mem_insert, mem_singleton, gam, if_pos h]
    refine ⟨hp, ?_⟩
    rintro (rfl | rfl)
    · have h2 := Nat.le_of_dvd (lv_pos hnT) (hT.q_dvd_lv hnT h).2
      have h3 := D.L0_le_J
      have h4 : D.J ≤ D.q := by exact_mod_cast hJ
      omega
    · have := D.L0_le
      omega
  · have h1 := D.supply_big l h hlev.le
    have h2 : (#{m ∈ D.smooth T | lv D.k m ≤ l} : ℝ) + 1 < beta D.k l := by
      rcases lt_or_ge (l : ℝ) D.X with h' | h'
      · exact hT.card_le_of_small h h'
      · exact hT.card_le_of_large h' (lv_le n)
    have h3 := (le_card_sdiff {D.q, D.p0} (supply D.k l (D.gam l)))
    have h4 := card_le_two (a := D.q) (b := D.p0)
    rw [gam, if_neg (by omega)] at h3 ⊢
    have h5 : #{m ∈ D.smooth T | lv D.k m ≤ l} + 1 < #(supply D.k l (thr D.A l)) := by
      exact_mod_cast h2.trans_le h1
    omega

end State
end Setting

/-! ## 12. End of the proof -/

namespace Setting
variable {D : Setting} {T : Finset ℕ} {d : ℕ → ℕ}

namespace State

/-- If an uncovered number `n` of least level is covered by a fresh prime `p`, then the levels of
the numbers that are uncovered afterwards are not smaller. -/
lemma lv_le_of_uncovered (hT : D.State T d) {d' : ℕ → ℕ} {n p m : ℕ}
    (hmin : ∀ m ∈ D.uncovered T d, lv D.k n ≤ lv D.k m) (hn : n ∈ D.smooth T)
    (hp : p ∈ supply D.k (lv D.k n) (D.gam (lv D.k n))) (hd : ∀ r ∈ T, d' r = d r)
    (hm : m ∈ D.uncovered (insert p T) d') : lv D.k n ≤ lv D.k m := by
  obtain ⟨hm1, hm2, hm3, hm4⟩ := mem_filter.1 hm
  obtain ⟨⟨h2m, hmk⟩, hms⟩ := mem_smooth.1 hm1
  by_cases hpm : p ∣ m
  · obtain ⟨-, hgam, -, hdvd⟩ := (mem_filter.1 hp).2
    obtain ⟨h1, h2⟩ := lt_gam (D := D) (lv_pos hn)
    have h3 : lv D.k n < p := by exact_mod_cast h1.trans_le hgam
    have h4 : D.L0 ≤ p := by exact_mod_cast h2.trans hgam
    have h5 := D.ten_le
    have hodd := odd_of_smooth (forall_mem_insert _ _ _ |>.2 ⟨by omega, hT.two_lt⟩) hm1
    exact h3.le.trans (E387.le_lv hdvd (by omega) hmk hodd hpm)
  · refine hmin m (mem_filter.2 ⟨mem_smooth.2 ⟨⟨h2m, hmk⟩, fun r hr => ?_⟩, hm2, hm3,
      fun r hr => ?_⟩)
    · refine mem_moved.2 ((mem_moved.1 (hms hr)).imp_right (Or.imp_right fun h => ?_))
      exact (mem_insert.1 h).resolve_left
        (by rintro rfl; exact hpm (Nat.dvd_of_mem_primeFactors hr))
    · rw [← hd r hr]; exact hm4 r (mem_insert_of_mem hr)

/-- **Lemma 16** (one step). An uncovered number `n` of least level can be covered by a fresh prime
`p`. -/
lemma add (hT : D.State T d) {n p : ℕ} (hn : n ∈ D.uncovered T d)
    (hmin : ∀ m ∈ D.uncovered T d, lv D.k n ≤ lv D.k m)
    (hp : p ∈ supply D.k (lv D.k n) (D.gam (lv D.k n))) (hpT : p ∉ D.moved T) :
    D.State (insert p T) (Function.update d p n) := by
  simp only [mem_moved, not_or] at hpT
  set d' := Function.update d p n with hd'
  have hdp : d' p = n := Function.update_self p n d
  have hdr : ∀ r ∈ T, d' r = d r := fun r hr =>
    Function.update_of_ne (by rintro rfl; exact hpT.2.2 hr) _ _
  have key : ∀ Q : ℕ → ℕ → Prop, Q p n → (∀ r ∈ T, Q r (d r)) → ∀ r ∈ insert p T, Q r (d' r) := by
    intro Q h1 h2 r hr
    rcases mem_insert.1 hr with rfl | hr
    · rwa [hdp]
    · rw [hdr r hr]; exact h2 r hr
  have hsub : ∀ m ∈ D.smooth T, m ∈ D.smooth (insert p T) := fun m hm =>
    mem_smooth.2 ⟨(mem_smooth.1 hm).1,
      (mem_smooth.1 hm).2.trans (moved_mono (subset_insert _ _))⟩
  have hnT := (mem_filter.1 hn).1
  have hinj : Set.InjOn d' (insert p T : Finset ℕ) := by
    rw [coe_insert, Set.injOn_insert (by exact_mod_cast hpT.2.2)]
    refine ⟨hT.inj.congr fun r hr => (hdr r hr).symm, ?_⟩
    rintro ⟨r, hr, hrn⟩
    rw [hdp, hdr r hr] at hrn
    exact ne_of_uncovered hn hr hrn.symm
  refine ⟨key (fun _ m => m ∈ D.smooth (insert p T)) (hsub n hnT)
      fun r hr => hsub _ (hT.smooth r hr),
    hinj, key (fun r m => r ∈ supply D.k (lv D.k m) (D.gam (lv D.k m)) ∧ r ≠ D.q ∧ r ≠ D.p0)
      ⟨hp, hpT.1, hpT.2.1⟩ hT.fresh, fun m hm => ?_, ?_⟩
  · have hle := hT.lv_le_of_uncovered hmin hnT hp hdr hm
    exact key (fun _ a => lv D.k a ≤ lv D.k m) hle fun r hr => (hT.order n hn r hr).trans hle
  · have hsum := (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _
      (insert_subset_iff.2 ⟨hnT, image_subset_iff.2 hT.smooth⟩))
      fun m _ _ => by positivity).trans hT.sum_small
    rw [sum_filter] at hsum ⊢
    rw [← sum_image (f := fun m => if (lv D.k m : ℝ) < D.X then (lv D.k m : ℝ) ^ (-σ) else 0)
      hinj, image_insert, hdp, image_congr (fun r hr => hdr r hr)]
    exact hsum

end State

variable (D) in
/-- **Lemma 17** (end of the process). There is a state in which all uncovered numbers have level at
least `k / 5`. -/
lemma exists_state : ∃ T d, D.State T d ∧ ∀ n ∈ D.uncovered T d, D.k ≤ 5 * lv D.k n := by
  -- a state with as many primes as possible
  set sizes : Set ℕ := {N | ∃ T d, D.State T d ∧ #T = N} with hsizes
  have hne : sizes.Nonempty := ⟨0, ∅, id, ⟨by simp, by simp, by simp, by simp,
    by simpa using S_pos.le⟩, rfl⟩
  have hbdd : BddAbove sizes := by
    refine ⟨D.k + 1, ?_⟩
    rintro _ ⟨T, d, hT, rfl⟩
    rw [← card_range (D.k + 1)]
    exact card_le_card fun p hp => (mem_filter.1 (hT.fresh p hp).1).1
  obtain ⟨T, d, hT, hmax⟩ := Nat.sSup_mem hne hbdd
  refine ⟨T, d, hT, ?_⟩
  by_contra hcon
  push Not at hcon
  obtain ⟨n0, hn0, hn0l⟩ := hcon
  obtain ⟨n, hn, hmin⟩ := exists_min_image (D.uncovered T d) (lv D.k) ⟨n0, hn0⟩
  have hlev : 5 * lv D.k n < D.k := by have := hmin n0 hn0; omega
  obtain ⟨p, hp, hpT⟩ := hT.exists_fresh hn hlev
  have h2 := le_csSup hbdd (show #(insert p T) ∈ sizes from ⟨_, _, hT.add hn hmin hp hpT, rfl⟩)
  rw [card_insert_of_notMem fun h => hpT (mem_moved.2 (Or.inr (Or.inr h))), ← hmax] at h2
  omega

/-- An assignment of different freed primes to the uncovered numbers. -/
def Assigned (D : Setting) (T : Finset ℕ) (d P : ℕ → ℕ) : Prop :=
  Set.InjOn P (D.uncovered T d) ∧ ∀ n ∈ D.uncovered T d,
    (D.k - D.k / 5 < P n ∧ P n ≤ D.k) ∧ (P n).Prime ∧ P n % D.p0 = D.c0

/-- There are enough freed primes for the uncovered numbers of level at least `k / 5`. -/
lemma State.exists_assigned (hT : D.State T d) (hU : ∀ n ∈ D.uncovered T d, D.k ≤ 5 * lv D.k n) :
    ∃ P, D.Assigned T d P := by
  have hu := D.ten_le_u
  set F := {P ∈ Ioc (D.k - D.k / 5) D.k | P.Prime ∧ P % D.p0 = D.c0} with hF
  have hk : (D.k : ℝ) = Real.exp (D.u ^ 8) := by
    rw [← D.log_k, Real.exp_log (by exact_mod_cast D.k_pos)]
  have h5X : 5 * D.X ≤ D.k := by
    have h1 : 5 ≤ Real.exp 1 ^ 2 := by nlinarith [Real.exp_one_gt_d9]
    calc 5 * D.X ≤ Real.exp 1 ^ 2 * Real.exp D.u := by
          gcongr
          · exact D.X_pos.le
          · exact D.pow_le_exp
      _ = Real.exp (2 + D.u) := by rw [← Real.exp_nat_mul, ← Real.exp_add]; norm_num
      _ ≤ D.k := by
        have h2 : D.u ^ 2 ≤ D.u ^ 8 := pow_le_pow_right₀ (by linarith) (by norm_num)
        rw [hk]
        exact Real.exp_le_exp.2 (by nlinarith)
  have hcard : #(D.uncovered T d) ≤ #F := by
    have h1 := hT.card_large (l := D.k) (by linarith [D.X_pos]) le_rfl
    have h2 : #(D.uncovered T d) ≤ #{n ∈ D.large T | lv D.k n ≤ D.k} := by
      refine card_le_card fun n hn => ?_
      refine mem_filter.2 ⟨mem_filter.2 ⟨(mem_filter.1 hn).1, ?_⟩, lv_le n⟩
      have h3 : (D.k : ℝ) ≤ 5 * lv D.k n := by exact_mod_cast hU n hn
      linarith
    have h3 : (D.k : ℝ) / D.u ^ 120 ≤ D.k / D.u ^ 112 := by gcongr <;> linarith
    have h4 : (#(D.uncovered T d) : ℝ) ≤ #{n ∈ D.large T | lv D.k n ≤ D.k} := by exact_mod_cast h2
    exact_mod_cast h4.trans (h1.trans (h3.trans D.freed))
  obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le
    (α := D.uncovered T d) (β := F) (by rwa [Fintype.card_coe, Fintype.card_coe])
  refine ⟨fun n => if h : n ∈ D.uncovered T d then e ⟨n, h⟩ else 0, fun m hm n hn h => ?_,
    fun n hn => ?_⟩
  · simp only [mem_coe.1 hm, mem_coe.1 hn, dif_pos] at h
    simpa using e.injective (Subtype.ext h)
  · simp only [hn, dif_pos]
    obtain ⟨h1, h2, h3⟩ := mem_filter.1 (e ⟨n, hn⟩).2
    exact ⟨mem_Ioc.1 h1, h2, h3⟩

/-- Freed primes are not moved primes. -/
lemma State.notMem_moved (hT : D.State T d) {P : ℕ} (h1 : D.k - D.k / 5 < P) (h2 : P.Prime)
    (h3 : P % D.p0 = D.c0) : P ∉ D.moved T := by
  have hk := D.k_pos
  intro h
  rcases mem_moved.1 h with rfl | rfl | h
  · obtain ⟨c, hc⟩ := D.q_dvd
    have hc1 : c = 1 := by
      have h4 : c ≠ 0 := by rintro rfl; omega
      by_contra h5
      have : D.q * 2 ≤ D.q * c := Nat.mul_le_mul_left _ (by omega)
      omega
    rw [hc1, mul_one] at hc
    have h4 := D.q'_dvd
    rw [hc] at h4
    exact D.q'_lt.ne ((Nat.prime_dvd_prime_iff_eq D.q'_prime D.q_prime).1 h4)
  · have := D.lt_c0
    rw [Nat.mod_self] at h3
    omega
  · obtain ⟨-, -, hmod, hdvd⟩ := hT.prime h
    have h5 : 2 * P ∣ D.k - D.k % P := Nat.Coprime.mul_dvd_of_dvd_of_dvd
      ((Nat.coprime_primes Nat.prime_two h2).2 (hT.two_lt P h).ne) hdvd (Nat.dvd_sub_mod D.k)
    have h6 := (hT.lv_lt h).1
    have h7 := lv_le (D := D) (d P)
    have h8 := Nat.le_of_dvd (by omega) h5
    omega

/-- The classes: `1` for `q`, `c0` for `p0`, `d p` for `p ∈ T`, `n` for the freed prime `P n`, and
class zero for all other primes. -/
noncomputable def cls (D : Setting) (T : Finset ℕ) (d P : ℕ → ℕ) (p : ℕ) : ℕ :=
  if p = D.q then 1 else if p = D.p0 then D.c0 else if p ∈ T then d p % p else
    if p ∈ (D.uncovered T d).image P then Function.invFunOn P (D.uncovered T d) p else p

/-- The classes are admissible. -/
lemma State.cls_mem (hT : D.State T d) (hU : ∀ n ∈ D.uncovered T d, D.k ≤ 5 * lv D.k n) {P : ℕ → ℕ}
    (hP : D.Assigned T d P) {p : ℕ} (hp : p.Prime) :
    D.k % p < D.cls T d P p ∧ D.cls T d P p ≤ p := by
  rw [cls]
  split_ifs with h1 h2 h3 h4
  · rw [h1, Nat.mod_eq_zero_of_dvd D.q_dvd]
    exact ⟨one_pos, D.q_prime.one_le⟩
  · rw [h2]; exact ⟨D.lt_c0, D.c0_lt.le⟩
  · exact ⟨mod_lt_mod (mem_smooth.1 (hT.smooth p h3)).1.2.le (hT.prime h3).2.2.1 (hT.lv_lt h3).1,
      (Nat.mod_lt _ hp.pos).le⟩
  · obtain ⟨n, hn, rfl⟩ := mem_image.1 h4
    rw [hP.1.leftInvOn_invFunOn (mem_coe.2 hn)]
    have h5 := (hP.2 n hn).1
    have h6 := hU n hn
    have h7 : D.k % P n = D.k - P n := by
      rw [Nat.mod_eq_sub_mod h5.2, Nat.mod_eq_of_lt (by omega)]
    rw [lv] at h6
    omega
  · exact ⟨Nat.mod_lt _ hp.pos, le_rfl⟩

/-- The classes cover `1, ..., k`. -/
lemma State.cls_cover (hT : D.State T d) {P : ℕ → ℕ} (hP : D.Assigned T d P) {j : ℕ} (hj1 : 1 ≤ j)
    (hjk : j ≤ D.k) : ∃ p, p.Prime ∧ p ≤ D.k ∧ j ≡ D.cls T d P p [MOD p] := by
  have hPT : ∀ n ∈ D.uncovered T d, P n ∉ D.moved T := fun n hn =>
    hT.notMem_moved (hP.2 n hn).1.1 (hP.2 n hn).2.1 (hP.2 n hn).2.2
  have hqk : D.q ≤ D.k := Nat.le_of_dvd D.k_pos D.q_dvd
  have hcq : D.cls T d P D.q = 1 := by rw [cls, if_pos rfl]
  have hcp0 : D.cls T d P D.p0 = D.c0 := by rw [cls, if_neg D.q_ne_p0.symm, if_pos rfl]
  by_cases hj : j.primeFactors ⊆ D.moved T
  · have hjne : j ≠ D.k := by
      rintro rfl
      exact hT.q'_notMem (hj (Nat.mem_primeFactors.2 ⟨D.q'_prime, D.q'_dvd, by omega⟩))
    by_cases hj2 : j = 1
    · exact ⟨D.q, D.q_prime, hqk, by rw [hcq, hj2]⟩
    have hjs : j ∈ D.smooth T := mem_smooth.2 ⟨by omega, hj⟩
    by_cases hjU : j ∈ D.uncovered T d
    · refine ⟨P j, (hP.2 j hjU).2.1, (hP.2 j hjU).1.2, ?_⟩
      have h := hPT j hjU
      rw [mem_moved, not_or, not_or] at h
      rw [cls, if_neg h.1, if_neg h.2.1, if_neg h.2.2, if_pos (mem_image_of_mem P hjU),
        hP.1.leftInvOn_invFunOn (mem_coe.2 hjU)]
    · have h1 : ¬ (j % D.q ≠ 1 ∧ j % D.p0 ≠ D.c0 ∧ ∀ p ∈ T, j % p ≠ d p % p) := fun h =>
        hjU (mem_filter.2 ⟨hjs, h⟩)
      simp only [not_and_or, not_forall, not_not] at h1
      rcases h1 with h1 | h1 | ⟨p, hp, h1⟩
      · refine ⟨D.q, D.q_prime, hqk, ?_⟩
        rw [hcq, Nat.ModEq, h1, Nat.mod_eq_of_lt D.q_prime.one_lt]
      · refine ⟨D.p0, D.p0_prime, D.p0_le, ?_⟩
        rw [hcp0, Nat.ModEq, h1, Nat.mod_eq_of_lt D.c0_lt]
      · have hpk := mem_range.1 (mem_filter.1 (hT.fresh p hp).1).1
        refine ⟨p, (hT.prime hp).1, Nat.lt_succ_iff.1 hpk, ?_⟩
        have hne := (hT.fresh p hp).2
        rw [cls, if_neg hne.1, if_neg hne.2, if_pos hp, Nat.ModEq, h1, Nat.mod_mod]
  · obtain ⟨r, hr, hrT⟩ := not_subset.1 hj
    obtain ⟨hrp, hrj, -⟩ := Nat.mem_primeFactors.1 hr
    by_cases h : r ∈ (D.uncovered T d).image P
    · -- here `j = P n` is in the class of `p0`
      obtain ⟨n, hn, rfl⟩ := mem_image.1 h
      obtain ⟨⟨h1, -⟩, h2, h3⟩ := hP.2 n hn
      have hjP : j = P n := by
        obtain ⟨c, rfl⟩ := hrj
        have hc : c < 2 := by
          by_contra hc
          have := Nat.mul_le_mul_left (P n) (not_lt.1 hc)
          omega
        obtain rfl : c = 1 := by
          have : c ≠ 0 := by rintro rfl; omega
          omega
        rw [mul_one]
      exact ⟨D.p0, D.p0_prime, D.p0_le, by
        rw [hcp0, hjP, Nat.ModEq, h3, Nat.mod_eq_of_lt D.c0_lt]⟩
    · refine ⟨r, hrp, (Nat.le_of_dvd hj1 hrj).trans hjk, ?_⟩
      rw [mem_moved, not_or, not_or] at hrT
      rw [cls, if_neg hrT.1, if_neg hrT.2.1, if_neg hrT.2.2, if_neg h]
      exact (Nat.modEq_zero_iff_dvd.2 hrj).trans (Nat.modEq_zero_iff_dvd.2 dvd_rfl).symm

/-- **Lemma 18.** The classes can be chosen as required in Lemma 1. -/
theorem exists_cover (D : Setting) : ∃ a : ℕ → ℕ,
    (∀ p, p.Prime → p ≤ D.k → D.k % p < a p ∧ a p ≤ p) ∧
    ∀ j, 1 ≤ j → j ≤ D.k → ∃ p, p.Prime ∧ p ≤ D.k ∧ j ≡ a p [MOD p] := by
  obtain ⟨T, d, hT, hU⟩ := D.exists_state
  obtain ⟨P, hP⟩ := hT.exists_assigned hU
  exact ⟨D.cls T d P, fun p hp _ => hT.cls_mem hU hP hp, fun j hj1 hjk => hT.cls_cover hP hj1 hjk⟩

end Setting

end E387

/-- **Theorem** (Schinzel's conjecture in the eventual form). -/
public theorem main : type_of% @Erdos387.erdos_387.variants.schinzel := by
  filter_upwards [E387.exists_setting] with k hk hpp
  obtain ⟨D, rfl⟩ := hk hpp
  obtain ⟨a, ha, hcov⟩ := D.exists_cover
  exact E387.reduction a ha hcov

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
