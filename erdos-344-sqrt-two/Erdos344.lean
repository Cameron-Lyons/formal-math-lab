namespace E344

/-! ### 1. Notation, enumeration and gluing -/

/-- `P(J)`: the sums of `a i` over the finite sets of indices `i ∈ J`. -/
def P (a : ℕ → ℕ) (J : Set ℕ) : Set ℕ :=
  {n | ∃ T : Finset ℕ, (T : Set ℕ) ⊆ J ∧ ∑ i ∈ T, a i = n}

/-- `S_J(m)`: the sum of `a i` over the indices `i ∈ J` with `i < m`. -/
noncomputable def S (a : ℕ → ℕ) (J : Set ℕ) (m : ℕ) : ℕ := ∑ i ∈ range m, J.indicator a i

/-- `J` is `G`-good: each `a m` with `m ∈ J` is at most `G + S_J(m)`. -/
def Good (a : ℕ → ℕ) (J : Set ℕ) (G : ℕ) : Prop := ∀ m ∈ J, a m ≤ G + S a J m

/-- `X` is `G`-syndetic: every natural number `u` has an `x ∈ X` with `x ≤ u ≤ x + G`. -/
def Syndetic (X : Set ℕ) (G : ℕ) : Prop := ∀ u, ∃ x ∈ X, x ≤ u ∧ u ≤ x + G

/-- The empty sum lies in `P(J)`. -/
theorem zero_mem_P (a : ℕ → ℕ) (J : Set ℕ) : 0 ∈ P a J := ⟨∅, by simp, by simp⟩

/-- `P(J)` grows with `J`. -/
theorem P_mono {a : ℕ → ℕ} {J K : Set ℕ} (h : J ⊆ K) : P a J ⊆ P a K :=
  fun _ ⟨T, hT, e⟩ => ⟨T, hT.trans h, e⟩

/-- `P(J) + P(K) ⊆ P(J ∪ K)` for disjoint `J`, `K`. -/
theorem P_add {a : ℕ → ℕ} {J K : Set ℕ} (hJK : Disjoint J K) {x y : ℕ} (hx : x ∈ P a J)
    (hy : y ∈ P a K) : x + y ∈ P a (J ∪ K) := by
  obtain ⟨T, hT, rfl⟩ := hx
  obtain ⟨U, hU, rfl⟩ := hy
  refine ⟨T ∪ U, ?_, sum_union (disjoint_coe.1 (hJK.mono hT hU))⟩
  rw [coe_union]
  exact Set.union_subset_union hT hU

/-- `S_J(m + 1)` is `S_J(m)`, plus `a m` if `m ∈ J`. -/
theorem S_succ (a : ℕ → ℕ) (J : Set ℕ) (m : ℕ) : S a J (m + 1) = S a J m + J.indicator a m :=
  sum_range_succ _ _

/-- If `m ∈ J` and `m < m'`, then `S_J(m) + a m ≤ S_J(m')`. -/
theorem S_add_le {a : ℕ → ℕ} {J : Set ℕ} {m m' : ℕ} (hm : m ∈ J) (h : m < m') :
    S a J m + a m ≤ S a J m' := by
  calc S a J m + a m = S a J (m + 1) := by rw [S_succ, Set.indicator_of_mem hm]
    _ ≤ S a J m' := sum_le_sum_of_subset (range_subset_range.2 h)

/-- **Lemma 1.** `A` is infinite, and its elements `a 0 < a 1 < ...` satisfy `2 * a k ≤ k ^ 2 + 2`
for all large `k`. -/
theorem enumerate {A : Set ℕ} (hA : ∀ᶠ N : ℕ in atTop, Real.sqrt (2 * N) ≤ A.countUpTo N) :
    ∃ a : ℕ → ℕ, StrictMono a ∧ Set.range a = A ∧ ∀ᶠ k in atTop, 2 * a k ≤ k ^ 2 + 2 := by
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.1 hA
  have hcount : ∀ N ≥ N₀, 2 * N ≤ A.countUpTo N ^ 2 := by
    intro N hN
    have h := hN₀ N hN
    rw [Real.sqrt_le_left (by positivity)] at h
    exact_mod_cast h
  have hinf : A.Infinite := by
    intro hfin
    have h := hcount (N₀ + A.ncard ^ 2 + 1) (by omega)
    have h' : A.countUpTo (N₀ + A.ncard ^ 2 + 1) ≤ A.ncard :=
      Set.ncard_le_ncard Set.inter_subset_left hfin
    have := Nat.pow_le_pow_left h' 2
    omega
  have hmono : StrictMono (Nat.nth (· ∈ A)) := Nat.nth_strictMono hinf
  have hrange : Set.range (Nat.nth (· ∈ A)) = A := Nat.range_nth_of_infinite hinf
  refine ⟨Nat.nth (· ∈ A), hmono, hrange, ?_⟩
  filter_upwards [eventually_ge_atTop (N₀ + 1)] with k hk
  set a := Nat.nth (· ∈ A)
  have hak : k ≤ a k := hmono.le_apply
  -- the elements of `A` in `[1, a k - 1]` are among `a 0, ..., a (k - 1)`
  have hle : A.countUpTo (a k - 1) ≤ k := by
    have hsub : A ∩ Set.Icc 1 (a k - 1) ⊆ ((range k).image a : Finset ℕ) := by
      rintro n ⟨hn, h1, h2⟩
      obtain ⟨i, rfl⟩ := hrange.symm ▸ hn
      have hik : i < k := hmono.lt_iff_lt.1 (show a i < a k by omega)
      exact mem_coe.2 (mem_image_of_mem a (mem_range.2 hik))
    calc A.countUpTo (a k - 1) ≤ #((range k).image a) := by
          rw [← Set.ncard_coe_finset]
          exact Set.ncard_le_ncard hsub (finite_toSet _)
      _ ≤ k := card_image_le.trans (card_range k).le
  have h := (hcount (a k - 1) (by omega)).trans (Nat.pow_le_pow_left hle 2)
  omega

/-- **Lemma 2.** If `C` is infinite and `G`-good, then `P(C)` is `G`-syndetic. -/
theorem syndetic_of_good {a : ℕ → ℕ} (ha : StrictMono a) {C : Set ℕ} (hC : C.Infinite) {G : ℕ}
    (hG : Good a C G) : Syndetic (P a C) G := by
  have claim : ∀ m u, u ≤ G + S a C m → ∃ c ∈ P a (C ∩ Set.Iio m), c ≤ u ∧ u ≤ c + G := by
    intro m
    induction m with
    | zero => exact fun u hu => ⟨0, zero_mem_P a _, Nat.zero_le u, by simpa [S] using hu⟩
    | succ m ih =>
      intro u hu
      have hsub : C ∩ Set.Iio m ⊆ C ∩ Set.Iio (m + 1) :=
        Set.inter_subset_inter_right C (Set.Iio_subset_Iio m.le_succ)
      by_cases hum : u ≤ G + S a C m
      · obtain ⟨c, hc, h1, h2⟩ := ih u hum
        exact ⟨c, P_mono hsub hc, h1, h2⟩
      · rw [S_succ] at hu
        have hm : m ∈ C := by
          by_contra hm
          rw [Set.indicator_of_notMem hm] at hu
          omega
        rw [Set.indicator_of_mem hm] at hu
        have ham := hG m hm
        obtain ⟨c, hc, h1, h2⟩ := ih (u - a m) (by omega)
        have hdisj : Disjoint (C ∩ Set.Iio m) {m} :=
          Set.disjoint_singleton_right.2 fun h => lt_irrefl m h.2
        have hsum : c + a m ∈ P a (C ∩ Set.Iio m ∪ {m}) :=
          P_add hdisj hc ⟨{m}, by simp, by simp⟩
        refine ⟨c + a m, P_mono ?_ hsum, by omega, by omega⟩
        exact Set.union_subset hsub (Set.singleton_subset_iff.2 ⟨hm, m.lt_succ_self⟩)
  intro u
  obtain ⟨m, hm, hum⟩ := hC.exists_gt u
  have h1 : S a C m + a m ≤ S a C (m + 1) := S_add_le hm m.lt_succ_self
  have h2 : m ≤ a m := ha.le_apply
  obtain ⟨c, hc, h⟩ := claim (m + 1) u (by omega)
  exact ⟨c, P_mono Set.inter_subset_left hc, h⟩

/-- **Lemma 3, first part.** There is a finite `F ⊆ C` such that every sum from `C \ F` can be
completed to a multiple of `d` by a sum from `F`. -/
theorem exists_completion (a : ℕ → ℕ) (C : Set ℕ) {d : ℕ} (hd : 0 < d) :
    ∃ F : Finset ℕ, (F : Set ℕ) ⊆ C ∧ ∀ c ∈ P a (C \ F), ∃ f ∈ P a F, d ∣ f + c := by
  have : NeZero d := ⟨hd.ne'⟩
  -- `H` is the set of residues of `P(C)`, and `T h` has a sum with residue `h`
  set H : Set (ZMod d) := Nat.cast '' P a C
  have hH : ∀ h ∈ H, ∃ T : Finset ℕ, (T : Set ℕ) ⊆ C ∧ ((∑ i ∈ T, a i : ℕ) : ZMod d) = h := by
    rintro _ ⟨_, ⟨T, hT, rfl⟩, rfl⟩
    exact ⟨T, hT, rfl⟩
  choose! T hTC hT using hH
  set F : Finset ℕ := H.toFinite.toFinset.biUnion T
  have hFC : (F : Set ℕ) ⊆ C := by
    intro i hi
    obtain ⟨h, hh, hi⟩ := mem_biUnion.1 (mem_coe.1 hi)
    exact hTC h (H.toFinite.mem_toFinset.1 hh) hi
  have hF : ∀ h ∈ H, ∃ f ∈ P a F, (f : ZMod d) = h := fun h hh =>
    ⟨_, ⟨T h, coe_subset.2 (subset_biUnion_of_mem T (H.toFinite.mem_toFinset.2 hh)), rfl⟩, hT h hh⟩
  refine ⟨F, hFC, fun c hc => ?_⟩
  -- `h ↦ h + c` is an injective map of `H` into itself, hence onto
  have hmaps : Set.MapsTo (· + (c : ZMod d)) H H := by
    intro h hh
    obtain ⟨f, hf, rfl⟩ := hF h hh
    exact ⟨f + c, P_mono (Set.union_subset hFC Set.sdiff_subset)
      (P_add Set.disjoint_sdiff_right hf hc), Nat.cast_add f c⟩
  have hbij := (H.toFinite.injOn_iff_bijOn_of_mapsTo hmaps).1 (add_left_injective _).injOn
  obtain ⟨h, hh, h0⟩ := hbij.surjOn ⟨0, zero_mem_P a C, Nat.cast_zero⟩
  obtain ⟨f, hf, rfl⟩ := hF h hh
  exact ⟨f, hf, (ZMod.natCast_eq_zero_iff _ _).1 ((Nat.cast_add f c).trans h0)⟩

/-- **Lemma 3.** If `C` is infinite and good, then the multiples of `d` in `P(C)` form a syndetic
set. -/
theorem syndetic_multiples {a : ℕ → ℕ} (ha : StrictMono a) {C : Set ℕ} (hC : C.Infinite) {G : ℕ}
    (hG : Good a C G) {d : ℕ} (hd : 0 < d) : ∃ Γ, Syndetic {c ∈ P a C | d ∣ c} Γ := by
  obtain ⟨F, hFC, hF⟩ := exists_completion a C hd
  set σ := ∑ i ∈ F, a i
  have hgood : Good a (C \ F) (G + σ) := by
    intro m hm
    have h1 := hG m hm.1
    have h2 : S a C m ≤ S a (C \ F) m + σ := by
      calc S a C m ≤ ∑ i ∈ range m, ((C \ F).indicator a i + (F : Set ℕ).indicator a i) := by
            refine sum_le_sum fun i _ => ?_
            by_cases hi : i ∈ C <;> by_cases hi' : i ∈ F <;> simp [hi, hi']
        _ = S a (C \ F) m + ∑ i ∈ range m ∩ F, a i := by
            rw [sum_add_distrib, sum_indicator_eq_sum_inter, S]
        _ ≤ S a (C \ F) m + σ := Nat.add_le_add_left (sum_le_sum_of_subset inter_subset_right) _
    omega
  refine ⟨G + 2 * σ, fun u => ?_⟩
  by_cases hu : u < σ
  · exact ⟨0, ⟨zero_mem_P a C, dvd_zero d⟩, Nat.zero_le u, by omega⟩
  obtain ⟨c, hc, h1, h2⟩ := syndetic_of_good ha (hC.sdiff F.finite_toSet) hgood (u - σ)
  obtain ⟨f, hf, hfc⟩ := hF c hc
  have hfσ : f ≤ σ := by
    obtain ⟨U, hU, rfl⟩ := hf
    exact sum_le_sum_of_subset (coe_subset.1 hU)
  have hmem : f + c ∈ P a C :=
    P_mono (Set.union_subset hFC Set.sdiff_subset) (P_add Set.disjoint_sdiff_right hf hc)
  exact ⟨f + c, ⟨hmem, hfc⟩, by omega, by omega⟩

/-- **Lemma 4.** If `C` is infinite and good, `J` is disjoint from `C`, and `P(J)` contains
arbitrarily long progressions with difference `d`, then `P(J ∪ C)` contains an infinite progression
with difference `d`. -/
theorem glue {a : ℕ → ℕ} (ha : StrictMono a) {J C : Set ℕ} (hJC : Disjoint J C)
    (hC : C.Infinite) {G : ℕ} (hG : Good a C G) {d : ℕ} (hd : 0 < d)
    (hJ : ∀ L, ∃ x, ∀ j ≤ L, x + j * d ∈ P a J) : ∃ x, ∀ k, x + k * d ∈ P a (J ∪ C) := by
  obtain ⟨Γ, hΓ⟩ := syndetic_multiples ha hC hG hd
  obtain ⟨x, hx⟩ := hJ Γ
  refine ⟨x, fun k => ?_⟩
  obtain ⟨c, ⟨hcC, e, rfl⟩, h1, h2⟩ := hΓ (k * d)
  rw [mul_comm d e] at hcC h1 h2
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_mul_le_mul_right h1 hd)
  rw [add_mul] at h2
  have hj : j ≤ Γ := (Nat.le_mul_of_pos_right j hd).trans (by omega)
  rw [show x + (e + j) * d = x + j * d + e * d by ring]
  exact P_add hJC (hx j hj) hcC

/-! ### 2. Case 1: some difference `a (i + 1) - a i` occurs infinitely often -/

/-- **Lemma 5.** If `a` is strictly increasing and `a (i + 1) ≠ a i + 1` infinitely often, then
`a i - i` tends to infinity. -/
theorem add_le_of_frequently {a : ℕ → ℕ} (ha : StrictMono a)
    (h : ∃ᶠ i in atTop, a (i + 1) ≠ a i + 1) (E : ℕ) : ∀ᶠ i in atTop, i + E ≤ a i := by
  have hstep : ∀ i, a i < a (i + 1) := fun i => ha i.lt_succ_self
  induction E with
  | zero => exact Eventually.of_forall fun i => ha.le_apply
  | succ E ih =>
    obtain ⟨n, hn⟩ := eventually_atTop.1 ih
    obtain ⟨i, hi, hai⟩ := frequently_atTop.1 h n
    refine eventually_atTop.2 ⟨i + 1, fun j hj => ?_⟩
    induction j, hj using Nat.le_induction with
    | base =>
      have := hn i hi
      have := hstep i
      omega
    | succ j _ ihj =>
      have := hstep j
      omega

/-- **Choice of the pairs** for Lemma 6. If `Q i` holds infinitely often, there is an increasing
sequence of such `i` with `p_{r+1} ≥ 3 p_r + 9`. -/
theorem exists_sparse {Q : ℕ → Prop} (hQ : ∃ᶠ i in atTop, Q i) :
    ∃ p : ℕ → ℕ, StrictMono p ∧ (∀ r, Q (p r)) ∧ ∀ r, 3 * p r + 9 ≤ p (r + 1) := by
  choose f hf hfQ using frequently_atTop.1 hQ
  let p : ℕ → ℕ := fun r => Nat.rec (f 0) (fun _ m => f (3 * m + 9)) r
  have hp : ∀ r, 3 * p r + 9 ≤ p (r + 1) := fun r => hf _
  exact ⟨p, strictMono_nat_of_lt_succ fun r => by have := hp r; omega,
    fun r => by cases r <;> exact hfQ _, hp⟩

/-- The index set `B = {p_0, p_0 + 1, p_1, p_1 + 1, ...}`. -/
def pairs (p : ℕ → ℕ) : Set ℕ := {i | ∃ r, i = p r ∨ i = p r + 1}

/-- The elements of `B` below `p_{r+1}` are at most `p_r + 1`. -/
theorem le_of_mem_pairs {p : ℕ → ℕ} (hmono : StrictMono p) {r i : ℕ} (hi : i ∈ pairs p)
    (h : i < p (r + 1)) : i ≤ p r + 1 := by
  obtain ⟨s, hs⟩ := hi
  have hsr : s < r + 1 := hmono.lt_iff_lt.1 (by omega)
  have := hmono.monotone (Nat.le_of_lt_succ hsr)
  omega

/-- **Lemma 6(a).** The sum `W(m)` of `i + 4` over the indices `i < m` in `B` is at most `3 m + 6`,
and at most `p_r` if `m ≤ p_r`. (Every `m` satisfies `m ≤ p_m`.) -/
theorem S_pairs_le {p : ℕ → ℕ} (hmono : StrictMono p) (hp : ∀ r, 3 * p r + 9 ≤ p (r + 1))
    {r m : ℕ} (hm : m ≤ p r) :
    S (· + 4) (pairs p) m ≤ 3 * m + 6 ∧ S (· + 4) (pairs p) m ≤ p r := by
  induction r generalizing m with
  | zero =>
    have h : S (· + 4) (pairs p) m = 0 := by
      refine sum_eq_zero fun i hi => Set.indicator_of_notMem ?_ _
      rintro ⟨s, hs⟩
      have := hmono.monotone s.zero_le
      rw [mem_range] at hi
      omega
    omega
  | succ r ih =>
    have hpr := hp r
    have h0 := ih le_rfl
    have h0' := @ih m
    -- no element of `B` lies in `[p r + 2, m)`
    have h1 : S (· + 4) (pairs p) m ≤ S (· + 4) (pairs p) (p r + 1 + 1) := by
      refine sum_le_sum_of_ne_zero fun i hi hne => ?_
      rw [mem_range] at hi ⊢
      have := le_of_mem_pairs hmono (Set.mem_of_indicator_ne_zero hne) (hi.trans_le hm)
      omega
    rw [S_succ, S_succ, Set.indicator_of_mem (show p r ∈ pairs p from ⟨r, Or.inl rfl⟩),
      Set.indicator_of_mem (show p r + 1 ∈ pairs p from ⟨r, Or.inr rfl⟩)] at h1
    omega

/-- **Lemma 6(b).** If `a (p_r + 1) = a p_r + d` for all `r`, then `P(B)` contains arbitrarily long
progressions with difference `d`. -/
theorem pairs_progression {a p : ℕ → ℕ} (hp : ∀ r, 3 * p r + 9 ≤ p (r + 1)) {d : ℕ}
    (hd : ∀ r, a (p r + 1) = a (p r) + d) (L : ℕ) :
    ∃ x, ∀ j ≤ L, x + j * d ∈ P a (pairs p) := by
  refine ⟨∑ r ∈ range L, a (p r), fun j hj => ?_⟩
  -- take the larger index of the first `j` pairs and the smaller index of the others
  let q : ℕ → ℕ := fun r => p r + if r < j then 1 else 0
  have hq : StrictMono q := strictMono_nat_of_lt_succ fun r => by
    have := hp r
    simp only [q]
    split_ifs <;> omega
  refine ⟨(range L).map ⟨q, hq.injective⟩, ?_, ?_⟩
  · intro i hi
    obtain ⟨r, -, rfl⟩ := mem_map.1 (mem_coe.1 hi)
    refine ⟨r, ?_⟩
    simp only [Function.Embedding.coeFn_mk, q]
    split_ifs <;> simp
  · have haq : ∀ r, a (q r) = a (p r) + if r < j then d else 0 := by
      intro r
      simp only [q]
      split_ifs
      · exact hd r
      · rfl
    have hfilter : {r ∈ range L | r < j} = range j := by
      ext
      simp only [mem_filter, mem_range]
      omega
    rw [sum_map]
    simp only [Function.Embedding.coeFn_mk, haq]
    rw [sum_add_distrib, ← sum_filter, hfilter, sum_const, smul_eq_mul, card_range]

/-- The sum of `i + 4` over `i < m` is `(m ^ 2 + 7 m) / 2`. -/
theorem two_mul_sum (m : ℕ) : 2 * ∑ i ∈ range m, (i + 4) = m ^ 2 + 7 * m := by
  induction m with
  | zero => simp
  | succ m ih => rw [sum_range_succ, mul_add, ih]; ring

/-- **Lemma 7.** If `2 * a k ≤ k ^ 2 + 2` and `a k ≥ k + 4` for all large `k`, then the complement
of `B` is good. -/
theorem good_compl_pairs {a p : ℕ → ℕ} (ha : StrictMono a)
    (hquad : ∀ᶠ k in atTop, 2 * a k ≤ k ^ 2 + 2) (hfour : ∀ᶠ k in atTop, k + 4 ≤ a k)
    (hmono : StrictMono p) (hp : ∀ r, 3 * p r + 9 ≤ p (r + 1)) : ∃ G, Good a (pairs p)ᶜ G := by
  obtain ⟨k₀, hk₀⟩ := eventually_atTop.1 (hquad.and hfour)
  set C := (pairs p)ᶜ
  set w := ∑ i ∈ range k₀, (i + 4)
  refine ⟨a k₀ + w + 7, fun m _ => ?_⟩
  rcases lt_or_ge m k₀ with hm | hm
  · have := ha hm
    omega
  have h1 : S (· + 4) (pairs p) m + S (· + 4) C m = ∑ i ∈ range m, (i + 4) := by
    rw [S, S, ← sum_add_distrib]
    exact sum_congr rfl fun i _ => Set.indicator_self_add_compl_apply _ _ i
  have h2 : S (· + 4) C m ≤ S a C m + w := by
    calc S (· + 4) C m ≤ ∑ i ∈ range m, (C.indicator a i + if i < k₀ then i + 4 else 0) := by
          refine sum_le_sum fun i _ => ?_
          by_cases hi : i ∈ C
          · rw [Set.indicator_of_mem hi, Set.indicator_of_mem hi]
            have := fun h => (hk₀ i h).2
            split_ifs <;> omega
          · rw [Set.indicator_of_notMem hi]
            exact Nat.zero_le _
      _ = S a C m + ∑ i ∈ range m with i < k₀, (i + 4) := by
          rw [sum_add_distrib, ← sum_filter, S]
      _ ≤ S a C m + w := by
          refine Nat.add_le_add_left (sum_le_sum_of_subset fun i hi => ?_) _
          exact mem_range.2 (mem_filter.1 hi).2
  have h3 := (S_pairs_le hmono hp (hmono.le_apply (x := m))).1
  have h4 := two_mul_sum m
  have h5 := (hk₀ m hm).1
  omega

/-- **Proposition 8 (Case 1).** If `2 * a k ≤ k ^ 2 + 2` for all large `k` and `a (i + 1) = a i + d`
for infinitely many `i`, then `P(ℕ)` contains an infinite progression. -/
theorem case1 {a : ℕ → ℕ} (ha : StrictMono a) (hquad : ∀ᶠ k in atTop, 2 * a k ≤ k ^ 2 + 2)
    {d : ℕ} (hd : ∃ᶠ i in atTop, a (i + 1) = a i + d) :
    ∃ x d, 0 < d ∧ ∀ k, x + k * d ∈ P a Set.univ := by
  by_cases h1 : ∃ᶠ i in atTop, a (i + 1) ≠ a i + 1
  · obtain ⟨p, hmono, hpd, hp⟩ := exists_sparse hd
    obtain ⟨G, hG⟩ := good_compl_pairs ha hquad (add_le_of_frequently ha h1 4) hmono hp
    have hd0 : 0 < d := by
      have h : a (p 0) < a (p 0 + 1) := ha (p 0).lt_succ_self
      have := hpd 0
      omega
    have hC : (pairs p)ᶜ.Infinite := by
      refine Set.infinite_of_injective_forall_mem (f := fun r => p r + 2)
        (fun r s h => hmono.injective (Nat.add_right_cancel h)) fun r h => ?_
      have := hp r
      have := le_of_mem_pairs hmono (r := r) h (by omega)
      omega
    obtain ⟨x, hx⟩ := glue ha disjoint_compl_right hC hG hd0 (pairs_progression hp hpd)
    exact ⟨x, d, hd0, fun k => P_mono (Set.subset_univ _) (hx k)⟩
  · -- `a (i + 1) = a i + 1` for all large `i`: the `a i` themselves contain a progression
    simp only [not_frequently, not_not] at h1
    obtain ⟨i₀, hi₀⟩ := eventually_atTop.1 h1
    have hstep : ∀ k, a (i₀ + k) = a i₀ + k * 1 := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [← add_assoc, hi₀ _ (Nat.le_add_right _ _), ih]; ring
    exact ⟨a i₀, 1, one_pos, fun k => ⟨{i₀ + k}, Set.subset_univ _, by simp [hstep]⟩⟩

/-! ### 3. Shifts with small loss -/

/-- `loss Z Z' v = |(Z + v) \ Z'|`, the number of `z ∈ Z` with `z + v ∉ Z'`. -/
def loss (Z Z' : Finset ℤ) (v : ℤ) : ℕ := #((v +ᵥ Z) \ Z')

/-- **Lemma 9(a).** The loss does not increase when the first set shrinks and the second one
grows. -/
theorem loss_mono {U Z Z' U' : Finset ℤ} (h : U ⊆ Z) (h' : Z' ⊆ U') (v : ℤ) :
    loss U U' v ≤ loss Z Z' v :=
  card_le_card (sdiff_subset_sdiff (vadd_finset_subset_vadd_finset h) h')

/-- **Lemma 9(b).** Losses add up along a chain of sets. -/
theorem loss_add (Z Z' Z'' : Finset ℤ) (v w : ℤ) :
    loss Z Z'' (v + w) ≤ loss Z Z' v + loss Z' Z'' w := by
  have hsub : ((v + w) +ᵥ Z) \ Z'' ⊆ (w +ᵥ ((v +ᵥ Z) \ Z')) ∪ ((w +ᵥ Z') \ Z'') := by
    rw [add_comm v w, add_vadd, vadd_finset_sdiff]
    intro z hz
    by_cases h : z ∈ w +ᵥ Z'
    · exact mem_union_right _ (mem_sdiff.2 ⟨h, (mem_sdiff.1 hz).2⟩)
    · exact mem_union_left _ (mem_sdiff.2 ⟨(mem_sdiff.1 hz).1, h⟩)
  calc loss Z Z'' (v + w) ≤ _ := card_le_card hsub
    _ ≤ #(w +ᵥ ((v +ᵥ Z) \ Z')) + loss Z' Z'' w := card_union_le _ _
    _ = loss Z Z' v + loss Z' Z'' w := by rw [card_vadd_finset, loss, loss]

/-- **Lemma 9(c).** Opposite shifts of a set into itself have the same loss. -/
theorem loss_neg (Z : Finset ℤ) (v : ℤ) : loss Z Z (-v) = loss Z Z v := by
  have h : ((-v) +ᵥ Z) \ Z = (-v) +ᵥ (Z \ (v +ᵥ Z)) := by
    rw [vadd_finset_sdiff, neg_vadd_vadd]
  rw [loss, loss, h, card_vadd_finset]
  exact card_sdiff_comm (card_vadd_finset v Z).symm

/-- **Lemma 9(d).** Repeating a shift `x` times multiplies its loss by at most `x`. -/
theorem loss_mul (Z : Finset ℤ) (v : ℤ) (x : ℕ) : loss Z Z (x * v) ≤ x * loss Z Z v := by
  induction x with
  | zero => simp [loss]
  | succ x ih =>
    have h := loss_add Z Z Z (x * v) v
    rw [Nat.cast_succ, add_mul, one_mul, add_mul, one_mul]
    omega

/-- The sets `Z_0 = Z` and `Z_{i+1} = Z_i ∪ (Z_i + b_i)`. -/
def grow (b : ℕ → ℕ) (Z : Finset ℤ) : ℕ → Finset ℤ
  | 0 => Z
  | i + 1 => ((b i : ℤ) +ᵥ grow b Z i) ∪ grow b Z i

/-- The increment `δ_i = |Z_{i+1}| - |Z_i|`, written as the loss of the shift `b_i` on `Z_i`. -/
def inc (b : ℕ → ℕ) (Z : Finset ℤ) (i : ℕ) : ℕ := loss (grow b Z i) (grow b Z i) (b i)

/-- The sets `Z_i` increase. -/
theorem grow_mono (b : ℕ → ℕ) (Z : Finset ℤ) : Monotone (grow b Z) :=
  monotone_nat_of_le_succ fun _ => subset_union_right

/-- **Lemma 10(a).** `δ_s + ... + δ_{m-1} = |Z_m| - |Z_s|`. -/
theorem sum_inc (b : ℕ → ℕ) (Z : Finset ℤ) {s m : ℕ} (h : s ≤ m) :
    ∑ i ∈ Ico s m, inc b Z i + #(grow b Z s) = #(grow b Z m) := by
  induction m, h using Nat.le_induction with
  | base => simp
  | succ m hm ih =>
    rw [sum_Ico_succ_top hm, grow, ← card_sdiff_add_card, ← ih, inc, loss]
    ring

/-- **Lemma 10(b).** For `s ≤ q ≤ p ≤ m`, the shift by `x (b_p - b_q)` from `Z_s` to `Z_m` loses at
most `x (δ_q + δ_p)`. -/
theorem loss_diff (b : ℕ → ℕ) (Z : Finset ℤ) {s q p m : ℕ} (hsq : s ≤ q) (hqp : q ≤ p)
    (hpm : p ≤ m) (x : ℕ) : loss (grow b Z s) (grow b Z m) (x * ((b p : ℤ) - b q)) ≤
      x * (inc b Z q + inc b Z p) := by
  have hmono := grow_mono b Z
  have e : (x : ℤ) * ((b p : ℤ) - b q) = x * -(b q : ℤ) + x * b p := by ring
  calc _ ≤ loss (grow b Z s) (grow b Z p) (x * -(b q : ℤ)) +
        loss (grow b Z p) (grow b Z m) (x * b p) := e ▸ loss_add _ _ _ _ _
    _ ≤ loss (grow b Z q) (grow b Z q) (x * -(b q : ℤ)) +
        loss (grow b Z p) (grow b Z p) (x * b p) :=
      Nat.add_le_add (loss_mono (hmono hsq) (hmono hqp) _)
        (loss_mono Subset.rfl (hmono hpm) _)
    _ ≤ x * loss (grow b Z q) (grow b Z q) (-(b q : ℤ)) +
        x * loss (grow b Z p) (grow b Z p) (b p) :=
      Nat.add_le_add (loss_mul _ _ _) (loss_mul _ _ _)
    _ = x * (inc b Z q + inc b Z p) := by rw [loss_neg, inc, inc, mul_add]

/-! ### 4. One block and all scales

Here `8 b_i ≤ κ s²` for all `i < 2s` (condition (1) of the write-up). The numbers `v` and `D` below
may depend on `Z`; `κ` depends only on `b`. -/

/-- **Lemma 11, first step.** More than half of the indices `i ∈ [s, 2s)` are cheap: `s δ_i` is at
most twice the sum of all the `δ_i`. -/
theorem many_cheap {s : ℕ} (hs : 0 < s) (δ : ℕ → ℕ) :
    s < 2 * #{i ∈ Ico s (2 * s) | s * δ i ≤ 2 * ∑ k ∈ Ico s (2 * s), δ k} := by
  set Δ := ∑ k ∈ Ico s (2 * s), δ k
  set E' := {i ∈ Ico s (2 * s) | ¬ s * δ i ≤ 2 * Δ}
  have hcard : #{i ∈ Ico s (2 * s) | s * δ i ≤ 2 * Δ} + #E' = s := by
    rw [card_filter_add_card_filter_not, Nat.card_Ico]
    omega
  by_contra hcon
  -- at least `s / 2` indices are not cheap, so the sum of their `s δ_i` is too large
  have hE' : s ≤ 2 * #E' := by omega
  have h : #E' * (2 * Δ) < s * Δ := by
    calc #E' * (2 * Δ) = ∑ i ∈ E', 2 * Δ := (sum_const_nat fun _ _ => rfl).symm
      _ < ∑ i ∈ E', s * δ i := sum_lt_sum_of_nonempty (card_pos.1 (by omega)) fun i hi =>
          not_le.1 (mem_filter.1 hi).2
      _ ≤ ∑ i ∈ Ico s (2 * s), s * δ i := sum_le_sum_of_subset (filter_subset _ _)
      _ = s * Δ := by rw [← mul_sum]
  linarith [Nat.mul_le_mul_right Δ hE']

/-- **Lemma 11, second step.** Among more than `s / 2` indices in `[s, 2s)` there are `q < p` such
that `b_p - b_q = v D` with `0 < v < κ s`. -/
theorem exists_pair {b : ℕ → ℕ} (hb : StrictMono b) {κ D s : ℕ} (hκ : 0 < κ) (hD : 0 < D)
    (hs : 4 * D ≤ s) (hbκ : ∀ i < 2 * s, 8 * b i ≤ κ * s ^ 2) {E : Finset ℕ}
    (hE : E ⊆ Ico s (2 * s)) (hcard : s < 2 * #E) :
    ∃ q ∈ E, ∃ p ∈ E, q < p ∧ ∃ v, 0 < v ∧ v < κ * s ∧ b p = b q + v * D := by
  have hs0 : 0 < s := by omega
  set w := κ * s * D with hw
  -- the pair of `b_i mod D` and `⌊b_i / w⌋` takes fewer values than `E` has elements
  have hmaps : Set.MapsTo (fun i => (b i % D, b i / w)) E
      (range D ×ˢ range (s / (8 * D) + 1) : Finset (ℕ × ℕ)) := by
    intro i hi
    refine mem_coe.2 (mem_product.2 ⟨mem_range.2 (Nat.mod_lt _ hD), ?_⟩)
    rw [mem_range, Nat.lt_succ_iff, Nat.le_div_iff_mul_le (by positivity)]
    refine Nat.le_of_mul_le_mul_left (c := κ * s) ?_ (by positivity)
    calc κ * s * (b i / w * (8 * D)) = 8 * (w * (b i / w)) := by rw [hw]; ring
      _ ≤ 8 * b i := Nat.mul_le_mul_left _ (Nat.mul_div_le _ _)
      _ ≤ κ * s ^ 2 := hbκ i (mem_Ico.1 (hE hi)).2
      _ = κ * s * s := by ring
  have hlt : #(range D ×ˢ range (s / (8 * D) + 1)) < #E := by
    rw [card_product, card_range, card_range]
    have : 8 * D * (s / (8 * D)) ≤ s := Nat.mul_div_le _ _
    nlinarith
  obtain ⟨q, hq, p, hp, hne, heq⟩ := exists_ne_map_eq_of_card_lt_of_maps_to hlt hmaps
  wlog hqp : q < p generalizing p q
  · exact this p hp q hq hne.symm heq.symm (by omega)
  obtain ⟨hmod, hdiv⟩ := Prod.mk.inj heq
  have hbqp := hb hqp
  obtain ⟨v, hv⟩ := (Nat.modEq_iff_dvd' hbqp.le).1 hmod
  have hv' : b p = b q + v * D := by
    rw [mul_comm v D, ← hv]
    omega
  refine ⟨q, hq, p, hp, hqp, v, ?_, ?_, hv'⟩
  · refine Nat.pos_of_ne_zero ?_
    rintro rfl
    omega
  · refine Nat.lt_of_mul_lt_mul_right (a := D) ?_
    have h1 := Nat.div_add_mod (b q) w
    have h2 := Nat.div_add_mod (b p) w
    have h3 : b p % w < w := Nat.mod_lt (b p) (by positivity)
    rw [← hdiv] at h2
    omega

/-- **Lemma 11 (one block).** If `4 D ≤ s`, some `v` with `0 < v < κ s` satisfies: for all
`x ≤ 4 κ² s`, the shift by `x v D` from `Z_s` to `Z_{2s}` loses at most
`16 κ² (|Z_{2s}| - |Z_s|)`. -/
theorem block {b : ℕ → ℕ} (hb : StrictMono b) {κ D s : ℕ} (hκ : 0 < κ) (hD : 0 < D)
    (hs : 4 * D ≤ s) (hbκ : ∀ i < 2 * s, 8 * b i ≤ κ * s ^ 2) (Z : Finset ℤ) :
    ∃ v, 0 < v ∧ v < κ * s ∧ ∀ x ≤ 4 * κ ^ 2 * s,
      loss (grow b Z s) (grow b Z (2 * s)) (x * (v * D)) ≤
        16 * κ ^ 2 * (#(grow b Z (2 * s)) - #(grow b Z s)) := by
  have hs0 : 0 < s := by omega
  obtain ⟨q, hq, p, hp, hqp, v, hv0, hv, hbpq⟩ :=
    exists_pair hb hκ hD hs hbκ (filter_subset _ _) (many_cheap hs0 (inc b Z))
  refine ⟨v, hv0, hv, fun x hx => ?_⟩
  rw [mem_filter, mem_Ico] at hq hp
  set Δ := ∑ i ∈ Ico s (2 * s), inc b Z i
  rw [← sum_inc b Z (show s ≤ 2 * s by omega), Nat.add_sub_cancel]
  have e : (v * D : ℤ) = (b p : ℤ) - b q := by
    rw [hbpq]
    push_cast
    ring
  rw [e]
  refine (loss_diff b Z hq.1.1 hqp.le hp.1.2.le x).trans ?_
  refine Nat.le_of_mul_le_mul_left (c := s) ?_ hs0
  calc s * (x * (inc b Z q + inc b Z p)) = x * (s * inc b Z q + s * inc b Z p) := by ring
    _ ≤ (4 * κ ^ 2 * s) * (2 * Δ + 2 * Δ) := Nat.mul_le_mul hx (Nat.add_le_add hq.2 hp.2)
    _ = s * (16 * κ ^ 2 * Δ) := by ring

/-- **Lemma 12 (all scales).** There is `D` with `0 < D < κ n` such that for all `k` and all
`x ≤ 4 κ² s`, where `s = (4 κ)^k n`, the shift by `x D` from `Z_n` to `Z_{2s}` loses at most
`16 κ² (|Z_{2s}| - |Z_n|)`. -/
theorem scales {b : ℕ → ℕ} (hb : StrictMono b) {κ n : ℕ} (hκ : 0 < κ) (hn : 4 ≤ n)
    (hbκ : ∀ s, ∀ i < 2 * s, 8 * b i ≤ κ * s ^ 2) (Z : Finset ℤ) :
    ∃ D, 0 < D ∧ D < κ * n ∧ ∀ k, ∀ x ≤ 4 * κ ^ 2 * ((4 * κ) ^ k * n),
      loss (grow b Z n) (grow b Z (2 * ((4 * κ) ^ k * n))) (x * D) ≤
        16 * κ ^ 2 * (#(grow b Z (2 * ((4 * κ) ^ k * n))) - #(grow b Z n)) := by
  obtain ⟨D, hD0, hD, hD1⟩ := block hb hκ one_pos hn (hbκ n) Z
  refine ⟨D, hD0, hD, fun k => ?_⟩
  induction k with
  | zero => simpa using hD1
  | succ k ih =>
    intro x hx
    set s := (4 * κ) ^ k * n with hs
    rw [show (4 * κ) ^ (k + 1) * n = 4 * (κ * s) by rw [hs]; ring] at hx ⊢
    set s' := 4 * (κ * s) with hs'
    have hκn : κ * n ≤ κ * s := Nat.mul_le_mul_left κ (Nat.le_mul_of_pos_left n (by positivity))
    have hns : n ≤ s := Nat.le_mul_of_pos_left n (by positivity)
    have hκs : s ≤ κ * s := Nat.le_mul_of_pos_left s hκ
    obtain ⟨v, hv0, hv, hv1⟩ := block (s := s') hb hκ hD0 (by omega) (hbκ s') Z
    -- divide `x` by `v`; the remainder is handled by the induction hypothesis
    have hrem : x % v ≤ 4 * κ ^ 2 * s := by
      calc x % v ≤ κ * s' := ((Nat.mod_lt x hv0).trans hv).le
        _ = 4 * κ ^ 2 * s := by rw [hs']; ring
    have h1 := ih (x % v) hrem
    have h2 := hv1 (x / v) ((Nat.div_le_self x v).trans hx)
    have h3 := loss_add (grow b Z n) (grow b Z (2 * s)) (grow b Z (2 * s')) ((x % v : ℕ) * D)
      ((x / v : ℕ) * (v * D))
    have h4 : loss (grow b Z (2 * s)) (grow b Z (2 * s')) ((x / v : ℕ) * (v * D)) ≤
        loss (grow b Z s') (grow b Z (2 * s')) ((x / v : ℕ) * (v * D)) :=
      loss_mono (grow_mono b Z (by omega)) Subset.rfl _
    -- `|Z_n| ≤ |Z_{2s}| ≤ |Z_{s'}| ≤ |Z_{2s'}|`, so the two differences add up to at most the third
    have h5 := card_le_card (grow_mono b Z (show n ≤ 2 * s by omega))
    have h6 := card_le_card (grow_mono b Z (show 2 * s ≤ s' by omega))
    have h7 := card_le_card (grow_mono b Z (show s' ≤ 2 * s' by omega))
    have h8 : 16 * κ ^ 2 * (#(grow b Z (2 * s)) - #(grow b Z n)) +
        16 * κ ^ 2 * (#(grow b Z (2 * s')) - #(grow b Z s')) ≤
          16 * κ ^ 2 * (#(grow b Z (2 * s')) - #(grow b Z n)) := by
      rw [← mul_add]
      exact Nat.mul_le_mul_left _ (by omega)
    have e : (x * D : ℤ) = (x % v : ℕ) * D + (x / v : ℕ) * (v * D) := by
      have h : (x : ℤ) = (x % v : ℕ) + v * (x / v : ℕ) := by
        exact_mod_cast (Nat.mod_add_div x v).symm
      rw [h]
      ring
    rw [e]
    omega

/-! ### 5. The key proposition -/

/-- **Lemma 13 (saturation).** If `φ_i(R) ≤ g R + c_i` for all `i`, `R`, then for all `M`, `n₀`
there is `n ≥ n₀` such that for every `m ≥ n` some `R` has `M (φ_m(R) - φ_n(R)) < R`. -/
theorem saturation {φ : ℕ → ℕ → ℕ} {c : ℕ → ℕ} {g : ℕ} (hφ : ∀ i R, φ i R ≤ g * R + c i)
    (M n₀ : ℕ) : ∃ n ≥ n₀, ∀ m ≥ n, ∃ R, M * φ m R < M * φ n R + R := by
  by_contra! hcon
  have hiter : ∀ r, ∃ m ≥ n₀, ∀ R, r * R ≤ M * φ m R := by
    intro r
    induction r with
    | zero => exact ⟨n₀, le_rfl, fun R => by simp⟩
    | succ r ih =>
      obtain ⟨m, hm, h1⟩ := ih
      obtain ⟨m', hm', h2⟩ := hcon m hm
      refine ⟨m', hm.trans hm', fun R => ?_⟩
      have := h1 R
      have := h2 R
      rw [add_mul, one_mul]
      omega
  obtain ⟨m, -, h1⟩ := hiter (M * (g + 1) + 1)
  have h2 := h1 (c m + 1)
  have h3 := Nat.mul_le_mul_left M (hφ m (c m + 1))
  nlinarith

/-- **Lemma 14 (popular sum).** Let `Y` be `G`-syndetic, and let `Z`, `Z'` be finite sets of
integers, where `Z` has no negative elements and `(G + 1) ℓ < |Z|`. Some `t` has `t + v ∈ Y + Z'`
whenever `loss Z Z' v ≤ ℓ`. -/
theorem popular {Y : Set ℕ} {G : ℕ} (hY : Syndetic Y G) {Z : Finset ℤ} (Z' : Finset ℤ) {ℓ : ℕ}
    (hZ : (G + 1) * ℓ < #Z) (hZ0 : ∀ z ∈ Z, 0 ≤ z) :
    ∃ t : ℕ, ∀ v, loss Z Z' v ≤ ℓ → ∃ y ∈ Y, ∃ z ∈ Z', (t : ℤ) + v = y + z := by
  obtain ⟨u, hu⟩ : ∃ u : ℕ, ∀ z ∈ Z, z ≤ u := by
    obtain ⟨u, hu⟩ := Z.bddAbove
    exact ⟨u.toNat, fun z hz => (hu hz).trans (Int.self_le_toNat u)⟩
  choose y hyY hy1 hy2 using hY
  -- `f z = z + y` with some `y ∈ Y` such that `u ≤ f z ≤ u + G`
  let f : ℤ → ℕ := fun z => z.toNat + y (u + G - z.toNat)
  have hmaps : ∀ z ∈ Z, f z ∈ Icc u (u + G) := by
    intro z hz
    have h1 := hu z hz
    have h2 := hy1 (u + G - z.toNat)
    have h3 := hy2 (u + G - z.toNat)
    rw [mem_Icc]
    simp only [f]
    omega
  obtain ⟨t, -, ht⟩ := exists_lt_card_fiber_of_mul_lt_card_of_maps_to hmaps (n := ℓ) (by
    rwa [Nat.card_Icc, show u + G + 1 - u = G + 1 by omega])
  refine ⟨t, fun v hloss => ?_⟩
  -- more than `ℓ` elements `z` have `f z = t`, so one of them survives the shift
  obtain ⟨z, hz, hzv⟩ : ∃ z ∈ {z ∈ Z | f z = t}, v + z ∈ Z' := by
    by_contra! hcon
    have hsub : v +ᵥ {z ∈ Z | f z = t} ⊆ (v +ᵥ Z) \ Z' := by
      intro w hw
      obtain ⟨z, hz, rfl⟩ := mem_vadd_finset.1 hw
      exact mem_sdiff.2 ⟨vadd_mem_vadd_finset (mem_filter.1 hz).1, hcon z hz⟩
    have h := card_le_card hsub
    rw [card_vadd_finset] at h
    exact absurd (h.trans hloss) (not_le.2 ht)
  obtain ⟨hzZ, hft⟩ := mem_filter.1 hz
  refine ⟨_, hyY (u + G - z.toNat), v + z, hzv, ?_⟩
  have := hZ0 z hzZ
  simp only [f] at hft
  omega

/-- For every `R`, a `G`-syndetic set `X` has at least `R` elements below `(G + 1) R`. -/
theorem exists_start {X : Set ℕ} {G : ℕ} (hX : Syndetic X G) (R : ℕ) : ∃ Z : Finset ℤ,
    R ≤ #Z ∧ ∀ z ∈ Z, ∃ x ∈ X, z = (x : ℤ) ∧ x < (G + 1) * R := by
  classical
  set Z := {x ∈ range ((G + 1) * R) | x ∈ X}
  refine ⟨Z.image (↑), ?_, fun z hz => ?_⟩
  · -- every interval `[j (G + 1), j (G + 1) + G]` with `j < R` contains an element of `X`
    have h : Set.SurjOn (· / (G + 1)) (Z : Set ℕ) (range R : Finset ℕ) := by
      intro j hj
      obtain ⟨x, hxX, h1, h2⟩ := hX (j * (G + 1) + G)
      have h3 : (j + 1) * (G + 1) ≤ R * (G + 1) := Nat.mul_le_mul_right _ (mem_range.1 hj)
      have h4 : (j + 1) * (G + 1) = j * (G + 1) + (G + 1) := add_one_mul _ _
      rw [mul_comm R] at h3
      exact ⟨x, mem_coe.2 (mem_filter.2 ⟨mem_range.2 (by omega), hxX⟩),
        Nat.div_eq_of_lt_le (by omega) (by omega)⟩
    rw [card_image_of_injective _ Nat.cast_injective, ← card_range R]
    exact card_le_card_of_surjOn _ h
  · obtain ⟨x, hx, rfl⟩ := mem_image.1 hz
    exact ⟨x, (mem_filter.1 hx).2, rfl, mem_range.1 (mem_filter.1 hx).1⟩

/-- Every element of `Z_i` is an element of `Z` plus a sum of distinct terms among
`b_0, ..., b_{i-1}`. -/
theorem mem_grow {b : ℕ → ℕ} {Z : Finset ℤ} {i : ℕ} : ∀ z ∈ grow b Z i,
    ∃ x ∈ Z, ∃ T ⊆ range i, z = x + ((∑ k ∈ T, b k : ℕ) : ℤ) := by
  induction i with
  | zero => exact fun z hz => ⟨z, hz, ∅, by simp, by simp⟩
  | succ i ih =>
    intro z hz
    have hsub : range i ⊆ range (i + 1) := range_subset_range.2 i.le_succ
    rcases mem_union.1 hz with hz | hz
    · obtain ⟨w, hw, rfl⟩ := mem_vadd_finset.1 hz
      obtain ⟨x, hx, T, hT, rfl⟩ := ih w hw
      have hi : i ∉ T := fun h => lt_irrefl i (mem_range.1 (hT h))
      refine ⟨x, hx, insert i T, insert_subset (self_mem_range_succ i) (hT.trans hsub), ?_⟩
      rw [sum_insert hi, vadd_eq_add]
      push_cast
      ring
    · obtain ⟨x, hx, T, hT, rfl⟩ := ih z hz
      exact ⟨x, hx, T, hT.trans hsub, rfl⟩

/-- If `Z` consists of natural numbers below `K`, then `|Z_i| ≤ K + b_0 + ... + b_{i-1}`. -/
theorem card_grow_le {b : ℕ → ℕ} {Z : Finset ℤ} {K : ℕ} (hZ : ∀ z ∈ Z, 0 ≤ z ∧ z < K) (i : ℕ) :
    #(grow b Z i) ≤ K + ∑ k ∈ range i, b k := by
  have hsub : grow b Z i ⊆ Ico 0 ((K + ∑ k ∈ range i, b k : ℕ) : ℤ) := by
    intro z hz
    obtain ⟨x, hx, T, hT, rfl⟩ := mem_grow z hz
    have h1 := hZ x hx
    have h2 : ∑ k ∈ T, b k ≤ ∑ k ∈ range i, b k := sum_le_sum_of_subset hT
    rw [mem_Ico]
    omega
  calc #(grow b Z i) ≤ _ := card_le_card hsub
    _ = K + ∑ k ∈ range i, b k := by rw [Int.card_Ico]; omega

/-- **Proposition 15 (key proposition).** If `X`, `Y` are `G`-syndetic and `b` is strictly
increasing with `8 b_i ≤ κ s²` for all `i < 2s`, then the sumset of `X`, `Y` and the set of sums of
distinct `b_i` contains arbitrarily long progressions with one fixed difference `d`. -/
theorem key {X Y : Set ℕ} {G κ : ℕ} (hX : Syndetic X G) (hY : Syndetic Y G) {b : ℕ → ℕ}
    (hb : StrictMono b) (hκ : 0 < κ) (hbκ : ∀ s, ∀ i < 2 * s, 8 * b i ≤ κ * s ^ 2) :
    ∃ d, 0 < d ∧ ∀ L, ∃ t, ∀ j ≤ L, ∃ x ∈ X, ∃ y ∈ Y, ∃ T : Finset ℕ,
      t + j * d = x + y + ∑ i ∈ T, b i := by
  choose Z hZcard hZ using exists_start hX
  have hcard : ∀ i R, #(grow b (Z R) i) ≤ (G + 1) * R + ∑ k ∈ range i, b k := by
    refine fun i R => card_grow_le (fun z hz => ?_) i
    obtain ⟨x, -, rfl, hx⟩ := hZ R z hz
    exact ⟨Int.natCast_nonneg x, by exact_mod_cast hx⟩
  obtain ⟨n, hn4, hn⟩ := saturation hcard ((G + 1) * (16 * κ ^ 2)) 4
  refine ⟨(κ * n).factorial, Nat.factorial_pos _, fun L => ?_⟩
  set d := (κ * n).factorial
  obtain ⟨k, hk⟩ : ∃ k, L * d ≤ (4 * κ) ^ k * n :=
    ⟨L * d, (Nat.lt_pow_self (by omega)).le.trans (Nat.le_mul_of_pos_right _ (by omega))⟩
  set s := (4 * κ) ^ k * n
  have hns : n ≤ s := Nat.le_mul_of_pos_left n (by positivity)
  obtain ⟨R, hR⟩ := hn (2 * s) (by omega)
  obtain ⟨D, hD0, hD, hloss⟩ := scales hb hκ hn4 hbκ (Z R)
  have hlt : (G + 1) * (16 * κ ^ 2 * (#(grow b (Z R) (2 * s)) - #(grow b (Z R) n))) <
      #(grow b (Z R) n) := by
    have hle := Nat.mul_le_mul_left ((G + 1) * (16 * κ ^ 2))
      (card_le_card (grow_mono b (Z R) (show n ≤ 2 * s by omega)))
    calc _ = (G + 1) * (16 * κ ^ 2) * #(grow b (Z R) (2 * s)) -
          (G + 1) * (16 * κ ^ 2) * #(grow b (Z R) n) := by rw [← mul_assoc, Nat.mul_sub]
      _ < R := by omega
      _ ≤ #(grow b (Z R) 0) := hZcard R
      _ ≤ #(grow b (Z R) n) := card_le_card (grow_mono b (Z R) (Nat.zero_le n))
  obtain ⟨t, ht⟩ := popular hY (grow b (Z R) (2 * s)) hlt fun z hz => by
    obtain ⟨_, hx, T, -, rfl⟩ := mem_grow z hz
    obtain ⟨x, -, rfl, -⟩ := hZ R _ hx
    positivity
  obtain ⟨e, he⟩ : D ∣ d := Nat.dvd_factorial hD0 hD.le
  refine ⟨t, fun j hj => ?_⟩
  have hje : j * e ≤ 4 * κ ^ 2 * s := by
    calc j * e ≤ L * d := Nat.mul_le_mul hj (he ▸ Nat.le_mul_of_pos_left e hD0)
      _ ≤ s := hk
      _ ≤ 4 * κ ^ 2 * s := Nat.le_mul_of_pos_left s (by positivity)
  obtain ⟨y, hy, z, hz, h⟩ := ht _ (hloss k (j * e) hje)
  obtain ⟨_, hx, T, -, rfl⟩ := mem_grow z hz
  obtain ⟨x, hxX, rfl, -⟩ := hZ R _ hx
  refine ⟨x, hxX, y, hy, T, ?_⟩
  have hjd : ((j * d : ℕ) : ℤ) = (j * e : ℕ) * D := by
    rw [he]
    push_cast
    ring
  omega

/-! ### 6. Case 2: `a (i + 1) ≥ a i + 11` for all large `i` -/

/-- **Lemma 16(a).** If `a (i + 1) ≥ a i + 11` for all large `i`, then `a k ≥ 10 * k` for all large
`k`. -/
theorem linear_of_gaps {a : ℕ → ℕ} (h : ∀ᶠ i in atTop, a i + 11 ≤ a (i + 1)) :
    ∀ᶠ k in atTop, 10 * k ≤ a k := by
  obtain ⟨i₀, hi₀⟩ := eventually_atTop.1 h
  have hlin : ∀ t, 11 * t ≤ a (i₀ + t) := by
    intro t
    induction t with
    | zero => simp
    | succ t ih =>
      have := hi₀ (i₀ + t) (Nat.le_add_right i₀ t)
      rw [← add_assoc]
      omega
  filter_upwards [eventually_ge_atTop (11 * i₀)] with k hk
  obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le (show i₀ ≤ k by omega)
  have := hlin t
  omega

/-- The class `J_r` of the indices `4 q + r`. -/
def cls (r : ℕ) : Set ℕ := Set.range fun q => 4 * q + r

/-- **Lemma 16(b).** Let `2 * a k ≤ k ^ 2 + 2` and `a k ≥ 10 * k` for `k ≥ Q ≥ 1`, and let
`G = 8 (Q + 1)²`. Each class `{4q + r}` is `G`-good, and `a (4q + r) ≤ G (q + 1)²`. -/
theorem good_cls {a : ℕ → ℕ} (ha : StrictMono a) {Q : ℕ} (hQ : 1 ≤ Q)
    (hquad : ∀ k ≥ Q, 2 * a k ≤ k ^ 2 + 2) (hlin : ∀ k ≥ Q, 10 * k ≤ a k) {r : ℕ} (hr : r < 4) :
    Good a (cls r) (8 * (Q + 1) ^ 2) ∧ ∀ q, a (4 * q + r) ≤ 8 * (Q + 1) ^ 2 * (q + 1) ^ 2 := by
  have hlarge : ∀ q ≥ Q, a (4 * q + r) ≤ 8 * (q + 1) ^ 2 := by
    intro q hq
    have h := hquad (4 * q + r) (by omega)
    have : (4 * q + r) ^ 2 ≤ (4 * q + 3) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    linarith
  have hsmall : ∀ q ≤ Q, a (4 * q + r) ≤ 8 * (Q + 1) ^ 2 := fun q hq =>
    (ha.monotone (by omega)).trans (hlarge Q le_rfl)
  have hsum : ∀ q, 8 * (q + 1) ^ 2 ≤ 8 * (Q + 1) ^ 2 + S a (cls r) (4 * q + r) := by
    intro q
    rcases le_total q Q with hq | hq
    · exact (Nat.mul_le_mul_left 8 (Nat.pow_le_pow_left (by omega) 2)).trans (Nat.le_add_right _ _)
    induction q, hq using Nat.le_induction with
    | base => exact Nat.le_add_right _ _
    | succ q hq ih =>
      have h1 : S a (cls r) (4 * q + r) + a (4 * q + r) ≤ S a (cls r) (4 * (q + 1) + r) :=
        S_add_le ⟨q, rfl⟩ (by omega)
      have h2 := hlin (4 * q + r) (by omega)
      nlinarith
  refine ⟨?_, fun q => ?_⟩
  · rintro _ ⟨q, rfl⟩
    rcases le_total q Q with hq | hq
    · exact (hsmall q hq).trans (Nat.le_add_right _ _)
    · exact (hlarge q hq).trans (hsum q)
  · rcases le_total q Q with hq | hq
    · exact (hsmall q hq).trans (Nat.le_mul_of_pos_right _ (by positivity))
    · refine (hlarge q hq).trans (Nat.mul_le_mul_right _ ?_)
      exact Nat.le_mul_of_pos_right 8 (by positivity)

/-- **Proposition 17 (Case 2).** If `2 * a k ≤ k ^ 2 + 2` and `a k ≥ 10 * k` for all large `k`, then
`P(ℕ)` contains an infinite progression. -/
theorem case2 {a : ℕ → ℕ} (ha : StrictMono a) (hquad : ∀ᶠ k in atTop, 2 * a k ≤ k ^ 2 + 2)
    (hlin : ∀ᶠ k in atTop, 10 * k ≤ a k) : ∃ x d, 0 < d ∧ ∀ k, x + k * d ∈ P a Set.univ := by
  obtain ⟨Q, hQ⟩ := eventually_atTop.1 ((hquad.and hlin).and (eventually_ge_atTop 1))
  set G := 8 * (Q + 1) ^ 2
  have hgood : ∀ r < 4, Good a (cls r) G ∧ ∀ q, a (4 * q + r) ≤ G * (q + 1) ^ 2 := fun r hr =>
    good_cls ha (hQ Q le_rfl).2 (fun k hk => (hQ k hk).1.1) (fun k hk => (hQ k hk).1.2) hr
  have hinj : ∀ r, Function.Injective fun q => 4 * q + r := fun r q q' h => by
    dsimp only at h
    omega
  have hinf : ∀ r, (cls r).Infinite := fun r => Set.infinite_range_of_injective (hinj r)
  have hdisj : ∀ r < 4, ∀ r' < 4, r ≠ r' → Disjoint (cls r) (cls r') := by
    refine fun r hr r' hr' hne => Set.disjoint_left.2 ?_
    rintro _ ⟨q, rfl⟩ ⟨q', h⟩
    dsimp only at h
    omega
  have hsyn : ∀ r < 4, Syndetic (P a (cls r)) G := fun r hr =>
    syndetic_of_good ha (hinf r) (hgood r hr).1
  have hb : StrictMono fun q => a (4 * q + 2) := fun q q' h => ha (by omega)
  have hbκ : ∀ s, ∀ q < 2 * s, 8 * a (4 * q + 2) ≤ 32 * G * s ^ 2 := by
    intro s q hq
    calc 8 * a (4 * q + 2) ≤ 8 * (G * (q + 1) ^ 2) :=
          Nat.mul_le_mul_left 8 ((hgood 2 (by omega)).2 q)
      _ ≤ 8 * (G * (2 * s) ^ 2) := by gcongr; omega
      _ = 32 * G * s ^ 2 := by ring
  obtain ⟨d, hd, hprog⟩ := key (hsyn 0 (by omega)) (hsyn 1 (by omega)) hb (by positivity) hbκ
  have hdisj' : Disjoint (cls 0 ∪ cls 1 ∪ cls 2) (cls 3) := by
    simp [Set.disjoint_union_left, hdisj]
  have hJ : ∀ L, ∃ t, ∀ j ≤ L, t + j * d ∈ P a (cls 0 ∪ cls 1 ∪ cls 2) := by
    intro L
    obtain ⟨t, ht⟩ := hprog L
    refine ⟨t, fun j hj => ?_⟩
    obtain ⟨x, hx, y, hy, T, e⟩ := ht j hj
    have hT : ∑ q ∈ T, a (4 * q + 2) ∈ P a (cls 2) :=
      ⟨T.map ⟨_, hinj 2⟩, by simp [cls], sum_map _ _ _⟩
    rw [e]
    refine P_add ?_ (P_add (hdisj 0 (by omega) 1 (by omega) (by omega)) hx hy) hT
    simp [Set.disjoint_union_left, hdisj]
  obtain ⟨x, hx⟩ := glue ha hdisj' (hinf 3) (hgood 3 (by omega)).1 hd hJ
  exact ⟨x, d, hd, fun k => P_mono (Set.subset_univ _) (hx k)⟩

end E344

open E344 in
/-- **Theorem.** If `|A ∩ [1, N]| ≥ √(2N)` for all large `N`, then `A` is subcomplete. Either some
difference `a (i + 1) - a i ≤ 10` occurs infinitely often, or almost all differences are at least
`11`. -/
public theorem main : type_of% @Erdos344.erdos_344.variants.sqrt_two := by
  intro A hA
  obtain ⟨a, ha, rfl, hquad⟩ := enumerate hA
  have hP : ∃ x d, 0 < d ∧ ∀ k, x + k * d ∈ P a Set.univ := by
    by_cases hd : ∃ d ∈ range 11, ∃ᶠ i in atTop, a (i + 1) = a i + d
    · obtain ⟨d, -, hd⟩ := hd
      exact case1 ha hquad hd
    · push Not at hd
      refine case2 ha hquad (linear_of_gaps ?_)
      filter_upwards [(eventually_all_finset (range 11)).2 hd] with i hi
      have hlt : a i < a (i + 1) := ha i.lt_succ_self
      by_contra hcon
      exact hi (a (i + 1) - a i) (mem_range.2 (by omega)) (by omega)
  obtain ⟨x, d, hd, hx⟩ := hP
  refine ⟨x, d, hd, fun k => ?_⟩
  obtain ⟨T, -, hT⟩ := hx k
  exact ⟨T.image a, by simp, by rw [sum_image ha.injective.injOn, hT]⟩

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
