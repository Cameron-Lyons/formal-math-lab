#Leading ideal data
#---
#field characteristic: 3
#variable order:       x1, x2, x3, x4, x5
#monomial order:       graded reverse lexicographical
#length of basis:      16 elements sorted by increasing leading monomials
#---
[x4^1*x5^1,
x2^1*x5^1,
x1^1*x5^1,
x4^2,
x3^1*x4^1,
x2^1*x4^1,
x1^1*x4^1,
x2^1*x3^1,
x1^1*x3^1,
x1^1*x2^1,
x1^2,
x5^3,
x3^1*x5^2,
x3^2*x5^1,
x3^3,
x2^3]:
