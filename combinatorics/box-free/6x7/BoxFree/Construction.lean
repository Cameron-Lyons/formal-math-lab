def coloring52 : Coloring 52 := fun z row col =>
  layers[z].getMsbD (7 * row.val + col.val)

/-- A box would repeat a colored rectangle in two layers. Check every choice
of its two rows, two columns, color, and layers against the table. -/
theorem coloring52_boxFree : BoxFree coloring52 := by
  unfold BoxFree Rectangle
  decide +kernel

theorem exists_boxFree_52 : ∃ C : Coloring 52, BoxFree C :=
  ⟨coloring52, coloring52_boxFree⟩

/-- The exceptional layer uses 18 slots. Each of the other 51 uses 12. -/
theorem rectangles_per_layer (z : Fin 52) :
    rectangleCount (coloring52 z) = (if z = 0 then 18 else 12) := by
  revert z
  decide +kernel

end BoxFree
