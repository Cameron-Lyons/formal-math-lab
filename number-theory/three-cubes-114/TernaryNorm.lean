module

public import Mathlib.Data.Int.GCD
public import Mathlib.Data.Int.ModEq
public import Mathlib.RingTheory.Int.Basic
import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.ModCases
import Mathlib.Tactic.Ring

/-! Explicit root formulas for the two invariant factors of a primitive
principal ideal in the order generated by a cube root of k. The two-root
parameterization of primitive cubic ideals is due to Matthew Welsh,
https://arxiv.org/abs/2008.00538, Theorem 3. -/

@[expose] public section

namespace ThreeCubes114.TernaryNorm

def norm (k a b c : ℤ) : ℤ := a^3 + k*b^3 + k^2*c^3 - 3*k*a*b*c

def content (a b c : ℤ) : ℤ := Int.gcd (Int.gcd a b : ℤ) c

private theorem content_span (a b c : ℤ) :
    ∃ i j l : ℤ, i*a + j*b + l*c = content a b c := by
  let e : ℤ := Int.gcd a b
  let u := Int.gcdA e c
  refine ⟨u*Int.gcdA a b, u*Int.gcdB a b, Int.gcdB e c, ?_⟩
  calc
    _ = (a * Int.gcdA a b + b * Int.gcdB a b)*u + c * Int.gcdB e c := by ring
    _ = e*u + c * Int.gcdB e c := by rw [← Int.gcd_eq_gcd_ab]
    _ = _ := (Int.gcd_eq_gcd_ab e c).symm

private theorem content_divides (a b c : ℤ) :
    content a b c ∣ a ∧ content a b c ∣ b ∧ content a b c ∣ c :=
  ⟨dvd_trans (Int.gcd_dvd_left _ _) (Int.gcd_dvd_left _ _),
   dvd_trans (Int.gcd_dvd_left _ _) (Int.gcd_dvd_right _ _), Int.gcd_dvd_right _ _⟩

/-- The linear congruence c*r ≡ b (mod m) has an invertible coefficient
    and yields a cube root whenever m divides all three cofactors. -/
def rootRule (k m b c : ℤ) : Prop :=
  Int.gcd m c = 1 ∧ ∀ r : ℤ, m ∣ c*r-b → m ∣ r^3-k

private theorem root_of_minors {k m a b c : ℤ}
    (primitive : ∃ i j l : ℤ, i*a+j*b+l*c=1)
    (ha : m ∣ a^2-k*b*c) (hb : m ∣ k*c^2-a*b) (hc : m ∣ b^2-a*c) :
    rootRule k m b c := by
  have hg : Int.gcd m c = 1 := by
    by_contra h
    obtain ⟨p, hp, hpg⟩ := Nat.exists_prime_and_dvd h
    have hpi := Nat.prime_iff_prime_int.mp hp
    have hdiv := Int.natCast_dvd_natCast.mpr hpg
    have hpm := dvd_trans hdiv (Int.gcd_dvd_left m c)
    have hpc := dvd_trans hdiv (Int.gcd_dvd_right m c)
    obtain ⟨v, hv⟩ := hpc
    have hpa : (p:ℤ) ∣ a := by
      apply hpi.dvd_of_dvd_pow (n := 2)
      obtain ⟨j, hj⟩ := dvd_trans hpm ha
      exact ⟨j+k*b*v, by linear_combination hj + k*b*hv⟩
    have hpb : (p:ℤ) ∣ b := by
      apply hpi.dvd_of_dvd_pow (n := 2)
      obtain ⟨j, hj⟩ := dvd_trans hpm hc
      exact ⟨j+a*v, by linear_combination hj + a*hv⟩
    obtain ⟨i,j,l,h1⟩ := primitive
    have hone := dvd_add (dvd_add (dvd_mul_of_dvd_right hpa i) (dvd_mul_of_dvd_right hpb j))
      (dvd_mul_of_dvd_right (show (p:ℤ) ∣ c from ⟨v, hv⟩) l)
    rw [h1] at hone
    have : p ∣ 1 := by exact_mod_cast hone
    exact hp.ne_one (Nat.dvd_one.mp this)
  refine ⟨hg, ?_⟩
  intro r h
  have cancel (t : ℤ) (ht : m ∣ c*t) : m ∣ t := by
    simpa [hg] using Int.dvd_gcd_mul_iff_dvd_mul.mpr ht
  apply cancel; apply cancel; apply cancel
  obtain ⟨t,ht⟩ := h
  obtain ⟨v,hv⟩ := hb
  obtain ⟨w,hw⟩ := hc
  refine ⟨t*((c*r)^2+c*r*b+b^2) + b*w-c*v, ?_⟩
  linear_combination ((c*r)^2+c*r*b+b^2)*ht + b*hw - c*hv

/-- Remove the square of the common cofactor content from the norm. Even
    when g>1 this gives two usable cube-root congruences, one modulo g
    and one modulo the signed quotient d. -/
theorem normalized_roots (k a b c : ℤ) (hprim : content a b c = 1)
    (A B C : ℤ) (hA : A = a^2-k*b*c) (hB : B = k*c^2-a*b) (hC : C=b^2-a*c)
    (g : ℤ) (hg : g = content A B C) (hne : g ≠ 0) :
    ∃ d : ℤ, norm k a b c = g^2*d ∧ rootRule k g b c ∧ rootRule k d (B/g) (C/g) := by
  have hdiv := content_divides A B C
  rw [← hg] at hdiv
  obtain ⟨ha,hb,hc⟩ := hdiv
  have raw := content_span a b c
  rw [hprim] at raw
  have rootG := root_of_minors raw (hA ▸ ha) (hB ▸ hb) (hC ▸ hc)
  let u := A/g
  let v := B/g
  let w := C/g
  have hu : u*g = A := Int.ediv_mul_cancel ha
  have hv : v*g = B := Int.ediv_mul_cancel hb
  have hw : w*g = C := Int.ediv_mul_cancel hc
  have hnA : A^2-k*B*C = a*norm k a b c := by rw [hA,hB,hC]; unfold norm; ring
  have hnB : k*C^2-A*B = b*norm k a b c := by rw [hA,hB,hC]; unfold norm; ring
  have hnC : B^2-A*C = c*norm k a b c := by rw [hA,hB,hC]; unfold norm; ring
  rw [← hu, ← hv, ← hw] at hnA hnB hnC
  obtain ⟨i,j,l,h1⟩ := raw
  let d := i*(u^2-k*v*w) + j*(k*w^2-u*v) + l*(v^2-u*w)
  have hnorm : norm k a b c = g^2*d := by
    dsimp [d]
    linear_combination -i*hnA - j*hnB - l*hnC - norm k a b c*h1
  refine ⟨d, hnorm, rootG, ?_⟩
  obtain ⟨i',j',l',hspan⟩ := content_span A B C
  rw [← hg, ← hu, ← hv, ← hw] at hspan
  have hprim' : i'*u+j'*v+l'*w = 1 := by
    apply Int.eq_of_mul_eq_mul_left hne
    linear_combination hspan
  rw [hnorm] at hnA hnB hnC
  apply root_of_minors ⟨i',j',l',hprim'⟩
  · refine ⟨a, Int.eq_of_mul_eq_mul_left (pow_ne_zero 2 hne) ?_⟩
    linear_combination hnA
  · refine ⟨b, Int.eq_of_mul_eq_mul_left (pow_ne_zero 2 hne) ?_⟩
    linear_combination hnB
  · refine ⟨c, Int.eq_of_mul_eq_mul_left (pow_ne_zero 2 hne) ?_⟩
    linear_combination hnC

/-- Joining the two compatible linear congruences gives a cube root modulo
    the product whenever the invariant factors used here are coprime. -/
theorem combined_root {k g d b c v w r : ℤ} (hg : rootRule k g b c)
    (hd : rootRule k d v w) (hcop : Int.gcd g d = 1)
    (h1 : g ∣ c*r-b) (h2 : d ∣ w*r-v) : g*d ∣ r^3-k :=
  (Int.isCoprime_iff_gcd_eq_one.mpr hcop).mul_dvd (hg.2 r h1) (hd.2 r h2)

/-- A noncube residue modulo 19 certifies that the modulus cannot come
    from any previous full norm, for any choice of the three coefficients. -/
theorem full_norm_cube_mod_19 (a b c : ℤ) :
    ∃ t : ℤ, |norm 114 a b c| ≡ t^3 [ZMOD 19] := by
  have h : norm 114 a b c ≡ a^3 [ZMOD 19] := by
    apply Int.modEq_iff_dvd.mpr
    exact ⟨-6*b^3-684*c^3+18*a*b*c, by unfold norm; ring⟩
  rcases le_or_gt 0 (norm 114 a b c) with hp | hn
  · exact ⟨a, by rwa [abs_of_nonneg hp]⟩
  · refine ⟨-a, ?_⟩
    rw [abs_of_neg hn, show (-a)^3 = -(a^3) by ring]
    exact h.neg

/-- Checking the nineteen residues rules out a cube congruent to four. -/
theorem cube_ne_four_mod_19 (r : ℤ) : r^3 % 19 ≠ 4 := by
  mod_cases h : r % 19 <;> rw [(h.pow 3).eq] <;> decide

/-- The normalized modulus 3785 has a root, and its residue cannot occur
    for the absolute value of a full norm. -/
theorem joined_example :
    norm 114 1 4 1 = 18925 ∧ content (-455) 110 15 = 5 ∧
    (1269:ℤ)^3 % 3785 = 114 ∧ ∀ a b c : ℤ, |norm 114 a b c| ≠ 3785 := by
  refine ⟨by decide, by decide, by decide, ?_⟩
  intro a b c he
  obtain ⟨t, ht⟩ := full_norm_cube_mod_19 a b c
  rw [he] at ht
  exact cube_ne_four_mod_19 t ht.eq.symm

end ThreeCubes114.TernaryNorm
