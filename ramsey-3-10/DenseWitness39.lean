set_option maxHeartbeats 4000000 in
private theorem simple_trifree : checkSimpleTriFree adjacent = true := by decide

set_option maxHeartbeats 8000000 in
set_option maxRecDepth 200000 in
private theorem cert_ok : checkCert adjacent (List.finRange 39) 10 cert = true := by decide

/-- Pure-kernel proof that this 172-edge 39-vertex graph is simple, triangle-free,
    and has no independent 10-set. -/
theorem dense39_witness :
    Simple adjacent ∧ TriangleFree adjacent ∧
      ∀ s, Independent adjacent s → orderOf s < 10 :=
  let ⟨hs, htf⟩ := simpleTriFree_of_check simple_trifree
  ⟨hs, htf, orderOf_lt_of_checkCert cert cert_ok⟩

/-- Twice the edge count of this witness is 344 (172 edges, vs 167 edges in Exoo's graph). -/
theorem dense39_twiceEdges : Structural.twiceEdges adjacent = 344 := by decide

/-- Independent refutation of `RamseyProperty 39` (giving `R(3, 10) ≥ 40`). -/
theorem not_ramseyProperty_39 : ¬ RamseyProperty 39 := by
  intro h
  obtain ⟨hs, htf, hnoIS⟩ := dense39_witness
  obtain ⟨s, hind, h10⟩ := h adjacent hs htf
  exact Nat.not_lt_of_ge h10 (hnoIS s hind)

end Ramsey310.Dense39
