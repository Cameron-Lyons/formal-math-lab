ring R=2,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
ideal I=
x1^100+1,
x2^100+1,
x3^100+1,
x4^100+1,
x5^100+1,
x6^100+1,
x7^100+1,
x8^100+1,
x9^100+1,
x10^100+1;
option(redSB);
print("GB_STARTED");
ideal G=std(I);
print("GB_COMPLETE");
print("BASIS_IS_STANDARD="+string(attrib(G,"isSB")));
print("KRULL_DIM="+string(dim(G)));
print("BASIS_SIZE="+string(size(G)));
for(int k=1;k<=size(G);k++){print("LM="+string(leadexp(G[k])));}
print("LM_COMPLETE");
print("HILB_STARTED");
bigintvec H=hilb(G,2);
print("HILB_TYPE="+typeof(H));
bigint D=0;
for(int j=1;j<size(H);j++){D=D+H[j];}
print("HILB_DIM="+string(D));
print("BACKEND_COMPLETE");
quit;
