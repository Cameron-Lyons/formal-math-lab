open Finset Erdos338 Filter

namespace E338

/-! ### Definitions and constants -/

/-- The multiset `S` writes `n` as a sum of at most `r` elements of `A`, repetition allowed. -/
def IsRep (A : Set ℕ) (r n : ℕ) (S : Multiset ℕ) : Prop :=
  (∀ x ∈ S, x ∈ A) ∧ S.card ≤ r ∧ S.sum = n

/-- `B A r` is the set of sums of at most `r` elements of `A`, repetition allowed. -/
def B (A : Set ℕ) (r : ℕ) : Set ℕ := {n | ∃ S, IsRep A r n S}

/-- `D A k q` is the set of all `(k, q)`-robust numbers: the `n` such that, whatever set `W` of at
most `q` numbers is forbidden, `n` is a sum of at most `k` distinct elements of `A` outside `W`. -/
def D (A : Set ℕ) (k q : ℕ) : Set ℕ :=
  {n | ∀ W : Finset ℕ, #W ≤ q →
    ∃ G : Finset ℕ, (∀ x ∈ G, x ∈ A ∧ x ∉ W) ∧ #G ≤ k ∧ ∑ x ∈ G, x = n}

open scoped Classical in
/-- `cut S a b` is the set of all elements of `S` in the interval `[a, b]`. -/
noncomputable def cut (S : Set ℕ) (a b : ℕ) : Finset ℕ := {n ∈ Icc a b | n ∈ S}

/-- Membership in `cut S a b`. -/
lemma mem_cut {S : Set ℕ} {a b n : ℕ} : n ∈ cut S a b ↔ (a ≤ n ∧ n ≤ b) ∧ n ∈ S := by
  simp [cut]

/-- A sum of at most `k` distinct elements of `A` lies in `D A k 0`. -/
lemma mem_D_zero {A : Set ℕ} {k : ℕ} {G : Finset ℕ} (hA : ∀ x ∈ G, x ∈ A) (hk : #G ≤ k) :
    ∑ x ∈ G, x ∈ D A k 0 := fun W hW => by
  rw [Nat.le_zero, card_eq_zero] at hW
  exact ⟨G, fun x hx => ⟨hA x hx, by simp [hW]⟩, hk, rfl⟩

/-- The modulus `g c = (16 c ^ 2)!`. -/
def g (c : ℕ) : ℕ := (16 * c ^ 2).factorial

/-- `K c` bounds the number of robust summands that are used at a scale of type `c`. -/
def K (c : ℕ) : ℕ := (80 * c ^ 2 + 2) * g c

/-- `Q h c = g c + 4 h K c` is the number of elements that can be avoided at a scale of type `c`. -/
def Q (h c : ℕ) : ℕ := g c + 2 * (2 * h * K c)

/-- The increasing sequence of constants `c₀ = 6`, `c₁`, `c₂`, ...; `typ h i` is `cᵢ`. -/
def typ (h : ℕ) : ℕ → ℕ
  | 0 => 6
  | i + 1 => 3 * typ h i * (h + 2 * typ h i * Q h (typ h i))

/-- The scale `N` has type `c`: at least `N / c` numbers in `[1, 2 N]` are `(2 h, Q h c)`-robust. -/
def HasType (A : Set ℕ) (h N c : ℕ) : Prop := N ≤ c * #(cut (D A (2 * h) (Q h c)) 1 (2 * N))

/-- `g` is positive. -/
lemma g_pos (c : ℕ) : 1 ≤ g c := Nat.factorial_pos _

/-- `g` is monotone. -/
lemma g_mono : Monotone g := fun _ _ hab => Nat.factorial_le (by gcongr)

/-- `K` is monotone. -/
lemma K_mono : Monotone K := fun _ _ hab => Nat.mul_le_mul (by gcongr) (g_mono hab)

/-- The sequence of constants is monotone. -/
lemma typ_mono (h : ℕ) : Monotone (typ h) := by
  refine monotone_nat_of_le_succ fun i => ?_
  rw [typ]
  generalize typ h i = c
  have hQ : 1 ≤ Q h c := (g_pos c).trans (Nat.le_add_right _ _)
  calc c ≤ 3 * c * (2 * c * 1) := by nlinarith [Nat.le_mul_self c]
    _ ≤ 3 * c * (h + 2 * c * Q h c) := by gcongr; nlinarith

/-! ### Lemma 1: adding robust numbers -/

/-- The sets `D A k q` grow with `k` and shrink with `q`. -/
lemma D_mono {A : Set ℕ} {k k' q q' n : ℕ} (hk : k ≤ k') (hq : q' ≤ q) (hn : n ∈ D A k q) :
    n ∈ D A k' q' := fun W hW =>
  let ⟨G, hG, hGk, hGn⟩ := hn W (hW.trans hq)
  ⟨G, hG, hGk.trans hk, hGn⟩

/-- Lemma 1 (a): the summands of `y` can be chosen different from those of `x`. -/
lemma add_mem_D {A : Set ℕ} {k l q x y : ℕ} (hx : x ∈ D A k q) (hy : y ∈ D A l (q + k)) :
    x + y ∈ D A (k + l) q := by
  intro W hW
  obtain ⟨G, hG, hGk, rfl⟩ := hx W hW
  obtain ⟨H, hH, hHl, rfl⟩ := hy (W ∪ G) ((card_union_le _ _).trans (by omega))
  have hGH : Disjoint G H := disjoint_left.2 fun x hxG hxH =>
    (hH x hxH).2 (mem_union_right _ hxG)
  refine ⟨G ∪ H, fun x hx => ?_, (card_union_le _ _).trans (by omega), sum_union hGH⟩
  rcases mem_union.1 hx with hx | hx
  · exact hG x hx
  · exact ⟨(hH x hx).1, fun hxW => (hH x hx).2 (mem_union_left _ hxW)⟩

/-- Lemma 1 (b): robust numbers may be added with repetition, if enough elements are avoidable. -/
lemma sum_mem_D {A : Set ℕ} {k q : ℕ} (M : Multiset ℕ)
    (hM : ∀ x ∈ M, x ∈ D A k (q + k * M.card)) : M.sum ∈ D A (k * M.card) q := by
  induction M using Multiset.induction with
  | empty => exact fun W _ => ⟨∅, by simp⟩
  | cons a M ih =>
    rw [Multiset.card_cons, mul_add, mul_one] at hM ⊢
    rw [Multiset.sum_cons, add_comm a]
    have ha := hM a (Multiset.mem_cons_self a M)
    have hM' := ih fun x hx => D_mono le_rfl (by omega) (hM x (Multiset.mem_cons_of_mem hx))
    exact add_mem_D hM' (D_mono le_rfl (by omega) ha)

/-! ### Lemma 2: few numbers need a repeated summand -/

/-- A representation with the largest possible number of distinct summands. -/
def IsMaxRep (A : Set ℕ) (r n : ℕ) (S : Multiset ℕ) : Prop :=
  IsRep A r n S ∧ ∀ S', IsRep A r n S' → #S'.toFinset ≤ #S.toFinset

/-- Every element of `B A r` has a representation with the largest number of distinct summands. -/
lemma exists_isMaxRep {A : Set ℕ} {r n : ℕ} (hn : n ∈ B A r) : ∃ S, IsMaxRep A r n S := by
  obtain ⟨S, hS, hmin⟩ :=
    exists_minimalFor_of_wellFoundedLT (IsRep A r n) (fun S => r - #S.toFinset) hn
  refine ⟨S, hS, fun S' hS' => ?_⟩
  have h1 := (Multiset.toFinset_card_le S').trans hS'.2.1
  by_contra! hlt
  have := hmin hS' (by dsimp only; omega)
  dsimp only at this
  omega

/-- If `y` needs a repeated summand, then `y = w + a` with `w ∈ B A r`, where `a` is a summand of
every representation of `w` with the largest number of distinct summands. -/
lemma exists_repeated {A : Set ℕ} {r y : ℕ} (hy : y ∈ B A (r + 1)) (hyD : y ∉ D A (r + 1) 0) :
    ∃ w ∈ B A r, ∃ a, w + a = y ∧ ∀ S, IsMaxRep A r w S → a ∈ S := by
  obtain ⟨M, ⟨hMA, hMr, hMy⟩, hMmax⟩ := exists_isMaxRep hy
  -- some `a` occurs twice in `M`
  have hdup : ¬ M.Nodup := fun hnd => hyD <| by
    simpa [Finset.sum, hMy] using mem_D_zero (A := A) (G := ⟨M, hnd⟩) hMA hMr
  obtain ⟨a, ha⟩ : ∃ a, 2 ≤ M.count a := by
    simpa [Multiset.nodup_iff_count_le_one, Nat.lt_iff_add_one_le] using hdup
  obtain ⟨M', rfl⟩ := Multiset.exists_cons_of_mem (Multiset.count_pos.1 (by omega : 0 < M.count a))
  have haM' : a ∈ M' := by
    rw [Multiset.count_cons_self] at ha
    exact Multiset.count_pos.1 (by omega)
  rw [Multiset.card_cons] at hMr
  rw [Multiset.sum_cons] at hMy
  have hM' : IsRep A r M'.sum M' :=
    ⟨fun x hx => hMA x (Multiset.mem_cons_of_mem hx), by omega, rfl⟩
  refine ⟨M'.sum, ⟨M', hM'⟩, a, by omega, fun S ⟨⟨hSA, hSr, hSs⟩, hSmax⟩ => ?_⟩
  -- otherwise `S` together with `a` represents `y` with too many distinct summands
  by_contra haS
  have h1 := hSmax M' hM'
  have h2 := hMmax (a ::ₘ S) ⟨?_, ?_, ?_⟩
  · rw [Multiset.toFinset_cons, Multiset.toFinset_cons,
      card_insert_of_notMem (by simpa using haS), insert_eq_of_mem (by simpa using haM')] at h2
    omega
  · intro x hx
    rcases Multiset.mem_cons.1 hx with rfl | hx
    exacts [hMA _ (Multiset.mem_cons_self _ _), hSA x hx]
  · rw [Multiset.card_cons]
    omega
  · rw [Multiset.sum_cons, hSs, hMy]

/-- Lemma 2: the numbers that need a repeated summand are rare compared with `B A r`. -/
lemma card_B_succ_le (A : Set ℕ) (r N : ℕ) :
    #(cut (B A (r + 1)) 0 N) ≤ #(cut (D A (r + 1) 0) 0 N) + r * #(cut (B A r) 0 N) := by
  choose! S hS using fun w (hw : w ∈ B A r) => exists_isMaxRep hw
  have hcover : cut (B A (r + 1)) 0 N ⊆ cut (D A (r + 1) 0) 0 N ∪
      (cut (B A r) 0 N).biUnion fun w => (S w).toFinset.image (w + ·) := by
    intro y hy
    obtain ⟨hyN, hyB⟩ := mem_cut.1 hy
    simp only [mem_union, mem_biUnion, mem_image, Multiset.mem_toFinset, mem_cut]
    by_cases hyD : y ∈ D A (r + 1) 0
    · exact Or.inl ⟨hyN, hyD⟩
    · obtain ⟨w, hw, a, rfl, ha⟩ := exists_repeated hyB hyD
      exact Or.inr ⟨w, ⟨⟨Nat.zero_le _, by omega⟩, hw⟩, a, ha _ (hS w hw), rfl⟩
  refine (card_le_card hcover).trans ((card_union_le _ _).trans (Nat.add_le_add_left ?_ _))
  rw [mul_comm]
  refine card_biUnion_le_card_mul _ _ _ fun w hw => card_image_le.trans ?_
  exact (Multiset.toFinset_card_le (S w)).trans (hS w (mem_cut.1 hw).2).1.2.1

/-! ### Lemma 3: many numbers are robust -/

/-- The family `F` gives every `x ∈ X` a set of at most `r + 1` distinct elements of `A` with
sum `x`, and all `x ∈ X` are at most `N`. -/
def IsFamily (A : Set ℕ) (r N : ℕ) (X : Finset ℕ) (F : ℕ → Finset ℕ) : Prop :=
  ∀ x ∈ X, x ≤ N ∧ (∀ a ∈ F x, a ∈ A) ∧ #(F x) ≤ r + 1 ∧ ∑ a ∈ F x, a = x

/-- Lemma 3 (a): few `x ∈ X` use a given summand `u`. -/
lemma card_using_le {A : Set ℕ} {r N : ℕ} {X : Finset ℕ} {F : ℕ → Finset ℕ}
    (hF : IsFamily A r N X F) (u : ℕ) : #{x ∈ X | u ∈ F x} ≤ #(cut (B A r) 0 N) := by
  have hsum : ∀ x ∈ ({x ∈ X | u ∈ F x} : Finset ℕ), u + ∑ a ∈ (F x).erase u, a = x := by
    intro x hx
    obtain ⟨hxX, hux⟩ := mem_filter.1 hx
    rw [add_sum_erase _ (fun a => a) hux, (hF x hxX).2.2.2]
  refine card_le_card_of_injOn (fun x => ∑ a ∈ (F x).erase u, a) (fun x hx => ?_) ?_
  · obtain ⟨hxX, hux⟩ := mem_filter.1 hx
    obtain ⟨hxN, hxA, hxr, -⟩ := hF x hxX
    refine mem_cut.2 ⟨⟨Nat.zero_le _, ?_⟩, ((F x).erase u).val, ?_, ?_, ?_⟩
    · exact (Nat.le_add_left _ u).trans ((hsum x hx).le.trans hxN)
    · exact fun a ha => hxA a (mem_of_mem_erase ha)
    · rw [card_val, card_erase_of_mem hux]
      omega
    · simp [Finset.sum]
  · intro x hx y hy hxy
    rw [← hsum x hx, ← hsum y hy]
    exact congrArg (u + ·) hxy

/-- Lemma 3 (b): few `x ∈ X` use a summand from a given set `V`. -/
lemma card_meeting_le {A : Set ℕ} {r N : ℕ} {X : Finset ℕ} {F : ℕ → Finset ℕ}
    (hF : IsFamily A r N X F) (V : Finset ℕ) :
    #{x ∈ X | ¬ Disjoint (F x) V} ≤ #V * #(cut (B A r) 0 N) := by
  have hcover : {x ∈ X | ¬ Disjoint (F x) V} ⊆ V.biUnion fun u => {x ∈ X | u ∈ F x} := by
    intro x hx
    obtain ⟨hxX, hxV⟩ := mem_filter.1 hx
    obtain ⟨u, hux, huV⟩ := not_disjoint_iff.1 hxV
    exact mem_biUnion.2 ⟨u, huV, mem_filter.2 ⟨hxX, hux⟩⟩
  exact (card_le_card hcover).trans (card_biUnion_le_card_mul _ _ _ fun u _ => card_using_le hF u)

/-- The pairs of elements of `X` with sum `n` and with disjoint sets of summands. -/
def pairs (X : Finset ℕ) (F : ℕ → Finset ℕ) (n : ℕ) : Finset (ℕ × ℕ) :=
  {p ∈ X ×ˢ X | Disjoint (F p.1) (F p.2) ∧ p.1 + p.2 = n}

/-- Membership in `pairs X F n`. -/
lemma mem_pairs {X : Finset ℕ} {F : ℕ → Finset ℕ} {n : ℕ} {p : ℕ × ℕ} : p ∈ pairs X F n ↔
    p.1 ∈ X ∧ p.2 ∈ X ∧ Disjoint (F p.1) (F p.2) ∧ p.1 + p.2 = n := by
  simp [pairs, and_assoc]

/-- A pair with sum `n` is determined by its first element. -/
lemma card_pairs_le_of_fst {X Y : Finset ℕ} {F : ℕ → Finset ℕ} {n : ℕ}
    (hY : ∀ p ∈ pairs X F n, p.1 ∈ Y) : #(pairs X F n) ≤ #Y :=
  card_le_card_of_injOn Prod.fst hY fun p hp q hq hpq => by
    have h1 := (mem_pairs.1 hp).2.2.2
    have h2 := (mem_pairs.1 hq).2.2.2
    exact Prod.ext hpq (by omega)

/-- Lemma 3 (c): a number that is not `(2 h, q)`-robust is the sum of few pairs. -/
lemma card_pairs_le {A : Set ℕ} {r N h q n : ℕ} {X : Finset ℕ} {F : ℕ → Finset ℕ}
    (hF : IsFamily A r N X F) (hr : r + 1 ≤ h) (hn : n ∉ D A (2 * h) q) :
    #(pairs X F n) ≤ 2 * q * #(cut (B A r) 0 N) := by
  obtain ⟨W, hWq, hW⟩ : ∃ W : Finset ℕ, #W ≤ q ∧ ∀ G : Finset ℕ,
      (∀ x ∈ G, x ∈ A ∧ x ∉ W) → #G ≤ 2 * h → ∑ x ∈ G, x ≠ n := by
    simpa [D] using hn
  set Z : Finset ℕ := {x ∈ X | ¬ Disjoint (F x) W}
  have hZ : #Z ≤ q * #(cut (B A r) 0 N) :=
    (card_meeting_le hF W).trans (Nat.mul_le_mul_right _ hWq)
  -- one of the two elements of every pair lies in `Z`
  have hcover : ∀ p ∈ pairs X F n, p.1 ∈ Z ∪ Z.image (n - ·) := by
    intro p hp
    obtain ⟨hp1, hp2, hdisj, hsum⟩ := mem_pairs.1 hp
    obtain ⟨-, hA1, hr1, hs1⟩ := hF _ hp1
    obtain ⟨-, hA2, hr2, hs2⟩ := hF _ hp2
    by_contra hcon
    have hd1 : Disjoint (F p.1) W := by_contra fun hd =>
      hcon (mem_union_left _ (mem_filter.2 ⟨hp1, hd⟩))
    have hd2 : Disjoint (F p.2) W := by_contra fun hd =>
      hcon (mem_union_right _ (mem_image.2 ⟨p.2, mem_filter.2 ⟨hp2, hd⟩, by omega⟩))
    refine hW (F p.1 ∪ F p.2) (fun x hx => ?_) ((card_union_le _ _).trans (by omega)) ?_
    · rcases mem_union.1 hx with hx | hx
      · exact ⟨hA1 x hx, disjoint_left.1 hd1 hx⟩
      · exact ⟨hA2 x hx, disjoint_left.1 hd2 hx⟩
    · rw [sum_union hdisj, hs1, hs2, hsum]
  have h1 := (card_pairs_le_of_fst hcover).trans (card_union_le _ _)
  have h2 : #(Z.image (n - ·)) ≤ #Z := card_image_le
  rw [mul_assoc]
  omega

/-- Lemma 3 (d): few pairs of elements of `X` have a summand in common. -/
lemma card_common_le {A : Set ℕ} {r N h : ℕ} {X : Finset ℕ} {F : ℕ → Finset ℕ}
    (hF : IsFamily A r N X F) (hr : r + 1 ≤ h) :
    #{p ∈ X ×ˢ X | ¬ Disjoint (F p.1) (F p.2)} ≤ #X * (h * #(cut (B A r) 0 N)) := by
  rw [mul_comm]
  refine card_le_mul_card_image_of_maps_to (f := Prod.fst)
    (fun p hp => (mem_product.1 (mem_filter.1 hp).1).1) _ fun x hx => ?_
  have h1 : #{y ∈ X | ¬ Disjoint (F y) (F x)} ≤ h * #(cut (B A r) 0 N) :=
    (card_meeting_le hF (F x)).trans (Nat.mul_le_mul_right _ ((hF x hx).2.2.1.trans hr))
  refine (card_le_card_of_injOn Prod.snd (fun p hp => ?_) fun p hp q hq hpq => ?_).trans h1
  · obtain ⟨hp', rfl⟩ := mem_filter.1 hp
    obtain ⟨hpX, hd⟩ := mem_filter.1 hp'
    exact mem_coe.2 (mem_filter.2 ⟨(mem_product.1 hpX).2, fun hd' => hd hd'.symm⟩)
  · exact Prod.ext ((mem_filter.1 hp).2.trans (mem_filter.1 hq).2.symm) hpq

/-- Lemma 3 (e): counting all pairs of elements of `X`. -/
lemma card_sq_le {A : Set ℕ} {r N h q : ℕ} {X : Finset ℕ} {F : ℕ → Finset ℕ}
    (hF : IsFamily A r N X F) (hX : ∀ x ∈ X, 1 ≤ x) (hr : r + 1 ≤ h) :
    #X * #X ≤ #X * (h * #(cut (B A r) 0 N)) + #X * #(cut (D A (2 * h) q) 1 (2 * N)) +
      2 * N * (2 * q * #(cut (B A r) 0 N)) := by
  classical
  set e := #(cut (B A r) 0 N)
  have h1 : #{p ∈ X ×ˢ X | Disjoint (F p.1) (F p.2)} = ∑ n ∈ Icc 1 (2 * N), #(pairs X F n) := by
    simp only [pairs, ← filter_filter]
    refine card_eq_sum_card_fiberwise fun p hp => ?_
    obtain ⟨hp1, hp2⟩ := mem_product.1 (mem_filter.1 hp).1
    have := (hF _ hp1).1; have := hX _ hp1; have := (hF _ hp2).1
    exact mem_coe.2 (mem_Icc.2 ⟨by omega, by omega⟩)
  have h2 : ∀ n, #(pairs X F n) ≤ (if n ∈ D A (2 * h) q then #X else 0) + 2 * q * e := by
    intro n
    split_ifs with hn
    · exact le_add_right (card_pairs_le_of_fst fun p hp => (mem_pairs.1 hp).1)
    · exact (card_pairs_le hF hr hn).trans (Nat.le_add_left _ _)
  have h3 : ∑ n ∈ Icc 1 (2 * N), #(pairs X F n) ≤
      #X * #(cut (D A (2 * h) q) 1 (2 * N)) + 2 * N * (2 * q * e) := by
    refine (sum_le_sum fun n _ => h2 n).trans (le_of_eq ?_)
    rw [sum_add_distrib, ← sum_filter, sum_const, sum_const, Nat.card_Icc, smul_eq_mul, smul_eq_mul,
      Nat.add_sub_cancel, mul_comm, cut]
  have h4 := card_filter_add_card_filter_not (s := X ×ˢ X) fun p => Disjoint (F p.1) (F p.2)
  rw [card_product] at h4
  have h5 : _ ≤ #X * (h * e) := card_common_le hF hr
  omega

/-- Lemma 3: if `B A (r + 1)` is dense up to `N` and `B A r` is sparse, then many numbers in
`[1, 2 N]` are `(2 h, q)`-robust. -/
lemma dense_D {A : Set ℕ} {h r N c q : ℕ} (hr : r + 1 ≤ h) (hN : 1 ≤ N)
    (hdense : 3 * N ≤ c * #(cut (B A (r + 1)) 0 N))
    (hsparse : c * (h + 2 * c * q) * #(cut (B A r) 0 N) ≤ N) :
    N ≤ c * #(cut (D A (2 * h) q) 1 (2 * N)) := by
  set X := cut (D A (r + 1) 0) 1 N
  set e := #(cut (B A r) 0 N)
  set T := cut (D A (2 * h) q) 1 (2 * N)
  have hX : ∀ x ∈ X, (1 ≤ x ∧ x ≤ N) ∧ x ∈ D A (r + 1) 0 := fun x hx => mem_cut.1 hx
  choose! F hF using fun x hx => (hX x hx).2 ∅ (by simp)
  have hfam : IsFamily A r N X F := fun x hx =>
    ⟨(hX x hx).1.2, fun a ha => ((hF x hx).1 a ha).1, (hF x hx).2.1, (hF x hx).2.2⟩
  have h1 := card_sq_le (q := q) hfam (fun x hx => (hX x hx).1.1) hr
  -- the number `0` does not matter, since `e ≥ 1`
  have h0 : #(cut (D A (r + 1) 0) 0 N) ≤ #X + e := by
    refine (card_le_card fun y hy => ?_).trans (card_union_le _ _)
    obtain ⟨⟨-, hyN⟩, hyD⟩ := mem_cut.1 hy
    rcases Nat.eq_zero_or_pos y with rfl | hy1
    · exact mem_union_right _ (mem_cut.2 ⟨⟨le_rfl, hyN⟩, 0, by simp [IsRep]⟩)
    · exact mem_union_left _ (mem_cut.2 ⟨⟨hy1, hyN⟩, hyD⟩)
  have h2 : 3 * N ≤ c * #X + c * h * e := by
    calc 3 * N ≤ c * (#X + e + r * e) := hdense.trans
          (Nat.mul_le_mul_left _ ((card_B_succ_le A r N).trans (Nat.add_le_add_right h0 _)))
      _ = c * (#X + (r + 1) * e) := by ring
      _ ≤ c * (#X + h * e) := by gcongr
      _ = _ := by ring
  have h3 : c * h * e ≤ c * (h + 2 * c * q) * e := by gcongr; omega
  have h4 : 2 * N ≤ c * #X := by omega
  have h5 : #X * #X ≤ #X * ((h + 2 * c * q) * e + #T) := by
    calc #X * #X ≤ #X * (h * e) + #X * #T + 2 * N * (2 * q * e) := h1
      _ ≤ #X * (h * e) + #X * #T + c * #X * (2 * q * e) := by gcongr
      _ = _ := by ring
  have hXpos : 0 < #X := Nat.pos_of_ne_zero fun h0 => by rw [h0] at h4; omega
  have h6 := Nat.mul_le_mul_left c (Nat.le_of_mul_le_mul_left h5 hXpos)
  rw [mul_add, ← mul_assoc] at h6
  omega

/-! ### Lemma 4: every large scale has a type -/

/-- Lemma 4: every large scale has a type that is bounded in terms of `h`. -/
lemma exists_type {A : Set ℕ} {h : ℕ} (hA : HasOrder A h) :
    ∃ N₁, ∀ N ≥ N₁, ∃ c ≤ typ h h, HasType A h N c := by
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.1 hA
  refine ⟨2 * N₀ + typ h h + 1, fun N hN => ?_⟩
  -- `0` is not dense, and all `r ≥ h` are dense
  let Dense : ℕ → Prop := fun r => 3 * N ≤ typ h (h - r) * #(cut (B A r) 0 N)
  have hzero : ¬ Dense 0 := by
    have h1 : cut (B A 0) 0 N ⊆ {0} := fun n hn => by
      obtain ⟨-, S, -, h2, h3⟩ := mem_cut.1 hn
      rw [Nat.le_zero, Multiset.card_eq_zero] at h2
      simp [← h3, h2]
    have h2 := Nat.mul_le_mul_left (typ h h) (card_le_card h1)
    rw [card_singleton, mul_one] at h2
    exact not_le.2 (h2.trans_lt (by omega))
  have hlarge : ∀ r ≥ h, Dense r := fun r hr => by
    have h1 : #(Icc N₀ N) ≤ #(cut (B A r) 0 N) := card_le_card fun n hn => by
      obtain ⟨h1, h2⟩ := mem_Icc.1 hn
      obtain ⟨S, hSA, hSh, hSn⟩ := hN₀ n h1
      exact mem_cut.2 ⟨⟨Nat.zero_le _, h2⟩, S, hSA, hSh.trans hr, hSn⟩
    rw [Nat.card_Icc] at h1
    simp only [Dense, Nat.sub_eq_zero_of_le hr, typ]
    omega
  obtain ⟨r, hr, hr'⟩ :=
    Nat.exists_not_and_succ_of_not_zero_of_exists hzero ⟨h, hlarge h le_rfl⟩
  have hrh : r < h := not_le.1 fun hle => hr (hlarge r hle)
  have h1 : typ h (h - r) * #(cut (B A r) 0 N) < 3 * N := not_le.1 hr
  rw [(by omega : h - r = h - (r + 1) + 1), typ, mul_assoc 3, mul_assoc 3] at h1
  exact ⟨_, typ_mono h (Nat.sub_le _ _), dense_D hrh (by omega) hr' (by omega)⟩

/-! ### Lemma 5: adding elements of a dense set -/

/-- Lemma 5 (a): some `σ` is the sum of many pairs of elements of `T`. -/
lemma exists_popular_sum {T : Finset ℕ} {N c : ℕ} (hN : 1 ≤ N) (hT : ∀ x ∈ T, 1 ≤ x ∧ x ≤ 2 * N)
    (hc : N ≤ c * #T) : ∃ σ ≤ 4 * N, N ≤ 4 * c ^ 2 * #{x ∈ T | σ - x ∈ T} := by
  obtain ⟨σ, hσ, hmax⟩ := exists_max_image (Icc 1 (4 * N))
    (fun σ => #{p ∈ T ×ˢ T | p.1 + p.2 = σ}) ⟨1, mem_Icc.2 ⟨le_rfl, by omega⟩⟩
  refine ⟨σ, (mem_Icc.1 hσ).2, ?_⟩
  have h1 : #T * #T ≤ #{p ∈ T ×ˢ T | p.1 + p.2 = σ} * (4 * N) := by
    have := card_le_mul_card_image_of_maps_to (s := T ×ˢ T) (t := Icc 1 (4 * N))
      (f := fun p => p.1 + p.2) (fun p hp => by
        have h1 := hT _ (mem_product.1 hp).1
        have h2 := hT _ (mem_product.1 hp).2
        exact mem_Icc.2 ⟨by omega, by omega⟩) _ hmax
    rwa [card_product, Nat.card_Icc, Nat.add_sub_cancel] at this
  have h2 : #{p ∈ T ×ˢ T | p.1 + p.2 = σ} ≤ #{x ∈ T | σ - x ∈ T} := by
    refine card_le_card_of_injOn Prod.fst (fun p hp => ?_) fun p hp q hq hpq => ?_
    · obtain ⟨hpT, rfl⟩ := mem_filter.1 hp
      obtain ⟨hp1, hp2⟩ := mem_product.1 hpT
      exact mem_coe.2 (mem_filter.2 ⟨hp1, by simpa using hp2⟩)
    · have h1 := (mem_filter.1 hp).2
      have h2 := (mem_filter.1 hq).2
      exact Prod.ext hpq (by omega)
  refine Nat.le_of_mul_le_mul_left ?_ hN
  calc N * N ≤ (c * #T) * (c * #T) := Nat.mul_le_mul hc hc
    _ = c ^ 2 * (#T * #T) := by ring
    _ ≤ c ^ 2 * (#{x ∈ T | σ - x ∈ T} * (4 * N)) :=
      Nat.mul_le_mul_left _ (h1.trans (Nat.mul_le_mul_right _ h2))
    _ = _ := by ring

/-- Lemma 5 (b): if `C + 1` translates of `Y` have more than `σ` elements in total, then two of them
meet modulo `σ`. -/
lemma exists_translate {Y : Finset ℕ} {σ C : ℕ} (u : ℕ) (hY : ∀ x ∈ Y, x < σ)
    (hσ : σ < (C + 1) * #Y) :
    ∃ j, 1 ≤ j ∧ j ≤ C ∧ ∃ x ∈ Y, ∃ y ∈ Y, x + (σ - y) ≡ j * u [MOD σ] := by
  obtain ⟨⟨i, x⟩, hix, ⟨i', y⟩, hiy, hne, heq⟩ := exists_ne_map_eq_of_card_lt_of_maps_to
    (s := range (C + 1) ×ˢ Y) (t := range σ) (f := fun p => (p.2 + p.1 * u) % σ)
    (by rwa [card_product, card_range, card_range]) fun p hp => mem_coe.2 (mem_range.2
      (Nat.mod_lt _ ((Nat.zero_le _).trans_lt (hY p.2 (mem_product.1 hp).2))))
  obtain ⟨hi, hx⟩ := mem_product.1 hix
  obtain ⟨hi', hy⟩ := mem_product.1 hiy
  rw [mem_range] at hi hi'
  dsimp only at hi hi' hx hy heq
  wlog hii : i ≤ i' generalizing i i' x y
  · exact this i' y hiy i x hix hne.symm heq.symm hi' hy hi hx (by omega)
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hii
  have hmod : x ≡ y + j * u [MOD σ] := by
    refine Nat.ModEq.add_right_cancel' (i * u) (Eq.trans heq ?_)
    rw [add_mul, add_assoc, add_comm (i * u)]
  have hyσ := hY y hy
  refine ⟨j, Nat.pos_of_ne_zero ?_, by omega, x, hx, y, hy, ?_⟩
  · rintro rfl
    rw [zero_mul, add_zero] at hmod
    exact hne (by rw [hmod.eq_of_lt_of_lt (hY x hx) hyσ, add_zero])
  · calc x + (σ - y) ≡ y + j * u + (σ - y) [MOD σ] := hmod.add_right _
      _ = σ + j * u := by omega
      _ ≡ j * u [MOD σ] := by simp

/-- Lemma 5: the multiples of `g = g c` in `[4 g N, 10 g N]` are sums of at most `K c` elements of
`T`. -/
lemma cover {T : Finset ℕ} {N c n : ℕ} (hN : 1 ≤ N) (hT : ∀ x ∈ T, 1 ≤ x ∧ x ≤ 2 * N)
    (hc : N ≤ c * #T) (hgn : g c ∣ n) (hn : 4 * (g c * N) ≤ n) (hn' : n ≤ 10 * (g c * N)) :
    ∃ M : Multiset ℕ, (∀ x ∈ M, x ∈ T) ∧ M.sum = n ∧ M.card ≤ K c := by
  obtain ⟨σ, hσ, hσY⟩ := exists_popular_sum hN hT hc
  set Y : Finset ℕ := {x ∈ T | σ - x ∈ T}
  have hY : ∀ x ∈ Y, x ∈ T ∧ σ - x ∈ T ∧ x < σ := fun x hx => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hx
    have := hT _ h2
    exact ⟨h1, h2, by omega⟩
  have hYσ : #Y ≤ σ := by
    simpa using card_le_card (t := range σ) fun x hx => mem_range.2 (hY x hx).2.2
  -- find `x`, `z` in `T` with `x + z = j u` modulo `σ`
  obtain ⟨u, rfl⟩ := hgn
  have hσC : σ < (16 * c ^ 2 + 1) * #Y := by
    have h1 : (16 * c ^ 2 + 1) * #Y = 4 * (4 * c ^ 2 * #Y) + #Y := by ring
    have h2 : #Y ≠ 0 := fun h0 => by rw [h0] at hσY; omega
    omega
  obtain ⟨j, hj1, hjC, x, hx, y, hy, hxz⟩ := exists_translate u (fun x hx => (hY x hx).2.2) hσC
  obtain ⟨hxT, hσx, hxσ⟩ := hY x hx
  obtain ⟨-, hzT, -⟩ := hY y hy
  generalize σ - y = z at hzT hxz
  -- multiply by `a = g / j` and add copies of `σ = x + (σ - x)`
  obtain ⟨a, ha⟩ : j ∣ g c := Nat.dvd_factorial hj1 hjC
  have hag : a ≤ g c := ha ▸ Nat.le_mul_of_pos_left _ hj1
  have hle : a * (x + z) ≤ g c * u := by
    have := (hT x hxT).2; have := (hT z hzT).2
    calc a * (x + z) ≤ g c * (4 * N) := Nat.mul_le_mul hag (by omega)
      _ = 4 * (g c * N) := by ring
      _ ≤ g c * u := hn
  obtain ⟨k, hk⟩ : σ ∣ g c * u - a * (x + z) := by
    refine (Nat.modEq_iff_dvd' hle).1 ?_
    calc a * (x + z) ≡ a * (j * u) [MOD σ] := hxz.mul_left _
      _ = g c * u := by rw [ha]; ring
  have hkK : k ≤ 40 * c ^ 2 * g c := by
    refine Nat.le_of_mul_le_mul_right ?_ hN
    calc k * N ≤ k * (4 * c ^ 2 * σ) :=
          Nat.mul_le_mul_left _ (hσY.trans (Nat.mul_le_mul_left _ hYσ))
      _ = 4 * c ^ 2 * (σ * k) := by ring
      _ ≤ 4 * c ^ 2 * (10 * (g c * N)) := Nat.mul_le_mul_left _ (by omega)
      _ = 40 * c ^ 2 * g c * N := by ring
  refine ⟨.replicate a x + .replicate a z + .replicate k x + .replicate k (σ - x), ?_, ?_, ?_⟩
  · intro w hw
    simp only [Multiset.mem_add, Multiset.mem_replicate] at hw
    rcases hw with ((⟨_, rfl⟩ | ⟨_, rfl⟩) | ⟨_, rfl⟩) | ⟨_, rfl⟩ <;> assumption
  · simp only [Multiset.sum_add, Multiset.sum_replicate, smul_eq_mul]
    rw [add_assoc, ← mul_add, ← mul_add, Nat.add_sub_cancel' hxσ.le, mul_comm k, ← hk]
    omega
  · simp only [Multiset.card_add, Multiset.card_replicate]
    calc a + a + k + k ≤ 2 * g c + 2 * (40 * c ^ 2 * g c) := by omega
      _ = K c := by unfold K; ring

/-! ### Lemma 6: residues -/

/-- Lemma 6 (a): a finite set has a subset of fewer than `d` elements with the same sum modulo `d`
(two initial sums agree modulo `d`; remove the elements in between). -/
lemma exists_small_subset {d : ℕ} (hd : 1 ≤ d) (E : Finset ℕ) :
    ∃ E' ⊆ E, #E' < d ∧ ∑ x ∈ E', x ≡ ∑ x ∈ E, x [MOD d] := by
  induction E using Finset.strongInduction with
  | H E ih =>
    rcases lt_or_ge #E d with hE | hE
    · exact ⟨E, Subset.rfl, hE, Nat.ModEq.refl _⟩
    -- the initial sums over `x < y`, where `y` is in `E` or `y` is larger than all elements of `E`
    obtain ⟨b, hb⟩ := E.exists_nat_subset_range
    have hbE : ∀ x ∈ E, x < b := fun x hx => mem_range.1 (hb hx)
    obtain ⟨y, hy, z, hz, hne, heq⟩ := exists_ne_map_eq_of_card_lt_of_maps_to
      (s := insert b E) (t := range d) (f := fun y => (∑ x ∈ E with x < y, x) % d)
      (by rw [card_range, card_insert_of_notMem fun h => (hbE b h).false]; omega)
      fun y _ => mem_coe.2 (mem_range.2 (Nat.mod_lt _ hd))
    wlog hyz : y < z generalizing y z
    · exact this z hz y hy hne.symm heq.symm (by omega)
    have hyE : y ∈ E := (mem_insert.1 hy).resolve_left fun h => by
      rcases mem_insert.1 hz with rfl | hz
      exacts [hyz.ne h, (hbE z hz).not_gt (h ▸ hyz)]
    obtain ⟨E', hE', hE'd, hmod⟩ := ih ({x ∈ E | x < y} ∪ {x ∈ E | ¬ x < z}) <| by
      refine (ssubset_iff_of_subset (union_subset (filter_subset _ _) (filter_subset _ _))).2
        ⟨y, hyE, by simp [hyz]⟩
    refine ⟨E', hE'.trans (union_subset (filter_subset _ _) (filter_subset _ _)), hE'd,
      hmod.trans ?_⟩
    rw [sum_union (disjoint_filter.2 fun x _ h => by omega),
      ← sum_filter_add_sum_filter_not E (· < z)]
    exact Nat.ModEq.add_right _ heq

/-- Lemma 6 (b): every residue modulo `d` is a sum of fewer than `d` distinct elements of `A`, and
this sum is bounded. -/
lemma exists_residue {A : Set ℕ} {d m₀ : ℕ} (hd : 1 ≤ d)
    (hA : ∀ m ≥ m₀, ∃ E : Finset ℕ, (∀ x ∈ E, x ∈ A) ∧ ∑ x ∈ E, x = m) (n : ℕ) :
    ∃ E : Finset ℕ, (∀ x ∈ E, x ∈ A) ∧ #E < d ∧ ∑ x ∈ E, x ≡ n [MOD d] ∧
      ∑ x ∈ E, x ≤ d * (m₀ + 1) := by
  obtain ⟨E₀, hE₀A, hE₀⟩ := hA (n % d + d * m₀)
    ((Nat.le_mul_of_pos_left m₀ hd).trans (Nat.le_add_left _ _))
  obtain ⟨E, hEE, hEd, hmod⟩ := exists_small_subset hd E₀
  refine ⟨E, fun x hx => hE₀A x (hEE hx), hEd, hmod.trans ?_, ?_⟩
  · rw [hE₀]
    simp [Nat.ModEq]
  · have h1 : ∑ x ∈ E, x ≤ ∑ x ∈ E₀, x := sum_le_sum_of_subset hEE
    have h2 := Nat.mod_lt n hd
    rw [mul_add]
    omega

/-! ### Lemmas 7 and 8: one scale and two consecutive scales -/

/-- Lemma 7: if `N` has type `c`, then the multiples of `g = g c` in `[4 g N, 10 g N]` are
`(2 h K c, g)`-robust. -/
lemma one_scale {A : Set ℕ} {h N c n : ℕ} (hN : 1 ≤ N) (hc : HasType A h N c) (hgn : g c ∣ n)
    (hn : 4 * (g c * N) ≤ n) (hn' : n ≤ 10 * (g c * N)) :
    n ∈ D A (2 * h * K c) (g c) := by
  obtain ⟨M, hM, rfl, hMK⟩ := cover hN (fun x hx => (mem_cut.1 hx).1) hc hgn hn hn'
  have hMK' := Nat.mul_le_mul_left (2 * h) hMK
  have hQ : g c + 2 * h * M.card ≤ Q h c := by
    unfold Q
    omega
  exact D_mono hMK' le_rfl (sum_mem_D M fun x hx => D_mono le_rfl hQ (mem_cut.1 (hM x hx)).2)

/-- Lemma 8, the number `v`: if `N` has type `c`, then some `v ≥ N / c` in `[1, 2 N]` is
`(2 h, Q h c)`-robust. -/
lemma exists_large {A : Set ℕ} {h N c : ℕ} (hN : 1 ≤ N) (hc : HasType A h N c) :
    ∃ v ∈ D A (2 * h) (Q h c), 1 ≤ v ∧ v ≤ 2 * N ∧ N ≤ c * v := by
  rw [HasType] at hc
  set T := cut (D A (2 * h) (Q h c)) 1 (2 * N)
  have hne : T.Nonempty := card_pos.1 (Nat.pos_of_ne_zero fun h0 => by rw [h0] at hc; omega)
  obtain ⟨v, hvT, hmax⟩ := exists_max_image T id hne
  obtain ⟨⟨hv1, hvN⟩, hvD⟩ := mem_cut.1 hvT
  have hTv : #T ≤ v := by
    simpa using card_le_card (t := Icc 1 v) fun x hx => mem_Icc.2 ⟨(mem_cut.1 hx).1.1, hmax x hx⟩
  exact ⟨v, hvD, hv1, hvN, hc.trans (Nat.mul_le_mul_left _ hTv)⟩

/-- Lemma 8: if `N` has type `c` and `N + 1` has type `c'`, then the multiples of `g = g c` between
`4 g N` and `5 g' (N + 1)` are `(2 h K c + 2 h K c', g)`-robust, where `g' = g c'`. -/
lemma two_scales {A : Set ℕ} {h N c c' n : ℕ} (hN : 1 ≤ N) (hc : HasType A h N c)
    (hc' : HasType A h (N + 1) c') (hgn : g c ∣ n) (hn : 4 * (g c * N) ≤ n)
    (hn' : n ≤ 5 * (g c' * (N + 1))) : n ∈ D A (2 * h * K c + 2 * h * K c') (g c) := by
  rcases le_or_gt n (10 * (g c * N)) with hn10 | hn10
  · exact D_mono (Nat.le_add_right _ _) le_rfl (one_scale hN hc hgn hn hn10)
  have hcc : c ≤ c' := by
    by_contra! hcc
    have := Nat.mul_le_mul (g_mono hcc.le) (by omega : N + 1 ≤ 2 * N)
    linarith
  -- subtract a multiple of `g c * v`, where `v` is large and `(2 h, Q h c')`-robust
  obtain ⟨v, hvD, hv1, hvN, hNv⟩ := exists_large (by omega) hc'
  obtain ⟨p, ρ, hρ, hpρ⟩ : ∃ p ρ, ρ < g c * v ∧ n = 4 * (g c * N) + ρ + p * g c * v := by
    refine ⟨(n - 4 * (g c * N)) / (g c * v), (n - 4 * (g c * N)) % (g c * v),
      Nat.mod_lt _ (Nat.mul_pos (g_pos c) hv1), ?_⟩
    have := Nat.mod_add_div' (n - 4 * (g c * N)) (g c * v)
    rw [mul_assoc _ (g c) v]
    omega
  have hρ4 : ρ ≤ 4 * (g c * N) := by
    calc ρ ≤ g c * (4 * N) := hρ.le.trans (Nat.mul_le_mul_left _ (by omega))
      _ = 4 * (g c * N) := by ring
  have hp : p * g c ≤ K c' := by
    refine Nat.le_of_mul_le_mul_right ?_ hv1
    calc p * g c * v ≤ 5 * (g c' * (N + 1)) := by omega
      _ ≤ 5 * (g c' * (c' * v)) := by gcongr
      _ = 5 * c' * g c' * v := by ring
      _ ≤ K c' * v := by
        unfold K
        gcongr
        nlinarith [Nat.le_mul_self c']
  have hgρ : g c ∣ 4 * (g c * N) + ρ :=
    (Nat.dvd_add_left ((Dvd.intro_left p rfl).mul_right v)).1 (hpρ ▸ hgn)
  have hQ : g c + 2 * h * K c + 2 * h * (p * g c) ≤ Q h c' := by
    have h1 := g_mono hcc
    have h2 := Nat.mul_le_mul_left (2 * h) (K_mono hcc)
    have h3 := Nat.mul_le_mul_left (2 * h) hp
    unfold Q
    omega
  have hv := sum_mem_D (A := A) (k := 2 * h) (q := g c + 2 * h * K c) (.replicate (p * g c) v)
    fun x hx => by
      rw [Multiset.eq_of_mem_replicate hx, Multiset.card_replicate]
      exact D_mono le_rfl hQ hvD
  rw [Multiset.card_replicate, Multiset.sum_replicate, smul_eq_mul] at hv
  rw [hpρ]
  exact add_mem_D (one_scale hN hc hgρ (by omega) (by omega))
    (D_mono (Nat.mul_le_mul_left _ hp) le_rfl hv)

/-! ### The theorem -/

/-- The theorem, with the explicit bound `f h = Q h (typ h h)`. Condition (ii) is used only in the
weak form that every large integer is a sum of distinct elements of `A`. -/
theorem bounded_by_order {A : Set ℕ} {h : ℕ} (hA : HasOrder A h)
    (hA' : ∀ᶠ m in atTop, ∃ E : Finset ℕ, (∀ x ∈ E, x ∈ A) ∧ ∑ x ∈ E, x = m) :
    HasRestrictedOrder A (Q h (typ h h)) := by
  obtain ⟨N₁, hN₁⟩ := exists_type hA
  obtain ⟨m₀, hm₀⟩ := eventually_atTop.1 hA'
  choose! γ hγ hγN using hN₁
  set N₂ := N₁ + m₀ + 1
  refine eventually_atTop.2 ⟨5 * (g (γ N₂) * N₂), fun n hn => ?_⟩
  -- the scale `N`
  obtain ⟨i, hlow, hup⟩ := Nat.exists_not_and_succ_of_not_zero_of_exists
    (p := fun i => n < 5 * (g (γ (N₂ + i)) * (N₂ + i))) (not_lt.2 hn) ⟨n + 1, by
      have := Nat.le_mul_of_pos_left (N₂ + (n + 1)) (g_pos (γ (N₂ + (n + 1))))
      omega⟩
  obtain ⟨N, hN⟩ : ∃ N, N = N₂ + i := ⟨_, rfl⟩
  rw [not_lt, ← hN] at hlow
  rw [← add_assoc, ← hN] at hup
  have hc := hγN N (by omega)
  have hc' := hγN (N + 1) (by omega)
  have hcC := hγ N (by omega)
  have hcC' := hγ (N + 1) (by omega)
  generalize γ N = c at *
  generalize γ (N + 1) = c' at *
  -- the residue modulo `g c`
  obtain ⟨E, hEA, hEg, hEn, hEs⟩ := exists_residue (g_pos c) hm₀ n
  have hEN : ∑ x ∈ E, x ≤ g c * N := hEs.trans (Nat.mul_le_mul_left _ (by omega))
  have hgn := (Nat.modEq_iff_dvd' (by omega)).1 hEn
  -- the rest of the sum
  have hrest : n - ∑ x ∈ E, x ∈ D A (2 * h * K c + 2 * h * K c') (0 + g c) := by
    rw [zero_add]
    exact two_scales (by omega) hc hc' hgn (by omega) (by omega)
  have hmem := add_mem_D (mem_D_zero hEA hEg.le) hrest
  have hcount : g c + (2 * h * K c + 2 * h * K c') ≤ Q h (typ h h) := by
    have h1 := g_mono hcC
    have h2 := Nat.mul_le_mul_left (2 * h) (K_mono hcC)
    have h3 := Nat.mul_le_mul_left (2 * h) (K_mono hcC')
    unfold Q
    omega
  obtain ⟨G, hG, hGc, hGn⟩ := hmem ∅ (by simp)
  exact ⟨G, fun x hx => (hG x hx).1, hGc.trans hcount, by omega⟩

end E338

/-- The restricted order of a basis, if it exists, is bounded in terms of the order (question 3(ii)
of Erdős and Graham 1980). -/
public theorem main : type_of% @Erdos338.erdos_338.variants.bounded_by_order :=
  ⟨fun h => E338.Q h (E338.typ h h), fun _ _ hA ⟨_, ht⟩ =>
    E338.bounded_by_order hA (ht.mono fun _ ⟨E, hE, _, hm⟩ => ⟨E, hE, hm⟩)⟩

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
