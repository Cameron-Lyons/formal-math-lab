(26+27*a)*1+(28+28*a)*x1^2*x2^2*x3^2+(28+28*a)*x2^2*x3^2*x4^2+1*x3^2*x4^2*x5^2+1*x4^2*x5^2*x6^2+(28+28*a)*x5^2*x6^2*x7^2+(0+1*a)*x6^2*x7^2*x8^2+1*x7^2*x8^2*x9^2+(28+28*a)*x8^2*x9^2*x10^2+(0+1*a)*x9^2*x10^2*x11^2+1*x10^2*x11^2*x12^2+1*x11^2*x12^2*x13^2+1*x12^2*x13^2*x14^2+(28+28*a)*x13^2*x14^2*x15^2+(28+28*a)*x14^2*x15^2*x16^2+(28+28*a)*x15^2*x16^2*x17^2+(28+28*a)*x16^2*x17^2*x18^2+(28+28*a)*x17^2*x18^2*x19^2;
option(redSB);
print("GB_STARTED");
ideal G=std(I);
print("GB_COMPLETE");
print("BASIS_IS_STANDARD="+string(attrib(G,"isSB")));
print("KRULL_DIM="+string(dim(G)));
print("BASIS_SIZE="+string(size(G)));
for(int k=1;k<=size(G);k++){if(G[k]==0){ERROR("zero polynomial in standard basis export");}print("LM="+string(leadexp(G[k])));}
print("LM_COMPLETE");
print("HILB_STARTED");
bigintvec H=hilb(G,2);
print("HILB_TYPE="+typeof(H));
bigint D=0;
for(int j=1;j<size(H);j++){D=D+H[j];}
print("HILB_DIM="+string(D));
print("BACKEND_COMPLETE");
quit;
