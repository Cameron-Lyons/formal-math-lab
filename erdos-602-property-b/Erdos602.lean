open Set

namespace E602

variable {α : Type*} {I : Type*}

/-! ### Definitions -/

/-- The hypotheses: each `A i` is countable and has at least two points; two of the sets have a
finite intersection, and if they have a point `u` in common, then also a second one. -/
structure Family (A : I → Set α) : Prop where
  countable : ∀ i, (A i).Countable
  nontrivial : ∀ i, (A i).Nontrivial
  finite : ∀ i j, i ≠ j → (A i ∩ A j).Finite
  second : ∀ i j, i ≠ j → ∀ u ∈ A i ∩ A j, ∃ x ∈ A i ∩ A j, x ≠ u

/-- A partial colouring: `f x = some c` means that `x` has colour `c`, and `f x = none` that `x` is
uncoloured. The colour opposite to `c` is `!c`. -/
def Colouring (α : Type*) := α → Option Bool

/-- `f ≤ g` (`g` extends `f`): every point coloured by `f` has the same colour under `g`. -/
instance : Preorder (Colouring α) where
  le f g := ∀ x c, f x = some c → g x = some c
  le_refl _ _ _ h := h
  le_trans _ _ _ h h' x c hx := h' x c (h x c hx)

open Classical in
/-- Colour the points of `J` with `c`, and leave the other points as they are. -/
noncomputable def Colouring.paint (f : Colouring α) (J : Set α) (c : Bool) : Colouring α :=
  fun x => if x ∈ J then some c else f x

/-- The set `A i` is split by `f`: it contains points of both colours. -/
def Split (A : I → Set α) (f : Colouring α) (i : I) : Prop := ∀ c, ∃ x ∈ A i, f x = some c

/-- The point `y` is settled by `f`: every set containing `y` is split. -/
def Settled (A : I → Set α) (f : Colouring α) (y : α) : Prop := ∀ i, y ∈ A i → Split A f i

/-- A partial colouring is closed if every coloured point is settled. -/
def Closed (A : I → Set α) (f : Colouring α) : Prop := ∀ y c, f y = some c → Settled A f y

/-- `G` is a guard of the point `z` in colour `c`: a finite set of indices of split sets with label
`c`, such that every unsplit set containing `z` has an uncoloured point in some `A k`, `k ∈ G`. -/
structure Guard (A : I → Set α) (f : Colouring α) (l : I → Bool) (c : Bool) (z : α) (G : Set I) :
    Prop where
  finite : G.Finite
  split : ∀ k ∈ G, Split A f k
  label : ∀ k ∈ G, l k = c
  free : ∀ i, z ∈ A i → ¬Split A f i → ∃ k ∈ G, ∃ x ∈ A i ∩ A k, f x = none

/-- A state: a partial colouring and labels of the sets, such that only countably many coloured
points are unsettled and every coloured point has a guard in its own colour. -/
structure State (A : I → Set α) where
  col : Colouring α
  label : I → Bool
  countable : {y | (∃ c, col y = some c) ∧ ¬Settled A col y}.Countable
  guard : ∀ z c, col z = some c → ∃ G, Guard A col label c z G

variable {A : I → Set α} {f g : Colouring α}

/-- A painted point has its new colour. -/
theorem paint_mem {J : Set α} {c : Bool} {x : α} (hx : x ∈ J) : f.paint J c x = some c :=
  if_pos hx

/-- The other points are as before. -/
theorem paint_notMem {J : Set α} {c : Bool} {x : α} (hx : x ∉ J) : f.paint J c x = f x :=
  if_neg hx

/-- Painting uncoloured points gives an extension. -/
theorem le_paint {J : Set α} (hJ : ∀ x ∈ J, f x = none) (c : Bool) : f ≤ f.paint J c := by
  intro x d hx
  have hxJ : x ∉ J := fun h => by simp [hJ x h] at hx
  rw [paint_notMem hxJ, hx]

/-- Remark (a), for sets: what is split stays split. -/
theorem Split.mono (h : f ≤ g) {i : I} (hi : Split A f i) : Split A g i := fun c =>
  let ⟨x, hx, hxc⟩ := hi c
  ⟨x, hx, h x c hxc⟩

/-- Remark (a), for points: what is settled stays settled. -/
theorem Settled.mono (h : f ≤ g) {y : α} (hy : Settled A f y) : Settled A g y :=
  fun i hi => (hy i hi).mono h

/-- Remark (b): a set with a point of colour `c` and a point of colour `!c` is split. -/
theorem split_of_two {i : I} {c : Bool} {x z : α} (hx : x ∈ A i) (hxc : f x = some c) (hz : z ∈ A i)
    (hzc : f z = some (!c)) : Split A f i := by
  intro d
  rcases Bool.eq_or_eq_not d c with rfl | rfl
  · exact ⟨x, hx, hxc⟩
  · exact ⟨z, hz, hzc⟩

/-- Remark (c): the empty set is a guard of every settled point. -/
theorem Settled.guard {y : α} (hy : Settled A f y) (l : I → Bool) (c : Bool) :
    Guard A f l c y ∅ where
  finite := finite_empty
  split := by simp
  label := by simp
  free i hi hns := absurd (hy i hi) hns

/-- Remark (d): a chain of partial colourings has a union `F`. It extends all members, and every
colour of `F` comes from a member. -/
theorem exists_union {S : Set (Colouring α)} (hS : IsChain (· ≤ ·) S) :
    ∃ F : Colouring α, (∀ f ∈ S, f ≤ F) ∧ ∀ x c, F x = some c → ∃ f ∈ S, f x = some c := by
  have key : ∀ x, ∃ o : Option Bool, ∀ c, o = some c ↔ ∃ f ∈ S, f x = some c := by
    intro x
    by_cases h : ∃ d, ∃ f ∈ S, f x = some d
    · obtain ⟨d, f, hf, hfx⟩ := h
      refine ⟨some d, fun c => ⟨fun h => ⟨f, hf, hfx.trans h⟩, fun ⟨g, hg, hgx⟩ => ?_⟩⟩
      rcases hS.total hf hg with h | h
      · rw [← h x d hfx, hgx]
      · rw [← hfx, h x c hgx]
    · exact ⟨none, fun c => ⟨fun h' => by simp at h', fun h' => absurd ⟨c, h'⟩ h⟩⟩
  choose F hF using key
  exact ⟨F, fun f hf x c hx => (hF x c).2 ⟨f, hf, hx⟩, fun x c => (hF x c).1⟩

/-! ### Lemma 1: greedy hitting sets -/

/-- The greedy rule: `w` is taken if it is the last point of some `F i` of which no earlier point
was taken. -/
def Taken {ι : Type*} [LinearOrder α] [WellFoundedLT α] (F : ι → Set α) (w : α) : Prop :=
  ∃ i, IsGreatest (F i) w ∧ ∀ x ∈ F i, ∀ _ : x < w, ¬Taken F x
termination_by wellFounded_lt.wrap w
decreasing_by assumption

/-- **Lemma 1.** For nonempty finite sets `F i` there is a set `J` that meets every `F i` and each
point of which is the only point of `J` in some `F i`. -/
theorem exists_hitting {ι : Type*} (F : ι → Set α) (hF : ∀ i, (F i).Finite)
    (hne : ∀ i, (F i).Nonempty) :
    ∃ J ⊆ ⋃ i, F i, (∀ i, (F i ∩ J).Nonempty) ∧ ∀ w ∈ J, ∃ i, F i ∩ J = {w} := by
  obtain ⟨_, _⟩ := exists_wellFoundedLT α
  have rule (w : α) : Taken F w ↔ ∃ i, IsGreatest (F i) w ∧ ∀ x ∈ F i, x < w → ¬Taken F x := by
    rw [Taken]
  refine ⟨{w | Taken F w}, fun w hw => ?_, fun i => ?_, fun w hw => ?_⟩
  · obtain ⟨i, hi, -⟩ := (rule w).1 hw
    exact mem_iUnion.2 ⟨i, hi.1⟩
  · obtain ⟨w, hw, hmax⟩ := exists_max_image (F i) id (hF i) (hne i)
    by_contra h
    have hno : ∀ x ∈ F i, ¬Taken F x := fun x hx hxJ => h ⟨x, hx, hxJ⟩
    exact hno w hw ((rule w).2 ⟨i, ⟨hw, hmax⟩, fun x hx _ => hno x hx⟩)
  · obtain ⟨i, hi, hno⟩ := (rule w).1 hw
    refine ⟨i, eq_singleton_iff_unique_mem.2 ⟨⟨hi.1, hw⟩, fun x hx => ?_⟩⟩
    by_contra hxw
    exact hno x hx.1 (lt_of_le_of_ne (hi.2 hx.1) hxw) hx.2

/-! ### Lemma 2: lone points -/

/-- **Lemma 2.** Let `A k` be split, with label `c`, and let `w` be its only point of colour `c`.
Then `{k}` is a guard of `w`, that is, every unsplit set through `w` has an uncoloured point in
`A k`. -/
theorem guard_of_lone (hA : Family A) {l : I → Bool} {c : Bool} {k : I} {w : α} (hk : Split A f k)
    (hl : l k = c) (hwk : w ∈ A k) (hw : f w = some c) (hone : ∀ x ∈ A k, f x = some c → x = w) :
    Guard A f l c w {k} where
  finite := finite_singleton k
  split _ h := h ▸ hk
  label _ h := h ▸ hl
  free i hwi hi := by
    have hik : i ≠ k := fun h => hi (h ▸ hk)
    obtain ⟨x, hx, hxw⟩ := hA.second i k hik w ⟨hwi, hwk⟩
    refine ⟨k, rfl, x, hx, Option.eq_none_iff_forall_ne_some.2 fun d hd => ?_⟩
    rcases Bool.eq_or_eq_not d c with rfl | rfl
    · exact hxw (hone x hx.2 hd)
    · exact hi (split_of_two hwi hw hx.1 hd)

/-! ### Lemma 3: the points to be coloured -/

/-- `J` is a settling set for the point `y` of colour `c`: a countable set of uncoloured points with
the properties (1) `hit`, (2) `alone` and (3) `finite`. -/
structure SettlingSet (s : State A) (c : Bool) (y : α) (J : Set α) : Prop where
  colour : s.col y = some c
  countable : J.Countable
  uncoloured : ∀ w ∈ J, s.col w = none
  hit : ∀ i, y ∈ A i → ¬Split A s.col i → ∃ w ∈ J, w ∈ A i
  alone : ∀ w ∈ J, ∃ j, y ∈ A j ∧ ¬Split A s.col j ∧ A j ∩ J = {w}
  finite : ∀ k, s.label k = !c → (A k ∩ J).Finite

/-- **Lemma 3.** In a state, every coloured point has a settling set. -/
theorem exists_settlingSet (hA : Family A) (s : State A) {c : Bool} {y : α}
    (hy : s.col y = some c) : ∃ J, SettlingSet s c y J := by
  obtain ⟨G, hG⟩ := s.guard y c hy
  -- the uncoloured points of the guard, and the unsplit sets through `y`
  let U : Set α := {x | s.col x = none ∧ ∃ k ∈ G, x ∈ A k}
  let E : Set I := {i | y ∈ A i ∧ ¬Split A s.col i}
  have hUG : U ⊆ ⋃ k ∈ G, A k := fun x ⟨_, k, hk, hxk⟩ => mem_biUnion hk hxk
  have hfin : ∀ i ∉ G, (A i ∩ U).Finite := by
    intro i hi
    refine (hG.finite.biUnion fun k hk => hA.finite i k fun h => hi (h ▸ hk)).subset ?_
    rw [← inter_iUnion₂]
    exact inter_subset_inter_right _ hUG
  obtain ⟨J, hJU, hJ, hJa⟩ := exists_hitting (fun i : E => A i ∩ U)
    (fun i => hfin i fun h => i.2.2 (hG.split i h))
    (fun i =>
      let ⟨k, hk, x, hx, hxf⟩ := hG.free i i.2.1 i.2.2
      ⟨x, hx.1, hxf, k, hk, hx.2⟩)
  replace hJU : J ⊆ U := hJU.trans (iUnion_subset fun i => inter_subset_right)
  refine ⟨J, hy, ?_, fun w hw => (hJU hw).1, fun i hi hns => ?_, fun w hw => ?_, fun k hkc => ?_⟩
  · exact (hG.finite.countable.biUnion fun k _ => hA.countable k).mono (hJU.trans hUG)
  · obtain ⟨w, hw, hwJ⟩ := hJ ⟨i, hi, hns⟩
    exact ⟨w, hwJ, hw.1⟩
  · obtain ⟨j, hj⟩ := hJa w hw
    refine ⟨j, j.2.1, j.2.2, ?_⟩
    rw [← hj, inter_assoc, inter_eq_right.2 hJU]
  · have hkG : k ∉ G := fun h => by simp [hG.label k h] at hkc
    exact (hfin k hkG).subset (inter_subset_inter_right _ hJU)

/-! ### Lemma 4: settling one point -/

open Classical in
/-- The labels `m` of Lemma 4, for a point `y` of colour `c`: sets that are split already keep their
labels, the others get the label `!c`. -/
noncomputable def State.relabel (s : State A) (c : Bool) : I → Bool :=
  fun i => if Split A s.col i then s.label i else !c

namespace SettlingSet

variable {s : State A} {c : Bool} {y : α} {J : Set α}

/-- The new colouring extends the old one. -/
theorem le (hJ : SettlingSet s c y J) : s.col ≤ s.col.paint J !c :=
  le_paint hJ.uncoloured _

/-- The new colouring settles `y`. -/
theorem settled (hJ : SettlingSet s c y J) : Settled A (s.col.paint J !c) y := by
  intro i hi
  by_cases h : Split A s.col i
  · exact h.mono hJ.le
  · obtain ⟨w, hw, hwi⟩ := hJ.hit i hi h
    exact split_of_two hi (hJ.le y c hJ.colour) hwi (paint_mem hw)

/-- The claim in Lemma 4: a point `w` of `J` is the lone point of its new colour in some `A j`, so
`{j}` is a guard of `w`. This is case (ii). -/
theorem guard_new (hA : Family A) (hJ : SettlingSet s c y J) {w : α} (hw : w ∈ J) :
    ∃ j, Guard A (s.col.paint J !c) (s.relabel c) (!c) w {j} := by
  obtain ⟨j, hyj, hj, hjw⟩ := hJ.alone w hw
  have hwj : w ∈ A j := (hjw.superset rfl).1
  refine ⟨j, guard_of_lone hA (hJ.settled j hyj) (if_neg hj) hwj (paint_mem hw) ?_⟩
  intro x hx hxc
  by_cases hxJ : x ∈ J
  · exact hjw.subset ⟨hx, hxJ⟩
  · rw [paint_notMem hxJ] at hxc
    exact absurd (split_of_two hyj hJ.colour hx hxc) hj

/-- Case (i) of Lemma 4: a point of colour `c` keeps its guard. -/
theorem guard_same (hJ : SettlingSet s c y J) {z : α} (hz : s.col z = some c) {G : Set I}
    (hG : Guard A s.col s.label c z G) : Guard A (s.col.paint J !c) (s.relabel c) c z G where
  finite := hG.finite
  split k hk := (hG.split k hk).mono hJ.le
  label k hk := (if_pos (hG.split k hk)).trans (hG.label k hk)
  free i hi hns := by
    obtain ⟨k, hk, x, hx, hxf⟩ := hG.free i hi fun h => hns (h.mono hJ.le)
    have hxJ : x ∉ J := fun h => hns (split_of_two hi (hJ.le z c hz) hx.1 (paint_mem h))
    exact ⟨k, hk, x, hx, (paint_notMem hxJ).trans hxf⟩

/-- Case (iii) of Lemma 4: a point of colour `!c` gets a guard, namely its old one and those of
finitely many points of `J`. -/
theorem guard_other (hA : Family A) (hJ : SettlingSet s c y J) {z : α} {H : Set I}
    (hH : Guard A s.col s.label (!c) z H) :
    ∃ G, Guard A (s.col.paint J !c) (s.relabel c) (!c) z G := by
  choose q hq using fun w (hw : w ∈ J) => hJ.guard_new hA hw
  let T : Set α := ⋃ k ∈ H, A k ∩ J
  have hTJ : T ⊆ J := iUnion₂_subset fun k _ => inter_subset_right
  have hT : T.Finite := hH.finite.biUnion fun k hk => hJ.finite k (hH.label k hk)
  let Q : Set I := {k | ∃ w, ∃ hw : w ∈ T, q w (hTJ hw) = k}
  have hQ : Q.Finite := hT.dependent_image fun w hw => q w (hTJ hw)
  refine ⟨H ∪ Q, hH.finite.union hQ, ?_, ?_, fun i hi hns => ?_⟩
  · rintro k (hk | ⟨w, hw, rfl⟩)
    · exact (hH.split k hk).mono hJ.le
    · exact (hq w _).split _ rfl
  · rintro k (hk | ⟨w, hw, rfl⟩)
    · exact (if_pos (hH.split k hk)).trans (hH.label k hk)
    · exact (hq w _).label _ rfl
  · obtain ⟨k, hk, x, hx, hxf⟩ := hH.free i hi fun h => hns (h.mono hJ.le)
    by_cases hxJ : x ∈ J
    · obtain ⟨_, rfl, hfree⟩ := (hq x hxJ).free i hx.1 hns
      exact ⟨q x hxJ, Or.inr ⟨x, mem_biUnion hk ⟨hx.2, hxJ⟩, rfl⟩, hfree⟩
    · exact ⟨k, Or.inl hk, x, hx, (paint_notMem hxJ).trans hxf⟩

end SettlingSet

/-- **Lemma 4.** Every state can be extended to a state that settles a given coloured point `y`. -/
theorem exists_settle (hA : Family A) (s : State A) {c : Bool} {y : α} (hy : s.col y = some c) :
    ∃ t : State A, s.col ≤ t.col ∧ Settled A t.col y := by
  obtain ⟨J, hJ⟩ := exists_settlingSet hA s hy
  refine ⟨⟨s.col.paint J !c, s.relabel c, ?_, fun z d hz => ?_⟩, hJ.le, hJ.settled⟩
  · refine (hJ.countable.union s.countable).mono fun z ⟨⟨d, hz⟩, hzs⟩ => ?_
    by_cases hzJ : z ∈ J
    · exact Or.inl hzJ
    · exact Or.inr ⟨⟨d, (paint_notMem hzJ).symm.trans hz⟩, fun h => hzs (h.mono hJ.le)⟩
  · by_cases hzJ : z ∈ J
    · obtain rfl : (!c) = d := Option.some_inj.1 ((paint_mem hzJ).symm.trans hz)
      obtain ⟨j, hj⟩ := hJ.guard_new hA hzJ
      exact ⟨{j}, hj⟩
    · rw [paint_notMem hzJ] at hz
      obtain ⟨G, hG⟩ := s.guard z d hz
      rcases Bool.eq_or_eq_not d c with rfl | rfl
      · exact ⟨G, hJ.guard_same hz hG⟩
      · exact hJ.guard_other hA hG

/-! ### Lemma 5: closing off -/

/-- The sequence of Lemma 5: step `n = ⟨p, r⟩` applies `K` to the `r`-th entry on the list of the
`p`-th state. -/
def run {S T : Type*} (s₀ : S) (K : S → T → S) (e : S → ℕ → T) : ℕ → S
  | 0 => s₀
  | n + 1 => K (run s₀ K e n) (e (run s₀ K e n.unpair.1) n.unpair.2)
decreasing_by all_goals first | omega | exact Nat.lt_succ_of_le n.unpair_left_le

/-- **Lemma 5.** Every state extends to a closed colouring. -/
theorem exists_closed (hA : Family A) (s₀ : State A) : ∃ g, Closed A g ∧ s₀.col ≤ g := by
  -- `K s o` extends `s` and, if the entry `o` is a point coloured by `s`, settles it
  have settle : ∀ (s : State A) (o : Option α), ∃ t : State A, s.col ≤ t.col ∧
      ∀ y c, o = some y → s.col y = some c → Settled A t.col y := by
    intro s o
    by_cases h : ∃ y c, o = some y ∧ s.col y = some c
    · obtain ⟨y, c, rfl, hy⟩ := h
      obtain ⟨t, hle, ht⟩ := exists_settle hA s hy
      exact ⟨t, hle, fun z _ hz _ => Option.some_inj.1 hz ▸ ht⟩
    · exact ⟨s, le_rfl, fun y c ho hy => absurd ⟨y, c, ho, hy⟩ h⟩
  choose K hKle hK using settle
  -- every state has a list, with blanks `none`, of its unsettled coloured points
  choose e he using fun s : State A => countable_iff_exists_subset_range.1 (s.countable.image some)
  let s := run s₀ K e
  have hs : ∀ n, s (n + 1) = K (s n) (e (s n.unpair.1) n.unpair.2) := fun n => by simp only [s, run]
  have hmono : Monotone fun n => (s n).col := monotone_nat_of_le_succ fun n => by
    rw [hs]
    exact hKle _ _
  obtain ⟨g, hSg, hg⟩ := exists_union hmono.isChain_range
  have hle : ∀ n, (s n).col ≤ g := fun n => hSg _ (mem_range_self n)
  have h0 : s 0 = s₀ := by simp only [s, run]
  refine ⟨g, fun y c hy => ?_, h0 ▸ hle 0⟩
  obtain ⟨_, ⟨p, rfl⟩, hp⟩ := hg y c hy
  by_cases hset : Settled A (s p).col y
  · exact hset.mono (hle p)
  · -- `y` is the `r`-th entry on the list of the `p`-th state, and still coloured at step `⟨p, r⟩`
    obtain ⟨r, hr⟩ := he (s p) (mem_image_of_mem some ⟨⟨c, hp⟩, hset⟩)
    have hy' : (s (Nat.pair p r)).col y = some c := hmono (Nat.left_le_pair p r) y c hp
    have : Settled A (s (Nat.pair p r + 1)).col y := by
      rw [hs, Nat.unpair_pair]
      exact hK _ _ y c hr hy'
    exact this.mono (hle _)

/-! ### Lemma 6: starting -/

/-- Two uncoloured points `v ≠ w` can be given the colours `false` and `true`. -/
theorem exists_two_coloured {v w : α} (hv : f v = none) (hw : f w = none) (hvw : v ≠ w) :
    ∃ g, f ≤ g ∧ g v = some false ∧ g w = some true ∧
      ∀ x c, g x = some c → x = v ∧ c = false ∨ x = w ∧ c = true ∨ f x = some c := by
  have hw' : f.paint {v} false w = none := (paint_notMem (J := {v}) hvw.symm).trans hw
  refine ⟨(f.paint {v} false).paint {w} true, ?_, ?_, paint_mem rfl, fun x c hx => ?_⟩
  · exact (le_paint (by simpa) _).trans (le_paint (by simpa) _)
  · exact (paint_notMem (J := {w}) hvw).trans (paint_mem rfl)
  · simp only [Colouring.paint] at hx
    split_ifs at hx with hxw hxv
    · exact Or.inr (Or.inl ⟨hxw, (Option.some_inj.1 hx).symm⟩)
    · exact Or.inl ⟨hxv, (Option.some_inj.1 hx).symm⟩
    · exact Or.inr (Or.inr hx)

/-- Let `g` extend a closed `f` by the colours of `v` and `w`. If `v` and `w` have guards, then `g`
belongs to a state. -/
theorem exists_state (hf : Closed A f) (hle : f ≤ g) {v w : α}
    (hg : ∀ x c, g x = some c → x = v ∧ c = false ∨ x = w ∧ c = true ∨ f x = some c)
    {l : I → Bool} {G H : Set I} (hG : Guard A g l false v G) (hH : Guard A g l true w H) :
    ∃ s : State A, s.col = g := by
  refine ⟨⟨g, l, ?_, fun z c hz => ?_⟩, rfl⟩
  · refine (countable_insert.2 (countable_singleton w) : ({v, w} : Set α).Countable).mono ?_
    rintro z ⟨⟨c, hz⟩, hzs⟩
    rcases hg z c hz with ⟨h, -⟩ | ⟨h, -⟩ | h
    · exact Or.inl h
    · exact Or.inr h
    · exact absurd ((hf z c h).mono hle) hzs
  · rcases hg z c hz with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | h
    · exact ⟨G, hG⟩
    · exact ⟨H, hH⟩
    · exact ⟨∅, ((hf z c h).mono hle).guard l c⟩

/-- **Lemma 6.** If `f` is closed and does not split `A a`, then some state extends `f` and splits
`A a`. -/
theorem exists_start (hA : Family A) (hf : Closed A f) {a : I} (ha : ¬Split A f a) :
    ∃ s : State A, f ≤ s.col ∧ Split A s.col a := by
  classical
  have blank : ∀ i, ¬Split A f i → ∀ x ∈ A i, f x = none := fun i hi x hx =>
    Option.eq_none_iff_forall_ne_some.2 fun c hc => hi (hf x c hc i hx)
  by_cases h : ∃ b, b ≠ a ∧ ¬Split A f b ∧ (A a ∩ A b).Nonempty
  · -- first case: `{a}` guards `v` and `{b}` guards `w`
    obtain ⟨b, hba, hb, w, hwa, hwb⟩ := h
    obtain ⟨v, ⟨hva, hvb⟩, hvw⟩ := hA.second a b hba.symm w ⟨hwa, hwb⟩
    obtain ⟨g, hle, hgv, hgw, hg⟩ := exists_two_coloured (blank a ha v hva) (blank a ha w hwa) hvw
    have hga : Split A g a := split_of_two hva hgv hwa hgw
    have hgb : Split A g b := split_of_two hvb hgv hwb hgw
    let l : I → Bool := fun i => if i = a then false else true
    have hG : Guard A g l false v {a} := guard_of_lone hA hga (if_pos rfl) hva hgv
      fun x hx hxc => by simpa [blank a ha x hx] using hg x false hxc
    have hH : Guard A g l true w {b} := guard_of_lone hA hgb (if_neg hba) hwb hgw
      fun x hx hxc => by simpa [blank b hb x hx] using hg x true hxc
    obtain ⟨s, rfl⟩ := exists_state hf hle hg hG hH
    exact ⟨s, hle, hga⟩
  · -- second case: `v` and `w` are settled
    obtain ⟨v, hv, w, hw, hvw⟩ := hA.nontrivial a
    obtain ⟨g, hle, hgv, hgw, hg⟩ := exists_two_coloured (blank a ha v hv) (blank a ha w hw) hvw
    have hga : Split A g a := split_of_two hv hgv hw hgw
    have hset : ∀ x ∈ A a, Settled A g x := by
      intro x hx i hi
      by_contra hns
      exact h ⟨i, fun h => hns (h ▸ hga), fun h => hns (h.mono hle), x, hx, hi⟩
    obtain ⟨s, rfl⟩ := exists_state hf hle hg ((hset v hv).guard (fun _ => false) _)
      ((hset w hw).guard _ _)
    exact ⟨s, hle, hga⟩

/-! ### The theorem -/

/-- **Theorem**, for countable sets with at least two points: some colouring of all points gives
both colours to every set. By Zorn's lemma there is a maximal closed partial colouring, and it
splits every set. -/
theorem exists_colouring (hA : Family A) : ∃ F : α → Bool, ∀ i c, ∃ x ∈ A i, F x = c := by
  obtain ⟨f, hf⟩ := zorn_le₀ {f : Colouring α | Closed A f} fun S hS hchain => by
    obtain ⟨g, hle, hg⟩ := exists_union hchain
    refine ⟨g, fun y c hy => ?_, hle⟩
    obtain ⟨f, hf, hfy⟩ := hg y c hy
    exact (hS hf y c hfy).mono (hle f hf)
  have hsplit : ∀ i, Split A f i := by
    intro a
    by_contra ha
    obtain ⟨s, hfs, hsa⟩ := exists_start hA hf.prop ha
    obtain ⟨g, hg, hsg⟩ := exists_closed hA s
    have hgf : g ≤ f := hf.le_of_ge hg (hfs.trans hsg)
    exact ha ((hsa.mono hsg).mono hgf)
  exact ⟨fun x => (f x).getD false, fun i c =>
    let ⟨x, hx, hxc⟩ := hsplit i c
    ⟨x, hx, by simp [hxc]⟩⟩

end E602

open E602 in
/-- **Theorem.** The statement of Erdős Problem 602, exactly as formalized upstream. -/
public theorem main : type_of% @Erdos602.erdos_602 := by
  intro α I A h hfin hone
  have hA : Family A := by
    refine ⟨fun i => (h i).1, fun i => (h i).2.nontrivial, hfin, fun i j hij u hu => ?_⟩
    by_contra hno
    push Not at hno
    exact hone i j hij (ncard_eq_one.2 ⟨u, eq_singleton_iff_unique_mem.2 ⟨hu, hno⟩⟩)
  obtain ⟨F, hF⟩ := exists_colouring hA
  refine ⟨fun x => if F x then 1 else 0, fun i hmono => ?_⟩
  obtain ⟨x, hx, hxt⟩ := hF i true
  obtain ⟨y, hy, hyf⟩ := hF i false
  simpa [hxt, hyf] using hmono x hx y hy

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
