module

public import PrimePowers
public import Mathlib.Tactic.Eval
public import Mathlib.Tactic.FinCases

@[expose] public section

set_option Elab.async false

namespace Erdos677
open Finset

private def block (n : ℕ) : ℕ → ℕ
  | 0 => 1
  | k + 1 => (block n k).lcm (n + k + 1)

private theorem block_eq (n k : ℕ) : block n k = lcmInterval n k := by
  induction k with
  | zero => simp [block, lcmInterval]
  | succ k ih => rw [block, ih, lcmInterval_extend]

private def mask : List ℕ → ℕ
  | [] => 0
  | i :: is => (2 ^ i) ||| mask is

private theorem bit_mem (xs : List ℕ) (i : ℕ) :
    (mask xs).testBit i = true ↔ i ∈ xs := by
  induction xs with
  | nil => simp [mask]
  | cons j js ih => simp only [mask, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true,
      decide_eq_true_eq, ih, List.mem_cons]; tauto

/-- Only the ordering is generated by the elaborator. The kernel checks its coverage
and independently computes the LCM of each block. -/
private def makeOrder (limit k bits : ℕ) : ℕ :=
  let rows := (List.range (limit + 1)).map fun n => (n, block n k)
  let sorted := rows.mergeSort fun a b =>
    decide (a.2 < b.2 ∨ (a.2 = b.2 ∧ a.1 ≤ b.1))
  sorted.foldr (fun row acc => row.1 + (acc <<< bits)) 0

private def unpack (bits : ℕ) : ℕ → ℕ → List ℕ
  | 0, _ => []
  | len + 1, data => (data % 2 ^ bits) :: unpack bits len (data >>> bits)

/-- Scan by LCM and by start within a tie. Each class fits into an interval
of fewer than `k` steps. -/
private def scan (k key first : ℕ) : List (ℕ × ℕ) → Bool
  | [] => true
  | (start, value) :: xs =>
    if key = value then decide (first ≤ start ∧ start < first + k) && scan k key first xs
    else decide (key < value) && scan k value start xs

private def lengthCheck (limit k bits order : ℕ) : Bool :=
  let starts := unpack bits (limit + 1) order
  decide (mask starts = 2 ^ (limit + 1) - 1) &&
    scan k 0 0 (starts.map fun n => (n, block n k))

private theorem scan_sound (k : ℕ) (hk : 0 < k) (xs : List (ℕ × ℕ))
    (key first : ℕ) (h : scan k key first xs = true) :
    (∀ a ∈ xs, key < a.2 ∨ (key = a.2 ∧ first ≤ a.1 ∧ a.1 < first + k)) ∧
    ∀ a ∈ xs, ∀ b ∈ xs, a.2 = b.2 → a.1 < b.1 + k := by
  induction xs generalizing key first with
  | nil => simp
  | cons a xs ih =>
    rcases a with ⟨i, v⟩
    by_cases hv : key = v
    · simp [scan, hv] at h
      obtain ⟨hhead, htail⟩ := h
      obtain ⟨hl, hp⟩ := ih _ _ htail
      simp only [List.mem_cons, forall_eq_or_imp]
      grind
    · simp [scan, hv] at h
      obtain ⟨hhead, htail⟩ := h
      obtain ⟨hl, hp⟩ := ih _ _ htail
      simp only [List.mem_cons, forall_eq_or_imp]
      grind

private theorem lengthCheck_sound {limit k bits order n m : ℕ}
    (hc : lengthCheck limit k bits order = true)
    (hpos : 0 < k) (hm : m ≤ limit) (hk : n + k ≤ m) :
    lcmInterval m k ≠ lcmInterval n k := by
  simp only [lengthCheck, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨hmask, hscan⟩ := hc
  let ids := unpack bits (limit + 1) order
  have hmem (i : ℕ) (hi : i ≤ limit) :
      (i, block i k) ∈ ids.map (fun n => (n, block n k)) := by
    apply List.mem_map.mpr
    refine ⟨i, (bit_mem _ i).mp ?_, rfl⟩
    simp [ids, hmask, Nat.lt_succ_of_le hi]
  intro heq
  have eq : block m k = block n k := by simpa [block_eq] using heq
  have h := (scan_sound k hpos _ 0 0 hscan).2 _ (hmem m hm) _ (hmem n (by omega)) eq
  exact (not_lt_of_ge hk) h

private def primeTrial (p : ℕ) : Bool :=
  decide (2 ≤ p) && (List.range (p.sqrt - 1)).all (fun j => p % (j + 2) != 0)

private theorem primeTrial_sound {p : ℕ} (h : primeTrial p = true) : Nat.Prime p := by
  simp only [primeTrial, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  refine Nat.prime_def_le_sqrt.mpr ⟨h.1, fun d hd hdp hdiv => ?_⟩
  have hzero := Nat.mod_eq_zero_of_dvd hdiv
  have hf := h.2 (d - 2) (List.mem_range.mpr (by omega))
  simp [show d - 2 + 2 = d by omega, hzero] at hf

private def primeChain (limit width low : ℕ) : List ℕ → Bool
  | [] => decide (limit < low + width)
  | p :: ps => primeTrial p && decide (low < p ∧ p ≤ low + width) &&
      primeChain limit width p ps

private theorem covered {limit width : ℕ} (ps : List ℕ) (low m : ℕ)
    (hc : primeChain limit width low ps = true) (hm : low ≤ m) (hb : m + width ≤ limit) :
    ∃ p, p.Prime ∧ m < p ∧ p ≤ m + width := by
  induction ps generalizing low with
  | nil => simp [primeChain] at hc; omega
  | cons p ps ih =>
    simp only [primeChain, Bool.and_eq_true, decide_eq_true_eq] at hc
    by_cases hp : m < p
    · exact ⟨p, primeTrial_sound hc.1.1, hp, by omega⟩
    · exact ih p hc.2 (by omega)

private theorem long_ne {limit width m n k : ℕ} {ps : List ℕ}
    (hc : primeChain limit width 0 ps = true)
    (hw : width ≤ k) (hk : 0 < k) (hd : n + k ≤ m) (hb : m + k ≤ limit) :
    lcmInterval m k ≠ lcmInterval n k := by
  obtain ⟨p, hprime, hmp, hup⟩ := covered ps 0 m hc (by omega) (by omega)
  have hdiv : p ^ 1 ∣ lcmInterval m k :=
    (primePower_dvd_interval hprime hk).2 ⟨p, hmp, by omega, by simp⟩
  intro heq
  rw [heq] at hdiv
  obtain ⟨x, hnx, hxk, hdx⟩ := (primePower_dvd_interval hprime hk).1 hdiv
  have hpx : p ≤ x := Nat.le_of_dvd (by omega) (by simpa using hdx)
  omega

private def orders1000 : List ℕ := eval%
  (List.range 19).map fun j => makeOrder 1000 (j + 1) 10

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem short1000 (j : Fin 19) :
    lengthCheck 1000 (j.val + 1) 10 (orders1000[j.val]?.getD 0) = true := by
  fin_cases j <;> (as_aux_lemma => decide +kernel)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private def primes1000 : List ℕ := eval% (List.range 1001).filter primeTrial

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem primeCover1000 : primeChain 1000 20 0 primes1000 = true := by decide +kernel

/-- No disjoint equal-length blocks with the same LCM have last endpoint at most 1000. -/
theorem no_collision_through_1000 {m n k : ℕ} (hk : 0 < k) (hd : n + k ≤ m)
    (hb : m + k ≤ 1000) : lcmInterval m k ≠ lcmInterval n k := by
  by_cases hw : 20 ≤ k
  · exact long_ne primeCover1000 hw hk hd hb
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0)
    exact lengthCheck_sound (short1000 ⟨j, by omega⟩) hk (by omega) hd

end Erdos677
