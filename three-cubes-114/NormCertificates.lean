/-- Each of the 59 surviving discriminants falls strictly between consecutive squares. -/
theorem norm_survivors_between_squares : normSurvivors.length = 59 ∧
    ∀ row ∈ normSurvivors,
      let (a, z, q) := row
      let v := (4 * ((114-z^3)/a) - a^2)/3
      0 ≤ q ∧ q^2 < v ∧ v < (q+1)^2 := by decide +kernel

/-- Exact checks for the additional roots of `A³+114` in the upper band. -/
def otherRootSurvivors : List (Int × Int × Int) :=
  [(3951071115616830922, -215106674999403146344, 1832704471322896909770),
   (-4339129608359825765, 370122730587609592649, 3947177039074155064062)]

private def betweenSquares (row : Int × Int × Int) : Bool :=
  let (a, z, q) := row
  let v := (4 * ((114-z^3)/a) - a^2)/3
  decide (0 ≤ q ∧ q^2 < v ∧ v < (q+1)^2)

theorem other_root_survivors_between_squares :
    otherRootSurvivors.length = 2 ∧ otherRootSurvivors.all betweenSquares = true := by decide +kernel

