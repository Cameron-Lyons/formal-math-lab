open EuclideanGeometry Finset Erdos211

namespace E211

/-! ## The point set -/

/-- Integer vectors `(x, y, z)`. The third coordinate `v 2` is called the height of `v`. -/
abbrev Vec := Fin 3 → ℤ

/-- The integer vectors with `l ≤ x, y ≤ m` and `1 ≤ z ≤ h`. -/
noncomputable def box (l m h : ℤ) : Finset Vec := Icc ![l, l, 1] ![m, m, h]

/-- The half box `S`: the integer vectors with `-R ≤ x, y ≤ R - 1` and `1 ≤ z ≤ R - 1`. -/
noncomputable abbrev S (R : ℕ) : Finset Vec := box (-R) (R - 1) (R - 1)

/-- The central projection `(x, y, z) ↦ (x / z, y / z)`. -/
noncomputable def proj (v : Vec) : ℝ² := !₂[(v 0 : ℝ) / v 2, (v 1 : ℝ) / v 2]

open scoped Classical in
/-- The point set `P`: the projection of the half box. -/
noncomputable def P (R : ℕ) : Finset ℝ² := (S R).image proj

/-- Membership in a box, coordinate by coordinate. -/
theorem mem_box {l m h : ℤ} {v : Vec} : v ∈ box l m h ↔
    (l ≤ v 0 ∧ v 0 ≤ m) ∧ (l ≤ v 1 ∧ v 1 ≤ m) ∧ (1 ≤ v 2 ∧ v 2 ≤ h) := by
  simp only [box, mem_Icc, Pi.le_def, Fin.forall_fin_succ]
  simp
  tauto

/-- The number of elements of a box. -/
theorem card_box (l m h : ℤ) : #(box l m h) = (m + 1 - l).toNat ^ 2 * h.toNat := by
  simp [box, Pi.card_Icc, Fin.prod_univ_three, pow_two]

/-- The half box has `4R²(R - 1)` elements. -/
theorem card_S (R : ℕ) : #(S R) = 4 * R ^ 2 * (R - 1) := by
  have h1 : ((R : ℤ) - 1 + 1 - -R).toNat = 2 * R := by omega
  have h2 : ((R : ℤ) - 1).toNat = R - 1 := by omega
  rw [card_box, h1, h2]
  ring

/-- Two points of the plane with equal coordinates are equal. -/
theorem plane_ext {p q : ℝ²} (h0 : p 0 = q 0) (h1 : p 1 = q 1) : p = q := by
  ext i
  fin_cases i
  exacts [h0, h1]

/-! ## Every line is spanned by a short pair -/

/-- **Lemma 1 (combinations).** Let `u`, `w`, `v` have positive heights, `proj u ≠ proj w`, and
`m v = a u + b w` with `m > 0` and `b ≠ 0`. Then `proj v ≠ proj u`, and `proj u`, `proj v` span the
line through `proj u` and `proj w`. -/
theorem combination {u w v : Vec} (hu : 0 < u 2) (hw : 0 < w 2) (hv : 0 < v 2) {m a b : ℤ}
    (hm : 0 < m) (hb : b ≠ 0) (h : ∀ i, m * v i = a * u i + b * w i) (hne : proj u ≠ proj w) :
    proj u ≠ proj v ∧ line[ℝ, proj u, proj v] = line[ℝ, proj u, proj w] := by
  have hu' : (u 2 : ℝ) ≠ 0 := by exact_mod_cast hu.ne'
  have hw' : (w 2 : ℝ) ≠ 0 := by exact_mod_cast hw.ne'
  have hv' : (v 2 : ℝ) ≠ 0 := by exact_mod_cast hv.ne'
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hb' : (b : ℝ) ≠ 0 := by exact_mod_cast hb
  have h' : ∀ i, (m : ℝ) * v i = a * u i + b * w i := fun i => by exact_mod_cast h i
  -- `proj v = (1 - t) proj u + t proj w`
  set t : ℝ := b * w 2 / (m * v 2) with ht
  have ht0 : t ≠ 0 := by positivity
  have hcoord : ∀ i, (v i : ℝ) / v 2 = u i / u 2 + t * (w i / w 2 - u i / u 2) := by
    intro i
    rw [ht]
    field_simp
    linear_combination (u 2 : ℝ) * h' i - (u i : ℝ) * h' 2
  have hv_eq : proj v = AffineMap.lineMap (proj u) (proj w) t := by
    apply plane_ext
    · simpa [proj, AffineMap.lineMap_apply, add_comm] using hcoord 0
    · simpa [proj, AffineMap.lineMap_apply, add_comm] using hcoord 1
  have hne' : proj u ≠ proj v := by
    rw [hv_eq, ne_comm, Ne, AffineMap.lineMap_eq_left_iff]
    tauto
  refine ⟨hne', line_pair_eq (isLine_pair hne) (left_mem_affineSpan_pair ℝ _ _) ?_ hne'⟩
  rw [hv_eq]
  exact AffineMap.lineMap_mem_affineSpan_pair _ _ _

/-- **Lemma 2 (convexity).** If `u, w ∈ S` and `m v = a u + b w` with `a, b ≥ 0` and
`1 ≤ a + b ≤ m`, then `v ∈ S`. -/
theorem convex {R : ℕ} {u w v : Vec} (hu : u ∈ S R) (hw : w ∈ S R) {m a b : ℤ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : 1 ≤ a + b) (habm : a + b ≤ m)
    (h : ∀ i, m * v i = a * u i + b * w i) : v ∈ S R := by
  rw [mem_box] at hu hw ⊢
  have hm : 0 < m := by omega
  have upper : ∀ i, u i ≤ R - 1 → w i ≤ R - 1 → v i ≤ R - 1 := by
    intro i hui hwi
    have : m * v i ≤ m * (R - 1) := by nlinarith [h i]
    exact le_of_mul_le_mul_left this hm
  have lower : ∀ i, -R ≤ u i → -R ≤ w i → -R ≤ v i := by
    intro i hui hwi
    have : m * -R ≤ m * v i := by nlinarith [h i]
    exact le_of_mul_le_mul_left this hm
  have height : 0 < v 2 := by
    have : 0 < m * v 2 := by nlinarith [h 2]
    exact (mul_pos_iff_of_pos_left hm).mp this
  exact ⟨⟨lower 0 hu.1.1 hw.1.1, upper 0 hu.1.2 hw.1.2⟩,
    ⟨lower 1 hu.2.1.1 hw.2.1.1, upper 1 hu.2.1.2 hw.2.1.2⟩, height, upper 2 hu.2.2.2 hw.2.2.2⟩

/-- `(u, w)` is a spanning pair of the line `L`: `u, w ∈ S` project to distinct points of `L`. -/
def Spans (R : ℕ) (L : AffineSubspace ℝ ℝ²) (u w : Vec) : Prop :=
  u ∈ S R ∧ w ∈ S R ∧ proj u ≠ proj w ∧ line[ℝ, proj u, proj w] = L

/-- A spanning pair may be swapped. -/
theorem Spans.symm {R : ℕ} {L : AffineSubspace ℝ ℝ²} {u w : Vec} (h : Spans R L u w) :
    Spans R L w u :=
  ⟨h.2.1, h.1, h.2.2.1.symm, by rw [Set.pair_comm]; exact h.2.2.2⟩

/-- In a spanning pair, `w` may be replaced by `v ∈ S` if `m v = a u + b w` with `b ≠ 0`. -/
theorem Spans.replace {R : ℕ} {L : AffineSubspace ℝ ℝ²} {u w v : Vec} (h : Spans R L u w)
    (hv : v ∈ S R) {m a b : ℤ} (hm : 0 < m) (hb : b ≠ 0)
    (hcomb : ∀ i, m * v i = a * u i + b * w i) : Spans R L u v := by
  obtain ⟨hu, hw, hne, hL⟩ := h
  have pos : ∀ {x : Vec}, x ∈ S R → 0 < x 2 := fun hx => (mem_box.mp hx).2.2.1
  obtain ⟨hne', hline⟩ := combination (pos hu) (pos hw) (pos hv) hm hb hcomb hne
  exact ⟨hu, hv, hne', hline.trans hL⟩

/-- A spanning pair is short if its height sum is minimal. -/
def Short (R : ℕ) (L : AffineSubspace ℝ ℝ²) (u w : Vec) : Prop :=
  Spans R L u w ∧ ∀ u' w', Spans R L u' w' → u 2 + w 2 ≤ u' 2 + w' 2

/-- Every determined line has a short pair whose first vector is at least as high as the second. -/
theorem exists_short {R : ℕ} {L : AffineSubspace ℝ ℝ²} (hL : L ∈ determinedLines (P R)) :
    ∃ u w, Short R L u w ∧ w 2 ≤ u 2 := by
  classical
  let pairs := (S R ×ˢ S R).filter fun q => Spans R L q.1 q.2
  have mem_pairs : ∀ {u w}, Spans R L u w → (u, w) ∈ pairs := fun h =>
    mem_filter.mpr ⟨mem_product.mpr ⟨h.1, h.2.1⟩, h⟩
  have hne : pairs.Nonempty := by
    obtain ⟨a, ha, b, hb, hab, hL⟩ := mem_determinedLines.mp hL
    obtain ⟨u, hu, rfl⟩ := mem_image.mp ha
    obtain ⟨w, hw, rfl⟩ := mem_image.mp hb
    exact ⟨(u, w), mem_pairs ⟨hu, hw, hab, hL⟩⟩
  obtain ⟨⟨u, w⟩, hq, hmin⟩ := exists_min_image pairs (fun q => q.1 2 + q.2 2) hne
  have hspan : Spans R L u w := (mem_filter.mp hq).2
  have hmin : ∀ u' w', Spans R L u' w' → u 2 + w 2 ≤ u' 2 + w' 2 :=
    fun u' w' h => hmin (u', w') (mem_pairs h)
  rcases le_total (w 2) (u 2) with h | h
  · exact ⟨u, w, ⟨hspan, hmin⟩, h⟩
  · exact ⟨w, u, ⟨hspan.symm, fun u' w' h' => add_comm (w 2) (u 2) ▸ hmin u' w' h'⟩, h⟩

/-- The pair `(u, w)` is far if the two vectors differ by at least `R` in `x` or in `y`. -/
def Far (R : ℕ) (u w : Vec) : Prop := R ≤ |u 0 - w 0| ∨ R ≤ |u 1 - w 1|

/-- Lemma 3, first half: a short pair of unequal heights is far. -/
theorem Short.far {R : ℕ} {L : AffineSubspace ℝ ℝ²} {u w : Vec} (h : Short R L u w)
    (hlt : w 2 < u 2) : Far R u w := by
  obtain ⟨hspan, hmin⟩ := h
  by_contra hfar
  simp only [Far, not_or, not_le, abs_lt] at hfar
  have hu := mem_box.mp hspan.1
  have hw := mem_box.mp hspan.2.1
  have hv : u - w ∈ S R := by
    simp only [mem_box, Pi.sub_apply]
    omega
  have h' : Spans R L w (u - w) := hspan.symm.replace hv (m := 1) (a := -1) (b := 1) one_pos
    one_ne_zero (fun i => by simp only [Pi.sub_apply]; ring)
  have := hmin _ _ h'
  simp only [Pi.sub_apply] at this
  omega

/-- If `(u, w)` is short with `u` higher than `w`, there is no integer vector `(a u + b w) / m` with
`0 ≤ a, b < m` and `1 ≤ a + b ≤ m`: it could replace one of the two vectors. -/
theorem Short.no_combination {R : ℕ} {L : AffineSubspace ℝ ℝ²} {u w v : Vec} (h : Short R L u w)
    (hlt : w 2 < u 2) {m a b : ℤ} (ha : 0 ≤ a ∧ a < m) (hb : 0 ≤ b ∧ b < m)
    (hab : 1 ≤ a + b ∧ a + b ≤ m) : ¬ ∀ i, m * v i = a * u i + b * w i := by
  intro hcomb
  obtain ⟨hspan, hmin⟩ := h
  have hv := convex hspan.1 hspan.2.1 ha.1 hb.1 hab.1 hab.2 hcomb
  have hw := (mem_box.mp hspan.2.1).2.2.1
  have hheight := hcomb 2
  rcases ha.1.eq_or_lt with rfl | ha'
  · -- `a = 0`: `v` replaces `w`
    have := hmin _ _ (hspan.replace hv (by omega) (by omega : b ≠ 0) hcomb)
    nlinarith
  · -- `a > 0`: `v` replaces `u`
    have := hmin _ _ (hspan.symm.replace hv (by omega) (by omega : a ≠ 0)
      (fun i => (hcomb i).trans (add_comm _ _)))
    nlinarith

/-- The reduction of an integer vector modulo `p`. -/
def red (p : ℕ) (v : Vec) : Fin 3 → ZMod p := fun i => v i

/-- The pair `(u, w)` is good at `p` if it is linearly independent modulo `p`. -/
def Good (p : ℕ) (u w : Vec) : Prop := LinearIndependent (ZMod p) ![red p u, red p w]

/-- Lemma 3, second half: a short pair of unequal heights is good at every prime. -/
theorem Short.good {R : ℕ} {L : AffineSubspace ℝ ℝ²} {u w : Vec} (h : Short R L u w)
    (hlt : w 2 < u 2) {p : ℕ} (hp : p.Prime) : Good p u w := by
  have : NeZero p := ⟨hp.ne_zero⟩
  rw [Good, LinearIndependent.pair_iff]
  intro s t hst
  by_contra hne
  -- integers `0 ≤ a, b < p`, not both zero, such that `p` divides `a u + b w`
  obtain ⟨a, b, ha, hb, hab, hdvd⟩ : ∃ a b : ℕ, a < p ∧ b < p ∧ 1 ≤ a + b ∧
      ∀ i, (p : ℤ) ∣ a * u i + b * w i := by
    refine ⟨s.val, t.val, s.val_lt, t.val_lt, ?_, fun i => ?_⟩
    · by_contra h0
      exact hne ⟨(ZMod.val_eq_zero s).mp (by omega), (ZMod.val_eq_zero t).mp (by omega)⟩
    · rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      simpa [red] using congrFun hst i
  choose v hv using hdvd
  by_cases habp : a + b ≤ p
  · exact h.no_combination (m := p) (a := a) (b := b) hlt (by omega) (by omega) (by omega)
      fun i => (hv i).symm
  · refine h.no_combination (v := u + w - v) (m := p) (a := p - a) (b := p - b) hlt (by omega)
      (by omega) (by omega) fun i => ?_
    simp only [Pi.sub_apply, Pi.add_apply]
    linear_combination hv i

/-- **Lemma 3 (short pairs).** Every determined line is spanned by `proj u`, `proj w` for some
`u, w ∈ S` of equal height, or with `u` higher than `w`, far, and good at every prime. -/
theorem short_pair {R : ℕ} {L : AffineSubspace ℝ ℝ²} (hL : L ∈ determinedLines (P R)) :
    ∃ u w, Spans R L u w ∧
      (u 2 = w 2 ∨ (w 2 < u 2 ∧ Far R u w ∧ ∀ p : ℕ, p.Prime → Good p u w)) := by
  obtain ⟨u, w, h, hle⟩ := exists_short hL
  refine ⟨u, w, h.1, ?_⟩
  rcases hle.eq_or_lt with heq | hlt
  · exact Or.inl heq.symm
  · exact Or.inr ⟨hlt, h.far hlt, fun p hp => h.good hlt hp⟩

/-! ## Few lines -/

/-- The pairs `(i, j)` with `0 ≤ i ≤ j < M`. -/
noncomputable def triangle (M : ℕ) : Finset (ℤ × ℤ) :=
  (Ico 0 (M : ℤ) ×ˢ Ico 0 (M : ℤ)).filter fun q => q.1 ≤ q.2

/-- The square `[-M, M)²`. -/
noncomputable def square (M : ℕ) : Finset (ℤ × ℤ) := Ico (-M : ℤ) M ×ˢ Ico (-M : ℤ) M

/-- The near pairs: the pairs `(i, j)` of the square with `|i - j| < M`. -/
noncomputable def near (M : ℕ) : Finset (ℤ × ℤ) := (square M).filter fun q => |q.1 - q.2| < M

/-- The far blocks: the pairs of elements of the square, at least one of which is not near. (The
quotients of a far pair of vectors form a far block.) -/
noncomputable def farBlocks (M : ℕ) : Finset ((ℤ × ℤ) × (ℤ × ℤ)) :=
  (square M ×ˢ square M) \ (near M ×ˢ near M)

/-- **Lemma 4.1.** The triangle has `M(M + 1)/2` elements: it and its mirror image cover the square
`[0, M)²` and meet in the diagonal. -/
theorem card_triangle (M : ℕ) : 2 * #(triangle M) = M * (M + 1) := by
  let Q := Ico 0 (M : ℤ) ×ˢ Ico 0 (M : ℤ)
  let mirror := Q.filter fun q => q.2 ≤ q.1
  have hswap : #mirror = #(triangle M) := by
    apply card_bij' (fun q _ => q.swap) (fun q _ => q.swap) <;> simp [mirror, Q, triangle] <;> tauto
  have hunion : triangle M ∪ mirror = Q := by
    rw [triangle, ← filter_or]
    exact filter_true_of_mem fun q _ => le_total _ _
  have hinter : triangle M ∩ mirror = (Ico 0 (M : ℤ)).diag := by
    ext ⟨i, j⟩
    simp [mirror, Q, triangle]
    omega
  have h := card_union_add_card_inter (triangle M) mirror
  rw [hunion, hinter, hswap, card_product, diag_card, Int.card_Ico] at h
  simp at h
  linarith

/-- The square has `4M²` elements. -/
theorem card_square (M : ℕ) : #(square M) = 4 * M ^ 2 := by
  have h : ((M : ℤ) - -M).toNat = 2 * M := by omega
  simp only [square, card_product, Int.card_Ico, h]
  ring

/-- **Lemma 4.2.** At least `3M² - M` pairs are near: the other pairs of the square form two copies
of the triangle. -/
theorem card_near (M : ℕ) : 3 * M ^ 2 ≤ #(near M) + M := by
  have hsub : square M ⊆ near M ∪ ((triangle M).image (fun q => (q.1 - M, q.2)) ∪
      (triangle M).image (fun q => (q.2, q.1 - M))) := by
    rintro ⟨i, j⟩ h
    simp only [square, mem_product, mem_Ico] at h
    simp only [near, square, mem_union, mem_filter, mem_product, mem_Ico, mem_image, triangle,
      abs_lt, Prod.exists, Prod.mk.injEq]
    by_cases h1 : i + M ≤ j
    · exact Or.inr (Or.inl ⟨i + M, j, by omega, by omega, rfl⟩)
    by_cases h2 : j + M ≤ i
    · exact Or.inr (Or.inr ⟨j + M, i, by omega, rfl, by omega⟩)
    · exact Or.inl (by omega)
  have h := (card_le_card hsub).trans ((card_union_le _ _).trans
    (Nat.add_le_add_left ((card_union_le _ _).trans (add_le_add card_image_le card_image_le)) _))
  rw [card_square] at h
  linarith [card_triangle M]

/-- **Lemma 4.3 (far blocks).** There are at most `16M⁴ - (3M² - M)² ≤ 7M³(M + 1)` far blocks. -/
theorem card_farBlocks (M : ℕ) : #(farBlocks M) ≤ 7 * M ^ 3 * (M + 1) := by
  have hsub : near M ×ˢ near M ⊆ square M ×ˢ square M :=
    product_subset_product (filter_subset _ _) (filter_subset _ _)
  have h := card_sdiff_add_card_eq_card hsub
  simp only [card_product, card_square] at h
  have hnear := card_near M
  rw [farBlocks]
  zify at h hnear ⊢
  have hM : (0 : ℤ) ≤ 3 * M ^ 2 - M := by nlinarith
  have hsq : (3 * (M : ℤ) ^ 2 - M) ^ 2 ≤ (#(near M) : ℤ) ^ 2 := by gcongr; linarith
  have hpos : (0 : ℤ) ≤ (M : ℤ) ^ 3 + (M : ℤ) ^ 2 := by positivity
  linarith

/-- The six primes used in the count of lines. Their product is `30030`. -/
abbrev primes : Finset ℕ := {2, 3, 5, 7, 11, 13}

/-- The elements of `primes` are prime. -/
theorem prime_of_mem {p : ℕ} (hp : p ∈ primes) : p.Prime := by
  fin_cases hp <;> norm_num

/-- The elements of `primes` are prime, as an instance. -/
instance (p : primes) : Fact (p : ℕ).Prime := ⟨prime_of_mem p.2⟩

/-- An integer is determined by its quotient by `30030` and its residues modulo the six primes
(Chinese remainder theorem). -/
theorem eq_of_residues {a b : ℤ} (hq : a / 30030 = b / 30030)
    (hr : ∀ p ∈ primes, (a : ZMod p) = b) : a = b := by
  have hdvd : ∏ p ∈ primes, (p : ℤ) ∣ b - a := by
    refine prod_dvd_of_coprime (fun p hp q hq hpq => ?_) fun p hp => ?_
    · exact Nat.isCoprime_iff_coprime.mpr
        ((Nat.coprime_primes (prime_of_mem hp) (prime_of_mem hq)).mpr hpq)
    · exact (ZMod.intCast_eq_intCast_iff_dvd_sub a b p).mp (hr p hp)
  have hprod : ∏ p ∈ primes, (p : ℤ) = 30030 := by simp [primes]
  rw [hprod] at hdvd
  omega

open scoped Classical in
/-- The linearly independent pairs of vectors modulo `p`. -/
noncomputable def indepPairs (p : ℕ) [NeZero p] : Finset (Fin 2 → Fin 3 → ZMod p) :=
  univ.filter fun s => LinearIndependent (ZMod p) s

/-- There are `(p³ - 1)(p³ - p)` linearly independent pairs of vectors modulo a prime `p`. -/
theorem card_indepPairs (p : ℕ) [Fact p.Prime] :
    #(indepPairs p) = (p ^ 3 - 1) * (p ^ 3 - p) := by
  classical
  have h := card_linearIndependent (K := ZMod p) (V := Fin 3 → ZMod p) (k := 2) (by simp)
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype] at h
  simpa [indepPairs, Fin.prod_univ_two] using h

open scoped Classical in
/-- The far pairs `(u, w)` of vectors of `S` with `u` higher than `w` that are good at the six
primes. -/
noncomputable def farPairs (R : ℕ) : Finset (Vec × Vec) :=
  (S R ×ˢ S R).filter fun q => q.2 2 < q.1 2 ∧ Far R q.1 q.2 ∧ ∀ p ∈ primes, Good p q.1 q.2

/-- The quotients by `30030` and the residues modulo the six primes of the coordinates of a pair of
vectors. -/
def code (q : Vec × Vec) :
    (((ℤ × ℤ) × (ℤ × ℤ)) × (ℤ × ℤ)) × (∀ p : primes, Fin 2 → Fin 3 → ZMod p) :=
  ((((q.1 0 / 30030, q.2 0 / 30030), (q.1 1 / 30030, q.2 1 / 30030)),
    (q.2 2 / 30030, q.1 2 / 30030)), fun p => ![red p q.1, red p q.2])

/-- A pair of vectors is determined by its quotients and residues. -/
theorem code_injective : Function.Injective code := by
  rintro ⟨u, w⟩ ⟨u', w'⟩ heq
  simp only [code, Prod.mk.injEq] at heq
  obtain ⟨⟨⟨⟨hu0, hw0⟩, hu1, hw1⟩, hw2, hu2⟩, hres⟩ := heq
  have hres : ∀ p ∈ primes, red p u = red p u' ∧ red p w = red p w' := fun p hp =>
    ⟨congrFun (congrFun hres ⟨p, hp⟩) 0, congrFun (congrFun hres ⟨p, hp⟩) 1⟩
  refine Prod.ext (funext fun i => ?_) (funext fun i => ?_)
  · refine eq_of_residues ?_ fun p hp => congrFun (hres p hp).1 i
    fin_cases i
    exacts [hu0, hu1, hu2]
  · refine eq_of_residues ?_ fun p hp => congrFun (hres p hp).2 i
    fin_cases i
    exacts [hw0, hw1, hw2]

/-- **Lemma 5 (far pairs).** For `R = 30030 M`, the quotients of a far pair form an element of
`farBlocks M` and one of `triangle M`, and its residues are linearly independent modulo the six
primes. So there are at most `7M³(M + 1) · M(M + 1)/2 · ∏ (p³ - 1)(p³ - p)` far pairs. -/
theorem card_farPairs (M : ℕ) : 2 * #(farPairs (30030 * M)) ≤
    7 * M ^ 3 * (M + 1) * (M * (M + 1)) * ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p) := by
  have h : #(farPairs (30030 * M)) ≤ #((farBlocks M ×ˢ triangle M) ×ˢ
      Fintype.piFinset fun p : primes => indepPairs p) := by
    refine card_le_card_of_injOn code ?_ code_injective.injOn
    rintro ⟨u, w⟩ hq
    simp only [farPairs, coe_filter, mem_product, Set.mem_ofPred_eq, mem_box] at hq
    obtain ⟨⟨hu, hw⟩, hlt, hfar, hgood⟩ := hq
    simp only [Far, le_abs] at hfar
    push_cast at hu hw hfar
    simp only [code, mem_coe, mem_product, Fintype.mem_piFinset, indepPairs, mem_filter, mem_univ,
      true_and]
    refine ⟨⟨?_, ?_⟩, fun p => hgood p p.2⟩
    · simp only [farBlocks, near, square, mem_sdiff, mem_product, mem_filter, mem_Ico, abs_lt]
      omega
    · simp only [triangle, mem_filter, mem_product, mem_Ico]
      omega
  simp only [card_product, Fintype.card_piFinset, card_indepPairs] at h
  rw [prod_coe_sort primes fun p => (p ^ 3 - 1) * (p ^ 3 - p)] at h
  calc 2 * #(farPairs (30030 * M))
      ≤ 2 * (#(farBlocks M) * #(triangle M) * ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p)) := by gcongr
    _ = #(farBlocks M) * (2 * #(triangle M)) * ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p) := by ring
    _ ≤ _ := by
        rw [card_triangle]
        gcongr
        exact card_farBlocks M

open scoped Classical in
/-- The pairs `(u, w)` of vectors of `S` of equal height. -/
noncomputable def levelPairs (R : ℕ) : Finset (Vec × Vec) :=
  (S R ×ˢ S R).filter fun q => q.1 2 = q.2 2

/-- There are at most `16R⁵` pairs of equal height. -/
theorem card_levelPairs (R : ℕ) : #(levelPairs R) ≤ 16 * R ^ 5 := by
  have h : #(levelPairs R) ≤ #(S R ×ˢ square R) := by
    apply card_le_card_of_injOn fun q => (q.1, (q.2 0, q.2 1))
    · rintro ⟨u, w⟩ hq
      simp only [levelPairs, coe_filter, mem_product, Set.mem_ofPred_eq, mem_box] at hq
      simp only [coe_product, Set.mem_prod, mem_coe, mem_box, square, mem_Ico]
      omega
    · rintro ⟨u, w⟩ hq ⟨u', w'⟩ hq' heq
      simp only [levelPairs, coe_filter, Set.mem_ofPred_eq] at hq hq'
      simp only [Prod.mk.injEq] at heq ⊢
      obtain ⟨rfl, h0, h1⟩ := heq
      refine ⟨rfl, ?_⟩
      ext i
      fin_cases i
      exacts [h0, h1, hq.2.symm.trans hq'.2]
  calc #(levelPairs R) ≤ 4 * R ^ 2 * (R - 1) * (4 * R ^ 2) := by
        rwa [card_product, card_S, card_square] at h
    _ ≤ 4 * R ^ 2 * R * (4 * R ^ 2) := by gcongr; omega
    _ = 16 * R ^ 5 := by ring

/-- The proportion of independent residue pairs is at most `0.5145`. -/
theorem prod_primes_le :
    10000 * ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p) ≤ 5145 * 30030 ^ 6 := by
  norm_num [primes]

/-- **Lemma 6 (few lines).** For `R = 30030 M` the set `P` determines at most
`1.8008 R⁴ (R + 30030)² + 16 R⁵` lines. -/
theorem few_lines {M R : ℕ} (hR : R = 30030 * M) : (#(determinedLines (P R)) : ℝ) ≤
    1.8008 * (R : ℝ) ^ 4 * (R + 30030) ^ 2 + 16 * (R : ℝ) ^ 5 := by
  classical
  have hlines : #(determinedLines (P R)) ≤ #(farPairs R) + #(levelPairs R) := by
    refine (card_le_card fun L hL => ?_).trans ((card_image_le (s := farPairs R ∪ levelPairs R)
      (f := fun q => line[ℝ, proj q.1, proj q.2])).trans (card_union_le _ _))
    obtain ⟨u, w, ⟨hu, hw, -, huw⟩, h⟩ := short_pair hL
    refine mem_image.mpr ⟨(u, w), mem_union.mpr ?_, huw⟩
    have hS : (u, w) ∈ S R ×ˢ S R := mem_product.mpr ⟨hu, hw⟩
    rcases h with heq | ⟨hlt, hfar, hgood⟩
    · exact Or.inr (mem_filter.mpr ⟨hS, heq⟩)
    · exact Or.inl (mem_filter.mpr ⟨hS, hlt, hfar, fun p hp => hgood p (prime_of_mem hp)⟩)
  have hfar : 20000 * #(farPairs R) ≤
      7 * M ^ 3 * (M + 1) * (M * (M + 1)) * (5145 * 30030 ^ 6) := by
    calc 20000 * #(farPairs R) = 10000 * (2 * #(farPairs R)) := by ring
      _ ≤ 10000 * (7 * M ^ 3 * (M + 1) * (M * (M + 1)) *
            ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p)) := by
          rw [hR]
          exact Nat.mul_le_mul_left _ (card_farPairs M)
      _ = 7 * M ^ 3 * (M + 1) * (M * (M + 1)) *
            (10000 * ∏ p ∈ primes, (p ^ 3 - 1) * (p ^ 3 - p)) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ prod_primes_le
  have hlines' : (#(determinedLines (P R)) : ℝ) ≤ #(farPairs R) + 16 * (R : ℝ) ^ 5 := by
    exact_mod_cast hlines.trans (Nat.add_le_add_left (card_levelPairs R) _)
  have hfar' : 20000 * (#(farPairs R) : ℝ) ≤
      7 * (M : ℝ) ^ 3 * (M + 1) * (M * (M + 1)) * (5145 * 30030 ^ 6) := by exact_mod_cast hfar
  have hpos : 0 ≤ (M : ℝ) ^ 4 * (M + 1) ^ 2 := by positivity
  have hRM : (R : ℝ) = 30030 * M := by exact_mod_cast hR
  rw [hRM] at hlines' ⊢
  nlinarith

/-! ## Many points -/

/-- The elements of `S` whose coordinates are all divisible by `j`. -/
noncomputable def multiples (R j : ℕ) : Finset Vec := (S R).filter fun v => ∀ i, (j : ℤ) ∣ v i

/-- **Lemma 7 (multiples).** At most `4(R/j)³ + 5(R/j)²` elements of `S` are divisible by `j`. -/
theorem card_multiples (R j : ℕ) (hj : 0 < j) :
    (#(multiples R j) : ℝ) ≤ 4 * (R / j : ℝ) ^ 3 + 5 * (R / j : ℝ) ^ 2 := by
  let r := R / j
  have hj' : (0 : ℤ) < j := by exact_mod_cast hj
  have hsub : multiples R j ⊆ (box (-r) r r).image fun w i => j * w i := by
    intro v hv
    obtain ⟨hv, hdvd⟩ := mem_filter.mp hv
    choose w hw using hdvd
    simp only [mem_box, hw] at hv
    have bound : ∀ x : ℤ, j * x ≤ R → x ≤ r := fun x hx => by
      rw [Int.natCast_div, Int.le_ediv_iff_mul_le hj']
      linarith
    refine mem_image.mpr ⟨w, mem_box.mpr ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ?_, ?_⟩, funext fun i => (hw i).symm⟩
    · linarith [bound (-w 0) (by linarith)]
    · exact bound _ (by linarith)
    · linarith [bound (-w 1) (by linarith)]
    · exact bound _ (by linarith)
    · exact (mul_pos_iff_of_pos_left hj').mp (by linarith)
    · exact bound _ (by linarith)
  have hcard : #(multiples R j) ≤ (2 * r + 1) ^ 2 * r := by
    have h1 : ((r : ℤ) + 1 - -r).toNat = 2 * r + 1 := by omega
    simpa only [card_box, h1, Int.toNat_natCast] using (card_le_card hsub).trans card_image_le
  have hr : (r : ℝ) ≤ R / j := Nat.cast_div_le
  calc (#(multiples R j) : ℝ) ≤ ((2 * r + 1) ^ 2 * r : ℕ) := by exact_mod_cast hcard
    _ ≤ (4 * r ^ 3 + 5 * r ^ 2 : ℕ) := by
        norm_cast
        nlinarith [Nat.le_self_pow two_ne_zero r]
    _ ≤ 4 * (R / j : ℝ) ^ 3 + 5 * (R / j : ℝ) ^ 2 := by
        push_cast
        gcongr

open scoped Classical in
/-- The primitive elements of `S`: no prime divides all three coordinates. -/
noncomputable def primitive (R : ℕ) : Finset Vec :=
  (S R).filter fun v => ∀ p : ℕ, p.Prime → ¬ ∀ i, (p : ℤ) ∣ v i

/-- If no prime divides all coordinates of `v`, and `t v / z(v)` is an integer vector, then `z(v)`
divides `t`. -/
theorem height_dvd {v : Vec} (hv : ∀ p : ℕ, p.Prime → ¬ ∀ i, (p : ℤ) ∣ v i) {t : ℤ}
    (h : ∀ i, v 2 ∣ t * v i) : v 2 ∣ t := by
  have hunit : IsUnit (univ.gcd v) := by
    rw [Int.isUnit_iff_natAbs_eq]
    by_contra h1
    obtain ⟨p, hp, hdvd⟩ := Nat.exists_prime_and_dvd h1
    exact hv p hp fun i => (Int.natCast_dvd.mpr hdvd).trans (gcd_dvd (mem_univ i))
  have hdvd : v 2 ∣ univ.gcd fun i => t * v i := dvd_gcd fun i _ => h i
  exact hunit.dvd_mul_right.mp ((Finset.gcd_mul_left' _ _ _).dvd_iff_dvd_right.mp hdvd)

/-- **Lemma 8 (primitive vectors).** Distinct primitive vectors project to distinct points: the
height of a primitive vector `v` is the least positive integer `t` such that `t proj v` is
integral. -/
theorem proj_injOn (R : ℕ) : Set.InjOn proj (primitive R) := by
  classical
  intro u hu v hv huv
  obtain ⟨hu, hu'⟩ := mem_filter.mp hu
  obtain ⟨hv, hv'⟩ := mem_filter.mp hv
  have hu2 : 0 < u 2 := (mem_box.mp hu).2.2.1
  have hv2 : 0 < v 2 := (mem_box.mp hv).2.2.1
  have hprop : ∀ i, u i * v 2 = v i * u 2 := by
    have h0 : (u 0 : ℝ) / u 2 = v 0 / v 2 := congrFun (congrArg WithLp.ofLp huv) 0
    have h1 : (u 1 : ℝ) / u 2 = v 1 / v 2 := congrFun (congrArg WithLp.ofLp huv) 1
    rw [div_eq_div_iff (by exact_mod_cast hu2.ne') (by exact_mod_cast hv2.ne')] at h0 h1
    intro i
    fin_cases i
    exacts [by exact_mod_cast h0, by exact_mod_cast h1, mul_comm _ _]
  have h2 : u 2 = v 2 := Int.dvd_antisymm hu2.le hv2.le
    (height_dvd hu' fun i => ⟨v i, by linear_combination hprop i⟩)
    (height_dvd hv' fun i => ⟨u i, by linear_combination -hprop i⟩)
  ext i
  have := hprop i
  rw [h2] at this
  exact mul_right_cancel₀ hv2.ne' this

/-- A vector of `S` that is not primitive is a multiple of `2`, `3`, `5`, `7` or of an odd number
`2i + 1 ≥ 11`. -/
theorem S_subset (R : ℕ) : S R ⊆ primitive R ∪ (({2, 3, 5, 7} : Finset ℕ).biUnion (multiples R) ∪
    (Ico 5 R).biUnion fun i => multiples R (2 * i + 1)) := by
  classical
  intro v hv
  by_cases hprim : ∀ p : ℕ, p.Prime → ¬ ∀ i, (p : ℤ) ∣ v i
  · exact mem_union_left _ (mem_filter.mpr ⟨hv, hprim⟩)
  push Not at hprim
  obtain ⟨p, hp, hdvd⟩ := hprim
  have hmem : v ∈ multiples R p := mem_filter.mpr ⟨hv, hdvd⟩
  have hpR : p < R := by
    have hv2 := (mem_box.mp hv).2.2
    have := Int.le_of_dvd (by omega) (hdvd 2)
    omega
  refine mem_union_right _ ?_
  rcases lt_or_ge p 11 with h | h
  · refine mem_union_left _ (mem_biUnion.mpr ⟨p, ?_, hmem⟩)
    interval_cases p <;> first | decide | exact absurd hp (by decide)
  · obtain ⟨i, rfl⟩ := hp.odd_of_ne_two (by omega)
    exact mem_union_right _ (mem_biUnion.mpr ⟨i, mem_Ico.mpr (by omega), hmem⟩)

/-- One term of the union bound over the odd numbers is at most a difference, because
`(2x + 1)² ≥ 4x(x + 1)`. -/
theorem tail_term {x X : ℝ} (hx : 0 < x) (hX : 0 ≤ X) :
    4 * (X / (2 * x + 1)) ^ 3 + 5 * (X / (2 * x + 1)) ^ 2 ≤
      (X ^ 3 / (4 * x ^ 2) + 5 * X ^ 2 / (4 * x)) -
        (X ^ 3 / (4 * (x + 1) ^ 2) + 5 * X ^ 2 / (4 * (x + 1))) := by
  have h : 4 * (x * (x + 1)) ≤ (2 * x + 1) ^ 2 := by nlinarith
  calc 4 * (X / (2 * x + 1)) ^ 3 + 5 * (X / (2 * x + 1)) ^ 2
      = 4 * X ^ 3 * (2 * x + 1) / ((2 * x + 1) ^ 2) ^ 2 + 5 * X ^ 2 / (2 * x + 1) ^ 2 := by
        field_simp
    _ ≤ 4 * X ^ 3 * (2 * x + 1) / (4 * (x * (x + 1))) ^ 2 + 5 * X ^ 2 / (4 * (x * (x + 1))) := by
        gcongr
    _ = _ := by
        field_simp
        ring

/-- The union bound over the odd numbers `2i + 1 ≥ 11`: the differences telescope. -/
theorem tail_sum (n : ℕ) {X : ℝ} (hX : 0 ≤ X) :
    ∑ i ∈ Ico 5 n, (4 * (X / (2 * i + 1)) ^ 3 + 5 * (X / (2 * i + 1)) ^ 2) ≤
      X ^ 3 / 100 + X ^ 2 / 4 := by
  rcases le_total n 5 with hn | hn
  · rw [Ico_eq_empty_of_le hn, sum_empty]
    positivity
  have htel : ∑ i ∈ Ico 5 n, (4 * (X / (2 * i + 1)) ^ 3 + 5 * (X / (2 * i + 1)) ^ 2) ≤
      X ^ 3 / 100 + X ^ 2 / 4 - (X ^ 3 / (4 * n ^ 2) + 5 * X ^ 2 / (4 * n)) := by
    induction n, hn using Nat.le_induction with
    | base => norm_num; linarith
    | succ n hn ih =>
      rw [sum_Ico_succ_top hn]
      push_cast
      linarith [tail_term (by exact_mod_cast (by omega : 0 < n) : (0 : ℝ) < n) hX]
  have hpos : 0 ≤ X ^ 3 / (4 * n ^ 2) + 5 * X ^ 2 / (4 * n) := by positivity
  linarith

/-- **Lemma 9 (many points).** The set `P` has at least `3.298R³ - 7R²` points. -/
theorem many_points {R : ℕ} (hR : 1 ≤ R) : 3.298 * (R : ℝ) ^ 3 - 7 * (R : ℝ) ^ 2 ≤ #(P R) := by
  classical
  have hS : (#(S R) : ℝ) = 4 * (R : ℝ) ^ 3 - 4 * (R : ℝ) ^ 2 := by
    rw [card_S]
    push_cast [Nat.cast_sub hR]
    ring
  have hcover : (#(S R) : ℝ) ≤ #(primitive R) + (∑ j ∈ {2, 3, 5, 7}, (#(multiples R j) : ℝ) +
      ∑ i ∈ Ico 5 R, (#(multiples R (2 * i + 1)) : ℝ)) := by
    exact_mod_cast (card_le_card (S_subset R)).trans ((card_union_le _ _).trans (Nat.add_le_add_left
      ((card_union_le _ _).trans (Nat.add_le_add card_biUnion_le card_biUnion_le)) _))
  have hsmall : ∑ j ∈ {2, 3, 5, 7}, (#(multiples R j) : ℝ) ≤
      4 * (1 / 8 + 1 / 27 + 1 / 125 + 1 / 343) * (R : ℝ) ^ 3 +
        5 * (1 / 4 + 1 / 9 + 1 / 25 + 1 / 49) * (R : ℝ) ^ 2 := by
    refine (sum_le_sum fun j hj => card_multiples R j (by simp at hj; omega)).trans (le_of_eq ?_)
    norm_num [div_pow]
    ring
  have hlarge : ∑ i ∈ Ico 5 R, (#(multiples R (2 * i + 1)) : ℝ) ≤
      ∑ i ∈ Ico 5 R, (4 * (R / (2 * i + 1) : ℝ) ^ 3 + 5 * (R / (2 * i + 1) : ℝ) ^ 2) :=
    sum_le_sum fun i _ => by exact_mod_cast card_multiples R (2 * i + 1) (by omega)
  have htail := tail_sum R (Nat.cast_nonneg (α := ℝ) R)
  have hprim : (#(primitive R) : ℝ) ≤ #(P R) := by
    exact_mod_cast card_le_card_of_injOn proj (fun v hv => mem_image_of_mem proj
      (mem_filter.mp hv).1) (proj_injOn R)
  have h2 : 0 ≤ (R : ℝ) ^ 2 := by positivity
  have h3 : 0 ≤ (R : ℝ) ^ 3 := by positivity
  linarith

/-! ## Few points on each line -/

open scoped Classical in
/-- **Lemma 10 (points on a line).** Every line contains at most `2R²` points of `P`. -/
theorem points_on_line (R : ℕ) {L : AffineSubspace ℝ ℝ²} (hL : IsLine L) :
    #((P R).filter fun p => p ∈ L) ≤ 2 * R ^ 2 := by
  -- the possible values of one coordinate
  let X : Finset ℝ := (Ico (-R : ℤ) R ×ˢ Ico (1 : ℤ) R).image fun q => (q.1 : ℝ) / q.2
  have hX : #X ≤ 2 * R ^ 2 := by
    refine card_image_le.trans ?_
    simp only [card_product, Int.card_Ico]
    calc _ ≤ (2 * R) * R := by gcongr <;> omega
      _ = 2 * R ^ 2 := by ring
  have hmem : ∀ p ∈ P R, p 0 ∈ X ∧ p 1 ∈ X := by
    intro p hp
    obtain ⟨v, hv, rfl⟩ := mem_image.mp hp
    rw [mem_box] at hv
    exact ⟨mem_image.mpr ⟨(v 0, v 2), by simp; omega, by simp [proj]⟩,
      mem_image.mpr ⟨(v 1, v 2), by simp; omega, by simp [proj]⟩⟩
  by_cases hinj : ∀ a ∈ L, ∀ b ∈ L, a 0 = b 0 → a = b
  · -- the first coordinate is injective on `L`
    refine (card_le_card_of_injOn (fun p => p 0) (fun p hp => ?_) fun a ha b hb h => ?_).trans hX
    · exact (hmem p (mem_filter.mp hp).1).1
    · exact hinj a (mem_filter.mp ha).2 b (mem_filter.mp hb).2 h
  · -- `L` is vertical, and the second coordinate is injective on `L`
    push Not at hinj
    obtain ⟨a, ha, b, hb, h0, hab⟩ := hinj
    have hvert : ∀ c ∈ L, c 0 = a 0 := by
      intro c hc
      rw [← line_pair_eq hL ha hb hab] at hc
      obtain ⟨t, rfl⟩ := mem_affineSpan_pair_iff_exists_lineMap_eq.mp hc
      simp [AffineMap.lineMap_apply, h0]
    refine (card_le_card_of_injOn (fun p => p 1) (fun p hp => ?_) fun p hp q hq h => ?_).trans hX
    · exact (hmem p (mem_filter.mp hp).1).2
    · exact plane_ext ((hvert p (mem_filter.mp hp).2).trans (hvert q (mem_filter.mp hq).2).symm) h

/-! ## Conclusion -/

open scoped Classical in
/-- **Theorem.** Let `R = 30030 M` with `M ≥ 1000`. Then `P` has `n ≥ 3R³` points, every line
contains at most `2R²` of them, and `P` determines at most `0.166 k n` lines, where
`k = n - 2R²`. -/
theorem counterexample {M R : ℕ} (hR : R = 30030 * M) (hM : 1000 ≤ M) :
    3 * R ^ 3 ≤ #(P R) ∧ (∀ L, IsLine L → #((P R).filter fun p => p ∈ L) ≤ 2 * R ^ 2) ∧
      (#(determinedLines (P R)) : ℝ) ≤ 0.166 * (#(P R) - 2 * (R : ℝ) ^ 2) * #(P R) := by
  have hR1 : (30030000 : ℝ) ≤ R := by exact_mod_cast (by omega : 30030000 ≤ R)
  have hpoints := many_points (by omega : 1 ≤ R)
  have hlines := few_lines hR
  have hcube : 30030000 * (R : ℝ) ^ 2 ≤ (R : ℝ) ^ 3 := by
    rw [pow_succ _ 2, mul_comm]
    gcongr
  have hk : 3.2979 * (R : ℝ) ^ 3 ≤ #(P R) - 2 * (R : ℝ) ^ 2 := by nlinarith
  have hn : 3.2979 * (R : ℝ) ^ 3 ≤ #(P R) := by nlinarith
  refine ⟨?_, fun L hL => points_on_line R hL, ?_⟩
  · have : 3 * (R : ℝ) ^ 3 ≤ #(P R) := by linarith [pow_nonneg (R.cast_nonneg (α := ℝ)) 3]
    exact_mod_cast this
  · calc (#(determinedLines (P R)) : ℝ)
        ≤ 1.8008 * (R : ℝ) ^ 4 * (R + 30030) ^ 2 + 16 * (R : ℝ) ^ 5 := hlines
      _ ≤ 1.8008 * (R : ℝ) ^ 4 * (R + R / 1000) ^ 2 + (R / 1000000) * (R : ℝ) ^ 5 := by
        gcongr <;> linarith
      _ ≤ 0.166 * (3.2979 * (R : ℝ) ^ 3) * (3.2979 * (R : ℝ) ^ 3) := by
        have : 0 ≤ (R : ℝ) ^ 6 := by positivity
        linarith
      _ ≤ 0.166 * (#(P R) - 2 * (R : ℝ) ^ 2) * #(P R) := by
        gcongr
        linarith

end E211

/-- **Corollary.** The negation of the Formal Conjectures statement
`Erdos211.erdos_211.variants.one_sixth`. -/
public theorem main : ¬ (type_of% @Erdos211.erdos_211.variants.one_sixth) := by
  intro h
  obtain ⟨N, hN⟩ := h (1 / 1000) (by norm_num)
  obtain ⟨R, hR⟩ : ∃ R, R = 30030 * max 1000 N := ⟨_, rfl⟩
  obtain ⟨hn, hline, hlines⟩ := E211.counterexample hR (le_max_left _ _)
  set n := #(E211.P R)
  have hR0 : 0 < R := by omega
  have h1 : R ≤ R ^ 3 := Nat.le_self_pow (by norm_num) R
  have h2 : R ^ 2 ≤ R ^ 3 := Nat.pow_le_pow_right hR0 (by norm_num)
  have h3 : 0 < R ^ 2 := by positivity
  have hk : 2 * R ^ 2 < n := by omega
  have key := hN n (n - 2 * R ^ 2) (by omega) (by omega) (by omega) (E211.P R) rfl fun L hL => by
    rw [Nat.sub_sub_self hk.le]
    exact hline L hL
  rw [Nat.cast_sub hk.le] at key
  push_cast at key
  have hk' : (0 : ℝ) < n - 2 * (R : ℝ) ^ 2 := sub_pos.mpr (by exact_mod_cast hk)
  have hn' : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  linarith [mul_pos hk' hn']

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
