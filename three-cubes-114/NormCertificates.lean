/-- Positive control recovered from a distinct seed root. -/
theorem other_root_recovers_42 :
    let d : Int := 102980666258459
    let seed : Int := 28902416942381
    let x : Int := 80435758145817515
    let y : Int := -80538738812075974
    let z : Int := 12602123297335631
    x+y = -d ∧ seed^3%d = 42 ∧ z^3%d = 42 ∧ seed ≠ z%d ∧ x^3 + y^3 + z^3 = 42 := by
  decide +kernel

