open Finset
open scoped ComplexConjugate InnerProductSpace EuclideanGeometry

namespace Sol1066

/-! ### Lemma 1: vectors with inner products `±A` -/

/-- **Lemma 1 (a).** Vectors with `‖w‖² = 2A² + A` and pairwise inner products `-A` number at most
`2A + 2`, because `0 ≤ ‖∑ w‖²`. -/
theorem card_le {ι E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {A : ℕ} (hA : 0 < A)
    (w : ι → E) (I : Finset ι) (hself : ∀ i, ⟪w i, w i⟫_ℝ = 2 * A ^ 2 + A)
    (hne : ∀ i ∈ I, ∀ j ∈ I, i ≠ j → ⟪w i, w j⟫_ℝ = -A) : #I ≤ 2 * A + 2 := by
  classical
  have hA' : (0 : ℝ) < A := by exact_mod_cast hA
  have hrow (i : ι) (hi : i ∈ I) : ∑ j ∈ I, ⟪w i, w j⟫_ℝ = A * (2 * A + 2 - #I) := by
    have h : ∀ j ∈ I, ⟪w i, w j⟫_ℝ = -A + if i = j then (2 * A ^ 2 + 2 * A : ℝ) else 0 := by
      intro j hj
      split_ifs with hij
      · rw [← hij, hself]
        ring
      · rw [hne i hi j hj hij, add_zero]
    rw [sum_congr rfl h, sum_add_distrib, sum_ite_eq, if_pos hi, sum_const, nsmul_eq_mul]
    ring
  have hsum : 0 ≤ ∑ i ∈ I, ∑ j ∈ I, ⟪w i, w j⟫_ℝ := by
    simp only [← inner_sum, ← sum_inner]
    exact real_inner_self_nonneg
  rw [sum_congr rfl hrow, sum_const, nsmul_eq_mul] at hsum
  by_contra! hlt
  have hI : (2 * A + 2 : ℝ) < #I := by exact_mod_cast hlt
  nlinarith [mul_pos hA' (sub_pos.2 hI)]

/-- **Lemma 1 (b).** Let `n` vectors in `d`-dimensional space have `‖w‖² = 2A² + A` and all inner
products `±A`. Then `g_d(n) ≤ 2A + 2`, as the points `w / (2A)` show. -/
theorem gDim_le {ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {A : ℕ} (hA : 0 < A) (w : ι → E)
    (hself : ∀ i, ⟪w i, w i⟫_ℝ = 2 * A ^ 2 + A)
    (hne : ∀ i j, i ≠ j → ⟪w i, w j⟫_ℝ = A ∨ ⟪w i, w j⟫_ℝ = -A) :
    Erdos1066.gDim (Module.finrank ℝ E) (Fintype.card ι) ≤ 2 * A + 2 := by
  have hA' : (0 : ℝ) < A := by exact_mod_cast hA
  let p (i : ι) : ℝ^(Module.finrank ℝ E) :=
    (1 / (2 * A) : ℝ) • (stdOrthonormalBasis ℝ E).repr (w i)
  -- squared distances are `1` (inner product `A`) or `1 + 1/A` (inner product `-A`)
  have hdist (i j : ι) : dist (p i) (p j) ^ 2 = 1 + (A - ⟪w i, w j⟫_ℝ) / (2 * A ^ 2) := by
    rw [dist_eq_norm, ← smul_sub, ← map_sub, norm_smul, LinearIsometryEquiv.norm_map, mul_pow,
      Real.norm_of_nonneg (by positivity), norm_sub_sq_real, ← real_inner_self_eq_norm_sq,
      ← real_inner_self_eq_norm_sq, hself, hself]
    field_simp
    ring
  have hsep (i j : ι) (hij : i ≠ j) : 1 ≤ dist (p i) (p j) := by
    have h0 : 0 ≤ (A - ⟪w i, w j⟫_ℝ) / (2 * A ^ 2) := by
      refine div_nonneg ?_ (by positivity)
      rcases hne i j hij with h | h <;> rw [h] <;> linarith
    nlinarith [hdist i j, dist_nonneg (x := p i) (y := p j)]
  have hinj : Function.Injective p := fun i j hij => by
    by_contra h
    linarith [hsep i j h, dist_eq_zero.2 hij]
  refine csSup_le ⟨0, fun _ _ _ => ⟨∅, empty_subset _, Nat.zero_le _, by simp⟩⟩ fun k hk => ?_
  obtain ⟨Y, hYX, hkY, hY⟩ := hk (univ.image p) (card_image_of_injective _ hinj) (by
    intro x hx y hy hxy
    obtain ⟨i, -, rfl⟩ := mem_image.1 (mem_coe.1 hx)
    obtain ⟨j, -, rfl⟩ := mem_image.1 (mem_coe.1 hy)
    exact hsep i j fun h => hxy (by rw [h]))
  obtain ⟨I, -, rfl⟩ := subset_image_iff.1 hYX
  rw [card_image_of_injective _ hinj] at hkY
  -- points at distance greater than `1` have inner product `-A`
  refine hkY.trans (card_le hA w I hself fun i hi j hj hij => ?_)
  refine (hne i j hij).resolve_left fun h => ?_
  have h1 := hdist i j
  have h2 := hY (mem_coe.2 (mem_image_of_mem p hi)) (mem_coe.2 (mem_image_of_mem p hj))
    (hinj.ne hij)
  rw [h, sub_self, zero_div] at h1
  nlinarith

/-! ### Lemma 2: sums of two squares -/

/-- **Lemma 2.** If `u² + v² = 2^(2m+1)` with integers `u, v`, then `u = ±2^m`. -/
theorem eq_of_sq_add_sq (m : ℕ) (u v : ℤ) (h : u ^ 2 + v ^ 2 = 2 ^ (2 * m + 1)) :
    u = 2 ^ m ∨ u = -2 ^ m := by
  induction m generalizing u v with
  | zero =>
    norm_num at h
    have hu : u ≤ 1 := by nlinarith
    have hu' : -1 ≤ u := by nlinarith
    have hv : v ≤ 1 := by nlinarith
    have hv' : -1 ≤ v := by nlinarith
    interval_cases u <;> interval_cases v <;> simp_all
  | succ m ih =>
    have h4 : u ^ 2 + v ^ 2 = 4 * 2 ^ (2 * m + 1) := by
      rw [h]
      ring
    -- modulo `4`, both `u` and `v` are even
    obtain ⟨a, ha | ha⟩ := Int.even_or_odd' u <;> obtain ⟨b, hb | hb⟩ := Int.even_or_odd' v <;>
      subst ha hb
    · have := ih a b (by linarith)
      rw [pow_succ]
      omega
    all_goals
      ring_nf at h4
      omega

/-! ### Lemma 3: the group `W` and its characters -/

/-- The set `F × F`, to be equipped with the addition `(a, b) + (a', b') = (a + a', b + b' + a a')`.
In characteristic `2` these are the Witt vectors of length two. -/
@[ext] structure W (F : Type*) where
  /-- The first component. -/
  a : F
  /-- The second component. -/
  b : F

namespace W

variable {F : Type*} [Field F]

/-- The addition. -/
instance : Add (W F) := ⟨fun p q => ⟨p.a + q.a, p.b + q.b + p.a * q.a⟩⟩

/-- The zero element `(0, 0)`. -/
instance : Zero (W F) := ⟨⟨0, 0⟩⟩

/-- The inverse `-(a, b) = (-a, -b + a²)`. -/
instance : Neg (W F) := ⟨fun p => ⟨-p.a, -p.b + p.a ^ 2⟩⟩

/-- First component of a sum. -/
@[simp] theorem add_a (p q : W F) : (p + q).a = p.a + q.a := rfl

/-- Second component of a sum. -/
@[simp] theorem add_b (p q : W F) : (p + q).b = p.b + q.b + p.a * q.a := rfl

/-- First component of zero. -/
@[simp] theorem zero_a : (0 : W F).a = 0 := rfl

/-- Second component of zero. -/
@[simp] theorem zero_b : (0 : W F).b = 0 := rfl

/-- First component of an inverse. -/
@[simp] theorem neg_a (p : W F) : (-p).a = -p.a := rfl

/-- Second component of an inverse. -/
@[simp] theorem neg_b (p : W F) : (-p).b = -p.b + p.a ^ 2 := rfl

/-- `W F` is an abelian group. -/
instance : AddCommGroup (W F) where
  add_assoc p q r := by ext <;> simp <;> ring
  zero_add p := by ext <;> simp
  add_zero p := by ext <;> simp
  add_comm p q := by ext <;> simp <;> ring
  neg_add_cancel p := by
    ext <;> simp
    ring
  nsmul := nsmulRec
  zsmul := zsmulRec

/-- `W F` is finite when `F` is. -/
instance [Finite F] : Finite (W F) :=
  Finite.of_injective (fun p => (p.a, p.b)) fun p q h => by
    ext
    · exact congrArg Prod.fst h
    · exact congrArg Prod.snd h

end W

/-- **Lemma 3 (a).** Some character `χ` of `W F` has `χ (0, 1) ≠ 1`. -/
theorem exists_char (F : Type*) [Field F] [Finite F] : ∃ χ : AddChar (W F) ℂ, χ ⟨0, 1⟩ ≠ 1 :=
  AddChar.exists_apply_ne_zero.2 fun h => one_ne_zero (congrArg W.b h)

variable {F : Type*} [Field F] (χ : AddChar (W F) ℂ)

/-- **Lemma 3 (b).** If `χ (0, 1) ≠ 1` and `t ≠ 0`, then `∑ₓ χ (0, t x) = 0`: replacing `x` by
`x + 1/t` multiplies the sum by `χ (0, 1)`. -/
theorem sum_char [Fintype F] (hχ : χ ⟨0, 1⟩ ≠ 1) {t : F} (ht : t ≠ 0) :
    ∑ x, χ ⟨0, t * x⟩ = 0 := by
  have h : ∑ x, χ ⟨0, t * x⟩ = χ ⟨0, 1⟩ * ∑ x, χ ⟨0, t * x⟩ := by
    rw [mul_sum, ← Equiv.sum_comp (Equiv.addRight t⁻¹)]
    refine sum_congr rfl fun x _ => ?_
    rw [← AddChar.map_add_eq_mul]
    congr 1
    ext <;> simp
    field_simp
    ring
  have h' : (χ ⟨0, 1⟩ - 1) * ∑ x, χ ⟨0, t * x⟩ = 0 := by linear_combination -h
  exact (mul_eq_zero.1 h').resolve_left (sub_ne_zero.2 hχ)

/-- **Lemma 3 (c).** In characteristic `2` the values of `χ` are of the form `u + v i` with integers
`u, v`. (They are `±1, ±i`, because `4 p = 0` for every `p`.) The other half of Lemma 3 (c),
`χ (-p) = conj (χ p)`, is Mathlib's `AddChar.map_neg_eq_conj`, for finite `F`. -/
theorem char_value [CharP F 2] (p : W F) : ∃ u v : ℤ, χ p = u + v * Complex.I := by
  have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
  have h4p : (p + p) + (p + p) = 0 := by
    ext <;> simp
    · linear_combination 2 * p.a * h2
    · linear_combination (2 * p.b + 3 * p.a ^ 2) * h2
  have h4 : (χ p * χ p) * (χ p * χ p) = 1 := by
    rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul, h4p, AddChar.map_zero_eq_one]
  have h : (χ p - 1) * ((χ p + 1) * ((χ p - Complex.I) * (χ p + Complex.I))) = 0 := by
    linear_combination h4 - (χ p ^ 2 - 1) * Complex.I_sq
  rcases mul_eq_zero.1 h with h | h
  · exact ⟨1, 0, by push_cast; linear_combination h⟩
  rcases mul_eq_zero.1 h with h | h
  · exact ⟨-1, 0, by push_cast; linear_combination h⟩
  rcases mul_eq_zero.1 h with h | h
  · exact ⟨0, 1, by push_cast; linear_combination h⟩
  · exact ⟨0, -1, by push_cast; linear_combination h⟩

/-! ### Lemma 4: the character sums -/

/-- The element `δ(x) = (c x, b x) - (c' x, b' x)` of `W F`. -/
def diff (c b c' b' x : F) : W F := ⟨c * x, b * x⟩ - ⟨c' * x, b' * x⟩

/-- In characteristic `2`, `δ(x + y) = δ(x) + δ(y) + (0, (c - c')² y x)`. -/
theorem diff_add [CharP F 2] (c b c' b' x y : F) :
    diff c b c' b' (x + y) = diff c b c' b' x + diff c b c' b' y + ⟨0, (c - c') ^ 2 * y * x⟩ := by
  have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
  simp only [diff, sub_eq_add_neg]
  ext <;> simp
  · ring
  · linear_combination (- c * (c - c') * x * y) * h2

/-- **Lemma 4 (a).** Let `χ (0, 1) ≠ 1`. If `c = c'` and `b ≠ b'`, then `∑ₓ χ(δ(x)) = 0`. -/
theorem sum_diff_eq_zero [Fintype F] (hχ : χ ⟨0, 1⟩ ≠ 1) (c : F) {b b' : F} (hb : b ≠ b') :
    ∑ x, χ (diff c b c b' x) = 0 := by
  rw [← sum_char χ hχ (sub_ne_zero.2 hb)]
  refine sum_congr rfl fun x _ => congrArg χ ?_
  rw [diff, sub_eq_add_neg]
  ext <;> simp
  ring

/-- **Lemma 4 (b).** Let `F` have characteristic `2` and let `χ (0, 1) ≠ 1`. If `c ≠ c'`, then
`|∑ₓ χ(δ(x))|² = #F`. -/
theorem normSq_sum_diff [Fintype F] [CharP F 2] (hχ : χ ⟨0, 1⟩ ≠ 1) {c c' : F} (hc : c ≠ c')
    (b b' : F) :
    (∑ x, χ (diff c b c' b' x)) * conj (∑ x, χ (diff c b c' b' x)) = Fintype.card F := by
  set δ := diff c b c' b' with hδ
  have he : (c - c') ^ 2 ≠ 0 := pow_ne_zero 2 (sub_ne_zero.2 hc)
  calc (∑ x, χ (δ x)) * conj (∑ x, χ (δ x))
      = ∑ x, ∑ y, χ (δ (x + y)) * conj (χ (δ x)) := by
        rw [map_sum, mul_sum]
        refine sum_congr rfl fun x _ => ?_
        rw [← sum_mul, ← Equiv.sum_comp (Equiv.addLeft x) (fun z => χ (δ z))]
        rfl
    _ = ∑ x, ∑ y, χ (δ y) * χ ⟨0, (c - c') ^ 2 * y * x⟩ := by
        refine sum_congr rfl fun x _ => sum_congr rfl fun y _ => ?_
        rw [← AddChar.map_neg_eq_conj, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul, hδ,
          diff_add]
        congr 1
        abel
    _ = ∑ y, χ (δ y) * ∑ x, χ ⟨0, (c - c') ^ 2 * y * x⟩ := by
        rw [sum_comm]
        simp only [mul_sum]
    _ = χ (δ 0) * ∑ x, χ ⟨0, (c - c') ^ 2 * 0 * x⟩ := by
        refine sum_eq_single 0 (fun y _ hy => ?_) (by simp)
        rw [sum_char χ hχ (mul_ne_zero he hy), mul_zero]
    _ = Fintype.card F := by
        have h0 : (⟨0, 0⟩ : W F) = 0 := rfl
        simp [hδ, diff, h0]

/-- **Lemma 4 (c).** Let `F` have characteristic `2` and `2^(2m+1)` elements, and let
`χ (0, 1) ≠ 1`. If `c ≠ c'`, then `∑ₓ χ(δ(x))` has real part `±2^m`. -/
theorem re_sum_diff [Fintype F] [CharP F 2] (hχ : χ ⟨0, 1⟩ ≠ 1) {m : ℕ}
    (hF : Fintype.card F = 2 ^ (2 * m + 1)) {c c' : F} (hc : c ≠ c') (b b' : F) :
    (∑ x, χ (diff c b c' b' x)).re = 2 ^ m ∨ (∑ x, χ (diff c b c' b' x)).re = -2 ^ m := by
  choose u v huv using char_value χ
  obtain ⟨U, V, hS⟩ : ∃ U V : ℤ, ∑ x, χ (diff c b c' b' x) = (U : ℝ) + (V : ℝ) * Complex.I := by
    refine ⟨∑ x, u (diff c b c' b' x), ∑ x, v (diff c b c' b' x), ?_⟩
    simp only [huv, sum_add_distrib, ← sum_mul]
    push_cast
    rfl
  have h := normSq_sum_diff χ hχ hc b b'
  rw [hS, Complex.mul_conj, Complex.normSq_add_mul_I, hF] at h
  have hUV : U ^ 2 + V ^ 2 = 2 ^ (2 * m + 1) := by exact_mod_cast h
  have hre : ((U : ℝ) + (V : ℝ) * Complex.I : ℂ).re = U := by simp
  rw [hS, hre]
  exact_mod_cast eq_of_sq_add_sq m U V hUV

/-! ### Lemma 5: the vectors -/

/-- The vector `w_{c,b}` in `ℂ^F ⊕ ℝ^F`: the numbers `χ (c x, b x)` for `x ∈ F`, and then the vector
with `√A` in position `c` and zeros elsewhere. -/
noncomputable def vec [DecidableEq F] (A : ℕ) (c b : F) :
    WithLp 2 (EuclideanSpace ℂ F × EuclideanSpace ℝ F) :=
  .toLp 2 (.toLp 2 fun x => χ ⟨c * x, b * x⟩, EuclideanSpace.single c √A)

omit [Field F] in
/-- The real dimension of `ℂ^F ⊕ ℝ^F` is `3 * #F`. -/
theorem finrank_vec [Fintype F] :
    Module.finrank ℝ (WithLp 2 (EuclideanSpace ℂ F × EuclideanSpace ℝ F)) = 3 * Fintype.card F := by
  rw [(WithLp.linearEquiv 2 ℝ _).finrank_eq, Module.finrank_prod, finrank_real_of_complex]
  simp
  ring

/-- `⟪w_{c,b}, w_{c',b'}⟫` is the real part of `∑ₓ χ(δ(x))`, plus `A` if `c = c'`. -/
theorem inner_vec [Fintype F] [DecidableEq F] (A : ℕ) (c b c' b' : F) :
    ⟪vec χ A c b, vec χ A c' b'⟫_ℝ =
      (∑ x, χ (diff c b c' b' x)).re + if c = c' then (A : ℝ) else 0 := by
  rw [real_inner_comm]
  simp [vec, diff, PiLp.inner_apply, Complex.inner, sub_eq_add_neg, AddChar.map_add_eq_mul,
    AddChar.map_neg_eq_conj, eq_comm]

/-- **Lemma 5 (a).** If `#F = 2A²` then `‖w_{c,b}‖² = 2A² + A`. -/
theorem vec_self [Fintype F] [DecidableEq F] {A : ℕ} (hF : Fintype.card F = 2 * A ^ 2) (c b : F) :
    ⟪vec χ A c b, vec χ A c b⟫_ℝ = 2 * A ^ 2 + A := by
  rw [inner_vec, if_pos rfl]
  simp [diff, hF, ← Complex.ofReal_natCast, ← Complex.ofReal_pow]

/-- **Lemma 5 (b).** Let `F` have characteristic `2` and `2^(2m+1)` elements, let `A = 2^m`, and let
`χ (0, 1) ≠ 1`. If `(c, b) ≠ (c', b')`, then `w_{c,b}` and `w_{c',b'}` have inner product `±A`. -/
theorem vec_ne [Fintype F] [DecidableEq F] [CharP F 2] (hχ : χ ⟨0, 1⟩ ≠ 1) {m : ℕ}
    (hF : Fintype.card F = 2 ^ (2 * m + 1)) (c b c' b' : F) (hne : (c, b) ≠ (c', b')) :
    ⟪vec χ (2 ^ m) c b, vec χ (2 ^ m) c' b'⟫_ℝ = (2 ^ m : ℕ) ∨
      ⟪vec χ (2 ^ m) c b, vec χ (2 ^ m) c' b'⟫_ℝ = -(2 ^ m : ℕ) := by
  rw [inner_vec]
  by_cases hc : c = c'
  · subst hc
    have hb : b ≠ b' := fun h => hne (by rw [h])
    simp [sum_diff_eq_zero χ hχ c hb]
  · simpa [hc] using re_sum_diff χ hχ hF hc b b'

/-! ### The theorem -/

/-- **Theorem.** For `A = 2^m`, `d = 6A²` and `n = 4A⁴` we have `g_d(n) ≤ 2A + 2`. -/
public theorem gDim_upper (m : ℕ) :
    Erdos1066.gDim (6 * (2 ^ m) ^ 2) (4 * (2 ^ m) ^ 4) ≤ 2 * 2 ^ m + 2 := by
  classical
  let F := GaloisField 2 (2 * m + 1)
  let _ : Fintype F := Fintype.ofFinite F
  have hF : Fintype.card F = 2 ^ (2 * m + 1) := by
    rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 _ (by omega)
  have hF' : Fintype.card F = 2 * (2 ^ m) ^ 2 := by
    rw [hF]
    ring
  obtain ⟨χ, hχ⟩ := exists_char F
  have h := gDim_le (A := 2 ^ m) (by positivity) (fun i : F × F => vec χ (2 ^ m) i.1 i.2)
    (fun i => vec_self χ hF' i.1 i.2) (fun i j => vec_ne χ hχ hF i.1 i.2 j.1 j.2)
  rw [finrank_vec, Fintype.card_prod, hF'] at h
  convert h using 2 <;> ring

end Sol1066

/-- **Corollary.** No `c > 0` satisfies `c n / d ≤ g_d(n)` for all `d ≥ 1` and all `n`. -/
public theorem main : ¬ (type_of% @Erdos1066.erdos_1066.variants.higher_dim) := by
  rintro ⟨c, hc, h⟩
  obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt (6 / c) (one_lt_two : (1 : ℝ) < 2)
  rw [div_lt_iff₀ hc] at hm
  set A : ℝ := 2 ^ m with hA
  have hA1 : 1 ≤ A := one_le_pow₀ one_le_two
  have h1 : c * (4 * A ^ 4) / (6 * A ^ 2) ≤ 2 * A + 2 := by
    have hlow := h (6 * (2 ^ m) ^ 2) (4 * (2 ^ m) ^ 4) (Nat.mul_pos (by norm_num) (by positivity))
    push_cast at hlow
    exact hlow.trans (by rw [hA]; exact_mod_cast Sol1066.gDim_upper m)
  have h2 : c * (4 * A ^ 4) / (6 * A ^ 2) = 2 / 3 * (A * c) * A := by
    field_simp
    ring
  rw [h2] at h1
  nlinarith

/-- info: 'main' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms main
