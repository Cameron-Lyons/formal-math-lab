/-- The norm of `a + b ∛k` supplies a cube root via the linear equation `b*r ≡ -a`. -/
theorem norm_root {k a b d r : Int} (hn : d = a^3 + k*b^3)
    (hab : Int.gcd a b = 1) (hr : d ∣ b*r + a) : d ∣ r^3 - k := by
  have hn' : d = a^3 + (k*b^2)*b := by grind
  have hg : Int.gcd d b = 1 := by
    rw [hn', Int.gcd_add_mul_right_left]
    exact Int.gcd_pow_left_of_gcd_eq_one hab
  have cancel (v : Int) (h : d ∣ b*v) : d ∣ v := by
    have h' := Int.dvd_gcd_mul_iff_dvd_mul.mpr h
    simpa [hg] using h'
  obtain ⟨m, hm⟩ := hr
  apply cancel
  apply cancel
  apply cancel
  refine ⟨m * ((b*r)^2-a*b*r+a^2)-1, ?_⟩
  grind

