#Reduced Groebner basis data
#---
#field characteristic: 257
#variable order:       x1, x2, x3, x4
#monomial order:       graded reverse lexicographical
#length of basis:      10 elements sorted by increasing leading monomials
#---
[1*x2^1*x4^1+256*x1^1,
1*x3^2+256*x1^1*x4^1,
1*x2^1*x3^1+256*x4^1,
1*x1^1*x3^1+256*x4^2,
1*x1^1*x2^1+256*x3^1,
1*x1^2+256*x3^1*x4^1,
1*x4^3+256,
1*x3^1*x4^2+256*x2^2,
1*x1^1*x4^2+256*x2^1,
1*x2^3+256]:
