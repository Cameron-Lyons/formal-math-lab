#Reduced Groebner basis data
#---
#field characteristic: 2
#variable order:       x1, x2, x3
#monomial order:       graded reverse lexicographical
#length of basis:      6 elements sorted by increasing leading monomials
#---
[1*x2^1*x3^1+1*x2^1+1*x3^1+1,
1*x1^1*x3^1+1*x1^1+1*x3^1+1,
1*x1^1*x2^1+1*x1^1+1*x2^1+1,
1*x3^3+1,
1*x2^3+1,
1*x1^3+1]:
