namespace SmallCubic.TwoPoint

/-- If two rational pairs agree modulo m, their determinant vanishes as soon as
its archimedean upper bound is strictly smaller than m. -/
private theorem det_zero {m r H a b u v : ℤ}
    (h : m ∣ a-b*r) (hc : m ∣ u-v*r) (ha : |a| ≤ H) (hb : |b| ≤ H)
    (hm : H*(|u|+|v|) < m) : a*v-b*u = 0 := by
  apply Int.eq_zero_of_abs_lt_dvd (m := m)
  · obtain ⟨j,hj⟩ := h
    obtain ⟨k,hk⟩ := hc
    refine ⟨j*v-b*k, ?_⟩
    linear_combination v*hj - b*hk
  · calc
      |a*v-b*u| ≤ |a*v|+|b*u| := by
        simpa only [sub_eq_add_neg, abs_neg] using abs_add_le (a*v) (-(b*u))
      _ ≤ H*|v|+H*|u| := by
        simp only [abs_mul]
        exact add_le_add (mul_le_mul_of_nonneg_right ha (abs_nonneg _))
          (mul_le_mul_of_nonneg_right hb (abs_nonneg _))
      _ = H*(|u|+|v|) := by ring
      _ < m := hm

private theorem lattice_exclusion {m r H a b u v s t : ℤ}
    (h : m ∣ a-b*r) (ha : |a| ≤ H) (hb : |b| ≤ H)
    (hc : (m ∣ u-v*r) ∧ (m ∣ s-t*r) ∧ H*(|u|+|v|) < m ∧ H*(|s|+|t|) < m ∧
      u*t-s*v ≠ 0) : b = 0 := by
  obtain ⟨h₁,h₂,h₃,h₄,h₅⟩ := hc
  have hp := det_zero h h₁ ha hb h₃
  have hq := det_zero h h₂ ha hb h₄
  have hz : b*(u*t-s*v) = 0 := by linear_combination v*hq-t*hp
  exact (mul_eq_zero.mp hz).resolve_right h₅

