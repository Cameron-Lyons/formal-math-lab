private def unpackDigits : Nat → Nat → List Nat → List Nat
  | 0, _, acc => acc
  | k + 1, word, acc =>
    unpackDigits k (word >>> 4) ((word &&& 15) :: acc)

/-- Read all hexadecimal digits following the leading sentinel. -/
def unpack (word : Nat) : List Nat := unpackDigits (word.log2 / 4) word []

def bank : List (List Nat) := bankWords.map unpack

theorem bank_size : bank.length = 131 := by
  simp only [bank, List.length_map]
  rfl

/-- Read a published path from the chosen end. -/
def orientedPath (row : List Nat) (backwards : Bool) : List Vertex :=
  let path := vertices row
  if backwards then path.reverse else path

/-- Expand the finite bank and ask the kernel to check each concrete claim.
Checking rows separately bounds the memory used by reduction. -/
macro "checkBankRows" : tactic => `(tactic|
  set_option maxRecDepth 65536 in
  set_option maxHeartbeats 0 in
  (simp only [bank, bankWords, List.map_cons, List.map_nil, List.forall_mem_cons,
     List.forall_mem_nil, and_true]
   repeat' apply And.intro
   all_goals decide +kernel))

end Snake
