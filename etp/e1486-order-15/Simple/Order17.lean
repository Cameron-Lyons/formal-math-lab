def table (x y : Fin 17) : Fin 17 := Fin.ofNat 17 ((rows.getD x []).getD y 0)

/-- The kernel checks all `17³ = 4913` instances of the law. -/
theorem exists_table : ∃ op : Fin 17 → Fin 17 → Fin 17,
    ∀ x y z, op (op y x) (op x (op z z)) = x :=
  ⟨table, by decide⟩

end E1486.Order17
