#Reduced Groebner basis data
#---
#field characteristic: 5
#variable order:       x1, x2, x3, x4
#monomial order:       graded reverse lexicographical
#length of basis:      10 elements sorted by increasing leading monomials
#---
[1*x2^1*x4^1+4*x1^1,
1*x3^2+4*x1^1*x4^1,
1*x2^1*x3^1+4*x4^1,
1*x1^1*x3^1+4*x4^2,
1*x1^1*x2^1+4*x3^1,
1*x1^2+4*x3^1*x4^1,
1*x4^3+4,
1*x3^1*x4^2+4*x2^2,
1*x1^1*x4^2+4*x2^1,
1*x2^3+4]:
